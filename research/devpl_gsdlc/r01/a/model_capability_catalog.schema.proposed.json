{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/research/r01/a/model_capability_catalog.schema.proposed.json",
  "title": "DEVPL-GSDLC-R01-A Proposed Model Capability Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_id",
    "model_family",
    "provider_id",
    "origin_country",
    "license_class",
    "access_routes",
    "context_tokens",
    "capabilities",
    "official_source",
    "retrieved_at",
    "freshness_class",
    "evidence_status"
  ],
  "properties": {
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "model_family": {
      "type": "string",
      "minLength": 1
    },
    "provider_id": {
      "type": "string",
      "minLength": 1
    },
    "origin_country": {
      "type": [
        "string",
        "null"
      ]
    },
    "license_class": {
      "type": "string",
      "minLength": 1
    },
    "access_routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "context_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reasoning",
        "coding",
        "vision",
        "tool_calling",
        "structured_output",
        "embeddings",
        "reranking",
        "streaming",
        "batching"
      ],
      "properties": {
        "reasoning": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "coding": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "vision": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "tool_calling": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "structured_output": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "embeddings": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reranking": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "streaming": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "batching": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "official_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "retrieved_at": {
      "type": "string",
      "format": "date"
    },
    "freshness_class": {
      "enum": [
        "F0-volatile",
        "F1-route",
        "F2-contractual",
        "F3-license",
        "F4-stable"
      ]
    },
    "evidence_status": {
      "enum": [
        "verified",
        "conditional",
        "unknown"
      ]
    }
  },
  "x-devpilot-status": "proposed-research-contract-only",
  "x-runtime-enablement": false
}
