  "semantic_rules": [
    {
      "rule_id": "SEM-TOOL-APPROVAL-001",
      "title": "Sensitive side-effecting tools must be approval-governed or explicitly safe-gated",
      "category": "tool",
      "default_severity": "block",
      "finding_ids": [
        "MIASI_SEMANTIC_SENSITIVE_TOOL_APPROVAL_MISSING",
        "MIASI_SEMANTIC_CONTROLLED_WRITE_APPROVAL_REVIEW"
      ],
      "critical": true,
      "cannot_disable_without_adr": true
    },
    {
      "rule_id": "SEM-APPROVAL-SCOPE-001",
      "title": "Sensitive tools must have explicit approval metadata or concrete local guard scope",
      "category": "approval",
      "default_severity": "block",
      "finding_ids": [
        "MIASI_SEMANTIC_APPROVAL_METADATA_MISSING",
        "MIASI_SEMANTIC_APPROVAL_SCOPE_GENERIC",
        "MIASI_SEMANTIC_CONTROLLED_WRITE_APPROVAL_OR_GUARD_MISSING"
      ],
      "critical": true,
      "cannot_disable_without_adr": true
    },
    {
      "rule_id": "SEM-RBAC-001",
      "title": "Sensitive actions must be constrained by local identity/RBAC metadata",
      "category": "rbac",
      "default_severity": "block",
      "finding_ids": [
        "MIASI_SEMANTIC_RBAC_NOT_ENFORCED",
        "MIASI_SEMANTIC_UNKNOWN_ACTOR_NOT_DENIED",
        "MIASI_SEMANTIC_RBAC_BINDING_MISSING",
        "MIASI_SEMANTIC_RBAC_REVIEW_REQUIRED"
      ],
      "critical": true,
      "cannot_disable_without_adr": true
    },
    {
      "rule_id": "SEM-SECURITY-GUARD-001",
      "title": "Sensitive tools must declare SecretGuard, local guard and network/cost guard semantics",
      "category": "security",
      "default_severity": "block",
      "finding_ids": [
        "MIASI_SEMANTIC_SECRET_GUARD_MISSING",
        "MIASI_SEMANTIC_NETWORK_COST_GUARD_MISSING",
        "MIASI_SEMANTIC_LOCAL_WRITE_GUARD_MISSING"
      ],
      "critical": true,
      "cannot_disable_without_adr": true
    },
    {
      "rule_id": "SEM-NO-GO-GUARD-001",
      "title": "Remote/plugin/connector write or execute paths must remain deny/block guarded",
      "category": "no-go",
      "default_severity": "block",
      "finding_ids": [
        "MIASI_SEMANTIC_NO_GO_TOOL_ALLOWED",
        "MIASI_SEMANTIC_CONNECTOR_WRITE_WITHOUT_FUTURE_GUARDS"
      ],
      "critical": true,
      "cannot_disable_without_adr": true
    },
    {
      "rule_id": "SEM-EVAL-COVERAGE-001",
      "title": "Agentic safety, red-team, plugin, RBAC and remote fixtures must cover high-risk semantic threats",
      "category": "eval",
      "default_severity": "block",
      "finding_ids": [
        "MIASI_SEMANTIC_EVAL_FIXTURE_MISSING",
        "MIASI_SEMANTIC_EVAL_SUITE_ID_MISMATCH",
        "MIASI_SEMANTIC_EVAL_CASES_MISSING",
        "MIASI_SEMANTIC_EVAL_MARKER_COVERAGE_MISSING",
        "MIASI_SEMANTIC_EVAL_UNSAFE_RUNTIME_FLAG"
      ],
      "critical": true,
      "cannot_disable_without_adr": true
    },
    {
      "rule_id": "SEM-NO-GO-001",
      "title": "Remote/plugin/connector execute no-go policy rules must remain blocked",
      "category": "no-go",
      "default_severity": "block",
      "finding_ids": [
        "MIASI_SEMANTIC_NO_GO_RULE_ALLOWED"
      ],
      "critical": true,
      "cannot_disable_without_adr": true
    }
  ],
