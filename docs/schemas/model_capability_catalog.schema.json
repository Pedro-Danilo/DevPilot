{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/model_capability_catalog.schema.json",
  "title": "ModelCapabilityCatalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "status",
    "owner",
    "updated",
    "source_authority",
    "capability_vocabulary",
    "providers",
    "models",
    "gateway_adapters",
    "auth_adapters",
    "access_routes",
    "routing_policy",
    "migration"
  ],
  "properties": {
    "schema_id": {
      "const": "SCHEMA-DEVPL-GSDLC-06-A-MODEL-CAPABILITY-CATALOG-V1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "source_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_repo",
        "execution_commit",
        "execution_sha256",
        "r01_repo",
        "r01_commit",
        "r01_sha256",
        "r01_closure"
      ],
      "properties": {
        "execution_repo": {
          "type": "string"
        },
        "execution_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "execution_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "r01_repo": {
          "type": "string"
        },
        "r01_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "r01_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "r01_closure": {
          "type": "string"
        }
      }
    },
    "capability_vocabulary": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": [
          "text_generation",
          "classification",
          "structured_output",
          "tool_calling_output",
          "vision",
          "coding",
          "embeddings"
        ]
      }
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider_id",
          "provider_kind",
          "external_api",
          "runtime_enabled",
          "reason"
        ],
        "properties": {
          "provider_id": {
            "type": "string",
            "minLength": 1
          },
          "provider_kind": {
            "enum": [
              "mock",
              "local",
              "api"
            ]
          },
          "external_api": {
            "type": "boolean"
          },
          "runtime_enabled": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model_id",
          "provider_id",
          "model_class",
          "context_window",
          "capabilities",
          "cost",
          "evidence_refs",
          "freshness"
        ],
        "properties": {
          "model_id": {
            "type": "string",
            "minLength": 1
          },
          "provider_id": {
            "type": "string",
            "minLength": 1
          },
          "model_class": {
            "type": "string"
          },
          "context_window": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "tokens"
            ],
            "properties": {
              "state": {
                "type": "string"
              },
              "tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              }
            }
          },
          "capabilities": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text_generation",
              "classification",
              "structured_output",
              "tool_calling_output",
              "vision",
              "coding",
              "embeddings"
            ],
            "properties": {
              "text_generation": {
                "type": "string",
                "minLength": 1
              },
              "classification": {
                "type": "string",
                "minLength": 1
              },
              "structured_output": {
                "type": "string",
                "minLength": 1
              },
              "tool_calling_output": {
                "type": "string",
                "minLength": 1
              },
              "vision": {
                "type": "string",
                "minLength": 1
              },
              "coding": {
                "type": "string",
                "minLength": 1
              },
              "embeddings": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "cost": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "input_per_1k_usd",
              "output_per_1k_usd"
            ],
            "properties": {
              "state": {
                "type": "string"
              },
              "input_per_1k_usd": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "output_per_1k_usd": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              }
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "freshness": {
            "type": "string"
          }
        }
      }
    },
    "gateway_adapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gateway_adapter_id",
          "provider_id",
          "status"
        ],
        "properties": {
          "gateway_adapter_id": {
            "type": "string"
          },
          "provider_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    "auth_adapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "auth_adapter_id",
          "kind",
          "status",
          "secret_reference"
        ],
        "properties": {
          "auth_adapter_id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "secret_reference": {
            "type": "boolean"
          }
        }
      }
    },
    "access_routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "access_route_id",
          "research_route_id",
          "provider_id",
          "model_id",
          "gateway_adapter_id",
          "auth_adapter_id",
          "locality",
          "endpoint_class",
          "research_disposition",
          "disposition",
          "runtime_enabled",
          "opt_in_required",
          "external_api",
          "reason",
          "evidence_refs",
          "freshness",
          "target_regions"
        ],
        "properties": {
          "access_route_id": {
            "type": "string",
            "minLength": 1
          },
          "provider_id": {
            "type": "string",
            "minLength": 1
          },
          "model_id": {
            "type": "string",
            "minLength": 1
          },
          "gateway_adapter_id": {
            "type": "string",
            "minLength": 1
          },
          "auth_adapter_id": {
            "type": "string",
            "minLength": 1
          },
          "locality": {
            "enum": [
              "mock",
              "loopback",
              "remote",
              "consumer-session"
            ]
          },
          "endpoint_class": {
            "type": "string"
          },
          "research_disposition": {
            "type": "string"
          },
          "disposition": {
            "enum": [
              "enabled",
              "disabled",
              "conditional",
              "unknown",
              "blocked"
            ]
          },
          "runtime_enabled": {
            "type": "boolean"
          },
          "opt_in_required": {
            "type": "boolean"
          },
          "external_api": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "freshness": {
            "type": "string"
          },
          "target_regions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "research_route_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "routing_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_agnostic_request",
        "unknown_route",
        "unknown_capability",
        "mock_must_remain_available",
        "tool_execution_authority",
        "external_openai_compatibility_implies_authorization"
      ],
      "properties": {
        "provider_agnostic_request": {
          "const": true
        },
        "unknown_route": {
          "const": "deny"
        },
        "unknown_capability": {
          "const": "deny"
        },
        "mock_must_remain_available": {
          "const": true
        },
        "tool_execution_authority": {
          "const": "outside-model-gateway"
        },
        "external_openai_compatibility_implies_authorization": {
          "const": false
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legacy_contract",
        "strategy",
        "external_enabled_legacy_config"
      ],
      "properties": {
        "legacy_contract": {
          "const": "ModelProviderConfig"
        },
        "strategy": {
          "type": "string"
        },
        "external_enabled_legacy_config": {
          "type": "string"
        }
      }
    }
  }
}
