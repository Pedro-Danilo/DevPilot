{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/SCHEMA-DEVPL-PLANNING-DEPENDENCY-V1",
  "title": "Planning Dependency",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "id",
    "predecessor_id",
    "successor_id",
    "kind",
    "rationale"
  ],
  "properties": {
    "schema_id": {
      "const": "SCHEMA-DEVPL-PLANNING-DEPENDENCY-V1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^dep-[a-z0-9-]{2,59}$"
    },
    "predecessor_id": {
      "type": "string",
      "minLength": 1
    },
    "successor_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "requires",
        "blocks",
        "sequences"
      ]
    },
    "rationale": {
      "type": "string"
    }
  }
}
