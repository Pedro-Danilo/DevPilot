{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:devpilot:schema:story-dor-report:v1",
  "title": "DevPilot Story Definition of Ready Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id","schema_version","status","policy_version","story_id","story_version","workspace_id","evaluated_at_utc","checks","blockers_total","dor_report_sha256","source_mutations_performed","network_used","external_api_used"],
  "properties": {
    "schema_id":{"const":"SCHEMA-DEVPL-STORY-DOR-REPORT-V1"},
    "schema_version":{"const":"1.0.0"},
    "status":{"type":"string","enum":["PASS","BLOCK"]},
    "policy_version":{"const":"DEVPL-GSDLC-09-A-DOR-V1"},
    "story_id":{"type":"string","minLength":1},
    "story_version":{"type":"string","minLength":1},
    "workspace_id":{"type":"string"},
    "evaluated_at_utc":{"type":"string","minLength":1},
    "checks":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["code","status","message","subject"],"properties":{"code":{"type":"string","minLength":1},"status":{"type":"string","enum":["PASS","BLOCK"]},"message":{"type":"string","minLength":1},"subject":{"type":["string","null"]}}}},
    "blockers_total":{"type":"integer","minimum":0},
    "dor_report_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "source_mutations_performed":{"const":false},
    "network_used":{"const":false},
    "external_api_used":{"const":false}
  }
}
