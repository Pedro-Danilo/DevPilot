{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/mcp_fake_server_evaluation.schema.json",
  "title": "DevPilot McpFakeServerEvaluation v1",
  "description": "POST-H-032-G structural contract for local fake MCP server evaluation, MCP-to-MIASI mapping, permission model, threat model and audit trail without enabling real MCP.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_id",
    "report_id",
    "created_by",
    "status",
    "generated_at_utc",
    "adr_path",
    "contract_path",
    "tool_registry_path",
    "tool_call_policy_path",
    "summary",
    "server",
    "threat_model",
    "permission_model",
    "mcp_tool_mappings",
    "resources",
    "prompts",
    "protocol_exchanges",
    "audit_trail",
    "injection_evaluations",
    "safety",
    "findings",
    "notes",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "schema_id": {"const": "SCHEMA-DEVPL-MCP-FAKE-SERVER-EVALUATION-V1"},
    "report_id": {"const": "devpilot-mcp-fake-server-evaluation-report"},
    "created_by": {"const": "POST-H-032-G"},
    "status": {"enum": ["implemented-initial", "blocked"]},
    "generated_at_utc": {"type": "string", "minLength": 10},
    "adr_path": {"type": "string", "minLength": 1},
    "contract_path": {"type": "string", "minLength": 1},
    "tool_registry_path": {"type": "string", "minLength": 1},
    "tool_call_policy_path": {"type": "string", "minLength": 1},
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "created_by",
        "status",
        "decision",
        "preliminary",
        "mcp_real_enabled",
        "fake_server_only",
        "fake_server_local",
        "protocol_exchanges_total",
        "mcp_tools_total",
        "mcp_tool_mappings_total",
        "miasi_mapped_tools_total",
        "write_or_execute_tools_total",
        "write_or_execute_tools_require_approval",
        "permission_model_present",
        "audit_trail_events_total",
        "threat_model_present",
        "tool_call_policy_dry_run_first",
        "prompt_tool_injection_guard_passed",
        "connector_write_enabled",
        "plugin_execution_enabled",
        "remote_execution_enabled",
        "network_used",
        "external_api_used",
        "llm_used",
        "tools_executed",
        "source_mutations_performed",
        "schema_valid",
        "reports_written",
        "blocking_findings_total",
        "findings_total"
      ],
      "properties": {
        "created_by": {"const": "POST-H-032-G"},
        "status": {"enum": ["implemented-initial", "blocked"]},
        "decision": {"enum": ["PASS", "BLOCK"]},
        "preliminary": {"const": true},
        "mcp_real_enabled_by_default": {"type": "boolean"},
        "mcp_real_enabled": {"const": false},
        "fake_server_only": {"const": true},
        "fake_server_local": {"const": true},
        "protocol_exchanges_total": {"type": "integer", "minimum": 1},
        "mcp_tools_total": {"type": "integer", "minimum": 1},
        "mcp_tool_mappings_total": {"type": "integer", "minimum": 1},
        "miasi_mapped_tools_total": {"type": "integer", "minimum": 1},
        "write_or_execute_tools_total": {"type": "integer", "minimum": 0},
        "write_or_execute_tools_require_approval": {"const": true},
        "permission_model_present": {"const": true},
        "audit_trail_events_total": {"type": "integer", "minimum": 1},
        "threat_model_present": {"const": true},
        "tool_call_policy_dry_run_first": {"const": true},
        "prompt_tool_injection_guard_passed": {"const": true},
        "connector_write_enabled": {"const": false},
        "plugin_execution_enabled": {"const": false},
        "remote_execution_enabled": {"const": false},
        "network_used": {"const": false},
        "external_api_used": {"const": false},
        "llm_used": {"const": false},
        "tools_executed": {"const": false},
        "source_mutations_performed": {"const": false},
        "schema_valid": {"type": "boolean"},
        "reports_written": {"type": "boolean"},
        "blocking_findings_total": {"type": "integer", "minimum": 0},
        "findings_total": {"type": "integer", "minimum": 0}
      }
    },
    "server": {"type": "object", "additionalProperties": true},
    "threat_model": {"type": "object", "additionalProperties": true},
    "permission_model": {"type": "object", "additionalProperties": true},
    "mcp_tool_mappings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/mcpToolMapping"}},
    "resources": {"type": "array", "items": {"type": "object"}},
    "prompts": {"type": "array", "items": {"type": "object"}},
    "protocol_exchanges": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/protocolExchange"}},
    "audit_trail": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "injection_evaluations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/injectionEvaluation"}},
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_first",
        "mcp_real_enabled",
        "fake_server_only",
        "network_used",
        "external_api_used",
        "llm_used",
        "tools_executed",
        "connector_write_enabled",
        "plugin_execution_enabled",
        "remote_execution_enabled",
        "source_mutations_performed",
        "reports_only_under_outputs",
        "prompt_tool_injection_guard_enabled",
        "approval_binding_required_for_write_or_execute"
      ],
      "properties": {
        "local_first": {"const": true},
        "mcp_real_enabled": {"const": false},
        "fake_server_only": {"const": true},
        "network_used": {"const": false},
        "external_api_used": {"const": false},
        "llm_used": {"const": false},
        "tools_executed": {"const": false},
        "connector_write_enabled": {"const": false},
        "plugin_execution_enabled": {"const": false},
        "remote_execution_enabled": {"const": false},
        "source_mutations_performed": {"const": false},
        "reports_only_under_outputs": {"const": true},
        "prompt_tool_injection_guard_enabled": {"const": true},
        "approval_binding_required_for_write_or_execute": {"const": true}
      }
    },
    "findings": {"type": "array"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "mcpToolMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mcp_tool_id",
        "name",
        "miasi_tool_id",
        "miasi_tool_name",
        "side_effect",
        "risk_level",
        "requires_approval",
        "policy_rule_ids",
        "read_only",
        "fake_response_only",
        "dry_run",
        "tool_executed",
        "connector_write_allowed",
        "plugin_execution_allowed",
        "remote_execution_allowed",
        "network_allowed"
      ],
      "properties": {
        "mcp_tool_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "miasi_tool_id": {"type": "string", "minLength": 1},
        "miasi_tool_name": {"type": "string", "minLength": 1},
        "side_effect": {"type": "string", "minLength": 1},
        "risk_level": {"type": "string", "minLength": 1},
        "requires_approval": {"type": "boolean"},
        "policy_rule_ids": {"type": "array", "items": {"type": "string"}},
        "read_only": {"type": "boolean"},
        "fake_response_only": {"const": true},
        "dry_run": {"const": true},
        "tool_executed": {"const": false},
        "connector_write_allowed": {"const": false},
        "plugin_execution_allowed": {"const": false},
        "remote_execution_allowed": {"const": false},
        "network_allowed": {"const": false}
      }
    },
    "protocolExchange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "method", "ok", "policy_decision", "tool_executed", "network_used", "external_api_used", "payload_redacted"],
      "properties": {
        "request_id": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "ok": {"type": "boolean"},
        "policy_decision": {"enum": ["allow", "requires_approval", "block"]},
        "tool_executed": {"const": false},
        "network_used": {"const": false},
        "external_api_used": {"const": false},
        "payload_redacted": {"const": true}
      }
    },
    "injectionEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "effect", "rule_id", "blocked", "payload_redacted"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "effect": {"enum": ["allow", "warn", "deny", "block"]},
        "rule_id": {"type": "string", "minLength": 1},
        "blocked": {"const": true},
        "payload_redacted": {"const": true}
      }
    }
  }
}
