{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/safe_parallel_full_plan.schema.json",
  "title": "Safe Parallel Full Plan",
  "type": "object",
  "required": [
    "schema_id",
    "status",
    "collection_total",
    "safe_waves",
    "serial_shards",
    "plan_sha256"
  ],
  "properties": {
    "schema_id": {
      "const": "devpilot.testing.safe_parallel_full_plan.v1"
    },
    "status": {
      "const": "PASS"
    },
    "collection_total": {
      "type": "integer",
      "minimum": 1
    },
    "safe_waves": {
      "type": "array"
    },
    "serial_shards": {
      "type": "array"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": true
}
