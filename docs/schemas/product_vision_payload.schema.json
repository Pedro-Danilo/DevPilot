{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://devpilot.local/schemas/product_vision_payload.schema.json",
  "x-devpilot-schema-id": "SCHEMA-DEVPL-PRODUCT-VISION-PAYLOAD-V1",
  "title": "DevPilot Product Vision Payload v1",
  "required": [
    "schema_id",
    "problem",
    "vision",
    "mvp_outcomes",
    "indicators",
    "claims",
    "assumptions",
    "open_questions"
  ],
  "properties": {
    "schema_id": {
      "const": "devpilot.product-definition.product-vision.v1"
    },
    "problem": {
      "type": "string",
      "minLength": 1
    },
    "vision": {
      "type": "string",
      "minLength": 1
    },
    "mvp_outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "indicators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "source_refs"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
