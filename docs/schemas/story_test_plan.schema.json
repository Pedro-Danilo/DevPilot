{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/story_test_plan.schema.json",
  "title": "StoryTestPlan",
  "type": "object",
  "required": [
    "schema_id", "schema_version", "test_plan_id", "test_plan_hash", "workspace_id",
    "story_execution_id", "story_id", "source_change_plan_id", "source_change_plan_hash",
    "changed_paths", "test_impact_report_hash", "matched_contracts", "matched_rules",
    "required_tests", "recommended_tests", "unknown_impact", "sensitive_impact",
    "full_regression_signal", "policy", "provenance", "safety"
  ],
  "properties": {
    "schema_id": {"const": "SCHEMA-DEVPL-GSDLC-10-A-STORY-TEST-PLAN-V1"},
    "schema_version": {"const": "1.0.0"},
    "test_plan_id": {"type": "string", "pattern": "^story-test-plan-[0-9a-f]{24}$"},
    "test_plan_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "workspace_id": {"type": "string", "minLength": 1},
    "story_execution_id": {"type": "string", "minLength": 1},
    "story_id": {"type": "string", "minLength": 1},
    "story_version": {"type": "string"},
    "story_state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_change_plan_id": {"type": "string", "minLength": 1},
    "source_change_plan_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "changed_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "test_impact_report_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "matched_contracts": {"type": "array", "items": {"type": "object"}},
    "matched_rules": {"type": "array", "items": {"type": "object"}},
    "required_tests": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "recommended_tests": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "test_reasons": {"type": "object"},
    "test_policy": {"type": "object"},
    "unknown_impact": {
      "type": "object",
      "required": ["paths", "manual_review_required", "fail_closed"],
      "properties": {
        "paths": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "manual_review_required": {"type": "boolean"},
        "fail_closed": {"const": true}
      },
      "additionalProperties": false
    },
    "sensitive_impact": {
      "type": "object",
      "required": ["paths", "present", "required_tests_total", "required_tests_unwaivable"],
      "properties": {
        "paths": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "present": {"type": "boolean"},
        "required_tests_total": {"type": "integer", "minimum": 0},
        "required_tests_unwaivable": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "full_regression_signal": {
      "type": "object",
      "required": ["required_before_backlog_or_release_closure", "informational_only", "execution_authorized", "logical_full_runs_allowed_in_gsdlc_10_a", "profile_authority"],
      "properties": {
        "required_before_backlog_or_release_closure": {"type": "boolean"},
        "informational_only": {"const": true},
        "execution_authorized": {"const": false},
        "logical_full_runs_allowed_in_gsdlc_10_a": {"const": 0},
        "profile_authority": {"const": "frx-v2.4-current"}
      },
      "additionalProperties": false
    },
    "policy": {"type": "object"},
    "provenance": {"type": "object"},
    "safety": {"type": "object"}
  },
  "additionalProperties": true
}
