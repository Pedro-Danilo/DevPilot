{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/python_artifact_install_verification.schema.json",
  "title": "DevPilot PythonArtifactInstallVerification v1",
  "type": "object",
  "additionalProperties": true,
  "x-devpilot-schema-id": "SCHEMA-DEVPL-PYTHON-ARTIFACT-INSTALL-VERIFICATION-V1",
  "x-devpilot-sprint": "POST-H-027-B",
  "x-devpilot-status": "implemented-initial",
  "required": [
    "schema_version",
    "schema_id",
    "report_id",
    "created_by",
    "created_at",
    "scope",
    "decision",
    "implemented_status",
    "execution_mode",
    "artifact",
    "artifact_kind",
    "checks_total",
    "checks_passed_total",
    "checks_failed_total",
    "commands_executed_total",
    "commands_executed",
    "checks",
    "summary",
    "safety",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "schema_id": {"const": "SCHEMA-DEVPL-PYTHON-ARTIFACT-INSTALL-VERIFICATION-V1"},
    "report_id": {"type": "string", "minLength": 1},
    "created_by": {"const": "POST-H-027-B"},
    "created_at": {"type": "string"},
    "scope": {"const": "local-python-artifact-install"},
    "decision": {"enum": ["PASS", "BLOCK"]},
    "implemented_status": {"const": "implemented-initial"},
    "execution_mode": {"const": "temporary-venv-local-pip-install-smoke"},
    "artifact": {"type": ["string", "null"]},
    "artifact_kind": {"enum": ["wheel", "sdist", "unknown"]},
    "artifact_exists": {"type": "boolean"},
    "temp_cleaned": {"type": "boolean"},
    "checks_total": {"type": "integer", "minimum": 0},
    "checks_passed_total": {"type": "integer", "minimum": 0},
    "checks_failed_total": {"type": "integer", "minimum": 0},
    "critical_checks_total": {"type": "integer", "minimum": 0},
    "critical_checks_failed_total": {"type": "integer", "minimum": 0},
    "commands_executed_total": {"type": "integer", "minimum": 0},
    "commands_executed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command_id", "command", "exit_code", "duration_ms", "timed_out", "stdout_tail", "stderr_tail"],
        "additionalProperties": true,
        "properties": {
          "command_id": {"type": "string", "minLength": 1},
          "command": {"type": "array", "items": {"type": "string"}},
          "exit_code": {"type": "integer"},
          "duration_ms": {"type": "number"},
          "timed_out": {"type": "boolean"},
          "stdout_tail": {"type": "string"},
          "stderr_tail": {"type": "string"}
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check_id", "category", "status", "critical", "reason", "metadata"],
        "additionalProperties": true,
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "category": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "block"]},
          "critical": {"type": "boolean"},
          "reason": {"type": "string"},
          "metadata": {"type": "object"}
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "decision",
        "created_by",
        "preliminary",
        "artifact_kind",
        "artifact_installed",
        "cli_version_passed",
        "schema_list_passed",
        "project_state_validate_passed",
        "docs_governance_validate_passed",
        "import_from_installed_site_packages",
        "source_path_dependency_detected",
        "post_install_commands_passed",
        "network_used",
        "external_api_used",
        "source_mutations",
        "reports_written"
      ],
      "additionalProperties": true,
      "properties": {
        "decision": {"enum": ["PASS", "BLOCK"]},
        "created_by": {"const": "POST-H-027-B"},
        "preliminary": {"const": true},
        "artifact_kind": {"enum": ["wheel", "sdist", "unknown"]},
        "artifact_installed": {"type": "boolean"},
        "cli_version_passed": {"type": "boolean"},
        "schema_list_passed": {"type": "boolean"},
        "project_state_validate_passed": {"type": "boolean"},
        "docs_governance_validate_passed": {"type": "boolean"},
        "import_from_installed_site_packages": {"type": "boolean"},
        "source_path_dependency_detected": {"const": false},
        "post_install_commands_passed": {"type": "boolean"},
        "network_used": {"const": false},
        "external_api_used": {"const": false},
        "publish_performed": {"const": false},
        "deploy_performed": {"const": false},
        "source_mutations": {"const": false},
        "reports_written": {"type": "boolean"}
      }
    },
    "safety": {
      "type": "object",
      "required": [
        "local_first",
        "temporary_venv_created",
        "subprocess_executed",
        "pip_executed",
        "pip_no_index",
        "pip_no_deps",
        "network_used",
        "external_api_used",
        "publish_performed",
        "deploy_performed",
        "remote_execution_enabled",
        "connector_write_enabled",
        "plugin_execution_enabled",
        "source_mutations",
        "reports_written"
      ],
      "additionalProperties": true,
      "properties": {
        "local_first": {"const": true},
        "temporary_venv_created": {"type": "boolean"},
        "subprocess_executed": {"type": "boolean"},
        "pip_executed": {"type": "boolean"},
        "pip_no_index": {"const": true},
        "pip_no_deps": {"const": true},
        "socket_opened": {"const": false},
        "network_used": {"const": false},
        "external_api_used": {"const": false},
        "publish_performed": {"const": false},
        "deploy_performed": {"const": false},
        "remote_execution_enabled": {"const": false},
        "connector_write_enabled": {"const": false},
        "plugin_execution_enabled": {"const": false},
        "source_mutations": {"const": false},
        "reports_written": {"type": "boolean"}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
