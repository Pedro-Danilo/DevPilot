{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/SCHEMA-DEVPL-GSDLC-13-B-TECHNOLOGY-CATALOG-V2",
  "title": "DevPilot GSDLC-13-B TechnologyCatalog v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "catalog_id",
    "status",
    "version",
    "owner",
    "micro_sprint",
    "profiles",
    "typed_operations",
    "safety"
  ],
  "properties": {
    "schema_id": {
      "const": "SCHEMA-DEVPL-GSDLC-13-B-TECHNOLOGY-CATALOG-V2"
    },
    "catalog_id": {
      "const": "DEVPL-GSDLC-13-B-TECHNOLOGY-CATALOG"
    },
    "status": {
      "type": "string"
    },
    "version": {
      "const": "2.0.0"
    },
    "owner": {
      "const": "Ordóñez"
    },
    "micro_sprint": {
      "const": "DEVPL-GSDLC-13-B-CORRECTIVE"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile_id",
          "frontend",
          "backend",
          "database",
          "project_type",
          "templates",
          "supported_entry_modes",
          "tool_requirements"
        ],
        "properties": {
          "profile_id": {
            "const": "greenfield-neutral-shell"
          },
          "frontend": {
            "const": "undecided"
          },
          "backend": {
            "const": "undecided"
          },
          "database": {
            "const": "undecided"
          },
          "project_type": {
            "const": "agent-assisted-sdlc"
          },
          "templates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "supported_entry_modes": {
            "const": [
              "CREATE_NEW"
            ]
          },
          "tool_requirements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tool_id",
                "minimum_version",
                "discovery_mode",
                "required_for"
              ],
              "properties": {
                "tool_id": {
                  "const": "git"
                },
                "minimum_version": {
                  "type": "string"
                },
                "discovery_mode": {
                  "const": "typed-read-only"
                },
                "required_for": {
                  "const": [
                    "CREATE_NEW"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "typed_operations": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "operation_id",
          "category",
          "writes",
          "network_required",
          "approval_required",
          "rollback_required",
          "implementation_status"
        ]
      }
    },
    "safety": {
      "type": "object",
      "required": [
        "local_first",
        "deny_by_default",
        "arbitrary_shell_allowed",
        "silent_network_allowed",
        "remote_git_execute_allowed",
        "credential_material_allowed",
        "pilot_workspace_access_allowed"
      ]
    }
  }
}
