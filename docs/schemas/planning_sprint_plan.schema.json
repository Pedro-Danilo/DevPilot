{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/SCHEMA-DEVPL-PLANNING-SPRINT-PLAN-V1",
  "title": "Governed Planning Sprint Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "sprint_plan_id",
    "version",
    "title",
    "owner_role",
    "lifecycle",
    "backlog_reference",
    "capacity",
    "selected_stories",
    "completed_story_ids",
    "definition_of_ready",
    "definition_of_done",
    "test_intent_ids",
    "risk_focus_ids"
  ],
  "properties": {
    "schema_id": {
      "const": "SCHEMA-DEVPL-PLANNING-SPRINT-PLAN-V1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "sprint_plan_id": {
      "type": "string",
      "pattern": "^sprint-plan-[a-z0-9-]{2,52}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "owner_role": {
      "enum": [
        "owner",
        "product-owner"
      ]
    },
    "lifecycle": {
      "enum": [
        "DRAFT",
        "REVIEW",
        "APPROVED",
        "FROZEN"
      ]
    },
    "backlog_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backlog_id",
        "version",
        "lifecycle",
        "content_sha256"
      ],
      "properties": {
        "backlog_id": {
          "type": "string",
          "pattern": "^planning-backlog-[a-z0-9-]{2,48}$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "lifecycle": {
          "const": "FROZEN"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "limit"
      ],
      "properties": {
        "unit": {
          "enum": [
            "points",
            "hours",
            "items"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      }
    },
    "selected_stories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "story_id",
          "estimate",
          "readiness",
          "blocking_reasons"
        ],
        "properties": {
          "story_id": {
            "type": "string",
            "pattern": "^story-[a-z0-9-]{2,59}$"
          },
          "estimate": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "readiness": {
            "enum": [
              "READY",
              "NOT_READY",
              "BLOCKED"
            ]
          },
          "blocking_reasons": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "completed_story_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^story-[a-z0-9-]{2,59}$"
      }
    },
    "definition_of_ready": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "definition_of_done": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "test_intent_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "risk_focus_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    }
  }
}
