{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "devpilot://schemas/artifact_lifecycle_policy.schema.json",
  "x-devpilot-schema-id": "SCHEMA-DEVPL-GSDLC-04-A-ARTIFACT-LIFECYCLE-POLICY-V1",
  "title": "DevPilot Artifact Lifecycle Policy v1",
  "description": "GSDLC-04-A transition, role, provenance, profile-permission and upload/path policy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract",
    "status",
    "owner",
    "sprint",
    "states",
    "source_types",
    "roles",
    "transitions",
    "profile_permissions",
    "path_policy",
    "agent_assisted_execution_enabled",
    "server_authoritative",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "contract": {
      "const": "ArtifactLifecyclePolicy"
    },
    "status": {
      "const": "approved"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "sprint": {
      "const": "DEVPL-GSDLC-04-A"
    },
    "states": {
      "type": "array",
      "const": [
        "MISSING",
        "DRAFT",
        "VALIDATING",
        "FINDINGS",
        "READY_FOR_REVIEW",
        "APPROVAL_REQUIRED",
        "APPROVED",
        "FROZEN",
        "REVALIDATION_REQUIRED"
      ]
    },
    "source_types": {
      "type": "array",
      "const": [
        "MANUAL",
        "PASTE",
        "UPLOAD",
        "IMPORT",
        "AGENT_ASSISTED",
        "EXTERNAL_EDITOR"
      ]
    },
    "roles": {
      "type": "array",
      "const": [
        "owner",
        "product-owner",
        "architect",
        "security-reviewer",
        "developer",
        "qa-reviewer",
        "release-manager",
        "operator",
        "agent-supervisor"
      ]
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "allowed_roles",
          "mode",
          "requires_reviewer"
        ],
        "properties": {
          "from": {
            "enum": [
              "MISSING",
              "DRAFT",
              "VALIDATING",
              "FINDINGS",
              "READY_FOR_REVIEW",
              "APPROVAL_REQUIRED",
              "APPROVED",
              "FROZEN",
              "REVALIDATION_REQUIRED"
            ]
          },
          "to": {
            "enum": [
              "MISSING",
              "DRAFT",
              "VALIDATING",
              "FINDINGS",
              "READY_FOR_REVIEW",
              "APPROVAL_REQUIRED",
              "APPROVED",
              "FROZEN",
              "REVALIDATION_REQUIRED"
            ]
          },
          "allowed_roles": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "owner",
                "product-owner",
                "architect",
                "security-reviewer",
                "developer",
                "qa-reviewer",
                "release-manager",
                "operator",
                "agent-supervisor"
              ]
            }
          },
          "mode": {
            "enum": [
              "actor",
              "hash-drift-only"
            ]
          },
          "requires_reviewer": {
            "type": "boolean"
          }
        }
      }
    },
    "profile_permissions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "authoring_allowed",
          "import_allowed",
          "allowed_source_types",
          "validators",
          "approval_required"
        ],
        "properties": {
          "authoring_allowed": {
            "type": "boolean"
          },
          "import_allowed": {
            "type": "boolean"
          },
          "allowed_source_types": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "MANUAL",
                "PASTE",
                "UPLOAD",
                "IMPORT",
                "AGENT_ASSISTED",
                "EXTERNAL_EDITOR"
              ]
            }
          },
          "validators": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "approval_required": {
            "type": "boolean"
          }
        }
      }
    },
    "path_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_extensions",
        "max_source_bytes",
        "filename_pattern",
        "deny_absolute",
        "deny_parent_traversal",
        "deny_symlink",
        "secret_bearing_auto_version"
      ],
      "properties": {
        "allowed_extensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              ".md",
              ".json"
            ]
          }
        },
        "max_source_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "filename_pattern": {
          "type": "string",
          "minLength": 1
        },
        "deny_absolute": {
          "const": true
        },
        "deny_parent_traversal": {
          "const": true
        },
        "deny_symlink": {
          "const": true
        },
        "secret_bearing_auto_version": {
          "const": false
        }
      }
    },
    "agent_assisted_execution_enabled": {
      "const": false
    },
    "server_authoritative": {
      "const": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
