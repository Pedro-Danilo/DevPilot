{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/gsdlc_06_b_local_provider_health_report.schema.json",
  "title": "DevPilot GSDLC-06-B Local Provider Health Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "status", "summary", "providers", "hardware_fit_hints", "fallback", "safety"],
  "properties": {
    "schema_id": {"const": "devpilot.gsdlc06b.local_provider_health_report.v1"},
    "schema_version": {"const": "1.0.0"},
    "status": {"enum": ["PASS", "BLOCK"]},
    "summary": {
      "type": "object", "additionalProperties": true,
      "required": ["micro_sprint", "providers_total", "configured_total", "reachable_total", "healthy_total", "model_discovered_total", "enabled_total", "policy_allowed_total", "probe_requested", "network_scope", "network_used", "external_api_used", "discovery_enables_provider", "fallback_provider", "silent_fallback_allowed", "blocking_findings_total"],
      "properties": {
        "micro_sprint": {"const": "DEVPL-GSDLC-06-B"},
        "providers_total": {"type": "integer", "minimum": 1},
        "configured_total": {"type": "integer", "minimum": 0},
        "reachable_total": {"type": "integer", "minimum": 0},
        "healthy_total": {"type": "integer", "minimum": 0},
        "model_discovered_total": {"type": "integer", "minimum": 0},
        "enabled_total": {"type": "integer", "minimum": 0},
        "policy_allowed_total": {"type": "integer", "minimum": 0},
        "probe_requested": {"type": "boolean"},
        "network_scope": {"enum": ["none", "loopback-only"]},
        "network_used": {"type": "boolean"},
        "external_api_used": {"const": false},
        "discovery_enables_provider": {"const": false},
        "fallback_provider": {"const": "mock"},
        "silent_fallback_allowed": {"const": false},
        "blocking_findings_total": {"type": "integer", "minimum": 0}
      }
    },
    "providers": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": true,
        "required": ["provider_id", "configured", "reachable", "healthy", "model_discovered", "enabled", "probe_attempted", "models", "models_total", "endpoint_policy", "external_api", "requires_api_key", "discovery_enables_provider", "fallback"],
        "properties": {
          "provider_id": {"type": "string", "minLength": 1},
          "configured": {"type": "boolean"},
          "reachable": {"type": ["boolean", "null"]},
          "healthy": {"type": ["boolean", "null"]},
          "model_discovered": {"type": "boolean"},
          "enabled": {"type": "boolean"},
          "probe_attempted": {"type": "boolean"},
          "models": {"type": "array", "maxItems": 1024, "items": {"type": "string", "maxLength": 256}},
          "models_total": {"type": "integer", "minimum": 0},
          "external_api": {"const": false},
          "requires_api_key": {"type": "boolean"},
          "discovery_enables_provider": {"const": false},
          "endpoint_policy": {"type": "object"},
          "fallback": {"type": "object"}
        }
      }
    },
    "hardware_fit_hints": {"type": "object", "required": ["status", "authoritative", "recommendations"], "properties": {"authoritative": {"const": false}, "status": {"type": "string"}, "recommendations": {"type": "array", "maxItems": 16}}, "additionalProperties": true},
    "fallback": {"type": "object", "required": ["provider_id", "explicit_required", "silent_fallback_allowed", "discovery_triggers_fallback", "runtime_fallback_requires_router_configuration"], "properties": {"provider_id": {"const": "mock"}, "explicit_required": {"const": true}, "silent_fallback_allowed": {"const": false}, "discovery_triggers_fallback": {"const": false}, "runtime_fallback_requires_router_configuration": {"const": true}}, "additionalProperties": false},
    "safety": {"type": "object", "required": ["local_first", "external_api_used", "raw_secrets_exposed", "source_mutated", "discovery_enables_provider"], "properties": {"local_first": {"const": true}, "external_api_used": {"const": false}, "raw_secrets_exposed": {"const": false}, "source_mutated": {"const": false}, "discovery_enables_provider": {"const": false}}, "additionalProperties": false}
  }
}
