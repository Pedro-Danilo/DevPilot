{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/gsdlc12a_resume_checkpoint.schema.json",
  "title": "GSDLC-12-A Durable Resume Checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "workspace_id", "project_id", "sequence", "created_at_utc", "updated_at_utc", "session_binding", "authoritative_git", "current_step", "draft_refs", "safe_pending_work", "last_verified_evidence_refs", "recovery_reason", "browser_storage_authority", "runtime_db_snapshot_used", "source_mutations_performed", "checkpoint_hash"],
  "properties": {
    "schema_id": {"const": "SCHEMA-DEVPL-GSDLC-12-A-RESUME-CHECKPOINT-V1"},
    "schema_version": {"const": "1.0"},
    "workspace_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,256}$"},
    "project_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "sequence": {"type": "integer", "minimum": 0},
    "created_at_utc": {"type": "string", "minLength": 1},
    "updated_at_utc": {"type": "string", "minLength": 1},
    "session_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["actor", "session_fingerprint", "rotation_counter"],
      "properties": {
        "actor": {"type": "string", "minLength": 1, "maxLength": 256},
        "session_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "rotation_counter": {"type": "integer", "minimum": 0}
      }
    },
    "authoritative_git": {
      "type": "object", "additionalProperties": false,
      "required": ["head", "tree", "branch", "dirty", "fingerprint"],
      "properties": {
        "head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "branch": {"type": "string", "minLength": 1, "maxLength": 256},
        "dirty": {"type": "boolean"},
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "engineering_state_fingerprint": {"type": ["string", "null"]},
    "current_step": {"type": "string", "minLength": 1, "maxLength": 256},
    "draft_refs": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "safe_pending_work": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["work_id", "kind", "status", "sensitive", "safe_to_resume", "approval_id", "approval_actor", "approval_expires_at", "bound_git_head"],
        "properties": {
          "work_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "kind": {"type": "string", "minLength": 1, "maxLength": 64},
          "status": {"type": "string", "minLength": 1, "maxLength": 64},
          "sensitive": {"type": "boolean"},
          "safe_to_resume": {"type": "boolean"},
          "approval_id": {"type": ["string", "null"], "maxLength": 256},
          "approval_actor": {"type": ["string", "null"], "maxLength": 256},
          "approval_expires_at": {"type": ["string", "null"], "maxLength": 64},
          "bound_git_head": {"type": ["string", "null"], "maxLength": 64}
        }
      }
    },
    "last_verified_evidence_refs": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "recovery_reason": {"type": "string", "minLength": 1, "maxLength": 256},
    "browser_storage_authority": {"const": false},
    "runtime_db_snapshot_used": {"const": false},
    "source_mutations_performed": {"const": false},
    "checkpoint_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
