{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "devpilot://schemas/credential_record/v1",
  "title": "CredentialRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actor_id",
    "username",
    "password_hash_encoding",
    "salt_encoding",
    "kdf_algorithm",
    "kdf_version",
    "kdf_params",
    "credential_version",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "actor_id": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "password_hash_encoding": {
      "const": "binary-runtime-only"
    },
    "salt_encoding": {
      "const": "binary-runtime-only"
    },
    "kdf_algorithm": {
      "enum": [
        "scrypt"
      ]
    },
    "kdf_version": {
      "type": "integer",
      "minimum": 1
    },
    "kdf_params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "n",
        "r",
        "p",
        "dklen",
        "salt_bytes"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "n": {
          "type": "integer",
          "minimum": 16384
        },
        "r": {
          "type": "integer",
          "minimum": 8
        },
        "p": {
          "type": "integer",
          "minimum": 1
        },
        "dklen": {
          "type": "integer",
          "minimum": 32
        },
        "salt_bytes": {
          "type": "integer",
          "minimum": 16
        }
      }
    },
    "credential_version": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$comment": "Schema describes metadata only; password_hash/salt values are runtime-only and never valid source/evidence payload."
}
