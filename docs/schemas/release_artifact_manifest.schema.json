{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/SCHEMA-DEVPL-RELEASE-ARTIFACT-MANIFEST-V1",
  "title": "DevPilot ReleaseArtifactManifest v1",
  "description": "POST-H-027-C contract for local package artifact manifest and SHA-256 checksum evidence without publishing, deploying, signing or network access.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_id",
    "manifest_id",
    "created_by",
    "status",
    "generated_at_utc",
    "release_version",
    "scope",
    "policy",
    "artifacts",
    "checksums_file",
    "checksums",
    "summary",
    "safety",
    "limitations",
    "preliminary"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "schema_id": {"const": "SCHEMA-DEVPL-RELEASE-ARTIFACT-MANIFEST-V1"},
    "manifest_id": {"type": "string", "minLength": 8, "pattern": "^[A-Za-z0-9_.:-]+$"},
    "created_by": {"const": "POST-H-027-C"},
    "status": {"enum": ["draft", "implemented-initial", "verified-local"]},
    "generated_at_utc": {"type": "string", "minLength": 10},
    "release_version": {"type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:[-+][0-9A-Za-z.-]+)?$"},
    "scope": {"const": "local-package"},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_path", "status", "required_artifacts_total", "optional_artifacts_total"],
      "properties": {
        "policy_id": {"type": ["string", "null"]},
        "policy_path": {"type": "string", "minLength": 1},
        "status": {"type": ["string", "null"]},
        "required_artifacts_total": {"type": "integer", "minimum": 0},
        "optional_artifacts_total": {"type": "integer", "minimum": 0}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "artifact_type", "path", "required", "classification", "exists", "sha256", "size_bytes", "verification_status", "source", "notes"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 2},
          "artifact_type": {"enum": ["source_zip", "python_wheel", "python_sdist", "sbom", "release_notes", "verification_report", "other"]},
          "path": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "classification": {"enum": ["distributable", "generated-runtime-evidence", "source-documentation"]},
          "exists": {"type": "boolean"},
          "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "size_bytes": {"type": ["integer", "null"], "minimum": 0},
          "verification_status": {"enum": ["pass", "missing", "checksum-mismatch", "not-checked"]},
          "source": {"type": "string", "minLength": 1},
          "notes": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "checksums_file": {"type": "string", "minLength": 1},
    "checksums": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "generated", "verified", "entries_total", "entries_sha256", "mismatches"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "generated": {"type": "boolean"},
        "verified": {"type": "boolean"},
        "entries_total": {"type": "integer", "minimum": 0},
        "entries_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "mismatches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "expected_sha256", "actual_sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "expected_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
              "actual_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": ["decision", "created_by", "preliminary", "release_version", "scope", "required_missing_total", "checksum_mismatch_total", "network_used", "external_api_used", "publish_performed", "deploy_performed", "signing_performed", "source_mutations", "reports_written"],
      "properties": {
        "decision": {"enum": ["PASS", "BLOCK"]},
        "created_by": {"const": "POST-H-027-C"},
        "preliminary": {"const": true},
        "release_version": {"type": "string"},
        "scope": {"const": "local-package"},
        "required_missing_total": {"type": "integer", "minimum": 0},
        "checksum_mismatch_total": {"type": "integer", "minimum": 0},
        "network_used": {"const": false},
        "external_api_used": {"const": false},
        "publish_performed": {"const": false},
        "deploy_performed": {"const": false},
        "signing_performed": {"const": false},
        "source_mutations": {"const": false},
        "reports_written": {"type": "boolean"}
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_first", "network_used", "external_api_used", "publish_performed", "deploy_performed", "git_tagging_performed", "signing_performed", "remote_execution_enabled", "connector_write_enabled", "plugin_execution_enabled", "source_mutations", "reports_written"],
      "properties": {
        "local_first": {"const": true},
        "network_used": {"const": false},
        "external_api_used": {"const": false},
        "publish_performed": {"const": false},
        "deploy_performed": {"const": false},
        "git_tagging_performed": {"const": false},
        "signing_performed": {"const": false},
        "remote_execution_enabled": {"const": false},
        "connector_write_enabled": {"const": false},
        "plugin_execution_enabled": {"const": false},
        "source_mutations": {"const": false},
        "reports_written": {"type": "boolean"}
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "preliminary": {"const": true}
  },
  "allOf": [
    {
      "if": {"properties": {"summary": {"properties": {"decision": {"const": "PASS"}}}}},
      "then": {"properties": {"summary": {"properties": {"required_missing_total": {"const": 0}, "checksum_mismatch_total": {"const": 0}}}}}
    }
  ],
  "x-devpilot-schema-id": "SCHEMA-DEVPL-RELEASE-ARTIFACT-MANIFEST-V1",
  "x-devpilot-version": "1.0.0",
  "x-devpilot-sprint": "POST-H-027-C",
  "x-devpilot-status": "registered",
  "x-devpilot-preliminary": true
}
