{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/gap_action_map.schema.json",
  "title": "DevPilot GapActionMap v1",
  "description": "POST-H-031-C local read-only mapping from evidence/operator gaps to concrete, prioritized and verifiable operator actions. It does not execute commands and does not relax no-go gates.",
  "type": "object",
  "required": [
    "schema_version",
    "schema_id",
    "map_id",
    "created_by",
    "status",
    "generated_at_utc",
    "summary",
    "gaps",
    "actions",
    "unmapped_gaps",
    "safety",
    "limitations",
    "findings",
    "notes"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "schema_id": {"const": "SCHEMA-DEVPL-GAP-ACTION-MAP-V1"},
    "map_id": {"const": "devpilot-gap-action-map"},
    "created_by": {"const": "POST-H-031-C"},
    "status": {"enum": ["pass", "warn", "blocked"]},
    "generated_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "summary": {"$ref": "#/$defs/summary"},
    "gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}},
    "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}},
    "unmapped_gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}},
    "safety": {"$ref": "#/$defs/safety"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "findings": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "summary": {
      "type": "object",
      "required": [
        "created_by",
        "status",
        "decision",
        "gaps_total",
        "blocking_gaps_total",
        "mapped_gaps_total",
        "unmapped_gaps_total",
        "actions_total",
        "rules_total",
        "required_rule_categories_total",
        "required_rule_categories_present_total",
        "unsafe_actions_total",
        "unknown_gaps_total",
        "operator_health_overall_status",
        "operator_health_score",
        "read_only",
        "network_used",
        "external_api_used",
        "commands_executed",
        "source_mutations_performed",
        "reports_written",
        "preliminary"
      ],
      "additionalProperties": false,
      "properties": {
        "created_by": {"const": "POST-H-031-C"},
        "status": {"enum": ["implemented-initial", "blocked"]},
        "decision": {"enum": ["PASS", "BLOCK"]},
        "gaps_total": {"type": "integer", "minimum": 0},
        "blocking_gaps_total": {"type": "integer", "minimum": 0},
        "mapped_gaps_total": {"type": "integer", "minimum": 0},
        "unmapped_gaps_total": {"type": "integer", "minimum": 0},
        "actions_total": {"type": "integer", "minimum": 0},
        "rules_total": {"type": "integer", "minimum": 0},
        "required_rule_categories_total": {"type": "integer", "minimum": 0},
        "required_rule_categories_present_total": {"type": "integer", "minimum": 0},
        "unsafe_actions_total": {"type": "integer", "minimum": 0},
        "unknown_gaps_total": {"type": "integer", "minimum": 0},
        "operator_health_overall_status": {"enum": ["green", "yellow", "red", "unknown", "not_applicable"]},
        "operator_health_score": {"type": "integer", "minimum": 0, "maximum": 100},
        "read_only": {"const": true},
        "network_used": {"const": false},
        "external_api_used": {"const": false},
        "commands_executed": {"const": false},
        "source_mutations_performed": {"const": false},
        "reports_written": {"type": "boolean"},
        "preliminary": {"const": true}
      }
    },
    "source_ref": {
      "type": "object",
      "required": ["path", "kind", "required", "available", "description"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "kind": {"enum": ["json", "markdown", "python", "command", "schema", "generated-report", "directory", "unknown"]},
        "required": {"type": "boolean"},
        "available": {"type": "boolean"},
        "description": {"type": "string"}
      }
    },
    "gap": {
      "type": "object",
      "required": [
        "gap_id",
        "gap_type",
        "title",
        "severity",
        "status",
        "reason",
        "source_id",
        "path",
        "required",
        "blocking",
        "mapped",
        "source_refs"
      ],
      "additionalProperties": false,
      "properties": {
        "gap_id": {"type": "string", "minLength": 1},
        "gap_type": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "severity": {"enum": ["info", "warning", "fail", "block", "error"]},
        "status": {"enum": ["open", "mapped", "unknown", "not_applicable"]},
        "reason": {"type": "string", "minLength": 1},
        "source_id": {"type": ["string", "null"]},
        "path": {"type": ["string", "null"]},
        "required": {"type": "boolean"},
        "blocking": {"type": "boolean"},
        "mapped": {"type": "boolean"},
        "source_refs": {"type": "array", "items": {"$ref": "#/$defs/source_ref"}}
      }
    },
    "action": {
      "type": "object",
      "required": [
        "action_id",
        "gap_id",
        "rule_id",
        "priority",
        "category",
        "title",
        "owner",
        "command",
        "verification",
        "closure_criterion",
        "risk_if_ignored",
        "backlog_ref",
        "dry_run",
        "requires_approval",
        "safe",
        "source_refs"
      ],
      "additionalProperties": false,
      "properties": {
        "action_id": {"type": "string", "minLength": 1},
        "gap_id": {"type": "string", "minLength": 1},
        "rule_id": {"type": "string", "minLength": 1},
        "priority": {"enum": ["P0", "P1", "P2", "P3"]},
        "category": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "command": {"type": "string", "minLength": 1},
        "verification": {"type": "string", "minLength": 1},
        "closure_criterion": {"type": "string", "minLength": 1},
        "risk_if_ignored": {"type": "string", "minLength": 1},
        "backlog_ref": {"type": "string", "minLength": 1},
        "dry_run": {"const": true},
        "requires_approval": {"type": "boolean"},
        "safe": {"const": true},
        "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source_ref"}}
      }
    },
    "safety": {
      "type": "object",
      "required": [
        "local_first",
        "read_only",
        "dry_run",
        "network_used",
        "external_api_used",
        "mutations_performed",
        "source_mutations_performed",
        "commands_executed",
        "secrets_read",
        "raw_payloads_exported",
        "devpilot_db_read",
        "reports_written"
      ],
      "additionalProperties": true,
      "properties": {
        "local_first": {"const": true},
        "read_only": {"const": true},
        "dry_run": {"const": true},
        "network_used": {"const": false},
        "external_api_used": {"const": false},
        "mutations_performed": {"const": false},
        "source_mutations_performed": {"const": false},
        "commands_executed": {"const": false},
        "secrets_read": {"const": false},
        "raw_payloads_exported": {"const": false},
        "devpilot_db_read": {"const": false},
        "reports_written": {"type": "boolean"}
      }
    }
  },
  "x-devpilot-schema-id": "SCHEMA-DEVPL-GAP-ACTION-MAP-V1",
  "x-devpilot-sprint": "POST-H-031-C",
  "x-devpilot-status": "registered"
}
