{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/SCHEMA-DEVPL-UI-GOVERNED-JOB-V2",
  "title": "DevPilot UI Governed Job v2",
  "description": "UOC-007 persisted governed-job lifecycle state. Raw idempotency/cancel tokens and parameter values are deliberately not persisted.",
  "type": "object",
  "required": [
    "schema_version", "schema_id", "job_id", "capability_id", "workspace_id", "status",
    "risk_class", "dry_run", "timeout_seconds", "retry_limit", "retry_count",
    "heartbeat_interval_seconds", "heartbeat_sequence", "created_at", "updated_at",
    "last_heartbeat_at", "approval_binding_id", "supports_cancel", "supports_rollback",
    "cancel_token_hash", "idempotency_key_hash", "correlation_id", "request_fingerprint",
    "parameter_keys", "artifact_refs", "evidence_refs", "runtime_adapter_id", "errors",
    "result_summary"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "schema_id": {"const": "SCHEMA-DEVPL-UI-GOVERNED-JOB-V2"},
    "job_id": {"type": "string", "pattern": "^job_[a-f0-9]{32}$"},
    "capability_id": {"type": "string", "minLength": 1},
    "workspace_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "status": {"enum": [
      "planned", "pending-approval", "approved", "queued", "running", "pass",
      "pass-with-gaps", "block", "error", "cancel-requested", "cancelled",
      "rollback-running", "rolled-back", "expired"
    ]},
    "risk_class": {"enum": ["read-only", "mutating", "sensitive"]},
    "dry_run": {"type": "boolean"},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 7200},
    "retry_limit": {"type": "integer", "minimum": 0, "maximum": 2},
    "retry_count": {"type": "integer", "minimum": 0, "maximum": 2},
    "heartbeat_interval_seconds": {"type": "integer", "minimum": 1, "maximum": 60},
    "heartbeat_sequence": {"type": "integer", "minimum": 0},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1},
    "last_heartbeat_at": {"type": ["string", "null"]},
    "approval_binding_id": {"type": ["string", "null"]},
    "supports_cancel": {"type": "boolean"},
    "supports_rollback": {"type": "boolean"},
    "cancel_token_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "idempotency_key_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "correlation_id": {"type": "string", "pattern": "^corr_[A-Za-z0-9._:-]+$", "maxLength": 256},
    "request_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "parameter_keys": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "artifact_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "runtime_adapter_id": {"type": ["string", "null"]},
    "errors": {"type": "array", "items": {"type": "string"}},
    "result_summary": {"type": "object"}
  },
  "additionalProperties": false,
  "x-devpilot-schema-id": "SCHEMA-DEVPL-UI-GOVERNED-JOB-V2",
  "x-devpilot-sprint": "UOC-007",
  "x-devpilot-status": "registered",
  "x-devpilot-preliminary": true,
  "x-devpilot-note": "First persistent job lifecycle contract. UOC-008 adds operational console, multi-process/orphan reconciliation and log streaming."
}
