{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/SCHEMA-DEVPL-GSDLC-02-E-AUTH-UI-ROUTE-CONTRACT-REGISTRY-V1",
  "title": "GSDLC-02-E Auth UI Route Contract Registry",
  "type": "object",
  "required": [
    "schema_id",
    "registry_id",
    "status",
    "created_by",
    "routes",
    "summary"
  ],
  "properties": {
    "schema_id": {
      "const": "devpilot.gsdlc02e.auth_ui_route_contract_registry.v1"
    },
    "registry_id": {
      "const": "devpilot-auth-ui-route-contract-registry"
    },
    "routes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "route_id",
          "path",
          "page_component",
          "source_files",
          "allowed_api_routes",
          "critical",
          "local_only",
          "remote_execution_allowed",
          "external_api_allowed"
        ],
        "properties": {
          "route_id": {
            "enum": [
              "ui.login",
              "ui.first-run-owner",
              "ui.account-role"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "page_component": {
            "type": "string",
            "minLength": 1
          },
          "source_files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "allowed_api_routes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "critical": {
            "const": true
          },
          "local_only": {
            "const": true
          },
          "remote_execution_allowed": {
            "const": false
          },
          "external_api_allowed": {
            "const": false
          }
        },
        "additionalProperties": true
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "routes_total",
        "remote_execution_allowed_total",
        "external_api_allowed_total"
      ],
      "properties": {
        "routes_total": {
          "const": 3
        },
        "remote_execution_allowed_total": {
          "const": 0
        },
        "external_api_allowed_total": {
          "const": 0
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "x-devpilot-schema-id": "SCHEMA-DEVPL-GSDLC-02-E-AUTH-UI-ROUTE-CONTRACT-REGISTRY-V1",
  "x-devpilot-version": "1.0.0",
  "x-devpilot-sprint": "DEVPL-GSDLC-02-E",
  "x-devpilot-status": "registered"
}
