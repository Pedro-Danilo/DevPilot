{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "devpilot://schemas/workspace_edit_plan.schema.json",
  "title": "Workspace Edit Plan",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_id",
    "plan_id",
    "plan_hash",
    "document",
    "proposed_content",
    "diff",
    "risk",
    "policy",
    "created_at",
    "expires_at"
  ],
  "properties": {
    "schema_id": {
      "const": "devpilot.post_h_eval_002.uoc_004.edit_plan.v1"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^eplan_[0-9a-f]{32}$"
    },
    "plan_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "document": {
      "type": "object",
      "required": [
        "document_id",
        "relative_path",
        "document_sha_before",
        "proposed_sha256"
      ],
      "properties": {
        "document_id": {
          "type": "string"
        },
        "relative_path": {
          "type": "string"
        },
        "document_sha_before": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "proposed_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "diff": {
      "type": "object",
      "required": [
        "format",
        "content",
        "sha256",
        "truncated"
      ],
      "properties": {
        "format": {
          "const": "unified"
        },
        "content": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "truncated": {
          "const": false
        }
      }
    },
    "risk": {
      "type": "object"
    },
    "policy": {
      "type": "object"
    },
    "created_at": {
      "type": "string"
    },
    "expires_at": {
      "type": "string"
    }
  }
}
