{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/SCHEMA-DEVPL-UI-APPROVAL-BINDING-V1",
  "title": "DevPilot UI Approval Binding v1",
  "type": "object",
  "required": [
    "schema_version",
    "binding_id",
    "approval_id",
    "plan_id",
    "plan_sha256",
    "workspace_id",
    "actor",
    "scope",
    "decision",
    "expires_at",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "binding_id": {
      "type": "string",
      "pattern": "^binding_"
    },
    "approval_id": {
      "type": "string",
      "pattern": "^approval_"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^plan_"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": [
        "pending",
        "approved",
        "denied",
        "expired",
        "revoked"
      ]
    },
    "expires_at": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "credential_material_included": {
      "const": false
    }
  },
  "additionalProperties": false,
  "x-devpilot-schema-id": "SCHEMA-DEVPL-UI-APPROVAL-BINDING-V1",
  "x-devpilot-sprint": "UOC-000",
  "x-devpilot-status": "registered"
}
