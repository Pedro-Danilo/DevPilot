{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/workspace_edit_execution.schema.json",
  "title": "Workspace Edit Execution",
  "description": "UOC-005 approval-bound atomic document apply/rollback execution record. Backups are referenced relative to an external bounded control root; generic patch.apply and generic rollback remain outside this contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "execution_id",
    "status",
    "plan_id",
    "plan_hash",
    "approval_id",
    "actor",
    "workspace_id",
    "relative_path",
    "document_id",
    "pre_sha256",
    "post_sha256",
    "proposed_sha256",
    "backup_sha256",
    "backup_ref",
    "permissions_mode_before",
    "policy",
    "post_validation",
    "applied_at",
    "rollback",
    "source_write",
    "git_stage",
    "git_commit",
    "preliminary",
    "approval",
    "evidence_ref",
    "report_ref",
    "trace_event_types",
    "duration_ms"
  ],
  "properties": {
    "schema_id": {
      "const": "devpilot.post_h_eval_002.uoc_005.workspace_edit_execution.v1"
    },
    "execution_id": {
      "type": "string",
      "pattern": "^uedit_[0-9a-f]{32}$"
    },
    "status": {
      "enum": [
        "applied",
        "post-validation-blocked",
        "rolled-back-automatic",
        "rolled-back-manual",
        "rollback-failed"
      ]
    },
    "plan_id": {
      "type": "string",
      "pattern": "^eplan_[0-9a-f]{32}$"
    },
    "plan_hash": {
      "$ref": "#/$defs/sha256"
    },
    "approval_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "workspace_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 160
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "document_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "pre_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "post_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "proposed_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "backup_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "backup_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "permissions_mode_before": {
      "type": "string",
      "pattern": "^0o[0-7]{3,4}$"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "approval_bound",
        "action",
        "tool_id"
      ],
      "properties": {
        "status": {
          "const": "PASS"
        },
        "approval_bound": {
          "const": true
        },
        "action": {
          "const": "filesystem.workspace_document_apply"
        },
        "tool_id": {
          "const": "workspace.edit.apply"
        }
      }
    },
    "post_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "findings"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "BLOCK"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "applied_at": {
      "type": "string",
      "format": "date-time"
    },
    "rollback": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "mode",
            "restored_sha256",
            "at"
          ],
          "properties": {
            "mode": {
              "enum": [
                "automatic-compensating",
                "manual-approval-bound"
              ]
            },
            "approval_id": {
              "type": "string"
            },
            "actor": {
              "type": "string"
            },
            "restored_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "reason": {
              "type": "string"
            },
            "integrity_pass": {
              "type": "boolean"
            },
            "approval": {
              "type": "object"
            }
          }
        }
      ]
    },
    "source_write": {
      "const": true
    },
    "git_stage": {
      "const": false
    },
    "git_commit": {
      "const": false
    },
    "preliminary": {
      "const": true
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_id",
        "status",
        "tool_id",
        "action",
        "subject",
        "actor",
        "reason",
        "expires_at",
        "decision_at",
        "decided_by"
      ],
      "properties": {
        "approval_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "approved"
        },
        "tool_id": {
          "const": "workspace.edit.apply"
        },
        "action": {
          "const": "filesystem.workspace_document_apply"
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "decided_by": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evidence_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "report_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "trace_event_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "duration_ms": {
      "type": "number",
      "minimum": 0
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
