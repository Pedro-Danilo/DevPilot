{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/SCHEMA-DEVPL-WORKSPACE-DOCUMENT-RESOURCE-V1",
  "title": "DevPilot Workspace Document Resource v1",
  "description": "UOC-001 read-only document content returned through an opaque server-issued identifier.",
  "type": "object",
  "required": [
    "summary",
    "document",
    "ui_workspace_context",
    "safety"
  ],
  "properties": {
    "summary": {
      "type": "object",
      "required": [
        "workspace_id",
        "document_id",
        "content_type",
        "read_only",
        "mutations_performed"
      ],
      "properties": {
        "workspace_id": {
          "type": "string"
        },
        "document_id": {
          "type": "string",
          "pattern": "^doc_[A-Za-z0-9_-]{16,64}$"
        },
        "content_type": {
          "enum": [
            "text/markdown",
            "application/json",
            "application/yaml",
            "text/plain"
          ]
        },
        "parse_status": {
          "enum": [
            "valid",
            "invalid",
            "not-applicable"
          ]
        },
        "read_only": {
          "const": true
        },
        "mutations_performed": {
          "const": false
        }
      },
      "additionalProperties": true
    },
    "document": {
      "type": "object",
      "required": [
        "node_id",
        "document_id",
        "kind",
        "name",
        "relative_path",
        "category",
        "readable",
        "sha256",
        "encoding",
        "content",
        "breadcrumbs"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "pattern": "^(doc|dir)_[A-Za-z0-9_-]{16,64}$"
        },
        "document_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^doc_[A-Za-z0-9_-]{16,64}$"
        },
        "kind": {
          "enum": [
            "document",
            "folder"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "(^[A-Za-z]:|^/|^\\\\|(^|/)\\.\\.(/|$)|:)"
          }
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "extension": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            ".md",
            ".json",
            ".yaml",
            ".yml",
            ".txt",
            null
          ]
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "modified_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "readable": {
          "type": "boolean"
        },
        "blocked_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "encoding": {
          "const": "utf-8"
        },
        "content": {
          "type": "string",
          "maxLength": 1048576
        },
        "structured": {},
        "breadcrumbs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "relative_path": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": false
    },
    "ui_workspace_context": {
      "type": "object"
    },
    "safety": {
      "type": "object",
      "required": [
        "read_only",
        "mutations_performed",
        "absolute_paths_accepted_from_browser",
        "symlink_following",
        "external_api_used"
      ],
      "properties": {
        "read_only": {
          "const": true
        },
        "mutations_performed": {
          "const": false
        },
        "absolute_paths_accepted_from_browser": {
          "const": false
        },
        "symlink_following": {
          "const": false
        },
        "external_api_used": {
          "const": false
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "x-devpilot-schema-id": "SCHEMA-DEVPL-WORKSPACE-DOCUMENT-RESOURCE-V1",
  "x-devpilot-sprint": "UOC-001",
  "x-devpilot-status": "registered"
}
