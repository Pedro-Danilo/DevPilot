{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/story_test_impact_report.schema.json",
  "title": "StoryTestImpactReport",
  "type": "object",
  "required": ["schema_id", "schema_version", "changed_paths", "matched_contracts", "matched_rules", "unmatched_paths", "recommended_tests", "recommended_profiles", "summary"],
  "properties": {
    "schema_id": {"const": "SCHEMA-DEVPL-GSDLC-10-A-TEST-IMPACT-REPORT-V1"},
    "schema_version": {"const": "1.0.0"},
    "changed_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "matched_contracts": {"type": "array", "items": {"type": "object"}},
    "matched_rules": {"type": "array", "items": {"type": "object"}},
    "unmatched_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "recommended_tests": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "recommended_profiles": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "summary": {
      "type": "object",
      "required": ["changed_paths_total", "matched_contracts_total", "recommended_tests_total", "unmatched_paths_total", "tests_executed", "network_used", "external_api_used", "source_mutations_performed"],
      "properties": {
        "changed_paths_total": {"type": "integer", "minimum": 1},
        "matched_contracts_total": {"type": "integer", "minimum": 0},
        "recommended_tests_total": {"type": "integer", "minimum": 0},
        "unmatched_paths_total": {"type": "integer", "minimum": 0},
        "p0_selected_total": {"type": "integer", "minimum": 0},
        "p1_selected_total": {"type": "integer", "minimum": 0},
        "tests_executed": {"const": false},
        "network_used": {"const": false},
        "external_api_used": {"const": false},
        "source_mutations_performed": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
