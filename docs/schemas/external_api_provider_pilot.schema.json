{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/external_api_provider_pilot.schema.json",
  "title": "DevPilot ExternalApiProviderPilot v1",
  "description": "POST-H-032-C ADR-backed fake/gated pilot report for external API providers. It validates disabled-by-default, fake-provider-only tests, environment-variable secret handling, CostGuard enforcement and visible warning/risk-report semantics without real external API calls.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_id",
    "report_id",
    "created_by",
    "status",
    "generated_at_utc",
    "adr_path",
    "policy_path",
    "provider_registry_path",
    "summary",
    "providers",
    "fake_provider_contract",
    "cost_guard",
    "secret_handling",
    "real_call_gate",
    "safety",
    "findings",
    "notes",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "schema_id": {"const": "SCHEMA-DEVPL-EXTERNAL-API-PROVIDER-PILOT-V1"},
    "report_id": {"const": "devpilot-external-api-provider-pilot-report"},
    "created_by": {"const": "POST-H-032-C"},
    "status": {"enum": ["implemented-initial", "blocked"]},
    "generated_at_utc": {"type": "string", "minLength": 10},
    "adr_path": {"type": "string", "minLength": 1},
    "policy_path": {"type": "string", "minLength": 1},
    "provider_registry_path": {"type": "string", "minLength": 1},
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "created_by",
        "status",
        "decision",
        "api_providers_total",
        "api_enabled_total",
        "api_disabled_by_default_total",
        "api_requires_env_var_total",
        "api_key_values_in_repo_total",
        "fake_provider_contract_ok",
        "tests_require_real_api",
        "real_api_call_performed",
        "external_api_used",
        "network_used",
        "cost_guard_required",
        "cost_guard_blocks_accidental_external_api",
        "secret_handling_env_only",
        "secrets_read",
        "operator_warning_required",
        "risk_report_required",
        "blocking_findings_total",
        "findings_total",
        "schema_valid",
        "reports_written",
        "preliminary"
      ],
      "properties": {
        "created_by": {"const": "POST-H-032-C"},
        "status": {"enum": ["implemented-initial", "blocked"]},
        "decision": {"enum": ["PASS", "BLOCK", "ERROR"]},
        "api_providers_total": {"type": "integer", "minimum": 1},
        "api_enabled_total": {"const": 0},
        "api_disabled_by_default_total": {"type": "integer", "minimum": 1},
        "api_requires_env_var_total": {"type": "integer", "minimum": 1},
        "api_key_values_in_repo_total": {"const": 0},
        "fake_provider_contract_ok": {"const": true},
        "tests_require_real_api": {"const": false},
        "real_api_call_performed": {"const": false},
        "external_api_used": {"const": false},
        "network_used": {"const": false},
        "cost_guard_required": {"const": true},
        "cost_guard_blocks_accidental_external_api": {"const": true},
        "secret_handling_env_only": {"const": true},
        "secrets_read": {"const": false},
        "operator_warning_required": {"const": true},
        "risk_report_required": {"const": true},
        "blocking_findings_total": {"type": "integer", "minimum": 0},
        "findings_total": {"type": "integer", "minimum": 0},
        "schema_valid": {"type": "boolean"},
        "reports_written": {"type": "boolean"},
        "preliminary": {"const": true}
      }
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/provider"}
    },
    "fake_provider_contract": {
      "type": "object",
      "additionalProperties": true,
      "required": ["contract_id", "provider_id", "fake_provider_used", "real_provider_used", "network_used", "external_api_used", "api_key_read", "raw_prompt_stored", "raw_output_stored", "contract_ok"],
      "properties": {
        "contract_id": {"const": "external-api-fake-provider-contract"},
        "provider_id": {"type": "string", "minLength": 1},
        "fake_provider_used": {"const": true},
        "real_provider_used": {"const": false},
        "network_used": {"const": false},
        "external_api_used": {"const": false},
        "api_key_read": {"const": false},
        "raw_prompt_stored": {"const": false},
        "raw_output_stored": {"const": false},
        "contract_ok": {"const": true}
      }
    },
    "cost_guard": {
      "type": "object",
      "additionalProperties": true,
      "required": ["required", "accidental_external_api_decision", "budgeted_pilot_decision", "real_calls_blocked_without_budget", "estimated_cost_usd"],
      "properties": {
        "required": {"const": true},
        "real_calls_blocked_without_budget": {"const": true},
        "estimated_cost_usd": {"type": "number", "minimum": 0}
      }
    },
    "secret_handling": {
      "type": "object",
      "additionalProperties": true,
      "required": ["env_var_names_only", "secrets_read", "secrets_stored", "api_key_values_in_repo", "secret_guard_checked_policy", "allowed_env_vars"],
      "properties": {
        "env_var_names_only": {"const": true},
        "secrets_read": {"const": false},
        "secrets_stored": {"const": false},
        "api_key_values_in_repo": {"const": false},
        "secret_guard_checked_policy": {"const": true},
        "allowed_env_vars": {"type": "array", "items": {"type": "string"}}
      }
    },
    "real_call_gate": {
      "type": "object",
      "additionalProperties": true,
      "required": ["requested", "allowed", "provider", "env_var_name", "env_var_value_read", "operator_acknowledged_risk", "real_call_performed", "warning_visible", "report_required", "message"],
      "properties": {
        "requested": {"type": "boolean"},
        "allowed": {"type": "boolean"},
        "provider": {"type": "string", "minLength": 1},
        "env_var_name": {"type": ["string", "null"]},
        "env_var_value_read": {"const": false},
        "operator_acknowledged_risk": {"type": "boolean"},
        "real_call_performed": {"const": false},
        "warning_visible": {"const": true},
        "report_required": {"const": true},
        "message": {"type": "string", "minLength": 1}
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "local_first",
        "read_only",
        "dry_run",
        "external_api_enabled_by_default",
        "external_api_used",
        "network_used",
        "real_api_call_performed",
        "real_api_call_supported_by_this_sprint",
        "tests_require_real_api",
        "fake_provider_used",
        "secrets_read",
        "raw_prompts_stored",
        "raw_outputs_stored",
        "source_mutations_performed",
        "remote_execution_enabled",
        "connector_write_enabled",
        "plugin_execution_enabled",
        "llm_judge_used"
      ],
      "properties": {
        "local_first": {"const": true},
        "read_only": {"type": "boolean"},
        "dry_run": {"const": true},
        "external_api_enabled_by_default": {"const": false},
        "external_api_used": {"const": false},
        "network_used": {"const": false},
        "real_api_call_performed": {"const": false},
        "real_api_call_supported_by_this_sprint": {"const": false},
        "tests_require_real_api": {"const": false},
        "fake_provider_used": {"const": true},
        "secrets_read": {"const": false},
        "raw_prompts_stored": {"const": false},
        "raw_outputs_stored": {"const": false},
        "source_mutations_performed": {"const": false},
        "remote_execution_enabled": {"const": false},
        "connector_write_enabled": {"const": false},
        "plugin_execution_enabled": {"const": false},
        "llm_judge_used": {"const": false}
      }
    },
    "findings": {"type": "array", "items": {"type": "object"}},
    "notes": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "provider": {
      "type": "object",
      "additionalProperties": true,
      "required": ["provider_id", "kind", "registered", "enabled", "disabled_by_default", "requires_api_key", "api_key_env", "external_api", "fake_provider_supported", "cost_guard_required", "operator_warning_required", "risk_report_required", "blocking_findings"],
      "properties": {
        "provider_id": {"type": "string", "minLength": 1},
        "kind": {"const": "api"},
        "registered": {"const": true},
        "enabled": {"const": false},
        "disabled_by_default": {"const": true},
        "requires_api_key": {"const": true},
        "api_key_env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "external_api": {"const": true},
        "fake_provider_supported": {"const": true},
        "cost_guard_required": {"const": true},
        "operator_warning_required": {"const": true},
        "risk_report_required": {"const": true},
        "blocking_findings": {"type": "array", "maxItems": 0}
      }
    }
  },
  "x-devpilot-schema-id": "SCHEMA-DEVPL-EXTERNAL-API-PROVIDER-PILOT-V1",
  "x-devpilot-version": "1.0.0",
  "x-devpilot-sprint": "POST-H-032-C",
  "x-devpilot-status": "registered",
  "x-devpilot-preliminary": true,
  "x-devpilot-validation-enabled-sprint": "POST-H-032-C"
}
