{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/SCHEMA-DEVPL-LOCAL-INSTALL-SMOKE-REPORT-V1",
  "title": "DevPilot LocalInstallSmokeReport v1",
  "description": "Structural contract for POST-H-026-D local install and run verification reports.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "schema_id",
    "report_id",
    "created_by",
    "scope",
    "decision",
    "implemented_status",
    "execution_mode",
    "checks_total",
    "checks_passed_total",
    "checks_failed_total",
    "critical_checks_failed_total",
    "operator_commands_total",
    "operator_commands",
    "commands_executed",
    "checks",
    "safety",
    "summary",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "schema_id": {"const": "SCHEMA-DEVPL-LOCAL-INSTALL-SMOKE-REPORT-V1"},
    "report_id": {"const": "local-install-smoke-post_h_026_d"},
    "created_by": {"const": "POST-H-026-D"},
    "created_at": {"type": "string", "minLength": 10},
    "scope": {"const": "local-release-candidate"},
    "decision": {"enum": ["PASS", "BLOCK"]},
    "implemented_status": {"enum": ["implemented-initial"]},
    "execution_mode": {"const": "read-only-install-run-preflight"},
    "candidate_zip": {"type": ["string", "null"]},
    "candidate_zip_checked": {"type": "boolean"},
    "checks_total": {"type": "integer", "minimum": 1},
    "checks_passed_total": {"type": "integer", "minimum": 0},
    "checks_failed_total": {"type": "integer", "minimum": 0},
    "critical_checks_total": {"type": "integer", "minimum": 1},
    "critical_checks_failed_total": {"type": "integer", "minimum": 0},
    "operator_commands_total": {"type": "integer", "minimum": 1},
    "operator_commands": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "commands_executed": {"type": "array", "maxItems": 0},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["check_id", "category", "status", "critical", "reason"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "category": {"enum": ["python", "cli", "frontend", "artifact", "docs", "security"]},
          "status": {"enum": ["pass", "block"]},
          "critical": {"type": "boolean"},
          "reason": {"type": "string", "minLength": 1},
          "metadata": {"type": "object"}
        }
      }
    },
    "duration_ms": {"type": "number", "minimum": 0},
    "safety": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "local_first",
        "read_only",
        "dry_run",
        "subprocess_executed",
        "pip_executed",
        "npm_executed",
        "socket_opened",
        "network_used",
        "external_api_used",
        "remote_execution_enabled",
        "connector_write_enabled",
        "plugin_execution_enabled",
        "mutations_performed",
        "source_mutations",
        "reports_written"
      ],
      "properties": {
        "local_first": {"const": true},
        "read_only": {"const": true},
        "dry_run": {"const": true},
        "subprocess_executed": {"const": false},
        "pip_executed": {"const": false},
        "npm_executed": {"const": false},
        "socket_opened": {"const": false},
        "network_used": {"const": false},
        "external_api_used": {"const": false},
        "remote_execution_enabled": {"const": false},
        "connector_write_enabled": {"const": false},
        "plugin_execution_enabled": {"const": false},
        "mutations_performed": {"const": false},
        "source_mutations": {"const": false},
        "reports_written": {"type": "boolean"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "decision",
        "created_by",
        "preliminary",
        "python_package_importable",
        "editable_install_documented",
        "operator_checklist_documented",
        "frontend_smoke_documented",
        "clean_package_policy_passed",
        "candidate_zip_checked",
        "commands_executed",
        "network_used",
        "external_api_used",
        "mutations_performed",
        "source_mutations",
        "remote_execution_enabled",
        "connector_write_enabled",
        "plugin_execution_enabled"
      ],
      "properties": {
        "decision": {"enum": ["PASS", "BLOCK"]},
        "created_by": {"const": "POST-H-026-D"},
        "preliminary": {"const": true},
        "python_package_importable": {"type": "boolean"},
        "editable_install_documented": {"type": "boolean"},
        "operator_checklist_documented": {"type": "boolean"},
        "frontend_smoke_documented": {"type": "boolean"},
        "clean_package_policy_passed": {"type": "boolean"},
        "candidate_zip_checked": {"type": "boolean"},
        "commands_executed": {"const": false},
        "reports_written": {"type": "boolean"},
        "network_used": {"const": false},
        "external_api_used": {"const": false},
        "mutations_performed": {"const": false},
        "source_mutations": {"const": false},
        "remote_execution_enabled": {"const": false},
        "connector_write_enabled": {"const": false},
        "plugin_execution_enabled": {"const": false}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "x-devpilot-schema-id": "SCHEMA-DEVPL-LOCAL-INSTALL-SMOKE-REPORT-V1",
  "x-devpilot-sprint": "POST-H-026-D",
  "x-devpilot-status": "registered"
}
