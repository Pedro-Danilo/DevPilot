{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "devpilot://schemas/local_identity/v1",
  "title": "LocalIdentity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actor_id",
    "username",
    "display_name",
    "roles",
    "workspace_scopes",
    "status",
    "created_at"
  ],
  "properties": {
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "username": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "workspace_scopes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "active",
        "disabled"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
