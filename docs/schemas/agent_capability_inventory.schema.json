{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/agent_capability_inventory.schema.json",
  "title": "DevPilot AgentCapabilityInventory v1",
  "description": "POST-H-032-A governed agent capability inventory. It classifies agents, risks, tool allowlists and promotion candidates without enabling runtime autonomy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_id",
    "inventory_id",
    "created_by",
    "status",
    "generated_at_utc",
    "source_paths",
    "summary",
    "agents",
    "promotion_criteria_ref",
    "safety",
    "findings",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "schema_id": {"const": "SCHEMA-DEVPL-AGENT-CAPABILITY-INVENTORY-V1"},
    "inventory_id": {"const": "devpilot-agent-capability-inventory"},
    "created_by": {"const": "POST-H-032-A"},
    "status": {"enum": ["implemented-initial", "blocked"]},
    "generated_at_utc": {"type": "string", "minLength": 10},
    "source_paths": {"$ref": "#/$defs/source_paths"},
    "summary": {"$ref": "#/$defs/summary"},
    "agents": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/agent"}},
    "promotion_criteria_ref": {"$ref": "#/$defs/promotion_criteria_ref"},
    "safety": {"$ref": "#/$defs/safety"},
    "findings": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "notes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "source_paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_registry", "tool_registry", "policy_matrix", "promotion_criteria"],
      "properties": {
        "agent_registry": {"type": "string", "minLength": 1},
        "tool_registry": {"type": "string", "minLength": 1},
        "policy_matrix": {"type": "string", "minLength": 1},
        "promotion_criteria": {"type": "string", "minLength": 1}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "created_by", "status", "decision", "agents_total", "registry_agents_total", "implemented_agents_total",
        "future_agents_total", "tools_total", "agents_with_tools_total", "agents_with_tools_without_allowlist_total",
        "implemented_without_module_total", "implemented_without_tests_total", "model_aware_candidates_total",
        "rag_candidates_total", "rag_enabled_total", "rag_enabled_without_groundedness_total",
        "memory_candidates_total", "memory_enabled_total", "external_api_allowed_total",
        "source_mutation_allowed_total", "source_mutation_without_approval_total", "remote_execution_enabled_total",
        "connector_write_enabled_total", "plugin_execution_enabled_total", "promotion_criteria_valid", "schema_valid",
        "reports_written", "read_only", "dry_run", "agents_executed", "tools_executed", "models_called",
        "network_used", "external_api_used", "remote_execution_enabled", "connector_write_enabled", "plugin_execution_enabled",
        "source_mutations_performed", "llm_judge_used", "blocking_findings_total", "findings_total", "preliminary"
      ],
      "properties": {
        "created_by": {"const": "POST-H-032-A"},
        "status": {"enum": ["implemented-initial", "blocked"]},
        "decision": {"enum": ["PASS", "BLOCK", "ERROR"]},
        "agents_total": {"type": "integer", "minimum": 1},
        "registry_agents_total": {"type": "integer", "minimum": 1},
        "implemented_agents_total": {"type": "integer", "minimum": 0},
        "future_agents_total": {"type": "integer", "minimum": 0},
        "tools_total": {"type": "integer", "minimum": 0},
        "agents_with_tools_total": {"type": "integer", "minimum": 0},
        "agents_with_tools_without_allowlist_total": {"const": 0},
        "implemented_without_module_total": {"const": 0},
        "implemented_without_tests_total": {"const": 0},
        "model_aware_candidates_total": {"type": "integer", "minimum": 0},
        "rag_candidates_total": {"type": "integer", "minimum": 0},
        "rag_enabled_total": {"const": 0},
        "rag_enabled_without_groundedness_total": {"const": 0},
        "memory_candidates_total": {"type": "integer", "minimum": 0},
        "memory_enabled_total": {"const": 0},
        "external_api_allowed_total": {"const": 0},
        "source_mutation_allowed_total": {"const": 0},
        "source_mutation_without_approval_total": {"const": 0},
        "remote_execution_enabled_total": {"const": 0},
        "connector_write_enabled_total": {"const": 0},
        "plugin_execution_enabled_total": {"const": 0},
        "promotion_criteria_valid": {"const": true},
        "schema_valid": {"type": "boolean"},
        "reports_written": {"type": "boolean"},
        "read_only": {"const": true},
        "dry_run": {"const": true},
        "agents_executed": {"const": false},
        "tools_executed": {"const": false},
        "models_called": {"const": false},
        "network_used": {"const": false},
        "external_api_used": {"const": false},
        "remote_execution_enabled": {"const": false},
        "connector_write_enabled": {"const": false},
        "plugin_execution_enabled": {"const": false},
        "source_mutations_performed": {"const": false},
        "llm_judge_used": {"const": false},
        "blocking_findings_total": {"type": "integer", "minimum": 0},
        "findings_total": {"type": "integer", "minimum": 0},
        "preliminary": {"const": true}
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "agent_id", "implementation_module", "implementation_module_exists", "status", "mode", "modes",
        "autonomy_level", "allowed_tools", "forbidden_tools", "policy_rules", "approval_required_actions",
        "eval_coverage", "eval_coverage_existing", "observability_events", "rag_enabled", "memory_enabled",
        "external_api_allowed", "provider_modes_allowed", "promotion_target", "blocking_gaps",
        "source_mutation_allowed", "source_mutation_requires_approval", "connector_write_enabled", "plugin_execution_enabled",
        "remote_execution_enabled", "tool_calling_dry_run_first", "llm_enabled_by_default"
      ],
      "properties": {
        "agent_id": {"type": "string", "minLength": 1},
        "implementation_module": {"type": ["string", "null"]},
        "implementation_module_exists": {"type": "boolean"},
        "status": {"type": "string", "minLength": 1},
        "mode": {"enum": ["deterministic", "rule-based", "model-aware", "rag-aware", "memory-aware", "tool-calling", "multiagent"]},
        "modes": {"type": "array", "minItems": 1, "items": {"enum": ["deterministic", "rule-based", "model-aware", "rag-aware", "memory-aware", "tool-calling", "multiagent"]}},
        "autonomy_level": {"type": "string", "minLength": 1},
        "allowed_tools": {"type": "array", "items": {"type": "string"}},
        "forbidden_tools": {"type": "array", "items": {"type": "string"}},
        "policy_rules": {"type": "array", "items": {"type": "string"}},
        "approval_required_actions": {"type": "array", "items": {"type": "string"}},
        "eval_coverage": {"type": "array", "items": {"type": "string"}},
        "eval_coverage_existing": {"type": "array", "items": {"type": "string"}},
        "observability_events": {"type": "array", "items": {"type": "string"}},
        "rag_enabled": {"const": false},
        "memory_enabled": {"const": false},
        "external_api_allowed": {"const": false},
        "provider_modes_allowed": {"type": "array", "minItems": 1, "items": {"enum": ["mock", "local_llm_opt_in"]}},
        "promotion_target": {"type": "string", "minLength": 1},
        "blocking_gaps": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "source_mutation_allowed": {"const": false},
        "source_mutation_requires_approval": {"const": true},
        "connector_write_enabled": {"const": false},
        "plugin_execution_enabled": {"const": false},
        "remote_execution_enabled": {"const": false},
        "tool_calling_dry_run_first": {"const": true},
        "llm_enabled_by_default": {"const": false}
      }
    },
    "promotion_criteria_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "schema_id", "criteria_id", "available", "schema_valid"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "schema_id": {"const": "SCHEMA-DEVPL-AGENT-PROMOTION-CRITERIA-V1"},
        "criteria_id": {"const": "devpilot-agent-promotion-criteria"},
        "available": {"const": true},
        "schema_valid": {"const": true}
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_first", "read_only", "dry_run", "agents_executed", "tools_executed", "models_called",
        "rag_executed", "memory_read", "memory_written", "network_used", "external_api_used",
        "remote_execution_enabled", "connector_write_enabled", "plugin_execution_enabled", "source_mutations_performed", "llm_judge_used"
      ],
      "properties": {
        "local_first": {"const": true},
        "read_only": {"const": true},
        "dry_run": {"const": true},
        "agents_executed": {"const": false},
        "tools_executed": {"const": false},
        "models_called": {"const": false},
        "rag_executed": {"const": false},
        "memory_read": {"const": false},
        "memory_written": {"const": false},
        "network_used": {"const": false},
        "external_api_used": {"const": false},
        "remote_execution_enabled": {"const": false},
        "connector_write_enabled": {"const": false},
        "plugin_execution_enabled": {"const": false},
        "source_mutations_performed": {"const": false},
        "llm_judge_used": {"const": false}
      }
    }
  }
}
