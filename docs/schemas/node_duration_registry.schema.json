{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "devpilot.testing.node_duration_registry.v1",
  "title": "NodeDurationRegistry",
  "type": "object",
  "required": ["schema_id", "version", "updated", "scheduler_enabled", "parallel_workers", "aging_policy", "ingested_receipts", "environments", "rejections"],
  "properties": {
    "schema_id": {"const": "devpilot.testing.node_duration_registry.v1"},
    "version": {"const": "1.0.0"},
    "updated": {"type": "string", "minLength": 1},
    "scheduler_enabled": {"const": false},
    "parallel_workers": {"const": 1},
    "aging_policy": {
      "type": "object",
      "required": ["method", "alpha", "older_observations_lose_geometric_weight", "evidence_deleted"],
      "properties": {
        "method": {"const": "sequential_ewma"},
        "alpha": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "older_observations_lose_geometric_weight": {"const": true},
        "evidence_deleted": {"const": false}
      },
      "additionalProperties": false
    },
    "ingested_receipts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["source_receipt", "source_hash", "environment_fingerprint", "accepted", "rejected", "ingested_at"],
        "properties": {
          "source_receipt": {"type": "string", "minLength": 1},
          "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "environment_fingerprint": {"type": "string", "minLength": 1},
          "accepted": {"type": "integer", "minimum": 0},
          "rejected": {"type": "integer", "minimum": 0},
          "ingested_at": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "environments": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["nodes", "samples_total"],
        "properties": {
          "samples_total": {"type": "integer", "minimum": 0},
          "nodes": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["samples", "sample_count", "median", "p95", "robust_estimate", "min", "max", "last_seen", "classification", "confidence"],
              "properties": {
                "samples": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["duration_seconds", "observed_at", "outcome", "source_receipt"],
                    "properties": {
                      "duration_seconds": {"type": "number", "minimum": 0},
                      "observed_at": {"type": "string", "minLength": 1},
                      "outcome": {"type": "string", "minLength": 1},
                      "source_receipt": {"type": "string", "minLength": 1}
                    },
                    "additionalProperties": false
                  }
                },
                "sample_count": {"type": "integer", "minimum": 1},
                "median": {"type": "number", "minimum": 0},
                "p95": {"type": "number", "minimum": 0},
                "robust_estimate": {"type": "number", "minimum": 0},
                "min": {"type": "number", "minimum": 0},
                "max": {"type": "number", "minimum": 0},
                "last_seen": {"type": "string", "minLength": 1},
                "classification": {"enum": ["cold", "warm"]},
                "confidence": {"enum": ["low", "medium", "high"]}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "rejections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_receipt", "sample_index", "reason"],
        "properties": {
          "source_receipt": {"type": "string", "minLength": 1},
          "sample_index": {"type": "integer", "minimum": 0},
          "nodeid": {"type": ["string", "null"]},
          "reason": {"enum": ["invalid_nodeid", "invalid_duration"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
