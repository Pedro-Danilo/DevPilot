{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/SCHEMA-DEVPL-OPERATOR-FLOW-SMOKE-REPORT-V1",
  "title": "DevPilot OperatorFlowSmokeReport v1",
  "description": "POST-H-028-D schema-backed report for local operator flows and UI/API error states: API down, token missing/invalid, empty reports/traces, approvals, dry-run actions, forbidden action BLOCK, settings redaction and operator dashboard next actions.",
  "type": "object",
  "required": [
    "schema_version",
    "schema_id",
    "report_id",
    "created_by",
    "status",
    "generated_at_utc",
    "summary",
    "checks",
    "safety",
    "findings",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "schema_id": {"const": "SCHEMA-DEVPL-OPERATOR-FLOW-SMOKE-REPORT-V1"},
    "report_id": {"type": "string", "minLength": 1},
    "created_by": {"const": "POST-H-028-D"},
    "status": {"type": "string", "enum": ["pass", "blocked", "implemented-initial"]},
    "generated_at_utc": {"type": "string", "minLength": 1},
    "summary": {
      "type": "object",
      "required": [
        "decision",
        "operator_flow_smoke_passed",
        "minimal_flows_total",
        "minimal_flows_passed",
        "api_down_visible",
        "token_missing_blocked",
        "token_invalid_blocked",
        "token_missing_visible",
        "token_invalid_visible",
        "raw_stack_traces_visible",
        "reports_empty_state_visible",
        "traces_empty_state_visible",
        "approval_lifecycle_passed",
        "approval_runtime_sandbox_used",
        "dry_run_actions_allowed_total",
        "forbidden_action_blocked",
        "block_state_visible",
        "settings_redacted",
        "settings_plan_only",
        "operator_dashboard_no_go_visible",
        "operator_dashboard_next_actions_visible",
        "troubleshooting_messages_aligned",
        "blocking_findings_total",
        "report_schema_valid",
        "read_only",
        "dry_run",
        "network_used",
        "external_api_used",
        "mutations_performed",
        "source_mutations_performed"
      ],
      "properties": {
        "decision": {"type": "string", "enum": ["PASS", "BLOCK"]},
        "operator_flow_smoke_passed": {"type": "boolean"},
        "minimal_flows_total": {"type": "integer", "minimum": 0},
        "minimal_flows_passed": {"type": "integer", "minimum": 0},
        "api_down_visible": {"type": "boolean"},
        "token_missing_blocked": {"type": "boolean"},
        "token_invalid_blocked": {"type": "boolean"},
        "token_missing_visible": {"type": "boolean"},
        "token_invalid_visible": {"type": "boolean"},
        "raw_stack_traces_visible": {"const": false},
        "reports_empty_state_visible": {"type": "boolean"},
        "traces_empty_state_visible": {"type": "boolean"},
        "approval_lifecycle_passed": {"type": "boolean"},
        "approval_runtime_sandbox_used": {"type": "boolean"},
        "dry_run_actions_allowed_total": {"type": "integer", "minimum": 0},
        "forbidden_action_blocked": {"type": "boolean"},
        "block_state_visible": {"type": "boolean"},
        "settings_redacted": {"type": "boolean"},
        "settings_plan_only": {"type": "boolean"},
        "operator_dashboard_no_go_visible": {"type": "boolean"},
        "operator_dashboard_next_actions_visible": {"type": "boolean"},
        "troubleshooting_messages_aligned": {"type": "boolean"},
        "checks_total": {"type": "integer", "minimum": 0},
        "checks_passed": {"type": "integer", "minimum": 0},
        "findings_total": {"type": "integer", "minimum": 0},
        "warnings_total": {"type": "integer", "minimum": 0},
        "blocking_findings_total": {"type": "integer", "minimum": 0},
        "report_schema_valid": {"type": "boolean"},
        "reports_written": {"type": "boolean"},
        "read_only": {"const": true},
        "dry_run": {"const": true},
        "network_used": {"const": false},
        "external_api_used": {"const": false},
        "mutations_performed": {"const": false},
        "source_mutations_performed": {"const": false}
      },
      "additionalProperties": true
    },
    "checks": {
      "type": "object",
      "required": [
        "auth_error_flows",
        "reports_traces_empty_states",
        "settings_security_redaction",
        "action_launcher",
        "operator_dashboard",
        "approval_center",
        "ui_error_states",
        "troubleshooting"
      ],
      "additionalProperties": true
    },
    "safety": {
      "type": "object",
      "required": [
        "local_first",
        "read_only",
        "dry_run",
        "network_used",
        "external_api_used",
        "remote_execution_enabled",
        "connector_write_enabled",
        "plugin_execution_enabled",
        "source_mutations_performed",
        "llm_judge_used",
        "server_started",
        "sockets_opened",
        "approval_runtime_sandbox_used",
        "raw_token_included",
        "raw_secret_values_included"
      ],
      "properties": {
        "local_first": {"const": true},
        "read_only": {"const": true},
        "dry_run": {"const": true},
        "network_used": {"const": false},
        "external_api_used": {"const": false},
        "remote_execution_enabled": {"const": false},
        "connector_write_enabled": {"const": false},
        "plugin_execution_enabled": {"const": false},
        "source_mutations_performed": {"const": false},
        "llm_judge_used": {"const": false},
        "server_started": {"const": false},
        "sockets_opened": {"const": false},
        "approval_runtime_sandbox_used": {"type": "boolean"},
        "raw_token_included": {"const": false},
        "raw_secret_values_included": {"const": false}
      },
      "additionalProperties": true
    },
    "findings": {"type": "array", "items": {"$ref": "finding.schema.json"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false,
  "x-devpilot-schema-id": "SCHEMA-DEVPL-OPERATOR-FLOW-SMOKE-REPORT-V1",
  "x-devpilot-version": "1.0.0",
  "x-devpilot-sprint": "POST-H-028-D",
  "x-devpilot-status": "registered",
  "x-devpilot-preliminary": true
}
