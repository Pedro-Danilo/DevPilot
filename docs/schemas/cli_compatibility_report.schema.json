{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/cli_compatibility_report.schema.json",
  "title": "DevPilot CliCompatibilityReport v1",
  "description": "POST-H-030-E report for source-controlled CLI compatibility contracts, migrated/high-risk command coverage and normalized observable command contract safety.",
  "type": "object",
  "required": [
    "schema_version",
    "schema_id",
    "report_id",
    "created_by",
    "status",
    "generated_at_utc",
    "summary",
    "contracts",
    "smoke_results",
    "safety",
    "findings",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "schema_id": {"const": "SCHEMA-DEVPL-CLI-COMPATIBILITY-REPORT-V1"},
    "report_id": {"const": "devpilot-cli-compatibility-report"},
    "created_by": {"const": "POST-H-030-E"},
    "status": {"enum": ["pass", "blocked"]},
    "generated_at_utc": {"type": "string", "minLength": 10},
    "summary": {
      "type": "object",
      "required": [
        "created_by",
        "status",
        "decision",
        "quality_gate_subgate",
        "contracts_path",
        "matrix_path",
        "commands_total",
        "contracts_total",
        "required_contracts_total",
        "required_contracts_present_total",
        "migrated_commands_total",
        "high_or_critical_commands_total",
        "missing_required_contracts_total",
        "unsafe_contracts_total",
        "non_normalized_contracts_total",
        "json_envelope_incomplete_total",
        "blocking_findings_total",
        "tests_executed",
        "dry_run",
        "read_only",
        "network_used",
        "external_api_used",
        "mutations_performed",
        "source_mutations_performed",
        "reports_written",
        "preliminary"
      ],
      "properties": {
        "created_by": {"const": "POST-H-030-E"},
        "status": {"const": "implemented-initial"},
        "decision": {"enum": ["PASS", "BLOCK"]},
        "quality_gate_subgate": {"const": "cli-boundary-hotspot-reduction"},
        "contracts_path": {"type": "string", "minLength": 1},
        "matrix_path": {"type": "string", "minLength": 1},
        "commands_total": {"type": "integer", "minimum": 1},
        "contracts_total": {"type": "integer", "minimum": 1},
        "required_contracts_total": {"type": "integer", "minimum": 1},
        "required_contracts_present_total": {"type": "integer", "minimum": 0},
        "migrated_commands_total": {"type": "integer", "minimum": 1},
        "high_or_critical_commands_total": {"type": "integer", "minimum": 1},
        "tier_0_contracts_total": {"type": "integer", "minimum": 0},
        "tier_1_contracts_total": {"type": "integer", "minimum": 0},
        "tier_2_contracts_total": {"type": "integer", "minimum": 0},
        "missing_required_contracts_total": {"type": "integer", "minimum": 0},
        "unknown_contract_commands_total": {"type": "integer", "minimum": 0},
        "duplicate_contracts_total": {"type": "integer", "minimum": 0},
        "invalid_contract_ids_total": {"type": "integer", "minimum": 0},
        "unsafe_contracts_total": {"type": "integer", "minimum": 0},
        "non_normalized_contracts_total": {"type": "integer", "minimum": 0},
        "json_envelope_incomplete_total": {"type": "integer", "minimum": 0},
        "smoke_enabled": {"type": "boolean"},
        "smoke_contracts_total": {"type": "integer", "minimum": 0},
        "smoke_executed_total": {"type": "integer", "minimum": 0},
        "smoke_failed_total": {"type": "integer", "minimum": 0},
        "blocking_findings_total": {"type": "integer", "minimum": 0},
        "tests_executed": {"const": false},
        "dry_run": {"const": true},
        "read_only": {"const": true},
        "network_used": {"const": false},
        "external_api_used": {"const": false},
        "mutations_performed": {"const": false},
        "source_mutations_performed": {"const": false},
        "reports_written": {"type": "boolean"},
        "preliminary": {"const": true}
      },
      "additionalProperties": true
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["contract_id", "command_id", "tier", "command_path", "risk_level", "json_contract", "exit_code_contract", "help_contract", "normalization", "safety"],
        "properties": {
          "contract_id": {"type": "string", "pattern": "^cli-compat:"},
          "command_id": {"type": "string", "minLength": 1},
          "tier": {"enum": ["tier_0", "tier_1", "tier_2"]},
          "command_path": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "risk_level": {"enum": ["low", "medium", "high", "critical"]},
          "json_contract": {"type": "object", "required": ["required_top_level_keys"], "additionalProperties": true},
          "exit_code_contract": {"type": "object", "required": ["allowed_exit_codes"], "additionalProperties": true},
          "help_contract": {"type": "object", "required": ["required_tokens"], "additionalProperties": true},
          "normalization": {"type": "object", "additionalProperties": true},
          "safety": {"type": "object", "additionalProperties": true}
        },
        "additionalProperties": true
      }
    },
    "smoke_results": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "safety": {"type": "object", "additionalProperties": true},
    "findings": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
