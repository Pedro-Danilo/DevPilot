{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "devpilot.testing.historical_contract_authority_registry.v1",
  "title": "HistoricalContractAuthorityRegistry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "version",
    "status",
    "updated",
    "owner",
    "source_sprint",
    "source_repo",
    "source_commit",
    "authority_scopes",
    "contracts",
    "lifecycle_checks",
    "schema_complete_registries"
  ],
  "properties": {
    "schema_id": {
      "const": "devpilot.testing.historical_contract_authority_registry.v1"
    },
    "version": {
      "const": "1.0.0"
    },
    "status": {
      "enum": [
        "implemented-initial",
        "closed"
      ]
    },
    "updated": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "source_sprint": {
      "const": "FRX-v2.4-A"
    },
    "source_repo": {
      "type": "string",
      "minLength": 1
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "authority_scopes": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "historical-freeze",
          "current-active",
          "successor-needed",
          "deprecated-after-proof",
          "derived",
          "runtime-ephemeral"
        ]
      }
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contract_id",
          "authority_scope",
          "owner",
          "rationale",
          "test_files"
        ],
        "properties": {
          "contract_id": {
            "type": "string",
            "pattern": "^[a-z0-9_.-]+$"
          },
          "authority_scope": {
            "enum": [
              "historical-freeze",
              "current-active",
              "successor-needed",
              "deprecated-after-proof",
              "derived",
              "runtime-ephemeral"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "test_files": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "snapshot_path": {
            "type": "string",
            "minLength": 1
          },
          "mutable_current_paths": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "current_paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "successor_contract_id": {
            "type": "string",
            "minLength": 1
          },
          "proof_path": {
            "type": "string",
            "minLength": 1
          },
          "derived_from": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "excluded_patterns": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "authority_scope": {
                  "const": "historical-freeze"
                }
              }
            },
            "then": {
              "required": [
                "snapshot_path",
                "mutable_current_paths"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "authority_scope": {
                  "const": "current-active"
                }
              }
            },
            "then": {
              "required": [
                "current_paths"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "authority_scope": {
                  "const": "successor-needed"
                }
              }
            },
            "then": {
              "required": [
                "successor_contract_id"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "authority_scope": {
                  "const": "deprecated-after-proof"
                }
              }
            },
            "then": {
              "required": [
                "proof_path"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "authority_scope": {
                  "const": "derived"
                }
              }
            },
            "then": {
              "required": [
                "derived_from"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "authority_scope": {
                  "const": "runtime-ephemeral"
                }
              }
            },
            "then": {
              "required": [
                "excluded_patterns"
              ]
            }
          }
        ]
      }
    },
    "lifecycle_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "path",
          "required_at_detection_field",
          "pending_now_field"
        ],
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "required_at_detection_field": {
            "type": "string",
            "minLength": 1
          },
          "pending_now_field": {
            "type": "string",
            "minLength": 1
          },
          "legacy_field": {
            "type": "string",
            "minLength": 1
          },
          "status_at_close_field": {
            "type": "string",
            "minLength": 1
          },
          "current_status_field": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "schema_complete_registries": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "registry_id",
          "instance_path",
          "schema_contract",
          "semantic_validator"
        ],
        "properties": {
          "registry_id": {
            "type": "string",
            "minLength": 1
          },
          "instance_path": {
            "type": "string",
            "minLength": 1
          },
          "schema_contract": {
            "type": "string",
            "minLength": 1
          },
          "semantic_validator": {
            "enum": [
              "test-isolation",
              "node-duration"
            ]
          }
        }
      }
    }
  }
}
