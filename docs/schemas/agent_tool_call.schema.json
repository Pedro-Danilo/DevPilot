{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/agent_tool_call.schema.json",
  "title": "DevPilot AgentToolCall Contract Report v1",
  "description": "POST-H-032-F contract for local-first, dry-run-first, allowlisted, approval-bound and observable agent tool calls.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_id",
    "report_id",
    "created_by",
    "status",
    "generated_at_utc",
    "policy_path",
    "agent_inventory_path",
    "tool_registry_path",
    "policy_matrix_path",
    "summary",
    "policy",
    "executable_subset",
    "tool_calls",
    "injection_evaluations",
    "safety",
    "findings",
    "notes",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "schema_id": {"const": "SCHEMA-DEVPL-AGENT-TOOL-CALL-V1"},
    "report_id": {"type": "string", "minLength": 1},
    "created_by": {"const": "POST-H-032-F"},
    "status": {"enum": ["implemented-initial", "blocked"]},
    "generated_at_utc": {"type": "string", "minLength": 1},
    "policy_path": {"type": "string", "minLength": 1},
    "agent_inventory_path": {"type": "string", "minLength": 1},
    "tool_registry_path": {"type": "string", "minLength": 1},
    "policy_matrix_path": {"type": "string", "minLength": 1},
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "created_by",
        "status",
        "decision",
        "preliminary",
        "tools_total",
        "executable_subset_total",
        "agent_tool_calls_total",
        "allowlisted_pairs_total",
        "risky_tools_total",
        "risky_tools_with_approval_required_total",
        "dry_run_first_default",
        "tool_calls_validate_schema",
        "all_agent_tool_pairs_allowlisted",
        "approval_binding_for_risky_tools",
        "prompt_tool_injection_guard_passed",
        "connector_write_enabled",
        "plugin_execution_enabled",
        "remote_execution_enabled",
        "tools_executed",
        "network_used",
        "external_api_used",
        "llm_used",
        "source_mutations_performed",
        "observability_traceable",
        "schema_valid",
        "blocking_findings_total",
        "findings_total"
      ],
      "properties": {
        "created_by": {"const": "POST-H-032-F"},
        "status": {"enum": ["implemented-initial", "blocked"]},
        "decision": {"enum": ["PASS", "BLOCK"]},
        "preliminary": {"const": true},
        "tools_total": {"type": "integer", "minimum": 0},
        "executable_subset_total": {"type": "integer", "minimum": 0},
        "agent_tool_calls_total": {"type": "integer", "minimum": 0},
        "allowlisted_pairs_total": {"type": "integer", "minimum": 0},
        "risky_tools_total": {"type": "integer", "minimum": 0},
        "risky_tools_with_approval_required_total": {"type": "integer", "minimum": 0},
        "dry_run_first_default": {"const": true},
        "tool_calls_validate_schema": {"const": true},
        "all_agent_tool_pairs_allowlisted": {"const": true},
        "approval_binding_for_risky_tools": {"const": true},
        "prompt_tool_injection_guard_passed": {"const": true},
        "connector_write_enabled": {"const": false},
        "plugin_execution_enabled": {"const": false},
        "remote_execution_enabled": {"const": false},
        "tools_executed": {"const": false},
        "network_used": {"const": false},
        "external_api_used": {"const": false},
        "llm_used": {"const": false},
        "source_mutations_performed": {"const": false},
        "observability_traceable": {"const": true},
        "reports_written": {"type": "boolean"},
        "schema_valid": {"type": "boolean"},
        "blocking_findings_total": {"type": "integer", "minimum": 0},
        "findings_total": {"type": "integer", "minimum": 0}
      }
    },
    "policy": {"type": "object", "additionalProperties": true},
    "executable_subset": {
      "type": "array",
      "items": {"$ref": "#/$defs/executableTool"}
    },
    "tool_calls": {
      "type": "array",
      "items": {"$ref": "#/$defs/toolCall"}
    },
    "injection_evaluations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "effect", "rule_id", "blocked", "warned", "payload_redacted"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "effect": {"enum": ["allow", "warn", "deny", "block"]},
          "rule_id": {"type": "string", "minLength": 1},
          "blocked": {"type": "boolean"},
          "warned": {"type": "boolean"},
          "payload_redacted": {"const": true}
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_first",
        "contract_only",
        "dry_run_first_default",
        "fake_local_tools_only",
        "tools_executed",
        "connector_write_enabled",
        "plugin_execution_enabled",
        "remote_execution_enabled",
        "network_used",
        "external_api_used",
        "llm_used",
        "source_mutations_performed",
        "reports_only_under_outputs",
        "prompt_tool_injection_guard_enabled",
        "approval_binding_required_for_risky_tools"
      ],
      "properties": {
        "local_first": {"const": true},
        "contract_only": {"const": true},
        "dry_run_first_default": {"const": true},
        "fake_local_tools_only": {"const": true},
        "tools_executed": {"const": false},
        "connector_write_enabled": {"const": false},
        "plugin_execution_enabled": {"const": false},
        "remote_execution_enabled": {"const": false},
        "network_used": {"const": false},
        "external_api_used": {"const": false},
        "llm_used": {"const": false},
        "source_mutations_performed": {"const": false},
        "reports_only_under_outputs": {"const": true},
        "prompt_tool_injection_guard_enabled": {"const": true},
        "approval_binding_required_for_risky_tools": {"const": true}
      }
    },
    "findings": {"type": "array", "items": {"type": "object"}},
    "notes": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "executableTool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_id", "name", "status", "side_effect", "risk_level", "requires_approval", "policy_rule_ids", "executable_in_contract", "dry_run_first_required", "approval_binding_required", "connector_write_allowed", "plugin_execution_allowed", "remote_execution_allowed"],
      "properties": {
        "tool_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "side_effect": {"type": "string", "minLength": 1},
        "risk_level": {"type": "string", "minLength": 1},
        "requires_approval": {"type": "boolean"},
        "policy_rule_ids": {"type": "array", "items": {"type": "string"}},
        "executable_in_contract": {"type": "boolean"},
        "dry_run_first_required": {"const": true},
        "approval_binding_required": {"type": "boolean"},
        "connector_write_allowed": {"const": false},
        "plugin_execution_allowed": {"const": false},
        "remote_execution_allowed": {"const": false}
      }
    },
    "toolCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_call_id", "agent_id", "tool_id", "action", "subject", "allowed", "dry_run", "policy_exit_code", "policy_decision", "approval_required", "approval_binding_checked", "approval_valid", "risk_level", "side_effect", "allowlist_status", "observability_events", "traceable", "connector_write_used", "plugin_execution_used", "remote_execution_used", "metadata", "findings"],
      "properties": {
        "tool_call_id": {"type": "string", "minLength": 1},
        "agent_id": {"type": "string", "minLength": 1},
        "tool_id": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "subject": {"type": "string", "minLength": 1},
        "allowed": {"type": "boolean"},
        "dry_run": {"const": true},
        "policy_exit_code": {"type": "integer", "minimum": 0},
        "policy_decision": {"enum": ["allow", "requires_approval", "block"]},
        "approval_required": {"type": "boolean"},
        "approval_binding_checked": {"type": "boolean"},
        "approval_valid": {"type": "boolean"},
        "risk_level": {"type": "string", "minLength": 1},
        "side_effect": {"type": "string", "minLength": 1},
        "allowlist_status": {"const": "allowed"},
        "observability_events": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "traceable": {"const": true},
        "connector_write_used": {"const": false},
        "plugin_execution_used": {"const": false},
        "remote_execution_used": {"const": false},
        "metadata": {"type": "object", "additionalProperties": true},
        "findings": {"type": "array", "items": {"type": "object"}}
      }
    }
  }
}
