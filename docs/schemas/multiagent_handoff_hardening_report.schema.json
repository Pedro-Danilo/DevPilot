{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/multiagent_handoff_hardening_report.schema.json",
  "title": "DevPilot MultiagentHandoffHardeningReport v1",
  "description": "POST-H-032-H structural contract for deterministic multiagent handoff hardening, supervisor gate, human checkpoints, scope isolation and observability without swarm autonomy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "schema_id", "report_id", "created_by", "status", "generated_at_utc",
    "policy_path", "agent_inventory_path", "tool_call_policy_path", "workflow_registry_path",
    "summary", "policy", "workflow_registry", "handoffs", "scope_evaluations",
    "supervisor_gate_evaluations", "human_checkpoints", "workflow_evals", "observability",
    "injection_evaluations", "safety", "findings", "notes", "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "schema_id": {"const": "SCHEMA-DEVPL-MULTIAGENT-HANDOFF-HARDENING-REPORT-V1"},
    "report_id": {"const": "devpilot-multiagent-handoff-hardening-report"},
    "created_by": {"const": "POST-H-032-H"},
    "status": {"enum": ["implemented-initial", "blocked"]},
    "generated_at_utc": {"type": "string", "minLength": 10},
    "policy_path": {"type": "string", "minLength": 1},
    "agent_inventory_path": {"type": "string", "minLength": 1},
    "tool_call_policy_path": {"type": "string", "minLength": 1},
    "workflow_registry_path": {"type": "string", "minLength": 1},
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "created_by", "status", "decision", "preliminary", "swarm_autonomy_enabled",
        "handoffs_total", "handoffs_explicit_total", "handoffs_visible_total", "handoffs_traceable_total",
        "handoff_policy_decisions_total", "agents_scoped_total", "agents_scope_preserved",
        "child_inherits_unscoped_tools", "supervisor_gate_enabled", "supervisor_gate_deterministic",
        "supervisor_can_block_insufficient_evidence", "human_checkpoints_total",
        "risky_actions_require_human_checkpoint", "workflow_evals_total", "workflow_evals_positive_total",
        "workflow_evals_negative_total", "prompt_tool_injection_guard_passed", "observability_events_total",
        "connector_write_enabled", "plugin_execution_enabled", "remote_execution_enabled", "network_used",
        "external_api_used", "llm_used", "tools_executed", "source_mutations_performed",
        "schema_valid", "reports_written", "blocking_findings_total", "findings_total"
      ],
      "properties": {
        "created_by": {"const": "POST-H-032-H"},
        "status": {"enum": ["implemented-initial", "blocked"]},
        "decision": {"enum": ["PASS", "BLOCK"]},
        "preliminary": {"const": true},
        "swarm_autonomy_enabled": {"const": false},
        "handoffs_total": {"type": "integer", "minimum": 1},
        "handoffs_explicit_total": {"type": "integer", "minimum": 1},
        "handoffs_visible_total": {"type": "integer", "minimum": 1},
        "handoffs_traceable_total": {"type": "integer", "minimum": 1},
        "handoff_policy_decisions_total": {"type": "integer", "minimum": 1},
        "agents_scoped_total": {"type": "integer", "minimum": 1},
        "agents_scope_preserved": {"const": true},
        "child_inherits_unscoped_tools": {"const": false},
        "supervisor_gate_enabled": {"const": true},
        "supervisor_gate_deterministic": {"const": true},
        "supervisor_can_block_insufficient_evidence": {"const": true},
        "human_checkpoints_total": {"type": "integer", "minimum": 1},
        "risky_actions_require_human_checkpoint": {"const": true},
        "workflow_evals_total": {"type": "integer", "minimum": 2},
        "workflow_evals_positive_total": {"type": "integer", "minimum": 1},
        "workflow_evals_negative_total": {"type": "integer", "minimum": 1},
        "prompt_tool_injection_guard_passed": {"const": true},
        "observability_events_total": {"type": "integer", "minimum": 1},
        "connector_write_enabled": {"const": false},
        "plugin_execution_enabled": {"const": false},
        "remote_execution_enabled": {"const": false},
        "network_used": {"const": false},
        "external_api_used": {"const": false},
        "llm_used": {"const": false},
        "tools_executed": {"const": false},
        "source_mutations_performed": {"const": false},
        "schema_valid": {"type": "boolean"},
        "reports_written": {"type": "boolean"},
        "blocking_findings_total": {"type": "integer", "minimum": 0},
        "findings_total": {"type": "integer", "minimum": 0}
      }
    },
    "policy": {"type": "object"},
    "workflow_registry": {"type": "object"},
    "handoffs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": true,
        "required": ["handoff_id", "workflow_id", "sequence", "source_agent", "target_agent", "reason", "policy_decision", "trace_id", "explicit", "visible_to_operator", "supervisor_gate_required", "dry_run", "observability_events"],
        "properties": {
          "handoff_id": {"type": "string", "minLength": 1},
          "workflow_id": {"type": "string", "minLength": 1},
          "sequence": {"type": "integer", "minimum": 1},
          "source_agent": {"type": "string", "minLength": 1},
          "target_agent": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "policy_decision": {"type": "string", "minLength": 1},
          "trace_id": {"type": "string", "minLength": 1},
          "explicit": {"const": true},
          "visible_to_operator": {"const": true},
          "supervisor_gate_required": {"const": true},
          "dry_run": {"const": true},
          "observability_events": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "scope_evaluations": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": true}},
    "supervisor_gate_evaluations": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": true}},
    "human_checkpoints": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": true}},
    "workflow_evals": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": true}},
    "observability": {"type": "object", "additionalProperties": true},
    "injection_evaluations": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": true}},
    "safety": {
      "type": "object",
      "additionalProperties": true,
      "required": ["local_first", "report_only", "swarm_autonomy_enabled", "network_used", "external_api_used", "llm_used", "tools_executed", "connector_write_enabled", "plugin_execution_enabled", "remote_execution_enabled", "source_mutations_performed"],
      "properties": {
        "local_first": {"const": true},
        "report_only": {"const": true},
        "swarm_autonomy_enabled": {"const": false},
        "network_used": {"const": false},
        "external_api_used": {"const": false},
        "llm_used": {"const": false},
        "tools_executed": {"const": false},
        "connector_write_enabled": {"const": false},
        "plugin_execution_enabled": {"const": false},
        "remote_execution_enabled": {"const": false},
        "source_mutations_performed": {"const": false}
      }
    },
    "findings": {"type": "array", "items": {"type": "object"}},
    "notes": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
