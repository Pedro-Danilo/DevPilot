{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/SCHEMA-DEVPL-PLANNING-ROADMAP-V1",
  "title": "Planning Roadmap Authoring Payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["roadmap_id", "version", "milestones", "dependencies"],
  "properties": {
    "roadmap_id": {"type": "string", "pattern": "^planning-[a-z0-9-]{2,55}$"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "milestones": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id","version","title","owner_role","outcome","exit_criteria","trace_links"],
        "properties": {
          "id": {"type":"string","pattern":"^mil-[a-z0-9-]{2,59}$"},
          "version": {"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},
          "title": {"type":"string","minLength":1,"maxLength":256},
          "owner_role": {"enum":["owner","product-owner","architect","developer","qa-reviewer"]},
          "outcome": {"type":"string","minLength":1},
          "exit_criteria": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
          "trace_links": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["kind","target_id"],"properties":{"kind":{"enum":["requirement","risk","adr","test-intent"]},"target_id":{"type":"string","minLength":1,"maxLength":256}}}}
        }
      }
    },
    "dependencies": {
      "type":"array",
      "items":{"type":"object","additionalProperties":false,"required":["id","predecessor_id","successor_id","kind"],"properties":{"id":{"type":"string","minLength":3,"maxLength":64},"predecessor_id":{"type":"string","minLength":3},"successor_id":{"type":"string","minLength":3},"kind":{"enum":["requires","blocks","sequences"]},"rationale":{"type":"string"}}}
    }
  }
}
