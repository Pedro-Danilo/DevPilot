{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/gsdlc_09_c_dry_run_receipt.schema.json",
  "title": "GSDLC-09-C SourceChange dry-run receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "workspace_id",
    "story_execution_id",
    "plan_id",
    "plan_hash",
    "status",
    "exact_path_allowlist",
    "risk",
    "test_impact_preview",
    "source_mutations_performed",
    "actor",
    "actor_role",
    "completed_at_utc",
    "receipt_hash"
  ],
  "properties": {
    "schema_id": {
      "const": "SCHEMA-DEVPL-GSDLC-09-C-DRY-RUN-RECEIPT-V1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "story_execution_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_id": {
      "type": "string",
      "pattern": "^source-plan-[0-9a-f]{24}$"
    },
    "plan_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "const": "PASS"
    },
    "exact_path_allowlist": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risk": {
      "type": "object"
    },
    "test_impact_preview": {
      "type": "object"
    },
    "source_mutations_performed": {
      "const": false
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "actor_role": {
      "enum": [
        "owner",
        "developer"
      ]
    },
    "completed_at_utc": {
      "type": "string",
      "minLength": 1
    },
    "receipt_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
