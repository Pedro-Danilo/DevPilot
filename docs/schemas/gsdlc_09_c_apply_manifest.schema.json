{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/gsdlc_09_c_apply_manifest.schema.json",
  "title": "GSDLC-09-C ApplyManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "execution_id",
    "status",
    "plan_id",
    "plan_hash",
    "workspace_id",
    "story_execution_id",
    "approval_id",
    "actor",
    "required_role",
    "changes",
    "exact_path_allowlist",
    "backups",
    "duration_ms",
    "automatic_rollback",
    "automatic_rollback_integrity",
    "source_mutations_performed",
    "git_stage",
    "git_commit",
    "network_used",
    "external_api_used",
    "applied_at_utc"
  ],
  "properties": {
    "schema_id": {
      "const": "SCHEMA-DEVPL-GSDLC-09-C-APPLY-MANIFEST-V1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "execution_id": {
      "type": "string",
      "pattern": "^source-exec-[0-9a-f]{24}$"
    },
    "status": {
      "enum": [
        "applied",
        "rolled-back-automatic",
        "rollback-failed",
        "rolled-back-manual"
      ]
    },
    "plan_id": {
      "type": "string",
      "pattern": "^source-plan-[0-9a-f]{24}$"
    },
    "plan_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "story_execution_id": {
      "type": "string",
      "minLength": 1
    },
    "approval_id": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "required_role": {
      "const": "owner"
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "source_path",
          "target_path",
          "preimage_sha256",
          "postimage_sha256"
        ],
        "properties": {
          "operation": {
            "enum": [
              "CREATE",
              "EDIT",
              "RENAME"
            ]
          },
          "source_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "target_path": {
            "type": "string",
            "minLength": 1
          },
          "preimage_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "postimage_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "exact_path_allowlist": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "backups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "operation",
          "source_path",
          "target_path",
          "preimage_sha256",
          "postimage_sha256",
          "source_existed",
          "target_existed",
          "source_backup_ref",
          "target_backup_ref",
          "source_mode",
          "target_mode"
        ],
        "properties": {
          "operation": {
            "enum": [
              "CREATE",
              "EDIT",
              "RENAME"
            ]
          },
          "source_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "target_path": {
            "type": "string",
            "minLength": 1
          },
          "preimage_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "postimage_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_existed": {
            "type": "boolean"
          },
          "target_existed": {
            "type": "boolean"
          },
          "source_backup_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "target_backup_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_mode": {
            "type": [
              "integer",
              "null"
            ]
          },
          "target_mode": {
            "type": [
              "integer",
              "null"
            ]
          },
          "source_sha256_before": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "target_sha256_before": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "duration_ms": {
      "type": "number",
      "minimum": 0
    },
    "automatic_rollback": {
      "type": "boolean"
    },
    "automatic_rollback_integrity": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "source_mutations_performed": {
      "const": true
    },
    "git_stage": {
      "const": false
    },
    "git_commit": {
      "const": false
    },
    "network_used": {
      "const": false
    },
    "external_api_used": {
      "const": false
    },
    "applied_at_utc": {
      "type": "string",
      "minLength": 1
    }
  }
}
