{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/artifact_profiles.schema.json",
  "x-devpilot-schema-id": "SCHEMA-DEVPL-ARTIFACT-PROFILES-V1",
  "title": "DevPilot Artifact Profiles v1",
  "description": "Structural contract for data-driven Markdown artifact validation profiles, including additive MP-v2 professional profile metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract",
    "status",
    "owner",
    "sprint",
    "description",
    "preliminary",
    "generic_profile",
    "profiles",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.0$"
    },
    "contract": {
      "const": "ArtifactProfiles"
    },
    "status": {
      "enum": [
        "draft",
        "registered",
        "approved"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "sprint": {
      "const": "FUNC-SPRINT-24"
    },
    "description": {
      "type": "string",
      "minLength": 20
    },
    "preliminary": {
      "type": "boolean"
    },
    "generic_profile": {
      "$ref": "#/$defs/profile"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/profile"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "filename",
        "path_contains",
        "required_headings",
        "recommended_headings"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 10
        },
        "filename": {
          "type": [
            "string",
            "null"
          ]
        },
        "path_contains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_headings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "recommended_headings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "profile_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "payload_schema_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "semantic_rules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "completeness_rules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "upstream_trace_required": {
          "type": "boolean"
        },
        "assumptions_policy": {
          "enum": [
            "explicit",
            "forbidden",
            "allowed-with-rationale"
          ]
        },
        "open_questions_policy": {
          "enum": [
            "explicit",
            "forbidden",
            "allowed"
          ]
        },
        "prohibited_unsupported_claims": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "quality_gates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "render_template_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "human_review_checklist": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "downstream_semantics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "migration_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
