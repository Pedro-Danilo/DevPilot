{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/SCHEMA-DEVPL-PLANNING-STATE-V1",
  "title": "Planning State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "planning_id",
    "version",
    "lifecycle",
    "milestones",
    "epics",
    "stories",
    "sprints",
    "dependencies",
    "approval",
    "frozen_by"
  ],
  "properties": {
    "schema_id": {
      "const": "SCHEMA-DEVPL-PLANNING-STATE-V1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "planning_id": {
      "type": "string",
      "pattern": "^planning-[a-z0-9-]{2,55}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lifecycle": {
      "enum": [
        "DRAFT",
        "REVIEW",
        "APPROVED",
        "FROZEN"
      ]
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema_id",
          "schema_version",
          "id"
        ],
        "properties": {
          "schema_id": {
            "const": "SCHEMA-DEVPL-PLANNING-MILESTONE-V1"
          },
          "schema_version": {
            "const": "1.0.0"
          },
          "id": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "epics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema_id",
          "schema_version",
          "id"
        ],
        "properties": {
          "schema_id": {
            "const": "SCHEMA-DEVPL-PLANNING-EPIC-V1"
          },
          "schema_version": {
            "const": "1.0.0"
          },
          "id": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "stories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema_id",
          "schema_version",
          "id"
        ],
        "properties": {
          "schema_id": {
            "const": "SCHEMA-DEVPL-PLANNING-STORY-V1"
          },
          "schema_version": {
            "const": "1.0.0"
          },
          "id": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "sprints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema_id",
          "schema_version",
          "id"
        ],
        "properties": {
          "schema_id": {
            "const": "SCHEMA-DEVPL-PLANNING-SPRINT-V1"
          },
          "schema_version": {
            "const": "1.0.0"
          },
          "id": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema_id",
          "schema_version",
          "id"
        ],
        "properties": {
          "schema_id": {
            "const": "SCHEMA-DEVPL-PLANNING-DEPENDENCY-V1"
          },
          "schema_version": {
            "const": "1.0.0"
          },
          "id": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "approval": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "actor_id",
        "actor_role",
        "source_kind"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "actor_role": {
          "enum": [
            "owner",
            "product-owner"
          ]
        },
        "source_kind": {
          "const": "human"
        }
      },
      "additionalProperties": false
    },
    "frozen_by": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "actor_id",
        "actor_role",
        "source_kind"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "actor_role": {
          "enum": [
            "owner",
            "product-owner"
          ]
        },
        "source_kind": {
          "const": "human"
        }
      },
      "additionalProperties": false
    }
  }
}
