{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/git_commit_record.schema.json",
  "title": "GSDLC-10-D GitCommitRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "commit_record_id",
    "commit_hash",
    "parent_hash",
    "workspace_id",
    "story_execution_id",
    "story_id",
    "commit_plan_id",
    "commit_plan_hash",
    "stage_execution_id",
    "stage_approval_id",
    "commit_approval_id",
    "actor",
    "actor_role",
    "authority_source",
    "message",
    "author_name",
    "author_email",
    "committed_paths",
    "source_change_plan_id",
    "source_change_plan_hash",
    "story_test_plan_id",
    "story_test_plan_hash",
    "story_quality_report_id",
    "story_quality_report_hash",
    "requirement_ids",
    "test_evidence_ids",
    "traceability_complete",
    "worktree_clean",
    "index_clean",
    "push_performed",
    "force_push_performed",
    "rebase_performed",
    "reset_hard_performed",
    "shell",
    "agent_granted_authority",
    "model_route_granted_authority",
    "full_regression_started",
    "created_at_utc"
  ],
  "properties": {
    "schema_id": {
      "const": "SCHEMA-DEVPL-GSDLC-10-D-GIT-COMMIT-RECORD-V1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "commit_record_id": {
      "type": "string",
      "pattern": "^story-commit-record-[0-9a-f]{24}$"
    },
    "commit_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "parent_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "story_execution_id": {
      "type": "string",
      "minLength": 1
    },
    "story_id": {
      "type": "string",
      "minLength": 1
    },
    "commit_plan_id": {
      "type": "string",
      "minLength": 1
    },
    "commit_plan_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stage_execution_id": {
      "type": "string",
      "minLength": 1
    },
    "stage_approval_id": {
      "type": "string",
      "minLength": 1
    },
    "commit_approval_id": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "actor_role": {
      "const": "owner"
    },
    "authority_source": {
      "const": "human-session"
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "author_name": {
      "type": "string",
      "minLength": 1
    },
    "author_email": {
      "type": "string",
      "minLength": 3
    },
    "committed_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_change_plan_id": {
      "type": "string",
      "minLength": 1
    },
    "source_change_plan_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "story_test_plan_id": {
      "type": "string",
      "minLength": 1
    },
    "story_test_plan_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "story_quality_report_id": {
      "type": "string",
      "minLength": 1
    },
    "story_quality_report_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "requirement_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "test_evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "traceability_complete": {
      "const": true
    },
    "worktree_clean": {
      "const": true
    },
    "index_clean": {
      "const": true
    },
    "push_performed": {
      "const": false
    },
    "force_push_performed": {
      "const": false
    },
    "rebase_performed": {
      "const": false
    },
    "reset_hard_performed": {
      "const": false
    },
    "shell": {
      "const": false
    },
    "agent_granted_authority": {
      "const": false
    },
    "model_route_granted_authority": {
      "const": false
    },
    "full_regression_started": {
      "const": false
    },
    "created_at_utc": {
      "type": "string",
      "minLength": 1
    }
  }
}
