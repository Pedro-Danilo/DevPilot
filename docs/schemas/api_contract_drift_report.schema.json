{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/SCHEMA-DEVPL-API-CONTRACT-DRIFT-REPORT-V1",
  "title": "DevPilot ApiContractDriftReport v1",
  "description": "POST-H-028-A schema-backed report for local API contract drift across FastAPI runtime/canonical routes, ApiRouteContractRegistry, API_ROUTE_POLICIES and OpenAPI documentation.",
  "type": "object",
  "required": [
    "schema_version",
    "schema_id",
    "report_id",
    "created_by",
    "status",
    "generated_at_utc",
    "summary",
    "checks",
    "safety",
    "findings",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "schema_id": {"const": "SCHEMA-DEVPL-API-CONTRACT-DRIFT-REPORT-V1"},
    "report_id": {"type": "string", "minLength": 1},
    "created_by": {"const": "POST-H-028-A"},
    "status": {"type": "string", "enum": ["implemented-initial", "blocked", "pass"]},
    "generated_at_utc": {"type": "string", "minLength": 1},
    "summary": {
      "type": "object",
      "required": [
        "decision",
        "api_contract_drift_guard_passed",
        "runtime_routes_total",
        "canonical_routes_total",
        "registry_routes_total",
        "policy_routes_total",
        "unregistered_runtime_routes_total",
        "stale_registry_routes_total",
        "protected_routes_missing_policy_total",
        "protected_routes_missing_auth_or_policy_total",
        "response_contract_violations_total",
        "openapi_extra_paths_total",
        "openapi_missing_non_public_paths_total",
        "blocking_findings_total",
        "report_schema_valid",
        "read_only",
        "dry_run",
        "network_used",
        "external_api_used",
        "mutations_performed",
        "source_mutations_performed"
      ],
      "properties": {
        "decision": {"type": "string", "enum": ["PASS", "BLOCK"]},
        "api_contract_drift_guard_passed": {"type": "boolean"},
        "runtime_routes_total": {"type": "integer", "minimum": 0},
        "canonical_routes_total": {"type": "integer", "minimum": 0},
        "registry_routes_total": {"type": "integer", "minimum": 0},
        "policy_routes_total": {"type": "integer", "minimum": 0},
        "public_routes_total": {"type": "integer", "minimum": 0},
        "protected_routes_total": {"type": "integer", "minimum": 0},
        "unregistered_runtime_routes_total": {"type": "integer", "minimum": 0},
        "stale_registry_routes_total": {"type": "integer", "minimum": 0},
        "runtime_missing_canonical_routes_total": {"type": "integer", "minimum": 0},
        "runtime_extra_canonical_routes_total": {"type": "integer", "minimum": 0},
        "protected_routes_missing_policy_total": {"type": "integer", "minimum": 0},
        "protected_routes_missing_auth_or_policy_total": {"type": "integer", "minimum": 0},
        "response_contract_violations_total": {"type": "integer", "minimum": 0},
        "mutating_routes_total": {"type": "integer", "minimum": 0},
        "mutating_routes_without_justification_total": {"type": "integer", "minimum": 0},
        "no_go_violations_total": {"type": "integer", "minimum": 0},
        "openapi_paths_total": {"type": "integer", "minimum": 0},
        "openapi_extra_paths_total": {"type": "integer", "minimum": 0},
        "openapi_missing_non_public_paths_total": {"type": "integer", "minimum": 0},
        "openapi_missing_public_transport_paths_total": {"type": "integer", "minimum": 0},
        "checks_total": {"type": "integer", "minimum": 0},
        "checks_passed": {"type": "integer", "minimum": 0},
        "findings_total": {"type": "integer", "minimum": 0},
        "warnings_total": {"type": "integer", "minimum": 0},
        "blocking_findings_total": {"type": "integer", "minimum": 0},
        "report_schema_valid": {"type": "boolean"},
        "read_only": {"const": true},
        "dry_run": {"const": true},
        "network_used": {"const": false},
        "external_api_used": {"const": false},
        "mutations_performed": {"const": false},
        "source_mutations_performed": {"const": false}
      },
      "additionalProperties": true
    },
    "checks": {
      "type": "object",
      "required": ["route_inventory", "policy_binding", "response_contracts", "openapi_static", "no_go_gates"],
      "additionalProperties": true
    },
    "safety": {
      "type": "object",
      "required": [
        "local_first",
        "read_only",
        "dry_run",
        "network_used",
        "external_api_used",
        "remote_execution_enabled",
        "connector_write_enabled",
        "plugin_execution_enabled",
        "source_mutations_performed",
        "llm_judge_used"
      ],
      "properties": {
        "local_first": {"const": true},
        "read_only": {"const": true},
        "dry_run": {"const": true},
        "network_used": {"const": false},
        "external_api_used": {"const": false},
        "remote_execution_enabled": {"const": false},
        "connector_write_enabled": {"const": false},
        "plugin_execution_enabled": {"const": false},
        "source_mutations_performed": {"const": false},
        "llm_judge_used": {"const": false}
      },
      "additionalProperties": true
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "finding.schema.json"}
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false,
  "x-devpilot-schema-id": "SCHEMA-DEVPL-API-CONTRACT-DRIFT-REPORT-V1",
  "x-devpilot-version": "1.0.0",
  "x-devpilot-sprint": "POST-H-028-A",
  "x-devpilot-status": "registered",
  "x-devpilot-preliminary": true
}
