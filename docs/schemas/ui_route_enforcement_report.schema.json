{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/SCHEMA-DEVPL-UI-ROUTE-ENFORCEMENT-REPORT-V1",
  "title": "DevPilot UiRouteEnforcementReport v1",
  "description": "POST-H-028-E schema-backed report for blocking enforcement of UiRouteContractRegistry, UI/API bindings, state contracts, forbidden UI actions and API-only boundaries.",
  "type": "object",
  "required": [
    "schema_version",
    "schema_id",
    "report_id",
    "created_by",
    "status",
    "generated_at_utc",
    "summary",
    "checks",
    "safety",
    "findings",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "schema_id": {"const": "SCHEMA-DEVPL-UI-ROUTE-ENFORCEMENT-REPORT-V1"},
    "report_id": {"type": "string", "minLength": 1},
    "created_by": {"const": "POST-H-028-E"},
    "status": {"type": "string", "enum": ["pass", "blocked", "implemented-initial"]},
    "generated_at_utc": {"type": "string", "minLength": 1},
    "summary": {
      "type": "object",
      "required": [
        "decision",
        "ui_route_registry_enforcement_passed",
        "critical_routes_total",
        "critical_routes_registered_total",
        "critical_view_files_total",
        "critical_view_files_registered_total",
        "routes_total",
        "allowed_api_routes_total",
        "unregistered_api_refs_total",
        "missing_state_contracts_total",
        "no_go_violations_total",
        "forbidden_ui_actions_total",
        "filesystem_core_imports_total",
        "blocking_findings_total",
        "report_schema_valid",
        "read_only",
        "dry_run",
        "network_used",
        "external_api_used",
        "mutations_performed",
        "source_mutations_performed"
      ],
      "properties": {
        "decision": {"type": "string", "enum": ["PASS", "BLOCK"]},
        "ui_route_registry_enforcement_passed": {"type": "boolean"},
        "critical_routes_total": {"type": "integer", "minimum": 0},
        "critical_routes_registered_total": {"type": "integer", "minimum": 0},
        "critical_view_files_total": {"type": "integer", "minimum": 0},
        "critical_view_files_registered_total": {"type": "integer", "minimum": 0},
        "routes_total": {"type": "integer", "minimum": 0},
        "allowed_api_routes_total": {"type": "integer", "minimum": 0},
        "unregistered_api_refs_total": {"type": "integer", "minimum": 0},
        "missing_state_contracts_total": {"type": "integer", "minimum": 0},
        "no_go_violations_total": {"type": "integer", "minimum": 0},
        "forbidden_ui_actions_total": {"type": "integer", "minimum": 0},
        "filesystem_core_imports_total": {"type": "integer", "minimum": 0},
        "npm_smoke_required": {"type": "boolean"},
        "npm_smoke_passed": {"type": "boolean"},
        "checks_total": {"type": "integer", "minimum": 0},
        "checks_passed": {"type": "integer", "minimum": 0},
        "findings_total": {"type": "integer", "minimum": 0},
        "warnings_total": {"type": "integer", "minimum": 0},
        "blocking_findings_total": {"type": "integer", "minimum": 0},
        "report_schema_valid": {"type": "boolean"},
        "reports_written": {"type": "boolean"},
        "read_only": {"const": true},
        "dry_run": {"const": true},
        "network_used": {"const": false},
        "external_api_used": {"const": false},
        "mutations_performed": {"const": false},
        "source_mutations_performed": {"const": false}
      },
      "additionalProperties": true
    },
    "checks": {
      "type": "object",
      "required": [
        "registry_contract",
        "critical_routes",
        "allowed_api_routes",
        "state_contracts",
        "route_source_calls",
        "ui_boundary",
        "action_allowlist",
        "npm_smoke"
      ],
      "additionalProperties": true
    },
    "safety": {
      "type": "object",
      "required": [
        "local_first",
        "read_only",
        "dry_run",
        "network_used",
        "external_api_used",
        "remote_execution_enabled",
        "connector_write_enabled",
        "plugin_execution_enabled",
        "source_mutations_performed",
        "llm_judge_used",
        "server_started",
        "sockets_opened",
        "browser_required_for_core",
        "filesystem_read_from_ui",
        "core_python_import_from_ui"
      ],
      "properties": {
        "local_first": {"const": true},
        "read_only": {"const": true},
        "dry_run": {"const": true},
        "network_used": {"const": false},
        "external_api_used": {"const": false},
        "remote_execution_enabled": {"const": false},
        "connector_write_enabled": {"const": false},
        "plugin_execution_enabled": {"const": false},
        "source_mutations_performed": {"const": false},
        "llm_judge_used": {"const": false},
        "server_started": {"const": false},
        "sockets_opened": {"const": false},
        "browser_required_for_core": {"const": false},
        "filesystem_read_from_ui": {"const": false},
        "core_python_import_from_ui": {"const": false}
      },
      "additionalProperties": true
    },
    "findings": {"type": "array", "items": {"$ref": "finding.schema.json"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false,
  "x-devpilot-schema-id": "SCHEMA-DEVPL-UI-ROUTE-ENFORCEMENT-REPORT-V1",
  "x-devpilot-version": "1.0.0",
  "x-devpilot-sprint": "POST-H-028-E",
  "x-devpilot-status": "registered",
  "x-devpilot-preliminary": true
}
