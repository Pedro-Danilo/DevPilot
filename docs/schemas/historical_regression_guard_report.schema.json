{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/historical_regression_guard_report.schema.json",
  "title": "DevPilot HistoricalRegressionGuardReport v1",
  "description": "Schema-backed POST-H-029-E report for historical regression guard decisions. The guard is local-first, non-executing and blocks closure without explicit regression evidence or waiver decision.",
  "type": "object",
  "required": [
    "schema_version",
    "schema_id",
    "report_id",
    "created_by",
    "status",
    "generated_at_utc",
    "summary",
    "context",
    "changed_paths",
    "impact",
    "components",
    "regression_decision",
    "evidence",
    "waiver",
    "safety",
    "findings",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "schema_id": {"const": "SCHEMA-DEVPL-HISTORICAL-REGRESSION-GUARD-REPORT-V1"},
    "report_id": {"const": "devpilot-historical-regression-guard-report"},
    "created_by": {"const": "POST-H-029-E"},
    "status": {"enum": ["pass", "blocked"]},
    "generated_at_utc": {"type": "string", "minLength": 10},
    "summary": {
      "type": "object",
      "required": [
        "created_by",
        "status",
        "decision",
        "context",
        "regression_decision",
        "changed_paths_total",
        "unmatched_paths_total",
        "full_regression_required",
        "full_regression_reasons_total",
        "explicit_decision_required",
        "waiver_provided",
        "waiver_valid",
        "evidence_logs_total",
        "evidence_reports_total",
        "evidence_pending",
        "components_total",
        "components_passed_total",
        "warnings_total",
        "blocking_findings_total",
        "tests_executed",
        "dry_run",
        "network_used",
        "external_api_used",
        "mutations_performed",
        "source_mutations_performed",
        "reports_written",
        "preliminary"
      ],
      "properties": {
        "created_by": {"const": "POST-H-029-E"},
        "status": {"const": "implemented-initial"},
        "decision": {"enum": ["PASS", "BLOCK"]},
        "context": {"enum": ["micro-sprint", "backlog-closure", "release-candidate", "major-hito"]},
        "regression_decision": {"enum": ["full", "focal-expanded", "waiver", "pending"]},
        "changed_paths_total": {"type": "integer", "minimum": 0},
        "unmatched_paths_total": {"type": "integer", "minimum": 0},
        "full_regression_required": {"type": "boolean"},
        "full_regression_reasons_total": {"type": "integer", "minimum": 0},
        "explicit_decision_required": {"type": "boolean"},
        "waiver_provided": {"type": "boolean"},
        "waiver_valid": {"type": "boolean"},
        "evidence_logs_total": {"type": "integer", "minimum": 0},
        "evidence_reports_total": {"type": "integer", "minimum": 0},
        "evidence_pending": {"type": "boolean"},
        "components_total": {"type": "integer", "minimum": 1},
        "components_passed_total": {"type": "integer", "minimum": 0},
        "warnings_total": {"type": "integer", "minimum": 0},
        "blocking_findings_total": {"type": "integer", "minimum": 0},
        "tests_executed": {"const": false},
        "dry_run": {"const": true},
        "network_used": {"const": false},
        "external_api_used": {"const": false},
        "mutations_performed": {"const": false},
        "source_mutations_performed": {"const": false},
        "reports_written": {"type": "boolean"},
        "preliminary": {"const": true}
      },
      "additionalProperties": true
    },
    "context": {"enum": ["micro-sprint", "backlog-closure", "release-candidate", "major-hito"]},
    "changed_paths": {"type": "array", "items": {"type": "string"}},
    "impact": {"type": "object", "additionalProperties": true},
    "components": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": true}},
    "regression_decision": {
      "type": "object",
      "required": ["selected", "full_regression_required", "full_regression_reasons", "full_regression_run_declared", "explicit_decision_required"],
      "properties": {
        "selected": {"enum": ["full", "focal-expanded", "waiver", "pending"]},
        "full_regression_required": {"type": "boolean"},
        "full_regression_reasons": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "full_regression_run_declared": {"type": "boolean"},
        "explicit_decision_required": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "evidence": {"type": "object", "additionalProperties": true},
    "waiver": {"type": "object", "additionalProperties": true},
    "safety": {
      "type": "object",
      "required": [
        "local_first",
        "read_only",
        "dry_run",
        "tests_executed",
        "network_used",
        "external_api_used",
        "remote_execution_enabled",
        "connector_write_enabled",
        "plugin_execution_enabled",
        "mutations_performed",
        "source_mutations_performed",
        "llm_judge_used",
        "reports_written"
      ],
      "properties": {
        "local_first": {"const": true},
        "read_only": {"const": true},
        "dry_run": {"const": true},
        "tests_executed": {"const": false},
        "network_used": {"const": false},
        "external_api_used": {"const": false},
        "remote_execution_enabled": {"const": false},
        "connector_write_enabled": {"const": false},
        "plugin_execution_enabled": {"const": false},
        "mutations_performed": {"const": false},
        "source_mutations_performed": {"const": false},
        "llm_judge_used": {"const": false},
        "reports_written": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "findings": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "notes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false,
  "x-devpilot-schema-id": "SCHEMA-DEVPL-HISTORICAL-REGRESSION-GUARD-REPORT-V1",
  "x-devpilot-sprint": "POST-H-029-E",
  "x-devpilot-status": "registered"
}
