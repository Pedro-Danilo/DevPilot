{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/SCHEMA-DEVPL-UI-VISUAL-SMOKE-REPORT-V1",
  "title": "DevPilot UiVisualSmokeReport v1",
  "description": "POST-H-028-C schema-backed report for dependency-light UI visual smoke checks over critical local operator views, visual states, browser-tooling advisory status and screenshot hygiene.",
  "type": "object",
  "required": [
    "schema_version",
    "schema_id",
    "report_id",
    "created_by",
    "status",
    "generated_at_utc",
    "summary",
    "checks",
    "safety",
    "findings",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "schema_id": {"const": "SCHEMA-DEVPL-UI-VISUAL-SMOKE-REPORT-V1"},
    "report_id": {"type": "string", "minLength": 1},
    "created_by": {"const": "POST-H-028-C"},
    "status": {"type": "string", "enum": ["pass", "blocked", "implemented-initial"]},
    "generated_at_utc": {"type": "string", "minLength": 1},
    "summary": {
      "type": "object",
      "required": [
        "decision",
        "visual_smoke_passed",
        "critical_views_total",
        "critical_views_passed",
        "operator_dashboard_embedded",
        "states_checked_total",
        "states_visible_total",
        "empty_state_visible",
        "error_state_visible",
        "block_state_visible",
        "unauthorized_state_visible",
        "api_down_state_visible",
        "screenshots_versioned",
        "screenshots_written",
        "browser_tooling_required_for_core",
        "browser_smoke_status",
        "blocking_findings_total",
        "report_schema_valid",
        "read_only",
        "dry_run",
        "network_used",
        "external_api_used",
        "mutations_performed",
        "source_mutations_performed"
      ],
      "properties": {
        "decision": {"type": "string", "enum": ["PASS", "BLOCK"]},
        "visual_smoke_passed": {"type": "boolean"},
        "critical_views_total": {"type": "integer", "minimum": 0},
        "critical_views_passed": {"type": "integer", "minimum": 0},
        "operator_dashboard_embedded": {"type": "boolean"},
        "states_checked_total": {"type": "integer", "minimum": 0},
        "states_visible_total": {"type": "integer", "minimum": 0},
        "empty_state_visible": {"type": "boolean"},
        "error_state_visible": {"type": "boolean"},
        "block_state_visible": {"type": "boolean"},
        "unauthorized_state_visible": {"type": "boolean"},
        "api_down_state_visible": {"type": "boolean"},
        "screenshots_versioned": {"const": false},
        "screenshots_written": {"const": false},
        "screenshots_output_path": {"type": "string"},
        "browser_tooling_required_for_core": {"const": false},
        "browser_tooling_available": {"type": "boolean"},
        "browser_smoke_status": {"type": "string", "minLength": 1},
        "checks_total": {"type": "integer", "minimum": 0},
        "checks_passed": {"type": "integer", "minimum": 0},
        "findings_total": {"type": "integer", "minimum": 0},
        "warnings_total": {"type": "integer", "minimum": 0},
        "blocking_findings_total": {"type": "integer", "minimum": 0},
        "report_schema_valid": {"type": "boolean"},
        "reports_written": {"type": "boolean"},
        "read_only": {"const": true},
        "dry_run": {"const": true},
        "network_used": {"const": false},
        "external_api_used": {"const": false},
        "mutations_performed": {"const": false},
        "source_mutations_performed": {"const": false}
      },
      "additionalProperties": true
    },
    "checks": {
      "type": "object",
      "required": [
        "route_contracts",
        "critical_views",
        "visual_states",
        "ui_safety",
        "screenshot_hygiene",
        "browser_tooling"
      ],
      "additionalProperties": true
    },
    "safety": {
      "type": "object",
      "required": [
        "local_first",
        "read_only",
        "dry_run",
        "network_used",
        "external_api_used",
        "remote_execution_enabled",
        "connector_write_enabled",
        "plugin_execution_enabled",
        "source_mutations_performed",
        "llm_judge_used",
        "browser_required_for_core",
        "screenshots_versioned"
      ],
      "properties": {
        "local_first": {"const": true},
        "read_only": {"const": true},
        "dry_run": {"const": true},
        "network_used": {"const": false},
        "external_api_used": {"const": false},
        "remote_execution_enabled": {"const": false},
        "connector_write_enabled": {"const": false},
        "plugin_execution_enabled": {"const": false},
        "source_mutations_performed": {"const": false},
        "llm_judge_used": {"const": false},
        "browser_required_for_core": {"const": false},
        "screenshots_versioned": {"const": false}
      },
      "additionalProperties": true
    },
    "findings": {"type": "array", "items": {"$ref": "finding.schema.json"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false,
  "x-devpilot-schema-id": "SCHEMA-DEVPL-UI-VISUAL-SMOKE-REPORT-V1",
  "x-devpilot-version": "1.0.0",
  "x-devpilot-sprint": "POST-H-028-C",
  "x-devpilot-status": "registered",
  "x-devpilot-preliminary": true
}
