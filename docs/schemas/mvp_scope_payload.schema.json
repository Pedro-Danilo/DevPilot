{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://devpilot.local/schemas/mvp_scope_payload.schema.json",
  "x-devpilot-schema-id": "SCHEMA-DEVPL-MVP-SCOPE-PAYLOAD-V1",
  "title": "DevPilot MVP Scope Payload v1",
  "required": [
    "schema_id",
    "vision_ref",
    "in_scope",
    "out_of_scope",
    "constraints",
    "claims",
    "assumptions",
    "open_questions"
  ],
  "properties": {
    "schema_id": {
      "const": "devpilot.product-definition.mvp-scope.v1"
    },
    "vision_ref": {
      "type": "string",
      "minLength": 1
    },
    "in_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "out_of_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "source_refs"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
