{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/SCHEMA-DEVPL-UI-OPERATIONAL-CONSOLE-FLAGS-V1",
  "title": "DevPilot UI Operational Console Flags lifecycle v1",
  "type": "object",
  "required": [
    "schema_version",
    "schema_id",
    "registry_id",
    "created_by",
    "status",
    "version",
    "updated",
    "default_mode",
    "feature_flags",
    "kill_switches",
    "safety"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "schema_id": {
      "const": "SCHEMA-DEVPL-UI-OPERATIONAL-CONSOLE-FLAGS-V1"
    },
    "registry_id": {
      "const": "devpilot-ui-operational-console-flags"
    },
    "created_by": {
      "const": "UOC-000"
    },
    "status": {
      "enum": [
        "draft",
        "approved"
      ]
    },
    "version": {
      "type": "string"
    },
    "updated": {
      "type": "string"
    },
    "default_mode": {
      "const": "disabled-until-sprint-gate"
    },
    "feature_flags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "flag_id",
          "enabled",
          "owner_sprint",
          "requires_restart"
        ],
        "properties": {
          "flag_id": {
            "type": "string",
            "pattern": "^uoc\\."
          },
          "enabled": {
            "type": "boolean"
          },
          "owner_sprint": {
            "type": "string"
          },
          "requires_restart": {
            "type": "boolean"
          },
          "enabled_by": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "kill_switches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "switch_id",
          "state",
          "scope",
          "owner"
        ],
        "properties": {
          "switch_id": {
            "type": "string",
            "pattern": "^uoc\\."
          },
          "state": {
            "const": "engaged"
          },
          "scope": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "safety": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "x-devpilot-schema-id": "SCHEMA-DEVPL-UI-OPERATIONAL-CONSOLE-FLAGS-V1",
  "x-devpilot-sprint": "UOC-000",
  "x-devpilot-status": "registered-evolving"
}
