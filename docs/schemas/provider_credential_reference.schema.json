{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/provider_credential_reference.schema.json",
  "title": "ProviderCredentialReference",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider_id", "auth_adapter_id", "reference_type", "required", "source", "raw_secret_present"],
  "properties": {
    "provider_id": {"type": "string", "minLength": 1},
    "auth_adapter_id": {"type": "string", "minLength": 1},
    "reference_type": {"enum": ["none", "env", "provider-native", "consumer-session"]},
    "reference_name": {"type": ["string", "null"]},
    "required": {"type": "boolean"},
    "source": {"type": "string", "minLength": 1},
    "raw_secret_present": {"const": false}
  }
}
