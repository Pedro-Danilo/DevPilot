{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/ai_operation_parameters.schema.json",
  "x-devpilot-schema-id": "SCHEMA-DEVPL-UOC010-AI-OPERATION-PARAMETERS-V1",
  "title": "UOC-010 typed AI operation parameters",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "target_id": {"type": "string", "maxLength": 64},
    "query": {"type": "string", "maxLength": 1000},
    "top_k": {"type": "integer", "minimum": 1, "maximum": 10},
    "index_source": {"enum": ["canonical", "runtime"]},
    "agent_id": {"type": "string", "maxLength": 96},
    "task_id": {"type": "string", "maxLength": 64},
    "provider_id": {"type": "string", "maxLength": 32},
    "memory_opt_in": {"type": "boolean"},
    "workflow_id": {"type": "string", "maxLength": 64},
    "max_steps": {"type": "integer", "minimum": 1, "maximum": 3}
  }
}
