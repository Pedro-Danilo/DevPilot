{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/operator_evidence_export.schema.json",
  "title": "DevPilot OperatorEvidenceExport v1",
  "description": "POST-H-031-E redacted operator evidence export UX package. It exports curated summaries only, never raw prompts, raw outputs, .env files, secrets or SQLite DB bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_id",
    "export_id",
    "created_by",
    "status",
    "generated_at_utc",
    "redacted",
    "dry_run",
    "summary",
    "sections",
    "manifest",
    "checksums",
    "redaction_manifest",
    "exported_files",
    "interpretation",
    "safety",
    "limitations",
    "findings",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "schema_id": {"const": "SCHEMA-DEVPL-OPERATOR-EVIDENCE-EXPORT-V1"},
    "export_id": {"type": "string", "pattern": "^operator-evidence-export-[a-f0-9]{12}$"},
    "created_by": {"const": "POST-H-031-E"},
    "status": {"enum": ["implemented-initial", "blocked"]},
    "generated_at_utc": {"type": "string", "minLength": 10},
    "redacted": {"const": true},
    "dry_run": {"type": "boolean"},
    "summary": {"$ref": "#/$defs/summary"},
    "sections": {
      "type": "object",
      "required": [
        "evidence_graph",
        "operator_health",
        "gap_action_map",
        "claims_no_go_dashboard",
        "observability_redacted_export",
        "runtime_state_inventory",
        "production_ready_final_declaration"
      ],
      "additionalProperties": false,
      "properties": {
        "evidence_graph": {"$ref": "#/$defs/section"},
        "operator_health": {"$ref": "#/$defs/section"},
        "gap_action_map": {"$ref": "#/$defs/section"},
        "claims_no_go_dashboard": {"$ref": "#/$defs/section"},
        "observability_redacted_export": {"$ref": "#/$defs/section"},
        "runtime_state_inventory": {"$ref": "#/$defs/section"},
        "production_ready_final_declaration": {"$ref": "#/$defs/section"}
      }
    },
    "manifest": {"$ref": "#/$defs/manifest"},
    "checksums": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "redaction_manifest": {"$ref": "#/$defs/redaction_manifest"},
    "exported_files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/exported_file"}},
    "interpretation": {"$ref": "#/$defs/interpretation"},
    "safety": {"$ref": "#/$defs/safety"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "findings": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "created_by",
        "status",
        "decision",
        "redacted",
        "redaction_required",
        "redaction_applied",
        "dry_run",
        "write_report_requested",
        "execution_blocked",
        "reports_written",
        "network_used",
        "external_api_used",
        "commands_executed",
        "source_mutations_performed",
        "raw_payloads_exported",
        "raw_prompts_exported",
        "raw_outputs_exported",
        "env_files_exported",
        "devpilot_db_exported",
        "sqlite_raw_exported",
        "claims_mutated",
        "no_go_gates_mutated",
        "preliminary",
        "sections_total",
        "checksums_total",
        "redactions_total",
        "secret_value_scan_passed",
        "package_dir",
        "files_planned_total",
        "files_written_total"
      ],
      "properties": {
        "created_by": {"const": "POST-H-031-E"},
        "status": {"enum": ["implemented-initial", "blocked"]},
        "decision": {"enum": ["PASS", "BLOCK", "ERROR"]},
        "redacted": {"const": true},
        "redaction_required": {"const": true},
        "redaction_applied": {"const": true},
        "dry_run": {"type": "boolean"},
        "write_report_requested": {"type": "boolean"},
        "execution_blocked": {"type": "boolean"},
        "reports_written": {"type": "boolean"},
        "network_used": {"const": false},
        "external_api_used": {"const": false},
        "commands_executed": {"const": false},
        "source_mutations_performed": {"const": false},
        "raw_payloads_exported": {"const": false},
        "raw_prompts_exported": {"const": false},
        "raw_outputs_exported": {"const": false},
        "env_files_exported": {"const": false},
        "devpilot_db_exported": {"const": false},
        "sqlite_raw_exported": {"const": false},
        "claims_mutated": {"const": false},
        "no_go_gates_mutated": {"const": false},
        "preliminary": {"const": true},
        "sections_total": {"type": "integer", "minimum": 7},
        "checksums_total": {"type": "integer", "minimum": 1},
        "redactions_total": {"type": "integer", "minimum": 0},
        "secret_value_scan_passed": {"type": "boolean"},
        "package_dir": {"type": "string", "pattern": "^outputs/audit_exports/operator_evidence_export"},
        "files_planned_total": {"type": "integer", "minimum": 1},
        "files_written_total": {"type": "integer", "minimum": 0}
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": true,
      "required": ["section_id", "command", "ok", "exit_code", "message", "summary", "findings", "redacted", "metadata_only", "raw_payload_exported", "source_refs"],
      "properties": {
        "section_id": {"type": "string", "minLength": 1},
        "command": {"type": "string", "minLength": 1},
        "ok": {"type": "boolean"},
        "exit_code": {"type": "integer"},
        "message": {"type": "string"},
        "summary": {"type": "object", "additionalProperties": true},
        "findings": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "redacted": {"const": true},
        "metadata_only": {"const": true},
        "raw_payload_exported": {"const": false},
        "source_refs": {"type": "array", "items": {"type": "object", "additionalProperties": true}}
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": true,
      "required": ["manifest_id", "export_id", "created_by", "generated_at_utc", "redacted", "reports_written", "package_dir", "exported_files", "checksums", "redaction_manifest"],
      "properties": {
        "manifest_id": {"const": "operator-evidence-export-manifest"},
        "export_id": {"type": "string", "minLength": 1},
        "created_by": {"const": "POST-H-031-E"},
        "generated_at_utc": {"type": "string", "minLength": 10},
        "redacted": {"const": true},
        "reports_written": {"type": "boolean"},
        "package_dir": {"type": "string", "minLength": 1},
        "exported_files": {"type": "array", "items": {"$ref": "#/$defs/exported_file"}},
        "checksums": {"type": "object", "additionalProperties": {"type": "string"}},
        "redaction_manifest": {"$ref": "#/$defs/redaction_manifest"}
      }
    },
    "redaction_manifest": {
      "type": "object",
      "additionalProperties": true,
      "required": ["redaction_required", "redaction_applied", "redactions_total", "secret_value_scan_passed", "raw_prompts_exported", "raw_outputs_exported", "raw_payloads_exported", "env_files_exported", "sqlite_raw_exported", "devpilot_db_exported", "outputs_raw_exported", "sections_metadata_only", "llm_judge_used"],
      "properties": {
        "redaction_required": {"const": true},
        "redaction_applied": {"const": true},
        "redactions_total": {"type": "integer", "minimum": 0},
        "secret_value_scan_passed": {"type": "boolean"},
        "raw_prompts_exported": {"const": false},
        "raw_outputs_exported": {"const": false},
        "raw_payloads_exported": {"const": false},
        "env_files_exported": {"const": false},
        "sqlite_raw_exported": {"const": false},
        "devpilot_db_exported": {"const": false},
        "outputs_raw_exported": {"const": false},
        "sections_metadata_only": {"const": true},
        "llm_judge_used": {"const": false}
      }
    },
    "exported_file": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path", "kind", "redacted", "write_mode"],
      "properties": {
        "path": {"type": "string", "pattern": "^outputs/"},
        "kind": {"type": "string", "minLength": 1},
        "redacted": {"const": true},
        "write_mode": {"const": "write-report"}
      }
    },
    "interpretation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["audience", "scope", "not_external_certification", "not_enterprise_ready_claim", "not_remote_ready_claim", "not_saas_ready_claim", "instructions"],
      "properties": {
        "audience": {"type": "string"},
        "scope": {"type": "string"},
        "not_external_certification": {"const": true},
        "not_enterprise_ready_claim": {"const": true},
        "not_remote_ready_claim": {"const": true},
        "not_saas_ready_claim": {"const": true},
        "instructions": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": true,
      "required": ["local_first", "redacted", "redaction_required", "redaction_applied", "network_used", "external_api_used", "source_mutations_performed", "commands_executed", "raw_payloads_exported", "raw_prompts_exported", "raw_outputs_exported", "env_files_exported", "devpilot_db_exported", "sqlite_raw_exported", "claims_mutated", "no_go_gates_mutated"],
      "properties": {
        "local_first": {"const": true},
        "redacted": {"const": true},
        "redaction_required": {"const": true},
        "redaction_applied": {"const": true},
        "network_used": {"const": false},
        "external_api_used": {"const": false},
        "source_mutations_performed": {"const": false},
        "commands_executed": {"const": false},
        "raw_payloads_exported": {"const": false},
        "raw_prompts_exported": {"const": false},
        "raw_outputs_exported": {"const": false},
        "env_files_exported": {"const": false},
        "devpilot_db_exported": {"const": false},
        "sqlite_raw_exported": {"const": false},
        "claims_mutated": {"const": false},
        "no_go_gates_mutated": {"const": false}
      }
    }
  }
}
