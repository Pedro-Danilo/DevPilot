{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/rag_agent_context_pack.schema.json",
  "x-devpilot-schema-id": "SCHEMA-DEVPL-RAG-AGENT-CONTEXT-PACK-V1",
  "title": "DevPilot RagAgentContextPack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_id",
    "pack_id",
    "created_by",
    "status",
    "generated_at_utc",
    "bindings_path",
    "index_path",
    "summary",
    "agents",
    "negative_cases",
    "groundedness_eval",
    "safety",
    "findings",
    "notes",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "schema_id": {"const": "SCHEMA-DEVPL-RAG-AGENT-CONTEXT-PACK-V1"},
    "pack_id": {"type": "string", "minLength": 1},
    "created_by": {"const": "POST-H-032-D"},
    "status": {"enum": ["implemented-initial", "blocked"]},
    "generated_at_utc": {"type": "string", "minLength": 1},
    "bindings_path": {"type": "string", "minLength": 1},
    "index_path": {"type": "string", "minLength": 1},
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "created_by",
        "decision",
        "agents_total",
        "target_agents_total",
        "sources_total",
        "citations_total",
        "all_grounded_suggestions_have_sources",
        "insufficient_evidence_behavior_enabled",
        "negative_cases_total",
        "negative_cases_passed",
        "prohibited_claims_justified_total",
        "rag_reads_allowlisted_sources_only",
        "schema_valid",
        "llm_used",
        "network_used",
        "external_api_used",
        "memory_used",
        "tools_executed",
        "source_mutations_performed",
        "blocking_findings_total",
        "reports_written",
        "preliminary"
      ],
      "properties": {
        "created_by": {"const": "POST-H-032-D"},
        "decision": {"enum": ["PASS", "BLOCK"]},
        "agents_total": {"type": "integer", "minimum": 0},
        "target_agents_total": {"type": "integer", "minimum": 5},
        "grounded_agents_total": {"type": "integer", "minimum": 0},
        "insufficient_evidence_agents_total": {"type": "integer", "minimum": 0},
        "sources_total": {"type": "integer", "minimum": 0},
        "citations_total": {"type": "integer", "minimum": 0},
        "all_grounded_suggestions_have_sources": {"const": true},
        "insufficient_evidence_behavior_enabled": {"const": true},
        "negative_cases_total": {"type": "integer", "minimum": 1},
        "negative_cases_passed": {"const": true},
        "prohibited_claims_justified_total": {"const": 0},
        "rag_reads_allowlisted_sources_only": {"const": true},
        "context_pack_schema": {"const": "SCHEMA-DEVPL-RAG-AGENT-CONTEXT-PACK-V1"},
        "schema_valid": {"type": "boolean"},
        "llm_used": {"const": false},
        "network_used": {"const": false},
        "external_api_used": {"const": false},
        "memory_used": {"const": false},
        "tools_executed": {"const": false},
        "source_mutations_performed": {"const": false},
        "blocking_findings_total": {"type": "integer", "minimum": 0},
        "findings_total": {"type": "integer", "minimum": 0},
        "reports_written": {"type": "boolean"},
        "preliminary": {"const": true}
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["agent_id", "mode", "status", "target", "query", "suggestions", "sources", "source_ids", "citations", "freshness", "coverage", "grounded", "insufficient_evidence", "llm_used", "network_used", "external_api_used", "memory_used", "tools_executed"],
        "properties": {
          "agent_id": {"type": "string", "minLength": 1},
          "mode": {"const": "rag-aware"},
          "status": {"enum": ["grounded", "insufficient-evidence"]},
          "target": {"type": "string"},
          "query": {"type": "string"},
          "suggestions": {"type": "array", "minItems": 1},
          "sources": {"type": "array"},
          "source_ids": {"type": "array", "items": {"type": "string"}},
          "citations": {"type": "array", "items": {"type": "string"}},
          "freshness": {"type": "object"},
          "coverage": {"type": "object"},
          "grounded": {"type": "boolean"},
          "insufficient_evidence": {"type": "boolean"},
          "llm_used": {"const": false},
          "network_used": {"const": false},
          "external_api_used": {"const": false},
          "memory_used": {"const": false},
          "tools_executed": {"const": false}
        }
      }
    },
    "negative_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["case_id", "type", "claim", "expected_response", "actual_response", "passed", "sources_used_total", "prohibited_claim_justified", "unsupported_claim_blocked"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "type": {"type": "string"},
          "claim": {"type": "string"},
          "expected_response": {"const": "insufficient evidence"},
          "actual_response": {"const": "insufficient evidence"},
          "passed": {"const": true},
          "sources_used_total": {"const": 0},
          "prohibited_claim_justified": {"const": false},
          "unsupported_claim_blocked": {"const": true}
        }
      }
    },
    "groundedness_eval": {"type": "object", "additionalProperties": true},
    "safety": {
      "type": "object",
      "additionalProperties": true,
      "required": ["local_first", "read_only", "dry_run", "llm_used", "network_used", "external_api_used", "memory_read", "memory_written", "tools_executed", "source_mutations_performed", "remote_execution_enabled", "connector_write_enabled", "plugin_execution_enabled", "raw_prompts_stored", "raw_outputs_stored", "claims_prohibited_by_rag_policy_justified"],
      "properties": {
        "local_first": {"const": true},
        "read_only": {"type": "boolean"},
        "dry_run": {"const": true},
        "llm_used": {"const": false},
        "network_used": {"const": false},
        "external_api_used": {"const": false},
        "memory_read": {"const": false},
        "memory_written": {"const": false},
        "tools_executed": {"const": false},
        "source_mutations_performed": {"const": false},
        "remote_execution_enabled": {"const": false},
        "connector_write_enabled": {"const": false},
        "plugin_execution_enabled": {"const": false},
        "raw_prompts_stored": {"const": false},
        "raw_outputs_stored": {"const": false},
        "claims_prohibited_by_rag_policy_justified": {"const": false}
      }
    },
    "findings": {"type": "array"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
