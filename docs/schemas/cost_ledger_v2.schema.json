{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/cost_ledger_v2.schema.json",
  "title": "CostLedgerEntryV2",
  "type": "object", "additionalProperties": false,
  "required": ["schema_id","run_id","workload_id","provider_id","model_id","access_route_id","planned","actual","budget_policy_id","adjustment_reason","provenance","timestamp","prompt_stored","content_stored","raw_secret_present"],
  "properties": {
    "schema_id":{"const":"devpilot.cost-ledger-entry.v2"}, "run_id":{"type":"string","minLength":1}, "workload_id":{"type":"string","minLength":1},
    "provider_id":{"type":"string","minLength":1}, "model_id":{"type":"string","minLength":1}, "access_route_id":{"type":"string","minLength":1},
    "planned":{"$ref":"#/$defs/estimate"}, "actual":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/estimate"}]},
    "budget_policy_id":{"type":"string","minLength":1}, "adjustment_reason":{"type":["string","null"]},
    "provenance":{"type":"array","items":{"type":"string"}}, "timestamp":{"type":"string","minLength":1},
    "prompt_stored":{"const":false}, "content_stored":{"const":false}, "raw_secret_present":{"const":false}
  },
  "$defs": {"estimate":{"type":"object","additionalProperties":false,"required":["input_tokens","output_tokens","total_tokens","cost_state","cost_usd","currency","source","freshness"],"properties":{"input_tokens":{"type":"integer","minimum":0},"output_tokens":{"type":"integer","minimum":0},"total_tokens":{"type":"integer","minimum":0},"cost_state":{"enum":["known","estimated","unknown"]},"cost_usd":{"type":["number","null"],"minimum":0},"currency":{"const":"USD"},"source":{"type":"string"},"freshness":{"type":"string"}}}}
}
