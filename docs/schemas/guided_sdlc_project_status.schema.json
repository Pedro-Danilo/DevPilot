{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:devpilot:schema:guided-sdlc-project-status:v1",
  "title": "DevPilot Guided SDLC ProjectStatus v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "workspace_id",
    "project_id",
    "phase",
    "current_step",
    "lifecycle_status",
    "progress",
    "mipsoftware",
    "miasi",
    "artifact_readiness",
    "planning",
    "blockers",
    "pending_approvals",
    "quality",
    "git",
    "revalidation",
    "model_budget",
    "freshness",
    "source_refs",
    "next_action_ref",
    "reason",
    "network_used",
    "external_api_used",
    "source_mutations_performed"
  ],
  "properties": {
    "schema_id": {
      "const": "SCHEMA-DEVPL-GUIDED-SDLC-PROJECT-STATUS-V1"
    },
    "schema_version": {
      "const": "1.0"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "phase": {
      "type": "string",
      "enum": [
        "UNKNOWN",
        "NOT_STARTED",
        "INTAKE",
        "PROBLEM_DISCOVERY",
        "BUSINESS_ANALYSIS",
        "STAKEHOLDERS",
        "REQUIREMENTS",
        "RISK_ANALYSIS",
        "ARCHITECTURE",
        "DOMAIN_DESIGN",
        "DATA_DESIGN",
        "INTERFACE_DESIGN",
        "UX_UI_DESIGN",
        "QUALITY_PLAN",
        "SECURITY_PLAN",
        "TEST_PLAN",
        "IMPLEMENTATION",
        "INTEGRATION",
        "VERIFICATION",
        "VALIDATION",
        "RELEASE",
        "DEPLOYMENT",
        "OPERATION",
        "MONITORING",
        "INCIDENT_MANAGEMENT",
        "MAINTENANCE",
        "AUDIT",
        "RETIREMENT"
      ]
    },
    "current_step": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "UNKNOWN",
        "NEW",
        "IN_PROGRESS",
        "BLOCKED",
        "REVALIDATION_REQUIRED",
        "READY_FOR_RELEASE",
        "RELEASED"
      ]
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed_phases",
        "total_phase_transitions",
        "percent",
        "terminal"
      ],
      "properties": {
        "completed_phases": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "total_phase_transitions": {
          "type": "integer",
          "minimum": 1
        },
        "percent": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "terminal": {
          "type": "boolean"
        }
      }
    },
    "mipsoftware": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "phase_number": {
          "type": [
            "integer",
            "null"
          ]
        },
        "total_phases": {
          "type": "integer"
        },
        "current_step": {
          "type": "string"
        },
        "source_standard": {
          "type": "string"
        }
      }
    },
    "miasi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason_code"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "UNKNOWN",
            "APPLICABLE",
            "NOT_APPLICABLE"
          ]
        },
        "reason_code": {
          "type": "string"
        },
        "source_ref": {
          "type": "string"
        }
      }
    },
    "artifact_readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "total",
        "ready",
        "attention",
        "counts"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "UNKNOWN",
            "ATTENTION_REQUIRED",
            "READY",
            "IN_PROGRESS"
          ]
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "ready": {
          "type": "integer",
          "minimum": 0
        },
        "attention": {
          "type": "integer",
          "minimum": 0
        },
        "counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "planning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "total",
        "counts"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "UNKNOWN",
            "MATERIALIZED"
          ]
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "priority",
          "code",
          "category",
          "subject",
          "message",
          "source"
        ],
        "properties": {
          "priority": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "pending_approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference",
          "status",
          "source_kind"
        ],
        "properties": {
          "reference": {
            "type": "string"
          },
          "status": {
            "const": "PENDING"
          },
          "source_kind": {
            "type": "string"
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason_code",
        "counts",
        "references"
      ],
      "properties": {
        "status": {
          "type": "string"
        },
        "reason_code": {
          "type": "string"
        },
        "counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "head",
        "branch",
        "dirty",
        "fingerprint"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "KNOWN",
            "UNKNOWN"
          ]
        },
        "head": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "dirty": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "fingerprint": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "revalidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason_codes"
      ],
      "properties": {
        "status": {
          "type": "string"
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "model_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason_code",
        "model_route",
        "token_budget",
        "cost_budget_usd"
      ],
      "properties": {
        "status": {
          "const": "NOT_AVAILABLE"
        },
        "reason_code": {
          "const": "GSDLC_06_NOT_IMPLEMENTED"
        },
        "model_route": {
          "type": [
            "string",
            "null"
          ]
        },
        "token_budget": {
          "type": [
            "integer",
            "null"
          ]
        },
        "cost_budget_usd": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason_code",
        "observed_at_utc",
        "state_fingerprint",
        "expected_state_fingerprint"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "FRESH",
            "STALE",
            "UNKNOWN"
          ]
        },
        "reason_code": {
          "type": "string"
        },
        "observed_at_utc": {
          "type": "string"
        },
        "state_fingerprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "expected_state_fingerprint": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "next_action_ref": {
      "type": "string"
    },
    "reason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "unknown"
      ]
    },
    "network_used": {
      "const": false
    },
    "external_api_used": {
      "const": false
    },
    "source_mutations_performed": {
      "const": false
    }
  }
}
