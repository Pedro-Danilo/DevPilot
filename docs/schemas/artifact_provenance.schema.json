{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "devpilot://schemas/artifact_provenance.schema.json",
  "x-devpilot-schema-id": "SCHEMA-DEVPL-GSDLC-04-A-ARTIFACT-PROVENANCE-V1",
  "title": "DevPilot Artifact Provenance v1",
  "description": "Immutable-by-event provenance metadata for governed artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "source_type",
    "source_sha256",
    "normalized_sha256",
    "artifact_version",
    "base_commit",
    "author_actor",
    "author_role",
    "session_principal",
    "reviewer",
    "reviewer_role",
    "created_at",
    "updated_at",
    "source_label",
    "source_reference",
    "lineage"
  ],
  "properties": {
    "schema_id": {
      "const": "devpilot.gsdlc04.artifact_provenance.v1"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "MANUAL",
        "PASTE",
        "UPLOAD",
        "IMPORT",
        "AGENT_ASSISTED",
        "EXTERNAL_EDITOR"
      ]
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "normalized_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact_version": {
      "type": "integer",
      "minimum": 1
    },
    "base_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "author_actor": {
      "type": "string",
      "minLength": 1
    },
    "author_role": {
      "type": "string",
      "enum": [
        "owner",
        "product-owner",
        "architect",
        "security-reviewer",
        "developer",
        "qa-reviewer",
        "release-manager",
        "operator",
        "agent-supervisor"
      ]
    },
    "session_principal": {
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "reviewer_role": {
      "type": "string",
      "enum": [
        "owner",
        "product-owner",
        "architect",
        "security-reviewer",
        "developer",
        "qa-reviewer",
        "release-manager",
        "operator",
        "agent-supervisor"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_label": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "lineage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "event",
          "at",
          "actor",
          "state",
          "normalized_sha256"
        ],
        "properties": {
          "event": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "enum": [
              "MISSING",
              "DRAFT",
              "VALIDATING",
              "FINDINGS",
              "READY_FOR_REVIEW",
              "APPROVAL_REQUIRED",
              "APPROVED",
              "FROZEN",
              "REVALIDATION_REQUIRED"
            ]
          },
          "normalized_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
