{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/SCHEMA-DEVPL-JOB-LOG-PAGE-V1",
  "title": "DevPilot Job Log Page v1",
  "type": "object",
  "required": ["job_id", "entries", "cursor", "next_cursor", "truncated"],
  "properties": {
    "job_id": {"type": "string", "pattern": "^job_[a-f0-9]{32}$"},
    "entries": {"type": "array", "items": {"type": "object", "required": ["timestamp", "level", "phase", "message"], "properties": {"timestamp": {"type": "string"}, "level": {"type": "string"}, "phase": {"type": "string"}, "message": {"type": "string"}}, "additionalProperties": false}},
    "cursor": {"type": "integer", "minimum": 0},
    "next_cursor": {"type": "integer", "minimum": 0},
    "truncated": {"type": "boolean"}
  },
  "additionalProperties": false,
  "x-devpilot-schema-id": "SCHEMA-DEVPL-JOB-LOG-PAGE-V1",
  "x-devpilot-sprint": "UOC-008",
  "x-devpilot-status": "registered"
}
