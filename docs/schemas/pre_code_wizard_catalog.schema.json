{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/pre_code_wizard_catalog.schema.json",
  "title": "GSDLC-05-E Pre-code Wizard Catalog",
  "type": "object",
  "required": ["schema_id","status","version","profile_id","stages"],
  "properties": {
    "$schema": {"type":"string"},
    "schema_id": {"const":"devpilot.gsdlc05e.pre_code_wizard_catalog.v1"},
    "status": {"const":"implemented-initial"},
    "version": {"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "profile_id": {"const":"guided-pre-code-manual-v1"},
    "readiness_semantics": {"type":"string"},
    "stages": {
      "type":"array","minItems":7,"maxItems":7,
      "items": {"type":"object","required":["stage_id","order","label","relative_path","profile_id","advisor_step","allowed_modes"],"properties":{
        "stage_id":{"type":"string","pattern":"^[a-z0-9-]+$"},"order":{"type":"integer","minimum":1,"maximum":7},"label":{"type":"string","minLength":1},"relative_path":{"type":"string","pattern":"^docs/"},"profile_id":{"type":"string","minLength":1},"advisor_step":{"type":"string","minLength":1},"allowed_modes":{"type":"array","minItems":1,"items":{"enum":["MANUAL","IMPORT"]},"uniqueItems":true}
      },"additionalProperties":false}
    }
  },
  "additionalProperties": false
}
