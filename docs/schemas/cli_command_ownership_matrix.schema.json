{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/cli_command_ownership_matrix.schema.json",
  "title": "DevPilot CliCommandOwnershipMatrix v1",
  "description": "POST-H-030-A ownership matrix for public CLI commands. It is read-only metadata for reducing cli.py hotspot risk without changing command behavior.",
  "type": "object",
  "required": [
    "schema_version",
    "schema_id",
    "matrix_id",
    "created_by",
    "status",
    "version",
    "updated",
    "summary",
    "commands",
    "safety",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "schema_id": {
      "const": "SCHEMA-DEVPL-CLI-COMMAND-OWNERSHIP-MATRIX-V1"
    },
    "matrix_id": {
      "const": "devpilot-cli-command-ownership-matrix"
    },
    "created_by": {
      "const": "POST-H-030-A"
    },
    "status": {
      "enum": [
        "implemented-initial"
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "updated": {
      "type": "string",
      "minLength": 10
    },
    "summary": {
      "type": "object",
      "required": [
        "commands_total",
        "commands_covered_total",
        "coverage_complete",
        "high_or_critical_commands_total",
        "high_or_critical_with_owner_total",
        "missing_owner_total",
        "missing_compatibility_contract_total",
        "migrable_commands_total",
        "cli_only_commands_total",
        "dynamic_handler_loading_enabled",
        "tests_executed",
        "network_used",
        "external_api_used",
        "source_mutations_performed",
        "preliminary"
      ],
      "properties": {
        "commands_total": {
          "type": "integer",
          "minimum": 1
        },
        "commands_covered_total": {
          "type": "integer",
          "minimum": 1
        },
        "coverage_complete": {
          "const": true
        },
        "high_or_critical_commands_total": {
          "type": "integer",
          "minimum": 0
        },
        "high_or_critical_with_owner_total": {
          "type": "integer",
          "minimum": 0
        },
        "missing_owner_total": {
          "type": "integer",
          "const": 0
        },
        "missing_compatibility_contract_total": {
          "type": "integer",
          "const": 0
        },
        "migrable_commands_total": {
          "type": "integer",
          "minimum": 0
        },
        "cli_only_commands_total": {
          "type": "integer",
          "minimum": 0
        },
        "dynamic_handler_loading_enabled": {
          "const": false
        },
        "tests_executed": {
          "const": false
        },
        "network_used": {
          "const": false
        },
        "external_api_used": {
          "const": false
        },
        "source_mutations_performed": {
          "const": false
        },
        "preliminary": {
          "const": true
        }
      },
      "additionalProperties": true
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "safety": {
      "type": "object",
      "required": [
        "local_first",
        "read_only",
        "dry_run",
        "commands_executed",
        "dynamic_handler_loading_enabled",
        "runtime_router_enabled",
        "network_used",
        "external_api_used",
        "remote_execution_enabled",
        "connector_write_enabled",
        "plugin_execution_enabled",
        "source_mutations_performed"
      ],
      "properties": {
        "local_first": {
          "const": true
        },
        "read_only": {
          "const": true
        },
        "dry_run": {
          "const": true
        },
        "commands_executed": {
          "const": false
        },
        "dynamic_handler_loading_enabled": {
          "const": false
        },
        "runtime_router_enabled": {
          "const": false
        },
        "network_used": {
          "const": false
        },
        "external_api_used": {
          "const": false
        },
        "remote_execution_enabled": {
          "const": false
        },
        "connector_write_enabled": {
          "const": false
        },
        "plugin_execution_enabled": {
          "const": false
        },
        "source_mutations_performed": {
          "const": false
        }
      },
      "additionalProperties": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "registry_phase": {
      "enum": [
        "legacy-unregistered",
        "declarative-initial",
        "handler-migrated-incremental",
        "static-inventory"
      ]
    },
    "migration_state": {
      "enum": [
        "already-migrated",
        "planned",
        "registered-only",
        "deferred-cli-only"
      ]
    },
    "command": {
      "type": "object",
      "required": [
        "command_id",
        "command_path",
        "public_name",
        "domain_owner",
        "current_handler",
        "target_handler",
        "current_module",
        "target_module",
        "registry_phase",
        "migration_state",
        "risk_level",
        "compatibility_contract_id",
        "json_output_contract",
        "exit_code_contract",
        "human_output_contract",
        "test_coverage_refs",
        "planned_micro_sprint",
        "application_operation_id",
        "cli_only_reason"
      ],
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 1
        },
        "command_path": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "public_name": {
          "type": "string",
          "minLength": 1
        },
        "domain_owner": {
          "type": "string",
          "minLength": 1
        },
        "current_handler": {
          "type": "string",
          "minLength": 1
        },
        "target_handler": {
          "type": "string",
          "minLength": 1
        },
        "current_module": {
          "type": "string",
          "minLength": 1
        },
        "target_module": {
          "type": "string",
          "minLength": 1
        },
        "registry_phase": {
          "$ref": "#/$defs/registry_phase"
        },
        "migration_state": {
          "$ref": "#/$defs/migration_state"
        },
        "application_operation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "cli_only_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "risk_level": {
          "$ref": "#/$defs/risk"
        },
        "compatibility_contract_id": {
          "type": "string",
          "minLength": 1
        },
        "json_output_contract": {
          "type": "string",
          "minLength": 1
        },
        "exit_code_contract": {
          "type": "string",
          "minLength": 1
        },
        "human_output_contract": {
          "type": "string",
          "minLength": 1
        },
        "test_coverage_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "planned_micro_sprint": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "x-devpilot-schema-id": "SCHEMA-DEVPL-CLI-COMMAND-OWNERSHIP-MATRIX-V1",
  "x-devpilot-sprint": "POST-H-030-A",
  "x-devpilot-status": "registered"
}
