{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/SCHEMA-DEVPL-LOCAL-API-SECURITY-HARDENING-REPORT-V1",
  "title": "DevPilot LocalApiSecurityHardeningReport v1",
  "description": "POST-H-028-B schema-backed report for local API/UI auth, CORS, localhost bind, security headers and redaction hardening without enterprise auth, network, external APIs or source mutations.",
  "type": "object",
  "required": [
    "schema_version",
    "schema_id",
    "report_id",
    "created_by",
    "status",
    "generated_at_utc",
    "summary",
    "checks",
    "safety",
    "findings",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "schema_id": {"const": "SCHEMA-DEVPL-LOCAL-API-SECURITY-HARDENING-REPORT-V1"},
    "report_id": {"type": "string", "minLength": 1},
    "created_by": {"const": "POST-H-028-B"},
    "status": {"type": "string", "enum": ["pass", "blocked", "implemented-initial"]},
    "generated_at_utc": {"type": "string", "minLength": 1},
    "summary": {
      "type": "object",
      "required": [
        "decision",
        "local_api_security_hardening_passed",
        "protected_without_token_blocked",
        "protected_invalid_token_blocked",
        "protected_valid_token_passed",
        "cors_wildcard_enabled",
        "local_origin_allowed",
        "non_local_origin_rejected",
        "non_local_bind_allowed",
        "remote_bind_override_enabled",
        "security_headers_present",
        "settings_secrets_redacted",
        "token_redacted_in_report",
        "blocking_findings_total",
        "report_schema_valid",
        "read_only",
        "dry_run",
        "network_used",
        "external_api_used",
        "mutations_performed",
        "source_mutations_performed"
      ],
      "properties": {
        "decision": {"type": "string", "enum": ["PASS", "BLOCK"]},
        "local_api_security_hardening_passed": {"type": "boolean"},
        "protected_without_token_blocked": {"type": "boolean"},
        "protected_invalid_token_blocked": {"type": "boolean"},
        "protected_valid_token_passed": {"type": "boolean"},
        "cors_wildcard_enabled": {"const": false},
        "local_origin_allowed": {"type": "boolean"},
        "non_local_origin_rejected": {"type": "boolean"},
        "non_local_bind_allowed": {"const": false},
        "remote_bind_override_enabled": {"const": false},
        "security_headers_present": {"type": "boolean"},
        "settings_secrets_redacted": {"type": "boolean"},
        "token_redacted_in_report": {"type": "boolean"},
        "checks_total": {"type": "integer", "minimum": 0},
        "checks_passed": {"type": "integer", "minimum": 0},
        "findings_total": {"type": "integer", "minimum": 0},
        "warnings_total": {"type": "integer", "minimum": 0},
        "blocking_findings_total": {"type": "integer", "minimum": 0},
        "report_schema_valid": {"type": "boolean"},
        "reports_written": {"type": "boolean"},
        "read_only": {"const": true},
        "dry_run": {"const": true},
        "network_used": {"const": false},
        "external_api_used": {"const": false},
        "mutations_performed": {"const": false},
        "source_mutations_performed": {"const": false}
      },
      "additionalProperties": true
    },
    "checks": {
      "type": "object",
      "required": ["auth", "cors", "bind_host", "security_headers", "settings_redaction", "token_redaction", "no_go_gates"],
      "additionalProperties": true
    },
    "safety": {
      "type": "object",
      "required": [
        "local_first",
        "read_only",
        "dry_run",
        "network_used",
        "external_api_used",
        "remote_execution_enabled",
        "connector_write_enabled",
        "plugin_execution_enabled",
        "source_mutations_performed",
        "llm_judge_used"
      ],
      "properties": {
        "local_first": {"const": true},
        "read_only": {"const": true},
        "dry_run": {"const": true},
        "network_used": {"const": false},
        "external_api_used": {"const": false},
        "remote_execution_enabled": {"const": false},
        "connector_write_enabled": {"const": false},
        "plugin_execution_enabled": {"const": false},
        "source_mutations_performed": {"const": false},
        "llm_judge_used": {"const": false}
      },
      "additionalProperties": true
    },
    "findings": {"type": "array", "items": {"$ref": "finding.schema.json"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false,
  "x-devpilot-schema-id": "SCHEMA-DEVPL-LOCAL-API-SECURITY-HARDENING-REPORT-V1",
  "x-devpilot-version": "1.0.0",
  "x-devpilot-sprint": "POST-H-028-B",
  "x-devpilot-status": "registered",
  "x-devpilot-preliminary": true
}
