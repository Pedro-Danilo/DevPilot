{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/SCHEMA-DEVPL-RELEASE-CANDIDATE-VERIFICATION-PROFILE-V1",
  "title": "DevPilot Release Candidate Verification Profile Report v1",
  "description": "Structural contract for POST-H-026-B plan-only local release candidate verification profile reports.",
  "type": "object",
  "required": [
    "schema_version",
    "schema_id",
    "report_id",
    "created_by",
    "scope",
    "profile_id",
    "decision",
    "execution_mode",
    "commands_expected",
    "commands_configured",
    "commands_executed",
    "pytest_targets",
    "tcr_v2_contracts_selected_total",
    "tests_executed",
    "network_used",
    "external_api_used",
    "mutations_performed",
    "safety"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "schema_id": {
      "const": "SCHEMA-DEVPL-RELEASE-CANDIDATE-VERIFICATION-PROFILE-V1"
    },
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "created_by": {
      "const": "POST-H-026-B"
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "const": "local-release-candidate"
    },
    "profile_id": {
      "const": "release-candidate-local"
    },
    "decision": {
      "enum": [
        "PASS",
        "BLOCK"
      ]
    },
    "implemented_status": {
      "enum": [
        "implemented-initial"
      ]
    },
    "execution_mode": {
      "const": "plan-only"
    },
    "taxonomy": {
      "type": "array",
      "items": {
        "enum": [
          "always",
          "impacted",
          "release-candidate",
          "full"
        ]
      }
    },
    "commands_expected": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "commands_configured": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "commands_executed": {
      "type": "array",
      "maxItems": 0
    },
    "command_results": {
      "type": "array",
      "maxItems": 0
    },
    "pytest_targets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "tcr_v2_contracts_selected_total": {
      "type": "integer",
      "minimum": 0
    },
    "tcr_v2_contract_ids": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "duration_ms": {
      "type": "number",
      "minimum": 0
    },
    "network_allowed": {
      "const": false
    },
    "external_api_allowed": {
      "const": false
    },
    "requires_approval_for_pytest": {
      "const": true
    },
    "tests_executed": {
      "const": false
    },
    "network_used": {
      "const": false
    },
    "external_api_used": {
      "const": false
    },
    "mutations_performed": {
      "const": false
    },
    "source_mutations": {
      "const": false
    },
    "reports_written": {
      "type": "boolean"
    },
    "safety": {
      "type": "object",
      "required": [
        "local_first",
        "read_only",
        "plan_only",
        "tests_executed",
        "network_used",
        "external_api_used",
        "mutations_performed",
        "source_mutations"
      ],
      "properties": {
        "local_first": {
          "const": true
        },
        "read_only": {
          "const": true
        },
        "plan_only": {
          "const": true
        },
        "tests_executed": {
          "const": false
        },
        "network_used": {
          "const": false
        },
        "external_api_used": {
          "const": false
        },
        "mutations_performed": {
          "const": false
        },
        "source_mutations": {
          "const": false
        },
        "reports_written": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true,
  "x-devpilot-schema-id": "SCHEMA-DEVPL-RELEASE-CANDIDATE-VERIFICATION-PROFILE-V1",
  "x-devpilot-sprint": "POST-H-026-B",
  "x-devpilot-status": "registered"
}
