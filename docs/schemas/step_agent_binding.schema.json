{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/step_agent_binding.schema.json",
  "title": "DevPilot GSDLC-07-A StepAgentBinding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "catalog_id",
    "catalog_version",
    "status",
    "owner",
    "updated",
    "mip_workflow_registry",
    "role_catalog",
    "bindings",
    "safety"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_id": {
      "const": "SCHEMA-DEVPL-GSDLC-07-A-STEP-AGENT-BINDING-V1"
    },
    "schema_version": {
      "const": "1.0"
    },
    "catalog_id": {
      "const": "devpl-gsdlc-07-a-step-agent-bindings"
    },
    "catalog_version": {
      "const": "1.0.0"
    },
    "status": {
      "const": "implemented-initial"
    },
    "owner": {
      "const": "DEVPL-GSDLC-07-A"
    },
    "updated": {
      "type": "string"
    },
    "mip_workflow_registry": {
      "type": "string"
    },
    "role_catalog": {
      "type": "string"
    },
    "bindings": {
      "type": "array",
      "minItems": 19,
      "maxItems": 19,
      "items": {
        "$ref": "#/$defs/binding"
      }
    },
    "safety": {
      "type": "object"
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "agent_role_id",
        "explicit_none",
        "allowed_artifacts",
        "required_model_capabilities",
        "fallback",
        "tool_allowlist",
        "rationale",
        "execution_mode",
        "human_review_required",
        "approval_authority",
        "policy_status"
      ],
      "properties": {
        "step_id": {
          "type": "string",
          "minLength": 1
        },
        "agent_role_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "explicit_none": {
          "type": "boolean"
        },
        "allowed_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "required_model_capabilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "fallback": {
          "type": "object"
        },
        "tool_allowlist": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "execution_mode": {
          "const": "descriptor-only/07-a"
        },
        "human_review_required": {
          "const": true
        },
        "approval_authority": {
          "const": "human-only"
        },
        "policy_status": {
          "type": "string"
        }
      }
    }
  }
}
