{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/SCHEMA-DEVPL-PLANNING-BACKLOG-V1",
  "title": "Planning Backlog Authoring Payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["backlog_id", "version", "epics", "stories", "dependencies"],
  "$defs": {
    "trace_link": {"type":"object","additionalProperties":false,"required":["kind","target_id"],"properties":{"kind":{"enum":["requirement","risk","adr","test-intent"]},"target_id":{"type":"string","minLength":1,"maxLength":256}}},
    "priority": {"type":"object","additionalProperties":false,"required":["level","value_score","risk_score","rationale","source"],"properties":{"level":{"enum":["P0","P1","P2","P3"]},"value_score":{"type":"integer","minimum":1,"maximum":5},"risk_score":{"type":"integer","minimum":1,"maximum":5},"rationale":{"type":"string","minLength":1,"maxLength":1000},"source":{"enum":["MANUAL","DERIVED","AGENT"]}}}
  },
  "properties": {
    "backlog_id": {"type":"string","pattern":"^planning-backlog-[a-z0-9-]{2,48}$"},
    "version": {"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},
    "epics": {"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","version","title","owner_role","milestone_id","trace_links","priority"],"properties":{"id":{"type":"string","pattern":"^epic-[a-z0-9-]{2,59}$"},"version":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},"title":{"type":"string","minLength":1,"maxLength":256},"owner_role":{"enum":["owner","product-owner","architect","developer","qa-reviewer"]},"milestone_id":{"type":"string","pattern":"^mil-[a-z0-9-]{2,59}$"},"trace_links":{"type":"array","items":{"$ref":"#/$defs/trace_link"}},"priority":{"$ref":"#/$defs/priority"}}}},
    "stories": {"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","version","title","owner_role","epic_id","acceptance_criteria","trace_links","priority"],"properties":{"id":{"type":"string","pattern":"^story-[a-z0-9-]{2,59}$"},"version":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},"title":{"type":"string","minLength":1,"maxLength":256},"owner_role":{"enum":["owner","product-owner","architect","developer","qa-reviewer"]},"epic_id":{"type":"string","pattern":"^epic-[a-z0-9-]{2,59}$"},"acceptance_criteria":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"trace_links":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/trace_link"}},"priority":{"$ref":"#/$defs/priority"}}}},
    "dependencies": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","predecessor_id","successor_id","kind","rationale"],"properties":{"id":{"type":"string","pattern":"^dep-[a-z0-9-]{2,59}$"},"predecessor_id":{"type":"string","minLength":1},"successor_id":{"type":"string","minLength":1},"kind":{"enum":["requires","blocks","sequences"]},"rationale":{"type":"string","minLength":1}}}}
  }
}
