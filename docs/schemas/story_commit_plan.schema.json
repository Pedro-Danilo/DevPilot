{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/story_commit_plan.schema.json",
  "title": "GSDLC-10-D Story CommitPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "workspace_id",
    "story_execution_id",
    "story_id",
    "source_change_plan_id",
    "source_change_plan_hash",
    "story_test_plan_id",
    "story_test_plan_hash",
    "story_quality_report_id",
    "story_quality_report_hash",
    "quality_inputs_hash",
    "branch",
    "head_before",
    "exact_paths",
    "include_paths",
    "exclude_paths",
    "files",
    "commit",
    "approval",
    "traceability",
    "safety",
    "commit_plan_id",
    "commit_plan_hash",
    "created_at_utc",
    "expires_at_utc"
  ],
  "properties": {
    "schema_id": {
      "const": "SCHEMA-DEVPL-GSDLC-10-D-STORY-COMMIT-PLAN-V1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "story_execution_id": {
      "type": "string",
      "minLength": 1
    },
    "story_id": {
      "type": "string",
      "minLength": 1
    },
    "source_change_plan_id": {
      "type": "string",
      "minLength": 1
    },
    "source_change_plan_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "story_test_plan_id": {
      "type": "string",
      "minLength": 1
    },
    "story_test_plan_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "story_quality_report_id": {
      "type": "string",
      "minLength": 1
    },
    "story_quality_report_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "quality_inputs_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "head_before": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "exact_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "include_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exclude_paths": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relative_path",
          "expected_state",
          "change_operation",
          "approved_content_sha256",
          "working_content_sha256"
        ],
        "properties": {
          "relative_path": {
            "type": "string",
            "minLength": 1
          },
          "expected_state": {
            "enum": [
              "present",
              "deleted"
            ]
          },
          "change_operation": {
            "type": "string",
            "minLength": 1
          },
          "approved_content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "working_content_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "commit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message",
        "author_name",
        "author_email",
        "message_editable_before_plan"
      ],
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "author_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "author_email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 254
        },
        "message_editable_before_plan": {
          "const": true
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "required_role",
        "stage_approval_required",
        "commit_approval_required",
        "stage_and_commit_separate",
        "authority_source",
        "agent_granted_authority",
        "model_route_granted_authority"
      ],
      "properties": {
        "required": {
          "const": true
        },
        "required_role": {
          "const": "owner"
        },
        "stage_approval_required": {
          "const": true
        },
        "commit_approval_required": {
          "const": true
        },
        "stage_and_commit_separate": {
          "const": true
        },
        "authority_source": {
          "const": "server-rbac-policy-approval"
        },
        "agent_granted_authority": {
          "const": false
        },
        "model_route_granted_authority": {
          "const": false
        }
      }
    },
    "traceability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_ids",
        "story_id",
        "story_execution_id",
        "source_change_plan_id",
        "source_change_plan_hash",
        "story_test_plan_id",
        "story_test_plan_hash",
        "story_quality_report_id",
        "story_quality_report_hash",
        "test_evidence_ids"
      ],
      "properties": {
        "requirement_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "story_id": {
          "type": "string",
          "minLength": 1
        },
        "story_execution_id": {
          "type": "string",
          "minLength": 1
        },
        "source_change_plan_id": {
          "type": "string",
          "minLength": 1
        },
        "source_change_plan_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "story_test_plan_id": {
          "type": "string",
          "minLength": 1
        },
        "story_test_plan_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "story_quality_report_id": {
          "type": "string",
          "minLength": 1
        },
        "story_quality_report_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "test_evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exact_staging_only",
        "git_add_all_enabled",
        "push_enabled",
        "force_push_enabled",
        "rebase_enabled",
        "reset_hard_enabled",
        "shell_enabled",
        "full_regression_started"
      ],
      "properties": {
        "exact_staging_only": {
          "const": true
        },
        "git_add_all_enabled": {
          "const": false
        },
        "push_enabled": {
          "const": false
        },
        "force_push_enabled": {
          "const": false
        },
        "rebase_enabled": {
          "const": false
        },
        "reset_hard_enabled": {
          "const": false
        },
        "shell_enabled": {
          "const": false
        },
        "full_regression_started": {
          "const": false
        }
      }
    },
    "commit_plan_id": {
      "type": "string",
      "pattern": "^story-commit-plan-[0-9a-f]{24}$"
    },
    "commit_plan_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "created_at_utc": {
      "type": "string",
      "minLength": 1
    },
    "expires_at_utc": {
      "type": "string",
      "minLength": 1
    }
  }
}
