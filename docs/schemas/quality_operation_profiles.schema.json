{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/uoc009-quality-operation-profiles-v1",
  "title": "UOC-009 Quality Operation Profiles",
  "type": "object",
  "required": [
    "schema_id",
    "operations",
    "safety"
  ],
  "properties": {
    "schema_id": {
      "const": "SCHEMA-DEVPL-UOC009-QUALITY-OPERATION-PROFILES-V1"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "operation_id",
          "capability_id",
          "kind",
          "requires_approval",
          "timeout_seconds",
          "allowed_keys"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1
          },
          "capability_id": {
            "type": "string",
            "pattern": "^cli\\."
          },
          "kind": {
            "type": "string"
          },
          "requires_approval": {
            "type": "boolean"
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10800
          },
          "allowed_keys": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": true
      }
    },
    "safety": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
