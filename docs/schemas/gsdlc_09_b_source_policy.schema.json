{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/gsdlc_09_b_source_policy.schema.json",
  "title": "GSDLC-09-B Source Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id","schema_version","policy_id","status","allowed_extensions","denied_directory_names","denied_file_prefixes","maximum_inline_bytes","maximum_discovery_files","maximum_discovery_depth","allow_create","allow_edit","allow_rename","apply_enabled","shell_enabled","symlink_following","network_used","external_api_used"],
  "properties": {
    "schema_id": {"const": "SCHEMA-DEVPL-GSDLC-09-B-SOURCE-POLICY-V1"},
    "schema_version": {"const": "1.0.0"},
    "policy_id": {"const": "DEVPL-GSDLC-09-B-SOURCE-POLICY"},
    "status": {"const": "current-active"},
    "allowed_extensions": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^\\.[a-z0-9]+$"}},
    "denied_directory_names": {"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "denied_file_prefixes": {"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "maximum_inline_bytes": {"type":"integer","minimum":1024,"maximum":1048576},
    "maximum_discovery_files": {"type":"integer","minimum":1,"maximum":10000},
    "maximum_discovery_depth": {"type":"integer","minimum":1,"maximum":32},
    "allow_create": {"const": true}, "allow_edit": {"const": true}, "allow_rename": {"const": true},
    "apply_enabled": {"const": false}, "shell_enabled": {"const": false}, "symlink_following": {"const": false},
    "network_used": {"const": false}, "external_api_used": {"const": false}
  }
}
