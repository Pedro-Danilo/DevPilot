{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SCHEMA-DEVPL-GSDLC-05-B-MIP-WORKFLOW-REGISTRY-V1",
  "title": "GSDLC-05-B MIPWorkflowRegistry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_id",
    "schema_version",
    "registry_id",
    "registry_version",
    "status",
    "source_standard",
    "predecessor_registry",
    "generic_transition_catalog",
    "scope",
    "weight_policy",
    "waiver_policy",
    "phases",
    "safety"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_id": {
      "const": "SCHEMA-DEVPL-GSDLC-05-B-MIP-WORKFLOW-REGISTRY-V1"
    },
    "schema_version": {
      "const": "1.0"
    },
    "registry_id": {
      "const": "DEVPL-GSDLC-05-B-MIP-WORKFLOW-REGISTRY"
    },
    "registry_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "enum": [
        "implemented-initial/pending-owner-approval",
        "approved",
        "deprecated"
      ]
    },
    "source_standard": {
      "$ref": "#/$defs/sourceStandard"
    },
    "predecessor_registry": {
      "type": "object"
    },
    "generic_transition_catalog": {
      "type": "object"
    },
    "scope": {
      "type": "object"
    },
    "weight_policy": {
      "type": "object"
    },
    "waiver_policy": {
      "type": "object"
    },
    "phases": {
      "type": "array",
      "minItems": 19,
      "maxItems": 19,
      "items": {
        "$ref": "#/$defs/phase"
      }
    },
    "safety": {
      "type": "object"
    }
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "doc_id",
        "path",
        "heading",
        "source_sha256"
      ],
      "properties": {
        "doc_id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "heading": {
          "type": "string"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "sourceStandard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "doc_id",
        "path",
        "source_sha256",
        "lifecycle_heading",
        "artifact_matrix_heading",
        "gate_matrix_heading",
        "source_hash_policy"
      ],
      "properties": {
        "doc_id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "lifecycle_heading": {
          "type": "string"
        },
        "artifact_matrix_heading": {
          "type": "string"
        },
        "gate_matrix_heading": {
          "type": "string"
        },
        "source_hash_policy": {
          "const": "canonical-lf-utf8"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "label",
        "filename",
        "profile_id",
        "validator_ids",
        "accepted_statuses"
      ],
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "filename": {
          "type": [
            "string",
            "null"
          ]
        },
        "profile_id": {
          "type": "string"
        },
        "validator_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "accepted_statuses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "APPROVED",
              "FROZEN"
            ]
          }
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "accepted_statuses",
        "waiver_allowed",
        "blocker_text",
        "pass_text"
      ],
      "properties": {
        "gate_id": {
          "type": "string"
        },
        "accepted_statuses": {
          "type": "array",
          "items": {
            "enum": [
              "PASS",
              "WARN"
            ]
          }
        },
        "waiver_allowed": {
          "type": "boolean"
        },
        "blocker_text": {
          "type": "string"
        },
        "pass_text": {
          "type": "string"
        }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase_id",
        "ordinal",
        "phase",
        "current_step",
        "label",
        "mandatory",
        "weight_bps",
        "source_refs",
        "required_prerequisites",
        "required_artifacts",
        "exit_gate",
        "next_phase",
        "transition_id",
        "terminal_in_registry"
      ],
      "properties": {
        "phase_id": {
          "type": "string"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18
        },
        "phase": {
          "type": "string"
        },
        "current_step": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "mandatory": {
          "const": true
        },
        "weight_bps": {
          "type": "integer",
          "minimum": 1
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "required_prerequisites": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "exit_gate": {
          "$ref": "#/$defs/gate"
        },
        "transition_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "terminal_in_registry": {
          "type": "boolean"
        },
        "next_phase": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
