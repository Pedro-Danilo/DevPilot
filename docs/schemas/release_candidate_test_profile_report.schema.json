{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/release_candidate_test_profile_report.schema.json",
  "title": "DevPilot ReleaseCandidateTestProfileReport v1",
  "description": "Schema-backed POST-H-029-D report for the formal local release-candidate test profile. The profile is local-first, advisory/plan-only and never executes tests from JSON.",
  "type": "object",
  "required": [
    "schema_version",
    "schema_id",
    "report_id",
    "created_by",
    "status",
    "generated_at_utc",
    "summary",
    "profile",
    "required_commands",
    "recommended_commands",
    "optional_commands",
    "pytest_targets",
    "full_regression_required_when",
    "prerequisites",
    "tcr_v2",
    "taxonomy",
    "tests_run_profile",
    "safety",
    "findings",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "schema_id": {"const": "SCHEMA-DEVPL-RELEASE-CANDIDATE-TEST-PROFILE-REPORT-V1"},
    "report_id": {"const": "devpilot-release-candidate-test-profile-report"},
    "created_by": {"const": "POST-H-029-D"},
    "status": {"enum": ["pass", "blocked"]},
    "generated_at_utc": {"type": "string", "minLength": 10},
    "summary": {
      "type": "object",
      "required": [
        "created_by",
        "status",
        "decision",
        "profile_id",
        "required_commands_total",
        "required_commands_present_total",
        "recommended_commands_total",
        "optional_commands_total",
        "pytest_targets_total",
        "missing_required_commands_total",
        "missing_pytest_targets_total",
        "unsafe_commands_total",
        "required_sections_present",
        "full_regression_rules_total",
        "tcr_v2_contracts_selected_total",
        "tests_run_profile_synced",
        "taxonomy_profile_synced",
        "tests_executed",
        "dry_run",
        "network_used",
        "external_api_used",
        "mutations_performed",
        "source_mutations_performed",
        "reports_written",
        "preliminary"
      ],
      "properties": {
        "created_by": {"const": "POST-H-029-D"},
        "status": {"const": "implemented-initial"},
        "decision": {"enum": ["PASS", "BLOCK"]},
        "profile_id": {"const": "release-candidate-local"},
        "required_commands_total": {"type": "integer", "minimum": 1},
        "required_commands_present_total": {"type": "integer", "minimum": 0},
        "recommended_commands_total": {"type": "integer", "minimum": 0},
        "optional_commands_total": {"type": "integer", "minimum": 0},
        "pytest_targets_total": {"type": "integer", "minimum": 1},
        "missing_required_commands_total": {"type": "integer", "minimum": 0},
        "missing_pytest_targets_total": {"type": "integer", "minimum": 0},
        "unsafe_commands_total": {"type": "integer", "minimum": 0},
        "required_sections_present": {"type": "boolean"},
        "full_regression_rules_total": {"type": "integer", "minimum": 1},
        "tcr_v2_contracts_selected_total": {"type": "integer", "minimum": 0},
        "tests_run_profile_synced": {"type": "boolean"},
        "taxonomy_profile_synced": {"type": "boolean"},
        "tests_executed": {"const": false},
        "dry_run": {"const": true},
        "network_used": {"const": false},
        "external_api_used": {"const": false},
        "mutations_performed": {"const": false},
        "source_mutations_performed": {"const": false},
        "reports_written": {"type": "boolean"},
        "preliminary": {"const": true}
      },
      "additionalProperties": true
    },
    "profile": {"type": "object"},
    "required_commands": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/command_entry"}},
    "recommended_commands": {"type": "array", "items": {"$ref": "#/$defs/command_entry"}},
    "optional_commands": {"type": "array", "items": {"$ref": "#/$defs/command_entry"}},
    "pytest_targets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pytest_target"}},
    "full_regression_required_when": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "prerequisites": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "tcr_v2": {"type": "object", "additionalProperties": true},
    "taxonomy": {"type": "object", "additionalProperties": true},
    "tests_run_profile": {"type": "object", "additionalProperties": true},
    "safety": {
      "type": "object",
      "required": [
        "local_first",
        "read_only",
        "dry_run",
        "tests_executed",
        "network_used",
        "external_api_used",
        "remote_execution_enabled",
        "connector_write_enabled",
        "plugin_execution_enabled",
        "mutations_performed",
        "source_mutations_performed",
        "llm_judge_used"
      ],
      "properties": {
        "local_first": {"const": true},
        "read_only": {"const": true},
        "dry_run": {"const": true},
        "tests_executed": {"const": false},
        "network_used": {"const": false},
        "external_api_used": {"const": false},
        "remote_execution_enabled": {"const": false},
        "connector_write_enabled": {"const": false},
        "plugin_execution_enabled": {"const": false},
        "mutations_performed": {"const": false},
        "source_mutations_performed": {"const": false},
        "llm_judge_used": {"const": false}
      },
      "additionalProperties": true
    },
    "findings": {"type": "array", "items": {"type": "object"}},
    "notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "command_entry": {
      "type": "object",
      "required": ["id", "command", "category", "required", "write_report", "read_only", "approval_required_for_execution"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "command": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "write_report": {"type": "boolean"},
        "read_only": {"const": true},
        "approval_required_for_execution": {"type": "boolean"},
        "description": {"type": "string"}
      },
      "additionalProperties": true
    },
    "pytest_target": {
      "type": "object",
      "required": ["path", "domain", "criticality", "required"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "domain": {"type": "string", "minLength": 1},
        "criticality": {"enum": ["P0", "P1", "P2", "P3"]},
        "required": {"type": "boolean"},
        "reason": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
