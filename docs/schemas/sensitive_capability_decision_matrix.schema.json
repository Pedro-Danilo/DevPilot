{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.local/schemas/sensitive_capability_decision_matrix.schema.json",
  "title": "DevPilot SensitiveCapabilityDecisionMatrix v1",
  "description": "POST-H-034 matrix for sensitive capability ADR states and no-go runtime flags. Introduced by POST-H-034-A and extended by POST-H-034-B for plugin.execution.",
  "type": "object",
  "required": [
    "schema_version",
    "schema_id",
    "matrix_id",
    "created_by",
    "status",
    "catalog_version",
    "capabilities",
    "global_no_go_gates",
    "safety",
    "summary",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "schema_id": {
      "const": "SCHEMA-DEVPL-SENSITIVE-CAPABILITY-DECISION-MATRIX-V1"
    },
    "matrix_id": {
      "const": "SENSITIVE-CAPABILITY-DECISION-MATRIX-V1"
    },
    "created_by": {
      "enum": [
        "POST-H-034-A",
        "POST-H-034-B"
      ]
    },
    "status": {
      "enum": [
        "implemented-initial",
        "approved"
      ]
    },
    "catalog_version": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "capability_id",
          "decision_state",
          "runtime_enabled",
          "requires_future_adr"
        ],
        "properties": {
          "capability_id": {
            "enum": [
              "connector.write",
              "plugin.execution",
              "remote.execution",
              "multiuser.auth",
              "enterprise.saas"
            ]
          },
          "decision_state": {
            "enum": [
              "continue-blocked",
              "design-only",
              "pilot-gated-future",
              "approved-for-future-implementation",
              "rejected",
              "out-of-scope",
              "pending-adr"
            ]
          },
          "runtime_enabled": {
            "const": false
          },
          "requires_future_adr": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "global_no_go_gates": {
      "type": "object",
      "required": [
        "connector_write_enabled",
        "plugin_execution_enabled",
        "remote_execution_enabled",
        "production_multiuser",
        "enterprise_ready",
        "saas_ready",
        "compliance_certified"
      ],
      "properties": {
        "connector_write_enabled": {
          "const": false
        },
        "plugin_execution_enabled": {
          "const": false
        },
        "remote_execution_enabled": {
          "const": false
        },
        "production_multiuser": {
          "const": false
        },
        "enterprise_ready": {
          "const": false
        },
        "saas_ready": {
          "const": false
        },
        "compliance_certified": {
          "const": false
        }
      },
      "additionalProperties": true
    },
    "safety": {
      "type": "object",
      "required": [
        "local_first",
        "network_used",
        "external_api_used",
        "source_mutations_performed",
        "credentials_versioned"
      ],
      "properties": {
        "local_first": {
          "const": true
        },
        "network_used": {
          "const": false
        },
        "external_api_used": {
          "const": false
        },
        "source_mutations_performed": {
          "const": false
        },
        "credentials_versioned": {
          "const": false
        }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "additionalProperties": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true,
  "x-devpilot-schema-id": "SCHEMA-DEVPL-SENSITIVE-CAPABILITY-DECISION-MATRIX-V1",
  "x-devpilot-sprint": "POST-H-034-A",
  "x-devpilot-status": "registered"
}
