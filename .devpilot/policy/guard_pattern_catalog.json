          "rule_id": "TOOL_INJECTION_TARGET_OVERRIDE",
          "severity": "block",
          "pattern": "(?i)\\b(change|override|replace|redirect)\\b.{0,64}\\b(target|workspace|tool_id|tool call|destination)\\b",
