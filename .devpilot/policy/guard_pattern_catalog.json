  "guards": {
    "prompt_injection": {
      "module": "src/devpilot_core/policy/prompt_guard.py",
      "guard_class": "PromptInjectionGuard",
      "built_in_mandatory_pattern_ids": [
        "PROMPT_INJECTION_INSTRUCTION_OVERRIDE",
        "PROMPT_INJECTION_POLICY_BYPASS",
        "PROMPT_INJECTION_SECRET_EXFILTRATION",
        "PROMPT_INJECTION_ROLE_HIJACK",
        "PROMPT_INJECTION_HIDDEN_INSTRUCTION"
      ],
      "local_extensions_allowed": true,
      "patterns": [
        {
          "guard": "PromptInjectionGuard",
          "category": "instruction_override",
          "rule_id": "PROMPT_INJECTION_INSTRUCTION_OVERRIDE",
          "severity": "block",
          "pattern": "(?i)\\b(ignore|disregard|forget|override)\\b.{0,48}\\b(previous|prior|system|developer|policy|instruction|instructions|rules?)\\b",
          "source": "built-in-mandatory",
          "enabled": true,
          "critical": true,
          "built_in_mandatory": true,
          "cannot_disable_without_adr": true,
          "payload_redacted": true,
          "tests": [
            "tests/test_post_h_033_policy_guard_pattern_catalogs.py",
            "tests/test_prompt_injection_guard.py"
          ]
        },
        {
          "guard": "PromptInjectionGuard",
          "category": "policy_bypass",
          "rule_id": "PROMPT_INJECTION_POLICY_BYPASS",
          "severity": "block",
          "pattern": "(?i)\\b(bypass|disable|turn\\s*off|circumvent|skip)\\b.{0,48}\\b(policy|guard|approval|approval_id|safety|security|validation|validator)\\b",
          "source": "built-in-mandatory",
          "enabled": true,
          "critical": true,
          "built_in_mandatory": true,
          "cannot_disable_without_adr": true,
          "payload_redacted": true,
          "tests": [
            "tests/test_post_h_033_policy_guard_pattern_catalogs.py",
            "tests/test_prompt_injection_guard.py"
          ]
        },
        {
          "guard": "PromptInjectionGuard",
          "category": "secret_exfiltration",
          "rule_id": "PROMPT_INJECTION_SECRET_EXFILTRATION",
          "severity": "block",
          "pattern": "(?i)\\b(print|show|reveal|dump|exfiltrate|leak|send)\\b.{0,48}\\b(secret|secrets|token|tokens|api[_ -]?key|password|credentials?|\\.env|env vars?)\\b",
          "source": "built-in-mandatory",
          "enabled": true,
          "critical": true,
          "built_in_mandatory": true,
          "cannot_disable_without_adr": true,
          "payload_redacted": true,
          "tests": [
            "tests/test_post_h_033_policy_guard_pattern_catalogs.py",
            "tests/test_prompt_injection_guard.py"
          ]
        },
        {
          "guard": "PromptInjectionGuard",
          "category": "role_hijack",
          "rule_id": "PROMPT_INJECTION_ROLE_HIJACK",
          "severity": "warn",
          "pattern": "(?i)\\b(you\\s+are\\s+now|act\\s+as|pretend\\s+to\\s+be)\\b.{0,48}\\b(root|admin|developer|system|security auditor|owner)\\b",
          "source": "built-in-mandatory",
          "enabled": true,
          "critical": false,
          "built_in_mandatory": true,
          "cannot_disable_without_adr": true,
          "payload_redacted": true,
          "tests": [
            "tests/test_post_h_033_policy_guard_pattern_catalogs.py",
            "tests/test_prompt_injection_guard.py"
          ]
        },
        {
          "guard": "PromptInjectionGuard",
          "category": "hidden_instruction",
          "rule_id": "PROMPT_INJECTION_HIDDEN_INSTRUCTION",
          "severity": "warn",
          "pattern": "(?i)\\b(hidden|invisible|secret)\\b.{0,48}\\b(instruction|prompt|message|command)\\b",
          "source": "built-in-mandatory",
          "enabled": true,
          "critical": false,
          "built_in_mandatory": true,
          "cannot_disable_without_adr": true,
          "payload_redacted": true,
          "tests": [
            "tests/test_post_h_033_policy_guard_pattern_catalogs.py",
            "tests/test_prompt_injection_guard.py"
          ]
        },
        {
          "guard": "PromptInjectionGuard",
          "category": "data_exfiltration_instruction",
          "rule_id": "PROMPT_INJECTION_DATA_EXFILTRATION_REQUEST",
          "severity": "block",
          "pattern": "(?i)\\b(copy|extract|export|upload)\\b.{0,64}\\b(private|internal|confidential|workspace|repository)\\b.{0,64}\\b(data|files|prompts|logs|traces)\\b",
          "source": "local-extension",
          "enabled": true,
          "critical": false,
          "built_in_mandatory": false,
          "cannot_disable_without_adr": false,
          "payload_redacted": true,
          "tests": [
            "tests/test_post_h_033_policy_guard_pattern_catalogs.py"
          ]
        }
      ]
    },
