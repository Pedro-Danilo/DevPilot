  "state_domains": [
    {
      "name": "PlatformState",
      "owner": "DevPilot platform governance",
      "status": "implemented-current+successor-contract",
      "persistence": "DevPilot repository .devpilot/project_state.json for platform development state",
      "contains": [
        "platform baseline",
        "program/micro-sprint governance",
        "platform capabilities"
      ],
      "must_not_contain": [
        "managed-project workflow sessions",
        "managed-project approvals",
        "managed-project agent runs"
      ]
    },
    {
      "name": "WorkspaceEngineeringState",
      "owner": "GuidedSDLCService/WorkflowEngine",
      "status": "implemented-current/DEVPL-GSDLC-01-A",
      "persistence": "local workspace engineering store keyed by workspace_id; reconstructible from workspace metadata, source artifacts and Git",
      "contains": [
        "phase",
        "step",
        "artifact lifecycle",
        "planning lifecycle",
        "quality gates",
        "next action",
        "source fingerprints"
      ],
      "must_not_contain": [
        "credentials",
        "session tokens",
        "ephemeral job logs"
      ],
      "reconciliation": "on open/resume compare Git HEAD/branch/status and governed artifact hashes; external drift marks affected items REVALIDATION_REQUIRED before transition",
      "implementation_status": "implemented-initial/DEVPL-GSDLC-01-A",
      "schema_contract": "docs/schemas/workspace_engineering_state.schema.json",
      "persistence_contract": "outputs/workspaces/<workspace_id>/engineering_state.json",
      "persistence_source_controlled": false,
      "optimistic_concurrency": "sequence/exact-successor",
      "migration_contract": "docs/02_architecture/guided_sdlc/workspace_engineering_state_migration_contract.md"
    },
    {
      "name": "RuntimeOperationalState",
      "owner": "runtime services",
      "status": "implemented-current+planned-GSDLC-extension",
      "persistence": "local SQLite/JSONL/runtime stores outside versioned project source",
      "contains": [
        "authenticated sessions when enabled",
        "jobs",
        "approvals",
        "locks",
        "agent runs",
        "retries",
        "correlation ids"
      ],
      "must_not_contain": [
        "canonical product requirements",
        "canonical source documents as sole copy"
      ]
    }
  ],
