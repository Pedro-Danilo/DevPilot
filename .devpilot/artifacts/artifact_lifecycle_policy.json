  "path_policy": {
    "allowed_extensions": [
      ".md",
      ".json"
    ],
    "max_source_bytes": 1048576,
    "filename_pattern": "^[A-Za-z0-9][A-Za-z0-9._ -]{0,127}$",
    "deny_absolute": true,
    "deny_parent_traversal": true,
    "deny_symlink": true,
    "secret_bearing_auto_version": false
  },
  "agent_assisted_execution_enabled": false,
  "server_authoritative": true,
  "notes": [
    "ArtifactProfileRegistry remains the authority for Markdown profile selection; this policy references profile ids only.",
    "AGENT_ASSISTED is provenance-only in GSDLC-04-A; real agentic execution remains deferred to GSDLC-07.",
    "UOC-004 planning and UOC-005 approval/apply remain the only existing governed document write predecessors; GSDLC-04-A performs no workspace source writes.",
    "Upload/path limits are contractual now; upload execution is implemented in GSDLC-04-C."
