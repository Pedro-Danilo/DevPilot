    {
      "chunk_id": "ragchunk_2686dcbe835e5976",
      "source": {
        "path": "docs/functional_sprint_84_manifest.json",
        "line_start": 71,
        "line_end": 105,
        "title": "{"
      },
      "fragment": "],\n  \"pass_criteria\": [\n    \"ReleaseAgent runs in dry-run through AgentRuntime.\",\n    \"ReleaseAgent is registered in MIASI with implemented-initial status.\",\n    \"ReleaseAgent produces release checklist and recommendations.\",\n    \"Tool calls are auditable and policy-gated.\",\n    \"quality-gate release profile returns PASS.\",\n    \"Fase G closure report summarizes sprints 74 through 84.\",\n    \"No publish, deploy, signing or Git tagging is performed.\"\n  ],\n  \"block_criteria\": [\n    \"Do not close if ReleaseAgent publishes, deploys, signs or tags Git.\",\n    \"Do not close if ReleaseAgent bypasses MIASI or PolicyEngine.\",\n    \"Do not close if recommendations are not evidence-based.\",\n    \"Do not close if closure report is missing.\"\n  ],\n  \"risks\": [\n    {\n      \"id\": \"RISK-FUNC-84-001\",\n      \"risk\": \"Agent with excessive release authority\",\n      \"mitigation\": \"Dry-run only, no execute path, policy-gated tool calls.\"\n    },\n    {\n      \"id\": \"RISK-FUNC-84-002\",\n      \"risk\": \"Recommendations without evidence\",\n      \"mitigation\": \"Use local gates/builders and explicit checklist.\"\n    },\n    {\n      \"id\": \"RISK-FUNC-84-003\",\n      \"risk\": \"Confusing release readiness with deployment\",\n      \"mitigation\": \"Deploy/publish/tag/sign remain out of scope and documented as BLOCK.\"\n    }\n  ],\n  \"next_sprint\": \"FUNC-SPRINT-85 — ADR de arquitectura avanzada agentic/enterprise\"\n}",
      "tokens": {
