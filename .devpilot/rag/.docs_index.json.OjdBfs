        "title": "{"
      },
      "fragment": "{\n  \"sprint\": \"FUNC-SPRINT-33\",\n  \"title\": \"Hardening de SecretGuard y checks básicos de prompt/tool injection\",\n  \"status\": \"implemented\",\n  \"implemented_at\": \"2026-06-11\",\n  \"phase\": \"FASE-B-SEGURIDAD-OPERACIONAL\",\n  \"wave\": \"Ola 3 — Seguridad operacional, aprobación humana y ejecución controlada\",\n  \"source_backlog\": \"docs/devpilot_backlog_fase_B_seguridad_operacional.md\",\n  \"architectural_decision\": {\n    \"required\": false,\n    \"adr\": null,\n    \"reason\": \"FUNC-SPRINT-33 amplía guards internos existentes y agrega módulos dependency-free de detección pattern-based. No introduce dependencias externas, red, APIs, UI, backend, sandbox nuevo ni ejecución destructiva. Es una evolución interna del PolicyEngine y de la seguridad textual local.\"\n  },\n  \"created_files\": [\n    \"src/devpilot_core/policy/prompt_guard.py\",\n    \"src/devpilot_core/policy/tool_injection_guard.py\",\n    \"tests/test_prompt_injection_guard.py\",\n    \"tests/test_secret_guard_hardening.py\",\n    \"docs/audits/func_sprint_33_security_hardening_audit.md\",\n    \"docs/functional_sprint_33_manifest.json\",\n    \"tests/test_sprint_33_documentation.py\"\n  ],\n  \"modified_files\": [\n    \"README.md\",\n    \"docs/05_operations/runbook.md\",\n    \"docs/devpilot_backlog_fase_B_seguridad_operacional.md\",\n    \"docs/functional_backlog_after_precode.md\",\n    \"docs/03_security/security_threat_model.md\",\n    \"docs/06_miasi/policy_card.md\",\n    \"docs/06_miasi/tool_card.md\",\n    \"src/devpilot_core/policy/__init__.py\",\n    \"src/devpilot_core/policy/secrets.py\",\n    \"src/devpilot_core/policy/engine.py\",\n    \"src/devpilot_core/modeling/router.py\",\n    \"tests/test_sprint_28_documentation.py\",\n    \"tests/test_sprint_29_documentation.py\",\n    \"tests/test_sprint_30_documentation.py\",\n    \"tests/test_sprint_31_documentation.py\",\n    \"tests/test_sprint_32_documentation.py\"\n  ],",
