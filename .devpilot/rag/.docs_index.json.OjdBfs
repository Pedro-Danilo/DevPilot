      "fragment": "\"python -m devpilot_core validate all --json\",\n    \"python -m pytest -q\"\n  ],\n  \"tests\": [\n    \"tests/test_trace_context.py\",\n    \"tests/test_sprint_57_documentation.py\",\n    \"tests/test_event_logger.py\",\n    \"schema validate-manifest\",\n    \"validate all\",\n    \"pytest -q\"\n  ],\n  \"pass_criteria\": [\n    \"TraceContext serializa trace_id, run_id, timestamps y metadata redacted.\",\n    \"SpanRecord serializa span_id, parent_span_id, status, duration_ms, payload, metadata y findings.\",\n    \"Los spans soportan relación parent-child.\",\n    \"sanitize_span_payload redactoriza secretos y payloads raw sensibles.\",\n    \"Los ids son prefijados y permiten inyección de factory para pruebas.\",\n    \"EventLogger v1 mantiene compatibilidad.\",\n    \"No se agregan dependencias externas ni exporters activos.\"\n  ],\n  \"block_criteria\": [\n    \"SpanRecord guarda prompts, completions, diffs, patches, stdout/stderr o secretos crudos.\",\n    \"Se rompe EventLogger actual.\",\n    \"Se agrega OpenTelemetry SDK obligatorio.\",\n    \"Se implementa persistencia o CLI de trazas fuera del alcance de Sprint 57.\",\n    \"Se habilita telemetría remota, multiagente, handoffs, RAG, MCP o ejecución remota.\"\n  ],\n  \"risks\": [\n    {\n      \"id\": \"RISK-FUNC-57-001\",\n      \"risk\": \"Incompatibilidad con EventLogger v1\",\n      \"mitigation\": \"Implementar tracing.py como contrato independiente y verificar tests de EventLogger.\"\n    },\n    {\n      \"id\": \"RISK-FUNC-57-002\",\n      \"risk\": \"Exceso de metadatos o payloads sensibles\",\n      \"mitigation\": \"Redacción conservadora por claves y SecretGuard antes de serializar.\"\n    },\n    {\n      \"id\": \"RISK-FUNC-57-003\",",
