      "fragment": "\"Plugin Registry validates structurally and semantically.\",\n    \"Plugin loader dry-run emits trace evidence without loading arbitrary code.\",\n    \"Plugins remain deny-by-default with policy, permissions, owner, version and risk level.\",\n    \"No network, external API, shell, remote execution or source mutation is enabled.\"\n  ],\n  \"block_criteria\": [\n    \"Plugin execution or importable entrypoints are enabled.\",\n    \"Plugin permissions lack MIASI policy bindings.\",\n    \"Plugin references unknown connectors.\",\n    \"Quality gate does not consume plugin ecosystem evals.\"\n  ],\n  \"risks\": [\n    \"Implemented-initial only; no real plugin runtime or sandbox execution.\",\n    \"Registry changes must be reviewed as code because permissions affect future extensibility.\",\n    \"No plugin signing, dependency isolation or marketplace governance yet.\"\n  ],\n  \"network_used\": false,\n  \"external_api_used\": false,\n  \"mutations_performed\": false,\n  \"preliminary\": true,\n  \"sprint\": \"FUNC-SPRINT-93\",\n  \"phase\": \"FASE-H-CAPACIDADES-AVANZADAS\",\n  \"source_backlog\": \"docs/devpilot_backlog_fase_H_capacidades_avanzadas.md\",\n  \"audit_report\": \"docs/audits/func_sprint_93_plugin_ecosystem_audit.md\"\n}",
