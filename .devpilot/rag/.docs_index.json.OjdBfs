      "fragment": "{\n  \"sprint\": \"FUNC-SPRINT-31\",\n  \"title\": \"SafeSubprocessRunner y allowlist de ejecución controlada\",\n  \"status\": \"implemented\",\n  \"implemented_at\": \"2026-06-11\",\n  \"phase\": \"FASE-B-SEGURIDAD-OPERACIONAL\",\n  \"wave\": \"Ola 3 — Seguridad operacional, aprobación humana y ejecución controlada\",\n  \"source_backlog\": \"docs/devpilot_backlog_fase_B_seguridad_operacional.md\",\n  \"architectural_decision\": {\n    \"required\": false,\n    \"adr\": null,\n    \"reason\": \"FUNC-SPRINT-31 extends the existing local-first policy/guard architecture with an internal controlled-execution boundary. It adds no external dependencies, no network/API usage, no new storage backend, no UI and no destructive operations. It is a constrained implementation step required before tests.run.\"\n  },\n  \"created_files\": [\n    \"src/devpilot_core/execution/__init__.py\",\n    \"src/devpilot_core/execution/allowlist.py\",\n    \"src/devpilot_core/execution/models.py\",\n    \"src/devpilot_core/execution/safe_subprocess.py\",\n    \".devpilot/execution/command_allowlist.json\",\n    \"tests/test_safe_subprocess_runner.py\",\n    \"tests/test_sprint_31_documentation.py\",\n    \"docs/audits/func_sprint_31_safe_subprocess_runner_audit.md\",\n    \"docs/functional_sprint_31_manifest.json\"\n  ],\n  \"modified_files\": [\n    \"README.md\",\n    \"docs/05_operations/runbook.md\",\n    \"docs/devpilot_backlog_fase_B_seguridad_operacional.md\",\n    \"docs/functional_backlog_after_precode.md\",\n    \"tests/test_sprint_30_documentation.py\"\n  ],\n  \"commands\": [\n    \"python -m pytest tests/test_safe_subprocess_runner.py -q\",\n    \"python -m pytest tests/test_sprint_31_documentation.py -q\",\n    \"python -m devpilot_core schema validate-manifest docs/functional_sprint_31_manifest.json --json\",\n    \"python -m devpilot_core validate-frontmatter docs/audits/func_sprint_31_safe_subprocess_runner_audit.md --strict --json\",\n    \"python -m devpilot_core validate-artifact docs/audits/func_sprint_31_safe_subprocess_runner_audit.md --strict --json\",\n    \"python -m pytest -q\"\n  ],\n  \"tests\": [",
