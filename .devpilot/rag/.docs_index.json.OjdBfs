        "title": "{"
      },
      "fragment": "\"python -m devpilot_core miasi validate --json\",\n    \"python -m devpilot_core schema validate-manifest docs/functional_sprint_30_manifest.json --json\",\n    \"python -m pytest tests/test_approval_policy_binding.py -q\",\n    \"python -m pytest -q\"\n  ],\n  \"tests\": [\n    \"tests/test_approval_policy_binding.py\",\n    \"tests/test_sprint_30_documentation.py\",\n    \"tests/test_policy_engine.py\"\n  ],\n  \"pass_criteria\": [\n    \"Approval-gated action without approval_id produces BLOCK.\",\n    \"Expired approval produces BLOCK.\",\n    \"Wrong tool/action/subject scope produces BLOCK.\",\n    \"Valid approval only enables the declared scope.\",\n    \"MIASI Policy Matrix references ApprovalPolicyChecker for approval-gated rules.\",\n    \"policy simulate returns CommandResult and optional reports.\",\n    \"pytest -q passes.\"\n  ],\n  \"block_criteria\": [\n    \"Approval works as a global bypass.\",\n    \"A tests.run approval enables patch apply, deploy or Git write.\",\n    \"PolicyEngine ignores expiration.\",\n    \"MIASI registries become unsynchronized.\",\n    \"The sprint executes tools or commands instead of simulating policy.\"\n  ],\n  \"risks\": [\n    \"Actor remains local/declarative; authentication and RBAC remain future work.\",\n    \"Policy simulation does not execute tools; SafeSubprocessRunner remains future work.\",\n    \"Scope matching is deterministic and explicit; semantic scope inference is intentionally not implemented.\",\n    \"tests.run remains planned until FUNC-SPRINT-32.\"\n  ],\n  \"preliminary\": true,\n  \"next_sprint\": \"FUNC-SPRINT-31 — SafeSubprocessRunner y allowlist de ejecución controlada\"\n}",
