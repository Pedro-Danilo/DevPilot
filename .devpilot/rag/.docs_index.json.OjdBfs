      "chunk_id": "ragchunk_c9b37fa51dfa45c4",
      "source": {
        "path": "docs/post_h_010_d_manifest.json",
        "line_start": 36,
        "line_end": 75,
        "title": "{"
      },
      "fragment": "\"commands\": [\n    \"python -m pytest tests/test_observability_export.py tests/test_observability_cleanup_plan.py tests/test_observability_inventory.py tests/test_post_h_010_observability_retention.py tests/test_observability_retention_schema.py tests/test_schema_registry.py tests/test_project_global_state.py -q\",\n    \"python -m devpilot_core observability export --redacted --json --write-report\",\n    \"python -m devpilot_core schema validate --schema-id ObservabilityRedactedExport --instance outputs/reports/observability_redacted_export.json --json\",\n    \"python -m devpilot_core schema validate --schema-id PostHManifest --instance docs/post_h_010_d_manifest.json --json\",\n    \"python -m devpilot_core docs-governance validate --json\",\n    \"python -m devpilot_core test-contracts validate --json\",\n    \"python -m devpilot_core test-contracts validate-v2 --json\"\n  ],\n  \"tests\": [\n    \"tests/test_observability_export.py\",\n    \"tests/test_observability_cleanup_plan.py\",\n    \"tests/test_observability_inventory.py\",\n    \"tests/test_post_h_010_observability_retention.py\",\n    \"tests/test_observability_retention_schema.py\",\n    \"tests/test_schema_registry.py\",\n    \"tests/test_project_global_state.py\"\n  ],\n  \"pass_criteria\": [\n    \"Export requiere --redacted y aplica redaction_applied=true.\",\n    \"El export no contiene raw prompts, raw outputs, secretos, .env ni bytes SQLite crudos.\",\n    \"El reporte ObservabilityRedactedExport valida contra schema.\",\n    \"El comando permanece local-first sin red, API externa ni export remoto.\",\n    \"Los outputs se generan solo bajo outputs/reports y outputs/audit_exports.\"\n  ],\n  \"block_criteria\": [\n    \"Bloquear si se permite export no redactado.\",\n    \"Bloquear si aparecen API keys, tokens, passwords o valores .env en el export.\",\n    \"Bloquear si se exportan bytes crudos de .devpilot/devpilot.db o payloads crudos de agent_sessions.\",\n    \"Bloquear si network_used, external_api_used, remote_export_enabled o source_mutations_performed son true.\",\n    \"Bloquear si el export falla silenciosamente sin findings.\"\n  ],\n  \"risks\": [\n    \"El export es implemented-initial y no reemplaza un backend observability enterprise.\",\n    \"Los checksums son evidencia local, no firma criptográfica avanzada.\",\n    \"La integración con quality-gate queda para POST-H-010-E.\",\n    \"Los outputs generados no deben incluirse en ZIPs limpios de fuente.\"\n  ],\n  \"next_sprint\": \"POST-H-010\",\n  \"preliminary\": true,",
