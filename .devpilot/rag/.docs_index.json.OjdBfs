      "fragment": "\"tests/test_sprint_58_documentation.py\",\n    \"tests/test_sprint_59_documentation.py\",\n    \"tests/test_sprint_60_documentation.py\"\n  ],\n  \"commands\": [\n    \"python -m devpilot_core trace report --json --write-report\",\n    \"python -m devpilot_core trace inspect <trace_id> --json\",\n    \"python -m devpilot_core metrics summary --json --write-report\",\n    \"python -m pytest tests/test_observability_cli.py -q\",\n    \"python -m devpilot_core validate-artifact docs/audits/func_sprint_61_trace_metrics_cli_audit.md --json\",\n    \"python -m devpilot_core schema validate-manifest docs/functional_sprint_61_manifest.json --json\",\n    \"python -m devpilot_core validate all --json\",\n    \"python -m pytest -q\"\n  ],\n  \"tests\": [\n    \"tests/test_observability_cli.py\",\n    \"tests/test_sprint_61_documentation.py\",\n    \"schema validate-manifest\",\n    \"validate-artifact\",\n    \"validate all\",\n    \"pytest -q\"\n  ],\n  \"pass_criteria\": [\n    \"trace report devuelve CommandResult JSON parseable.\",\n    \"trace inspect devuelve árbol de spans o warning controlado si la traza no existe.\",\n    \"metrics summary agrega métricas locales por categoría/operación/estado/proveedor.\",\n    \"--write-report genera JSON/Markdown bajo outputs/reports.\",\n    \"DB vacía no causa excepción.\",\n    \"No se requieren UI, red, API externa, collector ni OpenTelemetry SDK.\"\n  ],\n  \"block_criteria\": [\n    \"trace_id inexistente genera excepción no controlada.\",\n    \"DB vacía bloquea la CLI.\",\n    \"Se exponen prompts, completions, secretos, diffs, patches, stdout o stderr crudos.\",\n    \"Se introduce dependencia externa obligatoria o telemetría remota.\",\n    \"Los comandos requieren UI o servicios externos.\"\n  ],\n  \"risks\": [\n    {\n      \"id\": \"RISK-FUNC-61-001\",",
