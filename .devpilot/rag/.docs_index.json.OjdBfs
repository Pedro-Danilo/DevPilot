      "fragment": "\"next_runtime_sprint\": \"FUNC-SPRINT-69\"\n  },\n  \"pass_criteria\": [\n    \"Token required for non-public endpoints.\",\n    \"CORS wildcard disabled by default.\",\n    \"Security headers are present.\",\n    \"Protected routes are bound to PolicyEngine.\",\n    \"Raw tokens are not persisted in reports by api token.\",\n    \"Remote host binding remains blocked.\"\n  ],\n  \"block_criteria\": [\n    \"CORS wildcard enabled by default.\",\n    \"Raw tokens written to logs or reports.\",\n    \"Protected endpoint without policy binding.\",\n    \"API accepts 0.0.0.0 host.\",\n    \"Write/execute endpoint exposed without Approval Workflow.\"\n  ],\n  \"next_sprint\": \"FUNC-SPRINT-69 — Web UI MVP: dashboard workspace/readiness/MIASI\",\n  \"implemented_at\": \"2026-06-15\",\n  \"wave\": \"Ola 9 — API local y Web UI local web-ready\",\n  \"source_backlog\": \"docs/devpilot_backlog_fase_F_producto_visual.md\",\n  \"architectural_decision\": {\n    \"required\": false,\n    \"adr\": \"docs/02_architecture/adrs/ADR-0013-web-ui-first.md\",\n    \"reason\": \"No se requiere nueva ADR porque Sprint 68 implementa los controles de seguridad previstos por ADR-0013 y el threat model de Sprint 64, sin cambiar la estrategia Web UI first ni habilitar exposición pública.\"\n  },\n  \"created_files\": [\n    \"src/devpilot_core/interfaces/api/security.py\",\n    \"tests/test_api_security.py\",\n    \"docs/audits/func_sprint_68_api_security_audit.md\",\n    \"docs/functional_sprint_68_manifest.json\"\n  ],\n  \"modified_files\": [\n    \"src/devpilot_core/interfaces/api/app.py\",\n    \"src/devpilot_core/interfaces/api/__init__.py\",\n    \"src/devpilot_core/cli.py\",\n    \"src/devpilot_core/application/services.py\",\n    \"docs/07_interfaces/api_contract_v1.md\",\n    \"docs/07_interfaces/openapi_v1.json\",\n    \"docs/07_interfaces/api_service_mapping.md\",",
