      "fragment": "\"tests/test_sprint_35_documentation.py\"\n  ],\n  \"commands\": [\n    \"python -m devpilot_core repo dependency-graph --target src/devpilot_core --json\",\n    \"python -m devpilot_core repo dependency-graph --target src/devpilot_core --json --write-report\",\n    \"python -m devpilot_core miasi validate --json\",\n    \"python -m pytest -q\"\n  ],\n  \"tests\": [\n    \"tests/test_dependency_graph.py\",\n    \"tests/test_sprint_36_documentation.py\"\n  ],\n  \"pass_criteria\": [\n    \"DependencyGraph extracts Python imports using AST without executing analyzed code.\",\n    \"The graph reports nodes, edges, fan-in and fan-out metrics.\",\n    \"External imports are separated from internal dependency edges.\",\n    \"Runtime/cache directories are excluded.\",\n    \"Syntax errors produce controlled findings instead of crashes.\",\n    \"The CLI returns CommandResult and supports --json/--write-report.\",\n    \"MIASI declares repo.dependency_graph as a read-only tool.\",\n    \"pytest -q passes.\"\n  ],\n  \"block_criteria\": [\n    \"The analyzer imports or executes code under analysis.\",\n    \"The analyzer follows paths outside the workspace.\",\n    \"The command calls network, external APIs or models.\",\n    \"A Python syntax error crashes the command.\",\n    \"Sprint 36 is documented as semantic SAST/SCA or runtime call graph certainty.\"\n  ],\n  \"risks\": [\n    \"Dynamic imports and runtime plugin loading are not fully detected.\",\n    \"Import edges are not equivalent to runtime call relationships.\",\n    \"Large repositories may require additional limits and pagination.\"\n  ],\n  \"preliminary\": true,\n  \"next_sprint\": \"FUNC-SPRINT-37 — RepoAnalyzer v2: estructura, riesgos y salud del repositorio\"\n}",
