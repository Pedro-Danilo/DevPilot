      "fragment": "\"python -m devpilot_core schema validate --schema-id RagGroundednessEval --instance evals/fixtures/rag_groundedness_post_h_cases.json --json\",\n    \"python -m devpilot_core schema validate --schema-id PostHManifest --instance docs/post_h_011_a_manifest.json --json\",\n    \"python -m devpilot_core docs-governance validate --json\",\n    \"python -m devpilot_core test-contracts validate --json\",\n    \"python -m devpilot_core test-contracts validate-v2 --json\",\n    \"python -m devpilot_core project-state validate --json\"\n  ],\n  \"tests\": [\n    \"tests/test_rag_groundedness_schema.py\",\n    \"tests/test_post_h_011_rag_groundedness.py\",\n    \"tests/test_schema_registry.py\",\n    \"tests/test_project_global_state.py\",\n    \"tests/test_documentation_governance_validator.py\",\n    \"tests/test_test_contract_registry.py\",\n    \"tests/test_test_contract_registry_v2.py\"\n  ],\n  \"pass_criteria\": [\n    \"RagGroundednessEval y RagGroundednessReport están registrados en schema_catalog.json.\",\n    \"evals/fixtures/rag_groundedness_post_h_cases.json valida contra RagGroundednessEval.\",\n    \"El fixture incluye al menos 10 casos locales con expected_sources existentes.\",\n    \"La suite incluye casos negativos con forbidden_claims.\",\n    \"La suite declara network_used=false, external_api_used=false, web_search_used=false y llm_judge_required=false.\"\n  ],\n  \"block_criteria\": [\n    \"Bloquear si el fixture requiere web o APIs externas.\",\n    \"Bloquear si alguna fuente esperada no existe localmente.\",\n    \"Bloquear si outputs/ se usan como fuente canónica esperada.\",\n    \"Bloquear si se declara LLM judge obligatorio.\",\n    \"Bloquear si se habilita remote execution, connector write o plugin execution.\"\n  ],\n  \"risks\": [\n    \"Esta versión es contractual y de fixtures; todavía no calcula groundedness real.\",\n    \"El keyword/claim matching determinístico puede producir falsa precisión si no se complementa con source coverage en POST-H-011-B/C.\",\n    \"RAG local no debe tratarse como fuente de verdad; la fuente canónica sigue siendo documentación gobernada.\",\n    \"La integración con quality-gate queda diferida a POST-H-011-E.\"\n  ],\n  \"next_sprint\": \"POST-H-011\",\n  \"preliminary\": true,\n  \"security\": {\n    \"local_first\": true,",
