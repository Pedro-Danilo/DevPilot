      "fragment": "{\n  \"sprint_id\": \"FUNC-SPRINT-08\",\n  \"title\": \"Workspace Manager mínimo\",\n  \"status\": \"implemented_initial\",\n  \"implemented_on\": \"2026-06-08\",\n  \"requires_api_key\": false,\n  \"external_calls\": false,\n  \"new_dependencies\": [],\n  \"adr_required\": false,\n  \"adr_reason\": \"Workspace Manager mínimo estaba previsto en el backlog y no introduce dependencias, APIs externas, secretos reales, modelos LLM, costos ni persistencia estructural nueva.\",\n  \"created_files\": [\n    \".devpilot/project.yaml\",\n    \"src/devpilot_core/workspace/__init__.py\",\n    \"src/devpilot_core/workspace/manager.py\",\n    \"tests/test_workspace_manager.py\",\n    \"docs/audits/func_sprint_08_workspace_manager_audit.md\",\n    \"docs/functional_sprint_08_manifest.json\"\n  ],\n  \"modified_files\": [\n    \"src/devpilot_core/cli.py\",\n    \"README.md\",\n    \"docs/05_operations/runbook.md\",\n    \"docs/functional_backlog_after_precode.md\"\n  ],\n  \"commands\": [\n    \"python -m devpilot_core workspace init --dry-run\",\n    \"python -m devpilot_core workspace init --execute\",\n    \"python -m devpilot_core workspace status\",\n    \"python -m devpilot_core workspace status --json\",\n    \"python -m devpilot_core workspace status --json --write-report\",\n    \"python -m pytest -q\"\n  ],\n  \"pass_criteria\": [\n    \"workspace init sin --execute no escribe archivos\",\n    \"workspace init --execute crea .devpilot/project.yaml cuando no existe\",\n    \"workspace init --execute bloquea sobrescritura si project.yaml ya existe\",\n    \"workspace status detecta workspace, docs, standards y checklist pre-code\",\n    \"salida JSON de comandos workspace es parseable\",\n    \"pytest -q pasa completo\"\n  ],",
