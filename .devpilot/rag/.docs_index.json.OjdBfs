        "line_end": 40,
        "title": "{"
      },
      "fragment": "{\n  \"sprint\": \"FUNC-SPRINT-51\",\n  \"title\": \"AgentRuntime v2 model-aware en modo monoagente\",\n  \"status\": \"implemented\",\n  \"implemented_at\": \"2026-06-12\",\n  \"phase\": \"FASE-D-IA-LOCAL-GOBERNADA\",\n  \"wave\": \"Ola 7 — Agentes especializados monoagente\",\n  \"source_backlog\": \"docs/devpilot_backlog_fase_D_ia_local_gobernada.md\",\n  \"architectural_decision\": {\n    \"required\": false,\n    \"adr\": \"docs/02_architecture/adrs/ADR-0011-local-model-providers.md\",\n    \"reason\": \"FUNC-SPRINT-51 ejecuta la arquitectura local-first ya aprobada. Extiende AgentRuntime para usar PromptRegistry, ModelAdapterRouter y BudgetLedger, sin introducir proveedores nuevos, APIs externas, handoffs ni multiagente.\"\n  },\n  \"created_files\": [\n    \"src/devpilot_core/agents/base.py\",\n    \"tests/test_agent_runtime_v2.py\",\n    \"tests/test_sprint_51_documentation.py\",\n    \"docs/audits/func_sprint_51_agent_runtime_v2_audit.md\",\n    \"docs/functional_sprint_51_manifest.json\"\n  ],\n  \"modified_files\": [\n    \".devpilot/miasi/agent_registry.json\",\n    \".devpilot/miasi/policy_matrix.json\",\n    \".devpilot/miasi/tool_registry.json\",\n    \"README.md\",\n    \"docs/04_quality/test_strategy.md\",\n    \"docs/05_operations/runbook.md\",\n    \"docs/06_miasi/agent_card.md\",\n    \"docs/06_miasi/eval_card.md\",\n    \"docs/06_miasi/policy_card.md\",\n    \"docs/06_miasi/tool_card.md\",\n    \"docs/06_miasi/tool_registry.md\",\n    \"docs/devpilot_backlog_fase_D_ia_local_gobernada.md\",\n    \"docs/functional_backlog_after_precode.md\",\n    \"evals/fixtures/documentation_eval_cases.json\",\n    \"src/devpilot_core/agents/__init__.py\",\n    \"src/devpilot_core/agents/models.py\",\n    \"src/devpilot_core/agents/runtime.py\",\n    \"src/devpilot_core/cli.py\",\n    \"src/devpilot_core/evals/runner.py\"",
