      "fragment": "{\n  \"sprint\": \"FUNC-SPRINT-30\",\n  \"title\": \"Binding de aprobaciones con PolicyEngine y MIASI\",\n  \"status\": \"implemented\",\n  \"implemented_at\": \"2026-06-11\",\n  \"phase\": \"FASE-B-SEGURIDAD-OPERACIONAL\",\n  \"wave\": \"Ola 3 — Seguridad operacional, aprobación humana y ejecución controlada\",\n  \"source_backlog\": \"docs/devpilot_backlog_fase_B_seguridad_operacional.md\",\n  \"architectural_decision\": {\n    \"required\": false,\n    \"adr\": null,\n    \"reason\": \"FUNC-SPRINT-30 extends existing local-first PolicyEngine and ApprovalStore contracts without external dependencies, network calls, new storage backends, UI, tool execution or destructive actions. It is an internal policy-binding evolution, not a new architectural style.\"\n  },\n  \"created_files\": [\n    \"src/devpilot_core/approval/policy.py\",\n    \"tests/test_approval_policy_binding.py\",\n    \"tests/test_sprint_30_documentation.py\",\n    \"docs/audits/func_sprint_30_approval_policy_binding_audit.md\",\n    \"docs/functional_sprint_30_manifest.json\"\n  ],\n  \"modified_files\": [\n    \"src/devpilot_core/approval/__init__.py\",\n    \"src/devpilot_core/policy/engine.py\",\n    \"src/devpilot_core/cli.py\",\n    \".devpilot/miasi/policy_matrix.json\",\n    \"docs/06_miasi/policy_matrix.md\",\n    \"README.md\",\n    \"docs/05_operations/runbook.md\",\n    \"docs/devpilot_backlog_fase_B_seguridad_operacional.md\",\n    \"docs/functional_backlog_after_precode.md\",\n    \"tests/test_sprint_29_documentation.py\"\n  ],\n  \"commands\": [\n    \"python -m devpilot_core policy check execute --path . --tool tests.run --subject pytest --approval-id $approvalId --json\",\n    \"python -m devpilot_core policy simulate --tool tests.run --action execute --subject pytest --approval-id $approvalId --json --write-report\",\n    \"python -m devpilot_core miasi validate --json\",\n    \"python -m devpilot_core schema validate-manifest docs/functional_sprint_30_manifest.json --json\",\n    \"python -m pytest tests/test_approval_policy_binding.py -q\",\n    \"python -m pytest -q\"\n  ],",
