        "line_end": 110,
        "title": "{"
      },
      "fragment": "\"package-lock.json\"\n  ],\n  \"commands\": [\n    \"python -m devpilot_core approval list --json\",\n    \"python -m pytest tests/test_api_approvals_actions.py tests/test_web_ui_approval_center.py tests/test_sprint_71_documentation.py -q\",\n    \"cd ui/web && npm test\",\n    \"python -m devpilot_core schema validate-manifest docs/functional_sprint_71_manifest.json --json\",\n    \"python -m devpilot_core validate-artifact docs/audits/func_sprint_71_approval_center_audit.md --json\",\n    \"python -m devpilot_core validate all --json\",\n    \"python -m pytest -q\"\n  ],\n  \"tests\": [\n    \"python -m pytest tests/test_api_approvals_actions.py tests/test_web_ui_approval_center.py tests/test_sprint_71_documentation.py -q\",\n    \"python -m pytest tests/test_api_security.py tests/test_api_local.py tests/test_api_contract.py tests/test_api_reports_traces.py tests/test_api_approvals_actions.py tests/test_web_ui_mvp.py tests/test_web_ui_report_trace_viewer.py tests/test_web_ui_approval_center.py tests/test_application_services.py tests/test_application_services_v2.py -q\",\n    \"python -m pytest tests/test_sprint_*_documentation.py tests/test_phase_f_web_first_strategy.py -q\",\n    \"cd ui/web && npm test\",\n    \"python -m devpilot_core validate all --json\"\n  ],\n  \"pass_criteria\": [\n    \"Approval Center lists pending/approved/denied/revoked approval requests through /api/v1/approvals endpoints only.\",\n    \"Approval request/approve/deny operations are exposed through ApplicationService and policy-bound API routes.\",\n    \"Action Launcher supports only safe dry-run actions: readiness, code-review and refactor-plan.\",\n    \"Critical actions such as patch apply, refactor execute, rollback execute, git push and deploy are blocked from UI/API without creating a bypass.\",\n    \"Every approval mutation produces an auditable ApplicationResponse and uses the existing local approval store.\",\n    \"Web UI does not import devpilot_core, does not read outputs/ directly and does not access .devpilot database directly.\",\n    \"README, runbook, backlog, OpenAPI, API contract, mapping, audit and manifest remain synchronized.\"\n  ],\n  \"block_criteria\": [\n    \"Block if Web UI can execute critical/destructive actions without approval.\",\n    \"Block if patch apply/refactor execute/rollback execute/git push/deploy are available from UI.\",\n    \"Block if approval_id or token-like values are logged or rendered unsafely.\",\n    \"Block if API bypasses ApplicationService or PolicyEngine for dry-run actions.\",\n    \"Block if UI imports Python/core modules or reads local filesystem paths directly.\"\n  ],\n  \"risks\": [\n    \"Approval Center is an initial local MVP, not a multi-user RBAC workflow.\",\n    \"Browser token handling remains local-session based and must not be treated as enterprise authentication.\",\n    \"Dry-run action launcher intentionally exposes a small allowlist; broader actions require future policy/approval UX.\",\n    \"Approval evidence is local and should evolve toward richer trace/report correlation in later sprints.\",\n    \"Human approval state depends on the local workspace store and should be backed up with the rest of .devpilot state.\"",
      "tokens": {
