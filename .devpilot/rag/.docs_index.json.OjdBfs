    {
      "chunk_id": "ragchunk_e1dd6d06927c0424",
      "source": {
        "path": "docs/post_h_008_e_manifest.json",
        "line_start": 71,
        "line_end": 89,
        "title": "{"
      },
      "fragment": "\"Runtime artifacts no versionables rastreados por Git producen bloqueo.\",\n    \"git archive HEAD queda limpio cuando `.git` está disponible.\",\n    \"El plan determinista de source archive queda limpio cuando `.git` no está disponible.\",\n    \"Test Contract Registry v1/v2 valida con el nuevo contrato.\"\n  ],\n  \"block_criteria\": [\n    \"BLOCK si outputs, devpilot.db, agent_sessions, caches o build artifacts entran al archive.\",\n    \"BLOCK si la policy deja de exigir exclusiones críticas.\",\n    \"BLOCK si runtime_artifacts_allowed_in_release_zip=true.\",\n    \"BLOCK si se ejecutan mutaciones de source o limpieza destructiva.\"\n  ],\n  \"risks\": [\n    \"El gate no firma ni cifra archives; esa capacidad queda para hardening posterior.\",\n    \"En ZIPs sin `.git`, la inspección git archive se reemplaza por plan determinista local.\",\n    \"No sustituye un DLP industrial completo ni análisis semántico de todo contenido textual.\"\n  ],\n  \"next_sprint\": \"POST-H-009\",\n  \"preliminary\": true\n}",
      "tokens": {
