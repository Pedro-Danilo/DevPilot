    {
      "chunk_id": "ragchunk_dcdc93cd4a949d1e",
      "source": {
        "path": "docs/functional_sprint_29_manifest.json",
        "line_start": 36,
        "line_end": 70,
        "title": "{"
      },
      "fragment": "\"python -m devpilot_core approval deny <approval_id> --actor owner --reason \\\"Riesgo no mitigado\\\" --json\",\n    \"python -m devpilot_core approval revoke <approval_id> --actor owner --reason \\\"Ya no aplica\\\" --json\",\n    \"python -m pytest tests/test_approval_cli.py -q\",\n    \"python -m pytest -q\"\n  ],\n  \"tests\": [\n    \"tests/test_approval_cli.py\",\n    \"tests/test_sprint_29_documentation.py\"\n  ],\n  \"pass_criteria\": [\n    \"All approval CLI commands return CommandResult.\",\n    \"approval request creates a requested ApprovalRecord with scope and expiration.\",\n    \"approval list filters by status, tool and action.\",\n    \"approval show loads a single record by approval_id.\",\n    \"approval approve, deny and revoke require actor and reason.\",\n    \"Expired approvals cannot be approved.\",\n    \"Terminal approvals are not reopened.\",\n    \"Optional reports and local events are generated.\",\n    \"pytest -q passes.\"\n  ],\n  \"block_criteria\": [\n    \"An approval is approved without actor or reason.\",\n    \"An expired approval allows future execution.\",\n    \"CLI output prints raw secrets or sensitive payloads.\",\n    \"Approval CLI is treated as automatic tool authorization before PolicyEngine binding.\"\n  ],\n  \"risks\": [\n    \"Actor is local/declarative; authentication and RBAC remain future work.\",\n    \"PolicyEngine binding is explicitly deferred to FUNC-SPRINT-30.\",\n    \"The CLI does not execute tests, patches, refactors or deploys.\",\n    \"Approval records are local SQLite evidence and require future retention/privacy controls.\"\n  ],\n  \"preliminary\": true,\n  \"next_sprint\": \"FUNC-SPRINT-30 — Binding de aprobaciones con PolicyEngine y MIASI\"\n}",
