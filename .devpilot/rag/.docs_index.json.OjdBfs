        "deployment": 1,
        "model": 4,
        "control": 1,
        "plane": 1,
        "seguro": 1,
        "habilitado": 1,
        "por": 3,
        "defecto": 2,
        "multiuser": 1,
        "auth": 1,
        "productivo": 1,
