      "fragment": "{\n  \"sprint\": \"FUNC-SPRINT-24\",\n  \"title\": \"Artifact Profiles data-driven y ValidationGateway inicial\",\n  \"status\": \"implemented\",\n  \"implemented_at\": \"2026-06-10\",\n  \"phase\": \"FASE-A-BASELINE-INDUSTRIAL-MINIMA\",\n  \"wave\": \"Ola 1 — Consolidación contractual y Schema Engine\",\n  \"source_backlog\": \"docs/devpilot_backlog_fase_A_baseline_industrial_minima.md\",\n  \"architectural_decision\": {\n    \"required\": false,\n    \"adr\": null,\n    \"reason\": \"FUNC-SPRINT-24 adds data-driven profile configuration and an orchestration facade without new dependency, provider, policy, storage backend or destructive behavior. It reuses the jsonschema dependency already governed by ADR-0010.\"\n  },\n  \"created_files\": [\n    \"src/devpilot_core/validation/__init__.py\",\n    \"src/devpilot_core/validation/artifact_profile_registry.py\",\n    \"src/devpilot_core/validation/gateway.py\",\n    \"docs/validation/artifact_profiles.json\",\n    \"docs/schemas/artifact_profiles.schema.json\",\n    \"docs/audits/func_sprint_24_validation_gateway_audit.md\",\n    \"docs/functional_sprint_24_manifest.json\",\n    \"tests/test_artifact_profile_registry.py\",\n    \"tests/test_validation_gateway.py\",\n    \"tests/test_sprint_24_documentation.py\"\n  ],\n  \"modified_files\": [\n    \"src/devpilot_core/cli.py\",\n    \"src/devpilot_core/validators/artifact_profiles.py\",\n    \"src/devpilot_core/standards/registry.py\",\n    \"docs/schemas/schema_catalog.json\",\n    \"README.md\",\n    \"docs/05_operations/runbook.md\",\n    \"docs/devpilot_backlog_fase_A_baseline_industrial_minima.md\",\n    \"docs/functional_backlog_after_precode.md\",\n    \"tests/test_schema_registry.py\",\n    \"tests/test_sprint_22_documentation.py\",\n    \"tests/test_sprint_23_documentation.py\"\n  ],\n  \"commands\": [\n    \"python -m devpilot_core validate docs --json\",",
