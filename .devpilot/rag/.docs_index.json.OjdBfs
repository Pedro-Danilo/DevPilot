        "line_end": 75,
        "title": "{"
      },
      "fragment": "\"tests/test_sprint_34_documentation.py\",\n    \"tests/test_sprint_35_documentation.py\",\n    \"tests/test_sprint_36_documentation.py\"\n  ],\n  \"commands\": [\n    \"python -m devpilot_core repo analyze --json\",\n    \"python -m devpilot_core repo analyze --json --write-report\",\n    \"python -m devpilot_core miasi validate --json\",\n    \"python -m pytest -q\"\n  ],\n  \"tests\": [\n    \"tests/test_repo_analyzer.py\",\n    \"tests/test_sprint_37_documentation.py\"\n  ],\n  \"pass_criteria\": [\n    \"RepoAnalyzer consolidates RepoInventory, DependencyGraph and GitAdapter signals.\",\n    \"The command returns CommandResult and supports --json/--write-report.\",\n    \"Runtime folders are excluded from analysis.\",\n    \"Repositories without Git produce partial controlled analysis instead of crashing.\",\n    \"Secret-like content is not emitted as raw payload.\",\n    \"MIASI declares repo.analyze as a read-only tool.\",\n    \"pytest -q passes.\"\n  ],\n  \"block_criteria\": [\n    \"The analyzer mixes outputs runtime into repository health.\",\n    \"The analyzer emits raw secrets.\",\n    \"A missing Git repository breaks the analysis.\",\n    \"The analyzer executes/imports code under analysis.\",\n    \"Sprint 37 is documented as SAST/SCA or industrial certification.\",\n    \"Patch apply, Git write, refactor execution or deploy are enabled.\"\n  ],\n  \"risks\": [\n    \"Health score is heuristic and may be overinterpreted.\",\n    \"Modules-without-tests heuristic can generate false positives.\",\n    \"TODO/FIXME scan is textual and bounded.\",\n    \"No vulnerability/license/coverage/cyclomatic complexity analysis yet.\"\n  ],\n  \"preliminary\": true,\n  \"next_sprint\": \"FUNC-SPRINT-38 — Architecture/code drift inicial\"\n}",
