        "title": "{"
      },
      "fragment": "{\n  \"sprint\": \"FUNC-SPRINT-29\",\n  \"title\": \"CLI de aprobación: request, list, show, approve, deny y revoke\",\n  \"status\": \"implemented\",\n  \"implemented_at\": \"2026-06-11\",\n  \"phase\": \"FASE-B-SEGURIDAD-OPERACIONAL\",\n  \"wave\": \"Ola 3 — Seguridad operacional, aprobación humana y ejecución controlada\",\n  \"source_backlog\": \"docs/devpilot_backlog_fase_B_seguridad_operacional.md\",\n  \"architectural_decision\": {\n    \"required\": false,\n    \"adr\": null,\n    \"reason\": \"FUNC-SPRINT-29 exposes the existing approval domain through dependency-free local CLI commands. It introduces no external dependency, network call, provider, UI, destructive action or new storage backend. PolicyEngine binding is explicitly deferred to FUNC-SPRINT-30.\"\n  },\n  \"created_files\": [\n    \"src/devpilot_core/approval/service.py\",\n    \"tests/test_approval_cli.py\",\n    \"tests/test_sprint_29_documentation.py\",\n    \"docs/audits/func_sprint_29_approval_cli_audit.md\",\n    \"docs/functional_sprint_29_manifest.json\"\n  ],\n  \"modified_files\": [\n    \"src/devpilot_core/approval/__init__.py\",\n    \"src/devpilot_core/approval/store.py\",\n    \"src/devpilot_core/cli.py\",\n    \"README.md\",\n    \"docs/05_operations/runbook.md\",\n    \"docs/devpilot_backlog_fase_B_seguridad_operacional.md\",\n    \"docs/functional_backlog_after_precode.md\",\n    \"tests/test_sprint_28_documentation.py\"\n  ],\n  \"commands\": [\n    \"python -m devpilot_core approval request --tool tests.run --action execute --subject pytest --reason \\\"Validar cambios\\\" --actor owner --json\",\n    \"python -m devpilot_core approval list --status requested --json\",\n    \"python -m devpilot_core approval show <approval_id> --json\",\n    \"python -m devpilot_core approval approve <approval_id> --actor owner --reason \\\"Revisión OK\\\" --json\",\n    \"python -m devpilot_core approval deny <approval_id> --actor owner --reason \\\"Riesgo no mitigado\\\" --json\",\n    \"python -m devpilot_core approval revoke <approval_id> --actor owner --reason \\\"Ya no aplica\\\" --json\",\n    \"python -m pytest tests/test_approval_cli.py -q\",\n    \"python -m pytest -q\"\n  ],",
      "tokens": {
