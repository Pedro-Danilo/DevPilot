      },
      "fragment": "\"tests/test_sprint_64_documentation.py\",\n    \"tests/test_sprint_65_documentation.py\",\n    \"tests/test_sprint_66_documentation.py\",\n    \"tests/test_sprint_67_documentation.py\",\n    \"tests/test_sprint_68_documentation.py\",\n    \"tests/test_sprint_69_documentation.py\"\n  ],\n  \"commands\": [\n    \"python -m devpilot_core trace report --json\",\n    \"python -m devpilot_core metrics summary --json\",\n    \"python -m pytest tests/test_api_reports_traces.py tests/test_web_ui_report_trace_viewer.py tests/test_sprint_70_documentation.py -q\",\n    \"cd ui/web && npm test\",\n    \"python -m pytest -q\"\n  ],\n  \"tests\": [\n    \"python -m pytest tests/test_api_reports_traces.py tests/test_web_ui_report_trace_viewer.py tests/test_sprint_70_documentation.py -q\",\n    \"python -m pytest tests/test_api_security.py tests/test_api_local.py tests/test_api_contract.py tests/test_web_ui_mvp.py tests/test_sprint_69_documentation.py tests/test_api_reports_traces.py tests/test_web_ui_report_trace_viewer.py tests/test_sprint_70_documentation.py tests/test_application_services.py tests/test_application_services_v2.py -q\",\n    \"python -m pytest tests/test_sprint_*_documentation.py tests/test_phase_f_web_first_strategy.py -q\",\n    \"cd ui/web && npm test\",\n    \"python -m devpilot_core validate all --json\"\n  ],\n  \"pass_criteria\": [\n    \"Report Viewer lists and opens reports through /api/v1/reports endpoints only.\",\n    \"Trace Viewer lists traces, renders empty states and supports trace inspection through /api/v1/traces endpoints only.\",\n    \"Finding filters by severity/status/command are available without exposing secrets.\",\n    \"UI does not read outputs/, .devpilot/ or filesystem directly.\",\n    \"API responses redact token-like values and bound output paths to allowed report/trace stores.\",\n    \"README, runbook, backlog, contracts, audit and manifest remain synchronized.\"\n  ],\n  \"block_criteria\": [\n    \"Block if Web UI imports devpilot_core or reads local files directly.\",\n    \"Block if report/trace endpoints expose raw secrets or unrestricted filesystem paths.\",\n    \"Block if large traces are returned without limit/pagination controls.\",\n    \"Block if report/trace viewers add write/execute actions.\"\n  ],\n  \"risks\": [\n    \"Report and trace viewers are first-version local MVP, not a full industrial observability console.\",\n    \"Trace tree rendering is intentionally basic and may require virtualization for very large traces.\",\n    \"Browser UI still depends on token handling by the local user and is not enterprise RBAC.\",\n    \"Report inventory is constrained to safe local report paths and intentionally omits arbitrary filesystem browsing.\"",
