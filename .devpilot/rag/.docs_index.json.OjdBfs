    {
      "chunk_id": "ragchunk_9318862c8f006745",
      "source": {
        "path": "docs/functional_sprint_35_manifest.json",
        "line_start": 36,
        "line_end": 70,
        "title": "{"
      },
      "fragment": "\"commands\": [\n    \"python -m devpilot_core git branches --json\",\n    \"python -m devpilot_core git tags --json\",\n    \"python -m devpilot_core git log --limit 20 --json\",\n    \"python -m devpilot_core git diff-report --json --write-report\",\n    \"python -m devpilot_core miasi validate --json\",\n    \"python -m pytest -q\"\n  ],\n  \"tests\": [\n    \"tests/test_git_adapter_v2.py\",\n    \"tests/test_sprint_35_documentation.py\"\n  ],\n  \"pass_criteria\": [\n    \"GitAdapter v2 operates only in read-only mode.\",\n    \"Branches, tags and bounded log commands return JSON-serializable CommandResult payloads.\",\n    \"git diff-report generates structured file, line and risk metadata and can write JSON/Markdown evidence.\",\n    \"Write-capable Git commands are blocked by allowlist.\",\n    \"A non-Git repository returns controlled warning output without crashing.\",\n    \"MIASI declares Git read-only tools.\",\n    \"pytest -q passes.\"\n  ],\n  \"block_criteria\": [\n    \"Any Git write operation is exposed or allowed.\",\n    \"A command uses shell=True or a free shell string.\",\n    \"A non-Git repository raises an uncontrolled exception.\",\n    \"Sprint 35 is documented as patch apply, sandbox or Git write.\"\n  ],\n  \"risks\": [\n    \"Diff risk classification is heuristic and preliminary.\",\n    \"Large diffs are bounded and may be truncated.\",\n    \"No remote, submodule, LFS or signature analysis is implemented yet.\"\n  ],\n  \"preliminary\": true,\n  \"next_sprint\": \"FUNC-SPRINT-36 — DependencyGraph e import graph Python\"\n}",
