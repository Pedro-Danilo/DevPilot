    {
      "chunk_id": "ragchunk_ca3d0cc71fd5fb3e",
      "source": {
        "path": "docs/functional_sprint_20_manifest.json",
        "line_start": 36,
        "line_end": 66,
        "title": "{"
      },
      "fragment": "\"tests/test_sprint_20_documentation_reconciliation.py\",\n    \"python -m pytest -q\"\n  ],\n  \"pass_criteria\": [\n    \"Capability matrix exists and classifies implemented/partial/planned/disabled/future capabilities.\",\n    \"Roadmap reconciliation maps historical command names to current commands or planned/future status.\",\n    \"README and runbook declare FUNC-SPRINT-20 as latest hito and FUNC-SPRINT-21 as next sprint.\",\n    \"C4 Context/Container/Component distinguish implemented, partial, planned, disabled and future states.\",\n    \"pytest -q passes.\"\n  ],\n  \"block_criteria\": [\n    \"Documentation states real UI/API/external providers/patch apply/refactor execution as implemented.\",\n    \"Historical command names are presented as available when they are planned only.\",\n    \"C4 views omit state markers for aspirational nodes.\",\n    \"Tests fail.\"\n  ],\n  \"risks\": [\n    \"Manual documentation reconciliation can drift until Schema Engine/Command Catalog exist.\",\n    \"This sprint does not implement schemas or traceability; it only prepares clean contracts.\"\n  ],\n  \"adr_required\": false,\n  \"adr_rationale\": \"No new architecture, dependency, external provider, security policy or runtime behavior was introduced. The sprint is documentary and reconciliatory.\",\n  \"preliminary_notes\": [\n    \"C4 Component is a first reconciled documentation view and should later be validated against a Component/Command Catalog.\",\n    \"This sprint does not implement schemas; the capability matrix remains a manual baseline until Traceability Engine and Schema Registry make it executable.\"\n  ],\n  \"next_sprint\": \"FUNC-SPRINT-21 — Schema Registry y catálogo de contratos DevPilot\",\n  \"corrective_adjustments\": [\n    \"Adjusted tests/test_release_manifest.py so Sprint 19 release checksums remain point-in-time evidence while living docs modified by Sprint 20 do not break regression.\"\n  ]\n}",
