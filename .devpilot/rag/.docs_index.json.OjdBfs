      },
      "fragment": "\"commands\": [\n    \"python -m devpilot_core docs-governance validate --json\",\n    \"python -m devpilot_core docs-governance validate --write-report --json\",\n    \"python -m devpilot_core schema validate --schema-id DocumentationGovernanceReport --instance outputs/reports/documentation_governance_report.json --json\",\n    \"python -m devpilot_core test-contracts validate --json\",\n    \"python -m devpilot_core test-contracts validate-v2 --json\"\n  ],\n  \"tests\": [\n    \"tests/test_documentation_governance_validator.py\",\n    \"tests/test_post_h_009_documentation_governance.py\",\n    \"tests/test_documentation_source_registry_schema.py\",\n    \"tests/test_post_h_006_b_declarative_registry.py\",\n    \"tests/test_project_global_state.py\",\n    \"tests/test_test_contract_registry.py\",\n    \"tests/test_test_contract_registry_v2.py\"\n  ],\n  \"pass_criteria\": [\n    \"docs-governance validate passes in the valid baseline.\",\n    \"Approved Markdown sources declared in the registry have valid frontmatter.\",\n    \"Critical/source-of-truth sources have existing required_tests.\",\n    \"Registry doc_id/status metadata is consistent with frontmatter or structured status when exposed.\",\n    \"DocumentationGovernanceReport validates against schema when --write-report is used.\"\n  ],\n  \"block_criteria\": [\n    \"A registered source path does not exist.\",\n    \"A source-of-truth critical document has no required test or a missing required test.\",\n    \"A Markdown approved source lacks frontmatter.\",\n    \"A registry doc_id or status_required contradicts source frontmatter/status.\",\n    \"The validator uses network, external APIs, LLM judge or source mutations.\"\n  ],\n  \"risks\": [\n    \"This validator covers metadata only; Markdown/JSON semantic drift is deferred to POST-H-009-C.\",\n    \"Current README and changelog are registered as current/derived sources without frontmatter by design.\",\n    \"Quality-gate hardening integration remains deferred to POST-H-009-E.\"\n  ],\n  \"next_sprint\": \"POST-H-009\"\n}",
