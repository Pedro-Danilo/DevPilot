      "fragment": "\"python -m devpilot_core traceability scan --json\",\n    \"python -m devpilot_core traceability scan --json --write-report\",\n    \"python -m devpilot_core traceability scan --target docs/01_requirements --json\",\n    \"python -m pytest tests/test_traceability_extractors.py -q\",\n    \"python -m pytest -q\"\n  ],\n  \"tests\": [\n    \"tests/test_traceability_extractors.py\",\n    \"tests/test_sprint_25_documentation.py\"\n  ],\n  \"pass_criteria\": [\n    \"Traceability package is importable.\",\n    \"TraceEntity, TraceLink and TraceGraph are serializable to JSON.\",\n    \"Extractor detects FR, REQ, US, AC, TEST and ADR IDs.\",\n    \"Extractor detects duplicate IDs and malformed ID-like tokens.\",\n    \"traceability scan returns CommandResult and supports --json.\",\n    \"traceability scan supports --write-report.\",\n    \"No source documents are modified.\",\n    \"pytest -q passes.\"\n  ],\n  \"block_criteria\": [\n    \"Extractor infers semantic links not explicitly present.\",\n    \"Command mutates source documents.\",\n    \"Duplicate IDs are not reported.\",\n    \"Targets outside the project root are accepted.\",\n    \"A new dependency is added without ADR.\"\n  ],\n  \"risks\": [\n    \"Heuristic extraction can report legitimate repeated references as duplicates.\",\n    \"Malformed ID-like tokens in filenames can be reported as warnings.\",\n    \"No traceability coverage or gap analysis is implemented until Sprint 26.\",\n    \"Trace links remain empty by design in Sprint 25.\"\n  ],\n  \"next_sprint\": \"FUNC-SPRINT-26 — Traceability Engine: validate, coverage y report\"\n}",
