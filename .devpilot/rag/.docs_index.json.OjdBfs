      "fragment": "\"next_sprint\": \"FUNC-SPRINT-70 — Report Viewer y Trace Viewer\",\n  \"phase\": \"FASE-F-PRODUCTO-VISUAL\",\n  \"source_repo\": \"repo_DevPilot_Local_85.zip\",\n  \"wave\": \"Fase F — Producto visual\",\n  \"source_backlog\": \"docs/devpilot_backlog_fase_F_producto_visual.md\",\n  \"architectural_decision\": {\n    \"adr_required\": false,\n    \"rationale\": \"FUNC-SPRINT-69 implements the Web UI local MVP under ADR-0013/Web UI first and the Sprint 64 UI/API threat model; it does not change the frontend/API strategy.\"\n  },\n  \"commands\": [\n    \"python -m devpilot_core api token --json\",\n    \"python -m devpilot_core api serve --host 127.0.0.1 --port 8787 --execute\",\n    \"cd ui/web && npm install\",\n    \"cd ui/web && npm test\",\n    \"cd ui/web && npm run dev\",\n    \"python -m pytest tests/test_web_ui_mvp.py tests/test_sprint_69_documentation.py -q\",\n    \"python -m devpilot_core validate all --json\"\n  ],\n  \"pass_criteria\": [\n    \"Dashboard local displays workspace, readiness, standards and MIASI cards.\",\n    \"Web UI consumes only /api/v1 endpoints and sends X-DevPilot-Token.\",\n    \"Frontend does not import devpilot_core, Python modules, .devpilot or outputs directly.\",\n    \"UI remains read-only and exposes no write/execute actions.\",\n    \"Smoke test and Python contract tests pass.\",\n    \"README, runbook, backlog, internal contract, audit and manifest remain synchronized.\"\n  ],\n  \"block_criteria\": [\n    \"Frontend imports Python/core modules or reads local repo files directly.\",\n    \"Frontend requires external APIs or paid services.\",\n    \"Dashboard exposes destructive write/execute actions.\",\n    \"Token is hardcoded or persisted in source files.\",\n    \"Node/UI installation steps are not documented.\",\n    \"pyproject dependency state leaves Starlette TestClient warning unresolved by design.\"\n  ]\n}",
