      "fragment": "{\n  \"sprint\": \"FUNC-SPRINT-41\",\n  \"title\": \"PatchSandbox y ChangeSet model\",\n  \"status\": \"implemented\",\n  \"implemented_at\": \"2026-06-11\",\n  \"phase\": \"FASE-C-INGENIERIA-DE-REPOSITORIO\",\n  \"wave\": \"Ola 5 — Sandbox, patch/refactor ejecutable y rollback\",\n  \"source_backlog\": \"docs/devpilot_backlog_fase_C_ingenieria_repositorio.md\",\n  \"architectural_decision\": {\n    \"required\": false,\n    \"adr\": null,\n    \"reason\": \"FUNC-SPRINT-41 implementa una capacidad prevista explícitamente por Fase C usando componentes ya aprobados: PatchPreflightEngine, PolicyEngine, SafeSubprocessRunner, Approval Workflow y ReportEngine. No introduce dependencias externas, red, APIs, modelos, Git write, rollback ejecutable, refactor execution ni deploy. La allowlist de git apply real se genera solo como artefacto runtime dentro de outputs/sandbox y no modifica la allowlist global.\"\n  },\n  \"created_files\": [\n    \"src/devpilot_core/sandbox/__init__.py\",\n    \"src/devpilot_core/sandbox/patch_sandbox.py\",\n    \"src/devpilot_core/changes/__init__.py\",\n    \"src/devpilot_core/changes/models.py\",\n    \"tests/test_patch_sandbox.py\",\n    \"tests/test_sprint_41_documentation.py\",\n    \"docs/audits/func_sprint_41_patch_sandbox_changeset_audit.md\",\n    \"docs/functional_sprint_41_manifest.json\"\n  ],\n  \"modified_files\": [\n    \".devpilot/miasi/agent_registry.json\",\n    \".devpilot/miasi/policy_matrix.json\",\n    \".devpilot/miasi/tool_registry.json\",\n    \".gitignore\",\n    \"README.md\",\n    \"docs/04_quality/test_strategy.md\",\n    \"docs/05_operations/runbook.md\",\n    \"docs/06_miasi/tool_card.md\",\n    \"docs/06_miasi/tool_registry.md\",\n    \"docs/devpilot_backlog_fase_C_ingenieria_repositorio.md\",\n    \"docs/functional_backlog_after_precode.md\",\n    \"src/devpilot_core/cli.py\",\n    \"tests/test_sprint_35_documentation.py\",\n    \"tests/test_sprint_36_documentation.py\",\n    \"tests/test_spri