      "fragment": "\"python -m devpilot_core schema validate --schema-id PostHManifest --instance docs/post_h_011_b_manifest.json --json\",\n    \"python -m devpilot_core docs-governance validate --json\",\n    \"python -m devpilot_core test-contracts validate --json\",\n    \"python -m devpilot_core test-contracts validate-v2 --json\",\n    \"python -m devpilot_core project-state validate --json\"\n  ],\n  \"tests\": [\n    \"tests/test_rag_citations_source_coverage.py\",\n    \"tests/test_post_h_011_rag_groundedness.py\",\n    \"tests/test_rag_groundedness_schema.py\",\n    \"tests/test_schema_registry.py\",\n    \"tests/test_project_global_state.py\",\n    \"tests/test_documentation_governance_validator.py\",\n    \"tests/test_test_contract_registry.py\",\n    \"tests/test_test_contract_registry_v2.py\"\n  ],\n  \"pass_criteria\": [\n    \"Calcula source_coverage por fuente esperada.\",\n    \"Detecta fuentes inexistentes.\",\n    \"Funciona con docs_index y con lectura directa de documentos.\",\n    \"Bloquea fuentes remotas, runtime outputs y stale/deprecated.\",\n    \"No usa web, APIs externas, LLM judge, remote execution, connector write ni plugin execution.\"\n  ],\n  \"block_criteria\": [\n    \"Bloquear si inventa fuentes.\",\n    \"Bloquear si outputs/ se aceptan como fuente canónica.\",\n    \"Bloquear si fuentes deprecated/stale pasan como válidas.\",\n    \"Bloquear si la cobertura queda bajo el umbral del caso.\",\n    \"Bloquear si la implementación requiere red o proveedor externo.\"\n  ],\n  \"risks\": [\n    \"Todavía no evalúa required_claims ni forbidden_claims; esa lógica queda para POST-H-011-C.\",\n    \"El uso de docs_index es auxiliar; la fuente de verdad sigue siendo el documento local canónico.\",\n    \"La clasificación stale depende de metadata declarada; documentos sin frontmatter se tratan como no stale hasta tener reglas adicionales.\",\n    \"La integración CLI y quality-gate queda diferida a POST-H-011-D/E.\"\n  ],\n  \"next_sprint\": \"POST-H-011\",\n  \"preliminary\": true,\n  \"security\": {\n    \"local_first\": true,",
