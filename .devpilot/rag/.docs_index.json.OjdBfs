      "fragment": "\"tests/test_sprint_52_documentation.py\",\n    \"tests/test_sprint_53_documentation.py\",\n    \"tests/test_sprint_54_documentation.py\",\n    \"tests/test_sprint_55_documentation.py\",\n    \"tests/test_sprint_56_documentation.py\",\n    \"tests/test_sprint_57_documentation.py\",\n    \"tests/test_sprint_58_documentation.py\",\n    \"tests/test_sprint_59_documentation.py\"\n  ],\n  \"commands\": [\n    \"python -m devpilot_core state init --json\",\n    \"python -m devpilot_core agent run documentation-audit --target docs/01_requirements --provider mock --json --write-report\",\n    \"python -m devpilot_core model generate --provider mock --prompt \\\"hello\\\" --json\",\n    \"python -m pytest tests/test_agentops_instrumentation.py -q\",\n    \"python -m pytest tests/test_agentops_instrumentation.py tests/test_agent_runtime.py tests/test_agent_runtime_v2.py tests/test_policy_engine.py tests/test_approval_cli.py tests/test_model_governance.py -q\",\n    \"python -m devpilot_core validate-artifact docs/audits/func_sprint_60_agentic_instrumentation_audit.md --json\",\n    \"python -m devpilot_core schema validate-manifest docs/functional_sprint_60_manifest.json --json\",\n    \"python -m devpilot_core validate all --json\",\n    \"python -m pytest -q\"\n  ],\n  \"tests\": [\n    \"tests/test_agentops_instrumentation.py\",\n    \"tests/test_agent_runtime.py\",\n    \"tests/test_agent_runtime_v2.py\",\n    \"tests/test_policy_engine.py\",\n    \"tests/test_approval_cli.py\",\n    \"tests/test_model_governance.py\",\n    \"tests/test_sprint_60_documentation.py\",\n    \"schema validate-manifest\",\n    \"validate all\",\n    \"pytest -q\"\n  ],\n  \"pass_criteria\": [\n    \"AgentRuntime genera trace correlacionable.\",\n    \"AgentToolCall incluye tool_call_id y produce tool.call spans.\",\n    \"PolicyEngine produce policy.check spans/eventos/métricas.\",\n    \"ApprovalService produce approval.workflow spans/eventos/métricas.\",\n    \"ModelAdapterRouter produce model.call spans y métricas provider/model/task.\",\n    \"No se registran prompts, completions, secretos, diffs, stdout o stderr crudos.\",\n    \"La observabilidad es best-effort y no cambia comportamiento funcional.\"",
