      "fragment": "{\n  \"sprint\": \"FUNC-SPRINT-61\",\n  \"title\": \"CLI de trazas y métricas: trace report, trace inspect, metrics summary\",\n  \"status\": \"implemented\",\n  \"implemented_at\": \"2026-06-13\",\n  \"phase\": \"FASE-E-AGENTOPS-OBSERVABILIDAD\",\n  \"wave\": \"Ola 8 — Observabilidad avanzada y AgentOps\",\n  \"source_backlog\": \"docs/devpilot_backlog_fase_E_agentops_observabilidad.md\",\n  \"architectural_decision\": {\n    \"required\": false,\n    \"adr\": \"docs/02_architecture/adrs/ADR-0012-observability-v2-agentops.md\",\n    \"reason\": \"FUNC-SPRINT-61 expone consulta CLI local sobre señales ya definidas por ADR-0012. No introduce exporter, red, telemetría remota ni dependencias externas, por lo que no requiere una ADR nueva.\"\n  },\n  \"summary\": {\n    \"implementation_level\": \"implemented-initial\",\n    \"trace_report_cli_added\": true,\n    \"trace_inspect_cli_added\": true,\n    \"metrics_summary_cli_added\": true,\n    \"markdown_reports_supported\": true,\n    \"empty_db_controlled\": true,\n    \"unknown_trace_id_controlled\": true,\n    \"external_dependencies_added\": false,\n    \"remote_telemetry_enabled\": false,\n    \"network_required\": false,\n    \"external_api_used\": false,\n    \"ui_required\": false,\n    \"next_runtime_sprint\": \"FUNC-SPRINT-62\"\n  },\n  \"created_files\": [\n    \"src/devpilot_core/observability/trace_queries.py\",\n    \"tests/test_observability_cli.py\",\n    \"tests/test_sprint_61_documentation.py\",\n    \"docs/audits/func_sprint_61_trace_metrics_cli_audit.md\",\n    \"docs/functional_sprint_61_manifest.json\"\n  ],\n  \"modified_files\": [\n    \"README.md\",\n    \"docs/05_operations/runbook.md\",\n    \"docs/05_operations/observability_plan.md\",\n    \"docs/06_miasi/observability_card.md\",",
