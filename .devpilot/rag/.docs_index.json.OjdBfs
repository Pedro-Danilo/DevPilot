    {
      "chunk_id": "ragchunk_ff5d722f445f6739",
      "source": {
        "path": "docs/functional_sprint_22_manifest.json",
        "line_start": 36,
        "line_end": 75,
        "title": "{"
      },
      "fragment": "\"docs/05_operations/runbook.md\",\n    \"docs/devpilot_backlog_fase_A_baseline_industrial_minima.md\",\n    \"docs/functional_backlog_after_precode.md\",\n    \"tests/test_release_manifest.py\"\n  ],\n  \"commands\": [\n    \"python -m devpilot_core schema validate --schema docs/schemas/command_result.schema.json --instance <archivo-command-result.json> --json\",\n    \"python -m devpilot_core schema validate --schema CommandResult --instance <archivo-command-result.json> --json\",\n    \"python -m devpilot_core schema validate --schema EvidenceReport --instance outputs/reports/schema_list.json --json\",\n    \"python -m devpilot_core schema validate --schema docs/schemas/application_response.schema.json --instance <archivo-application-response.json> --json --write-report\",\n    \"python -m pytest tests/test_schema_validator.py -q\",\n    \"python -m pytest -q\"\n  ],\n  \"tests\": [\n    \"tests/test_schema_validator.py\",\n    \"tests/test_schema_registry.py\",\n    \"tests/test_release_manifest.py\"\n  ],\n  \"pass_criteria\": [\n    \"Valid JSON instances pass their registered schemas.\",\n    \"Invalid JSON instances produce actionable findings.\",\n    \"JSON parse errors are converted to CommandResult without uncontrolled stacktraces.\",\n    \"schema validate supports --json and --write-report.\",\n    \"jsonschema dependency is documented by ADR-0010.\",\n    \"No network, external API or API key is required.\",\n    \"pytest -q passes.\"\n  ],\n  \"block_criteria\": [\n    \"Invalid instances pass without findings.\",\n    \"The validator throws uncontrolled stacktraces.\",\n    \"A dependency is added without ADR.\",\n    \"Remote reference resolution is required.\",\n    \"Documentation overstates structural validation as semantic validation.\"\n  ],\n  \"risks\": [\n    \"JSON Schema validation is structural and does not replace business rules.\",\n    \"Initial schemas are permissive and require future hardening.\",\n    \"The new jsonschema dependency must be maintained below major version 5 until reviewed.\"\n  ],\n  \"next_sprint\": \"FUNC-SPRINT-23 — Schemas MIASI, Workspace, Providers y Sprint Manifests\"",
