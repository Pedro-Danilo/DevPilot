    {
      "chunk_id": "ragchunk_0d94a3ba222c25b3",
      "source": {
        "path": "docs/functional_sprint_53_manifest.json",
        "line_start": 71,
        "line_end": 105,
        "title": "{"
      },
      "fragment": "\"python -m devpilot_core prompt validate --json\",\n    \"python -m devpilot_core model budget status --limit 10 --json\",\n    \"python -m devpilot_core validate all --json\",\n    \"python -m devpilot_core miasi validate --json\",\n    \"python -m pytest -q\"\n  ],\n  \"tests\": [\n    \"tests/test_review_agents.py\",\n    \"tests/test_sprint_53_documentation.py\"\n  ],\n  \"pass_criteria\": [\n    \"CodeReviewAgent y PatchReviewAgent ejecutan en modo monoagente dry-run.\",\n    \"Ningún agente modifica archivos ni aplica patches.\",\n    \"Los agentes integran findings de CodeReviewEngine, PatchReviewEngine y PatchPreflightEngine.\",\n    \"Los agentes están registrados en MIASI con tools y políticas declaradas.\",\n    \"Los prompts están versionados y validados por PromptRegistry.\",\n    \"EvalRunner incluye casos safe/risky de code review y patch review.\",\n    \"Mock provider permite pruebas herméticas sin modelos locales ni APIs externas.\"\n  ],\n  \"block_criteria\": [\n    \"PatchReviewAgent aplica un patch.\",\n    \"CodeReviewAgent modifica código.\",\n    \"Algún agente usa provider externo o adapter directo.\",\n    \"Se requiere modelo local real para pruebas base.\",\n    \"Se persisten prompts, completions, patches o secretos crudos.\",\n    \"Se habilitan handoffs o multiagente.\"\n  ],\n  \"risks\": [\n    \"Los motores de revisión son heurísticos y pueden requerir calibración posterior.\",\n    \"La explicación model-aware con mock no evalúa calidad semántica real de modelos locales.\",\n    \"PatchPreflight no reemplaza tests de regresión ni revisión humana final.\"\n  ],\n  \"preliminary\": true,\n  \"next_sprint\": \"FUNC-SPRINT-54 — SafeRefactorAgent y TestPlannerAgent gobernados\"\n}",
