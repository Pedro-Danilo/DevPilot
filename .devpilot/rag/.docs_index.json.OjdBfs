      "fragment": "],\n  \"commands\": [\n    \"python -m devpilot_core schema validate --schema-id DocumentationSourceRegistry --instance .devpilot/docs_governance/source_registry.json --json\",\n    \"python -m devpilot_core schema list --json\",\n    \"python -m devpilot_core test-contracts validate --json\",\n    \"python -m devpilot_core test-contracts validate-v2 --json\"\n  ],\n  \"tests\": [\n    \"tests/test_documentation_source_registry_schema.py\",\n    \"tests/test_post_h_009_documentation_governance.py\",\n    \"tests/test_schema_registry.py\",\n    \"tests/test_project_global_state.py\",\n    \"tests/test_test_contract_registry.py\",\n    \"tests/test_test_contract_registry_v2.py\"\n  ],\n  \"pass_criteria\": [\n    \"DocumentationSourceRegistry validates against schema.\",\n    \"DocumentationGovernanceReport schema is registered for later micro-sprints.\",\n    \"Roadmap Markdown and JSON counterpart are declared.\",\n    \"Every source-of-truth entry has owner, status_required and required_tests.\",\n    \"Test contracts validate locally without network or external APIs.\"\n  ],\n  \"block_criteria\": [\n    \"A critical source-of-truth document is registered without tests.\",\n    \"Roadmap JSON is not linked to roadmap Markdown.\",\n    \"Registry schema is not registered in schema_catalog.\",\n    \"Validation requires network, LLM judge or external APIs.\"\n  ],\n  \"risks\": [\n    \"This is a registry/schema baseline only; executable drift detection is deferred.\",\n    \"Manual registry maintenance may drift until POST-H-009-B/C validators are implemented.\",\n    \"Some documents remain derived/current-state summaries rather than canonical decision sources.\"\n  ],\n  \"next_sprint\": \"POST-H-009\"\n}",
