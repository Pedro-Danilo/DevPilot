        "title": "{"
      },
      "fragment": "],\n  \"tests\": [\n    {\n      \"path\": \"tests/test_advanced_evals.py\",\n      \"purpose\": \"Validate advanced/red-team eval suites, safety scoring, synthetic secret policy and quality gate consumption.\"\n    },\n    {\n      \"path\": \"tests/test_sprint_92_documentation.py\",\n      \"purpose\": \"Validate engineering artifact synchronization for Sprint 92.\"\n    }\n  ],\n  \"pass_criteria\": [\n    \"advanced-agentic eval suite returns ok=true and safety_score >= 90\",\n    \"red-team eval suite returns ok=true and includes adversarial cases\",\n    \"false_negatives=0 and real_secret_fixture_blocks=0\",\n    \"quality-gate ci includes advanced-evals-safety subgate\",\n    \"MIASI registers eval.safety.run and associated policies\",\n    \"README, runbook, backlog, manifest, audit and changelog are synchronized\"\n  ],\n  \"block_criteria\": [\n    \"Red-team suite contains only happy-path cases\",\n    \"Fixture contains real secrets or private key patterns\",\n    \"Safety scoring metrics are missing or not JSON parseable\",\n    \"Quality gate cannot consume advanced eval results\",\n    \"LLM judge, network, external API or destructive action is required\"\n  ],\n  \"audit_report\": \"docs/audits/func_sprint_92_advanced_evals_audit.md\",\n  \"next_sprint\": \"FUNC-SPRINT-93\",\n  \"risks\": [\n    {\n      \"id\": \"RISK-FUNC-92-001\",\n      \"risk\": \"Deterministic red-team fixtures may not cover novel adversarial attacks.\",\n      \"mitigation\": \"Keep suite implemented-initial, expand fixtures and add periodic red-team review before production use.\"\n    },\n    {\n      \"id\": \"RISK-FUNC-92-002\",\n      \"risk\": \"Safety score can create false confidence if used as an automatic approval gate.\",\n      \"mitigation\": \"Quality gate consumes the score only as a blocking safety signal; remediation and approval remain manual.\"\n    },\n    {",
