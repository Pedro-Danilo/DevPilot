      },
      "fragment": "\"No cerrar si agrega dependencias externas innecesarias.\"\n  ],\n  \"risks\": [\n    {\n      \"id\": \"RISK-FUNC-77-001\",\n      \"risk\": \"Metadata incompleta\",\n      \"mitigation\": \"Manifest con versión, proyecto, Git, componentes, evidencias y artefactos esperados.\"\n    },\n    {\n      \"id\": \"RISK-FUNC-77-002\",\n      \"risk\": \"Git ausente en ZIP limpio\",\n      \"mitigation\": \"Soportar is_git_repo=false sin bloquear la generación del manifest.\"\n    },\n    {\n      \"id\": \"RISK-FUNC-77-003\",\n      \"risk\": \"Confundir manifest con release final\",\n      \"mitigation\": \"Documentar que packaging, SBOM, checksums, firma y publicación quedan para sprints posteriores.\"\n    }\n  ],\n  \"next_sprint\": \"FUNC-SPRINT-78 — Changelog generator y política de cambios\",\n  \"adr_required\": false,\n  \"adr_rationale\": \"No fue necesaria una ADR nueva: Sprint 77 implementa la estrategia de manifest y release local definida en ADR-0014 sin cambiar decisiones de publicación, packaging o seguridad.\",\n  \"audit_report\": \"docs/audits/func_sprint_77_release_manifest_audit.md\"\n}",
