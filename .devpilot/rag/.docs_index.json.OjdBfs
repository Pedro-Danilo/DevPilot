      "chunk_id": "ragchunk_97efba7d9d42d924",
      "source": {
        "path": "docs/post_h_010_c_manifest.json",
        "line_start": 36,
        "line_end": 75,
        "title": "{"
      },
      "fragment": "\"commands\": [\n    \"python -m pytest tests/test_observability_cleanup_plan.py tests/test_observability_inventory.py tests/test_post_h_010_observability_retention.py tests/test_observability_retention_schema.py tests/test_schema_registry.py tests/test_project_global_state.py -q\",\n    \"python -m devpilot_core observability cleanup-plan --json --write-report\",\n    \"python -m devpilot_core schema validate --schema-id ObservabilityCleanupPlan --instance outputs/reports/observability_cleanup_plan.json --json\",\n    \"python -m devpilot_core schema validate --schema-id PostHManifest --instance docs/post_h_010_c_manifest.json --json\",\n    \"python -m devpilot_core docs-governance validate --json\",\n    \"python -m devpilot_core test-contracts validate --json\",\n    \"python -m devpilot_core test-contracts validate-v2 --json\"\n  ],\n  \"tests\": [\n    \"tests/test_observability_cleanup_plan.py\",\n    \"tests/test_observability_inventory.py\",\n    \"tests/test_post_h_010_observability_retention.py\",\n    \"tests/test_observability_retention_schema.py\",\n    \"tests/test_schema_registry.py\",\n    \"tests/test_project_global_state.py\"\n  ],\n  \"pass_criteria\": [\n    \"Cleanup plan default es dry-run y mutations_performed=false.\",\n    \"El plan calcula acciones would_rotate, would_delete, would_archive, would_redact y would_export.\",\n    \"Acciones destructivas declaran requires_policy_engine=true y approval ids determinísticos.\",\n    \"El reporte ObservabilityCleanupPlan valida contra schema.\",\n    \"Path escape y targets bajo .git/src/docs/tests se bloquean.\"\n  ],\n  \"block_criteria\": [\n    \"Bloquear si se permite cleanup fuera del workspace.\",\n    \"Bloquear si el plan incluye .git, src, docs o tests como runtime cleanup targets.\",\n    \"Bloquear si se ejecuta borrado, rotación o archivado sin comando execute dedicado y aprobación.\",\n    \"Bloquear si network_used, external_api_used o source_mutations_performed son true.\",\n    \"Bloquear si --execute intenta mutar desde observability cleanup-plan.\"\n  ],\n  \"risks\": [\n    \"El comando es plan-only; no ejecuta cleanup real.\",\n    \"PolicyEngine se usa como simulación de aprobación, no como ejecución.\",\n    \"La exportación redactada todavía queda fuera del alcance hasta POST-H-010-D.\",\n    \"La integración de quality-gate queda para POST-H-010-E.\"\n  ],\n  \"next_sprint\": \"POST-H-010\",\n  \"preliminary\": true,\n  \"security\": {",
