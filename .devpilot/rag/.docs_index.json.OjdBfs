      "fragment": "\"python -m pytest tests/test_observability_retention_schema.py tests/test_post_h_010_observability_retention.py tests/test_schema_registry.py tests/test_documentation_governance_validator.py tests/test_project_global_state.py -q\",\n    \"python -m devpilot_core schema validate --schema-id ObservabilityRetentionPolicy --instance .devpilot/observability/retention_policy.json --json\",\n    \"python -m devpilot_core schema validate --schema-id PostHManifest --instance docs/post_h_010_a_manifest.json --json\",\n    \"python -m devpilot_core docs-governance validate --json\",\n    \"python -m devpilot_core test-contracts validate --json\",\n    \"python -m devpilot_core test-contracts validate-v2 --json\"\n  ],\n  \"tests\": [\n    \"tests/test_observability_retention_schema.py\",\n    \"tests/test_post_h_010_observability_retention.py\",\n    \"tests/test_schema_registry.py\",\n    \"tests/test_documentation_governance_validator.py\",\n    \"tests/test_project_global_state.py\"\n  ],\n  \"pass_criteria\": [\n    \"retention_policy.json valida contra ObservabilityRetentionPolicy.\",\n    \"Todos los targets críticos están clasificados.\",\n    \"remote_export_enabled=false, default_mode=dry-run y raw_prompts/raw_outputs/secrets=false.\",\n    \"outputs, .devpilot/devpilot.db y .devpilot/agent_sessions tienen clean_zip_excluded=true.\",\n    \"El backlog POST-H-010 queda approved y sincronizado con su mirror docs/POST-H-010_observability_retention.md.\"\n  ],\n  \"block_criteria\": [\n    \"Bloquear si se habilita export remoto o red/API externa.\",\n    \"Bloquear si se permite almacenar raw prompts, raw outputs o secretos.\",\n    \"Bloquear si se omiten events.jsonl, devpilot.db, agent_sessions, outputs/reports, metrics o traces.\",\n    \"Bloquear si un target runtime queda versionable/source_of_truth.\",\n    \"Bloquear si se implementa cleanup/export real en POST-H-010-A.\"\n  ],\n  \"risks\": [\n    \"La política no calcula todavía tamaños, fechas ni expiración real; eso queda para inventario POST-H-010-B.\",\n    \"La existencia de targets puede variar por workspace; POST-H-010-A valida contrato y defaults, no presencia runtime.\",\n    \"El scope metrics está modelado como ámbito lógico de .devpilot/devpilot.db hasta que POST-H-010-B inspeccione records de forma segura.\",\n    \"El gate de calidad todavía no consume esta política; queda para POST-H-010-E.\"\n  ],\n  \"next_sprint\": \"POST-H-010\",\n  \"preliminary\": true,\n  \"security\": {\n    \"local_first\": true,\n    \"dry_run\": true,\n    \"network_used\": false,",
