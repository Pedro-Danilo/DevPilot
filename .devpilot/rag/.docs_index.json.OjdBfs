      "fragment": "\"src/devpilot_core/review/__init__.py\",\n    \"tests/test_sprint_31_documentation.py\",\n    \"tests/test_sprint_32_documentation.py\",\n    \"tests/test_sprint_33_documentation.py\",\n    \"tests/test_sprint_34_documentation.py\",\n    \"tests/test_sprint_35_documentation.py\",\n    \"tests/test_sprint_36_documentation.py\",\n    \"tests/test_sprint_37_documentation.py\",\n    \"tests/test_sprint_38_documentation.py\",\n    \"tests/test_sprint_39_documentation.py\"\n  ],\n  \"commands\": [\n    \"python -m devpilot_core patch check --patch-file safe.patch --json\",\n    \"python -m devpilot_core patch check --patch-file safe.patch --json --write-report\",\n    \"python -m devpilot_core miasi validate --json\",\n    \"python -m pytest -q\"\n  ],\n  \"tests\": [\n    \"tests/test_patch_preflight.py\",\n    \"tests/test_sprint_40_documentation.py\"\n  ],\n  \"pass_criteria\": [\n    \"PatchPreflightEngine combines patch review, policy checks and git apply --check.\",\n    \"The command supports patch check --patch-file ... --json.\",\n    \"The command supports --write-report.\",\n    \"Applicable patches return PASS without applying changes.\",\n    \"Non-applicable patches return FAIL without applying changes.\",\n    \"Security/policy findings return BLOCK.\",\n    \"SafeSubprocessRunner allowlist contains only git apply --check for patch applicability.\",\n    \"MIASI declares patch.check.\"\n  ],\n  \"block_criteria\": [\n    \"The preflight modifies workspace files.\",\n    \"The preflight uses subprocess without SafeSubprocessRunner or allowlist.\",\n    \"Secret-like patches reach apply-check instead of being blocked first.\",\n    \"Malformed patches crash the command.\",\n    \"The sprint enables patch apply, sandbox, ChangeSet, rollback, Git write or deploy.\"\n  ],\n  \"risks\": [\n    \"git apply --check depends on Git availability.\",",
