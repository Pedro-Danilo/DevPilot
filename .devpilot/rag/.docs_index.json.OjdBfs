      "fragment": "\"block_criteria\": [\n    \"Se registran prompts, completions, diffs, patches, stdout/stderr o secretos crudos.\",\n    \"Se introduce dependencia externa obligatoria o telemetría remota.\",\n    \"Las métricas alteran el resultado funcional de comandos/model calls.\",\n    \"MetricsCollector falla cuando no existe DB inicializada.\",\n    \"El provider mock reporta costo real externo o external_api_used=true.\"\n  ],\n  \"risks\": [\n    {\n      \"id\": \"RISK-FUNC-59-001\",\n      \"risk\": \"Sobrecarga excesiva\",\n      \"mitigation\": \"Métricas simples y best-effort.\"\n    },\n    {\n      \"id\": \"RISK-FUNC-59-002\",\n      \"risk\": \"Confundir estimación con costo real\",\n      \"mitigation\": \"Campo estimated explícito y costo mock 0.0.\"\n    },\n    {\n      \"id\": \"RISK-FUNC-59-003\",\n      \"risk\": \"Datos sensibles en metadata\",\n      \"mitigation\": \"Redacción obligatoria mediante sanitize_metric_metadata.\"\n    },\n    {\n      \"id\": \"RISK-FUNC-59-004\",\n      \"risk\": \"Instrumentación agentic incompleta\",\n      \"mitigation\": \"Dejar API lista y mover runtime a FUNC-SPRINT-60.\"\n    }\n  ],\n  \"next_sprint\": \"FUNC-SPRINT-60 — Instrumentación agentic: agentes, tools, approvals y model calls\"\n}",
