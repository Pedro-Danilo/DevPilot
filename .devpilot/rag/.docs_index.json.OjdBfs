    {
      "chunk_id": "ragchunk_9678bdac98788718",
      "source": {
        "path": "docs/functional_sprint_24_manifest.json",
        "line_start": 36,
        "line_end": 75,
        "title": "{"
      },
      "fragment": "\"tests/test_sprint_22_documentation.py\",\n    \"tests/test_sprint_23_documentation.py\"\n  ],\n  \"commands\": [\n    \"python -m devpilot_core validate docs --json\",\n    \"python -m devpilot_core validate contracts --json\",\n    \"python -m devpilot_core validate all --json --write-report\",\n    \"python -m devpilot_core schema validate --schema ArtifactProfiles --instance docs/validation/artifact_profiles.json --json\",\n    \"python -m pytest tests/test_artifact_profile_registry.py -q\",\n    \"python -m pytest tests/test_validation_gateway.py -q\",\n    \"python -m pytest -q\"\n  ],\n  \"tests\": [\n    \"tests/test_artifact_profile_registry.py\",\n    \"tests/test_validation_gateway.py\",\n    \"tests/test_sprint_24_documentation.py\",\n    \"tests/test_schema_registry.py\"\n  ],\n  \"pass_criteria\": [\n    \"Artifact profiles JSON covers the existing Python profile catalog.\",\n    \"Artifact profiles JSON validates against ArtifactProfiles schema.\",\n    \"ArtifactProfileRegistry loads JSON profiles and keeps Python fallback.\",\n    \"ValidationGateway validates docs/contracts/all with CommandResult.\",\n    \"Warnings remain non-blocking warnings.\",\n    \"Gateway preserves underlying findings and does not duplicate validator logic.\",\n    \"No network, API key or destructive action is introduced.\",\n    \"pytest -q passes.\"\n  ],\n  \"block_criteria\": [\n    \"Changing profiles breaks readiness strict.\",\n    \"ValidationGateway hides findings emitted by internal validators.\",\n    \"Python profile fallback is removed before migration is stable.\",\n    \"A new dependency or runtime policy is added without ADR.\",\n    \"validate all produces a non-CommandResult response.\"\n  ],\n  \"risks\": [\n    \"JSON and Python profile catalogs can drift if future changes are not synchronized.\",\n    \"ValidationGateway can grow into duplicated validation logic if not kept as a facade.\",\n    \"validate all output is intentionally verbose because it preserves evidence details.\",\n    \"Traceability is not implemented yet and remains Sprint 25 scope.\"",
      "tokens": {
