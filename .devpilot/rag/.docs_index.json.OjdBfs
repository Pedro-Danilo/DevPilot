    {
      "chunk_id": "ragchunk_f20b66af809e5f8e",
      "source": {
        "path": "docs/functional_sprint_31_manifest.json",
        "line_start": 36,
        "line_end": 69,
        "title": "{"
      },
      "fragment": "\"python -m devpilot_core validate-frontmatter docs/audits/func_sprint_31_safe_subprocess_runner_audit.md --strict --json\",\n    \"python -m devpilot_core validate-artifact docs/audits/func_sprint_31_safe_subprocess_runner_audit.md --strict --json\",\n    \"python -m pytest -q\"\n  ],\n  \"tests\": [\n    \"tests/test_safe_subprocess_runner.py\",\n    \"tests/test_sprint_31_documentation.py\"\n  ],\n  \"pass_criteria\": [\n    \"SafeSubprocessRunner uses argument lists and never shell=True.\",\n    \"Commands outside the local allowlist are blocked.\",\n    \"cwd outside workspace is blocked by PathGuard.\",\n    \"Timeout is enforced.\",\n    \"stdout/stderr are redacted and truncated.\",\n    \"Execution result is serializable as CommandResult.\",\n    \"pytest -q passes.\"\n  ],\n  \"block_criteria\": [\n    \"Shell strings are accepted.\",\n    \"Unallowlisted commands execute.\",\n    \"cwd outside workspace executes.\",\n    \"Timeout does not terminate execution.\",\n    \"Secrets are emitted raw in stdout/stderr.\",\n    \"The sprint exposes arbitrary command execution or implements tests.run prematurely.\"\n  ],\n  \"risks\": [\n    \"The allowlist must remain narrow until Sprint 32 integrates tests.run with policy and approval.\",\n    \"Output redaction is a first conservative layer and does not replace industrial secret scanning.\",\n    \"No full filesystem sandbox or rollback exists yet.\",\n    \"Allowed pytest runs can execute test code; Sprint 32 must keep policy/approval checks in front of tests.run.\"\n  ],\n  \"preliminary\": true,\n  \"next_sprint\": \"FUNC-SPRINT-32 — tests.run como herramienta MIASI controlada\"\n}",
