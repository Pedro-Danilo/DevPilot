      },
      "fragment": "\"python -m devpilot_core miasi validate --json\",\n    \"python -m pytest -q\"\n  ],\n  \"tests\": [\n    \"tests/test_repo_analysis_agent.py\",\n    \"tests/test_sprint_52_documentation.py\"\n  ],\n  \"pass_criteria\": [\n    \"RepoAnalysisAgent ejecuta en modo monoagente read-only.\",\n    \"El agente usa allowed_tools declaradas en MIASI.\",\n    \"Provider mock activa model calls gobernadas por PromptRegistry y ModelAdapterRouter.\",\n    \"EvalRunner incluye casos repo-analysis y repo-analysis model-aware.\",\n    \"No se almacenan prompts, completions ni secretos crudos.\",\n    \"No hay handoffs ni multiagente.\"\n  ],\n  \"block_criteria\": [\n    \"El agente modifica archivos o ejecuta Git write.\",\n    \"El agente usa tools no declaradas o adapters directos.\",\n    \"Se requiere modelo local real para tests.\",\n    \"Se habilita una API externa.\",\n    \"Se persiste prompt/completion crudo o secreto.\"\n  ],\n  \"risks\": [\n    \"El análisis es heurístico y no sustituye SAST/SCA industrial ni revisión humana.\",\n    \"La priorización inicial puede requerir calibración con métricas históricas.\",\n    \"La salida model-aware con mock valida arquitectura, no calidad semántica final.\"\n  ],\n  \"preliminary\": true,\n  \"next_sprint\": \"FUNC-SPRINT-53 — CodeReviewAgent y PatchReviewAgent gobernados\"\n}",
