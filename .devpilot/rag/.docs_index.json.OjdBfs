      "fragment": "{\n  \"sprint\": \"FUNC-SPRINT-48\",\n  \"title\": \"Model governance: health, capability matrix y budget ledger\",\n  \"status\": \"implemented\",\n  \"implemented_at\": \"2026-06-12\",\n  \"phase\": \"FASE-D-IA-LOCAL-GOBERNADA\",\n  \"wave\": \"Ola 6 — ModelAdapter real local-first\",\n  \"source_backlog\": \"docs/devpilot_backlog_fase_D_ia_local_gobernada.md\",\n  \"architectural_decision\": {\n    \"required\": false,\n    \"adr\": \"docs/02_architecture/adrs/ADR-0011-local-model-providers.md\",\n    \"reason\": \"FUNC-SPRINT-48 ejecuta la arquitectura local-first aprobada en ADR-0011. No introduce proveedores externos, no cambia el boundary de ModelAdapterRouter y agrega gobierno operativo sobre providers locales ya declarados.\"\n  },\n  \"created_files\": [\n    \"src/devpilot_core/modeling/health.py\",\n    \"src/devpilot_core/modeling/capabilities.py\",\n    \"src/devpilot_core/modeling/budget.py\",\n    \"tests/test_model_governance.py\",\n    \"tests/test_sprint_48_documentation.py\",\n    \"docs/audits/func_sprint_48_model_governance_audit.md\",\n    \"docs/functional_sprint_48_manifest.json\"\n  ],\n  \"modified_files\": [\n    \".devpilot/miasi/policy_matrix.json\",\n    \".devpilot/miasi/tool_registry.json\",\n    \"README.md\",\n    \"docs/04_quality/test_strategy.md\",\n    \"docs/05_operations/runbook.md\",\n    \"docs/06_miasi/policy_card.md\",\n    \"docs/06_miasi/tool_card.md\",\n    \"docs/06_miasi/tool_registry.md\",\n    \"docs/devpilot_backlog_fase_D_ia_local_gobernada.md\",\n    \"docs/functional_backlog_after_precode.md\",\n    \"src/devpilot_core/cli.py\",\n    \"src/devpilot_core/modeling/__init__.py\",\n    \"src/devpilot_core/modeling/router.py\",\n    \"src/devpilot_core/store/local_store.py\"\n  ],\n  \"commands\": [\n    \"python -m devpilot_core model health --json\",",
