    {
      "chunk_id": "ragchunk_6d47848f2cf55063",
      "source": {
        "path": "docs/functional_sprint_38_manifest.json",
        "line_start": 36,
        "line_end": 75,
        "title": "{"
      },
      "fragment": "\"tests/test_sprint_34_documentation.py\",\n    \"tests/test_sprint_35_documentation.py\",\n    \"tests/test_sprint_36_documentation.py\",\n    \"tests/test_sprint_37_documentation.py\"\n  ],\n  \"commands\": [\n    \"python -m devpilot_core repo architecture-drift --json\",\n    \"python -m devpilot_core repo architecture-drift --json --write-report\",\n    \"python -m devpilot_core miasi validate --json\",\n    \"python -m pytest -q\"\n  ],\n  \"tests\": [\n    \"tests/test_architecture_drift_repo.py\",\n    \"tests/test_sprint_38_documentation.py\"\n  ],\n  \"pass_criteria\": [\n    \"ArchitectureDriftDetector compares documented components against real code modules.\",\n    \"The command returns CommandResult and supports --json/--write-report.\",\n    \"Findings separate doc_missing, code_missing and name_mismatch.\",\n    \"The output matrix includes confidence and documented status.\",\n    \"planned/future/disabled components without code are not blocking.\",\n    \"MIASI declares repo.architecture_drift as a read-only tool.\",\n    \"pytest -q passes.\"\n  ],\n  \"block_criteria\": [\n    \"The detector invents relationships not supported by path, exact name, alias or fuzzy confidence.\",\n    \"The detector modifies documentation or code automatically.\",\n    \"The detector executes/imports code under analysis.\",\n    \"The detector uses LLM, network or external APIs.\",\n    \"The detector marks planned/future components without code as BLOCK.\",\n    \"Patch apply, Git write, refactor execution, sandbox or deploy are enabled.\"\n  ],\n  \"risks\": [\n    \"Markdown/Mermaid extraction is heuristic.\",\n    \"Alias/fuzzy matching can produce false positives or false negatives.\",\n    \"The detector is not a Component Registry, SAST/SCA, runtime call graph or industrial certification.\",\n    \"Future evolution should add explicit architecture-code mapping contracts.\"\n  ],\n  \"preliminary\": true,\n  \"next_sprint\": \"FUNC-SPRINT-39 — ReviewRulePacks y quality gate de revisión\"",
