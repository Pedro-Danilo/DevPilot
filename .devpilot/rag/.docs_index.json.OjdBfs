      "fragment": "\"La firma/cifrado de audit exports queda para hardening posterior.\",\n    \"POST-H-010 queda cerrado como base local de retención/higiene, no como declaración production-ready final.\",\n    \"La ejecución real de cleanup sigue deshabilitada por diseño.\"\n  ],\n  \"next_sprint\": \"POST-H-011\",\n  \"preliminary\": true,\n  \"security\": {\n    \"local_first\": true,\n    \"dry_run\": true,\n    \"read_only\": true,\n    \"redaction_required\": true,\n    \"raw_payloads_read\": false,\n    \"raw_prompts_exported\": false,\n    \"raw_outputs_exported\": false,\n    \"secrets_exported\": false,\n    \"network_used\": false,\n    \"external_api_used\": false,\n    \"mutations_performed\": false,\n    \"destructive_cleanup_performed\": false,\n    \"source_mutations_performed\": false,\n    \"remote_execution_enabled\": false,\n    \"connector_write_enabled\": false,\n    \"plugin_execution_enabled\": false\n  }\n}",
