      "chunk_id": "ragchunk_be8adf68c6af18e2",
      "source": {
        "path": "docs/functional_sprint_39_manifest.json",
        "line_start": 36,
        "line_end": 75,
        "title": "{"
      },
      "fragment": "\"tests/test_sprint_32_documentation.py\",\n    \"tests/test_sprint_33_documentation.py\",\n    \"tests/test_sprint_34_documentation.py\",\n    \"tests/test_sprint_35_documentation.py\",\n    \"tests/test_sprint_36_documentation.py\",\n    \"tests/test_sprint_37_documentation.py\",\n    \"tests/test_sprint_38_documentation.py\"\n  ],\n  \"commands\": [\n    \"python -m devpilot_core repo quality-gate --json\",\n    \"python -m devpilot_core repo quality-gate --json --write-report\",\n    \"python -m devpilot_core miasi validate --json\",\n    \"python -m pytest -q\"\n  ],\n  \"tests\": [\n    \"tests/test_repo_quality_gate.py\",\n    \"tests/test_sprint_39_documentation.py\"\n  ],\n  \"pass_criteria\": [\n    \"ReviewRulePacks are grouped and versioned.\",\n    \"RepoQualityGate integrates RepoAnalyzer, CodeReviewEngine, optional PatchReviewEngine and PolicyEngine.\",\n    \"The command returns PASS, FAIL, BLOCK or ERROR through CommandResult.\",\n    \"The command supports --json and --write-report.\",\n    \"Warnings are advisory and do not block by default.\",\n    \"FAIL/BLOCK findings from integrated engines propagate to gate status.\",\n    \"MIASI declares repo.quality_gate.\"\n  ],\n  \"block_criteria\": [\n    \"The gate ignores BLOCK findings from integrated engines.\",\n    \"The gate emits raw secrets.\",\n    \"The gate applies patches or mutates files.\",\n    \"The gate executes Git write, refactor execution or deploy.\",\n    \"The gate uses LLMs, network or external APIs.\",\n    \"The gate blocks on informational warnings by default.\"\n  ],\n  \"risks\": [\n    \"Rule severity defaults may need tuning per repository.\",\n    \"The default code-review target is intentionally bounded to avoid legacy false positives.\",\n    \"The gate is not a replacement for SAST/SCA, license scanning, coverage, CI/CD or human review.\",\n    \"Future sprints should add patch preflight, sandbox, ChangeSet and rollback integration.\"",
