    {
      "chunk_id": "ragchunk_f2c503836c0894f4",
      "source": {
        "path": "docs/functional_sprint_83_manifest.json",
        "line_start": 71,
        "line_end": 104,
        "title": "{"
      },
      "fragment": "\"backup create dry-run returns PASS without writing artifacts.\",\n    \"backup create --execute writes a local backup ZIP and sidecar manifest.\",\n    \"backup list returns local backup catalog.\",\n    \"backup restore is dry-run by default.\",\n    \"backup restore --execute requires --confirm-restore.\",\n    \"upgrade check returns a local non-mutating plan.\",\n    \"Backup excludes .git, .venv, node_modules, outputs, dist and caches by default.\",\n    \"SecretGuard redacts or reports sensitive textual content.\"\n  ],\n  \"block_criteria\": [\n    \"Do not close if restore overwrites without explicit confirmation.\",\n    \"Do not close if backup includes .git or .venv by default.\",\n    \"Do not close if backup stores secrets without redaction or warning.\",\n    \"Do not close if upgrade check mutates files or requires network.\"\n  ],\n  \"risks\": [\n    {\n      \"id\": \"RISK-FUNC-83-001\",\n      \"risk\": \"Pérdida de datos por restore accidental\",\n      \"mitigation\": \"Dry-run por defecto y --execute + --confirm-restore para sobrescrituras.\"\n    },\n    {\n      \"id\": \"RISK-FUNC-83-002\",\n      \"risk\": \"Exfiltración de secretos\",\n      \"mitigation\": \"SecretGuard y redacción por defecto de archivos textuales.\"\n    },\n    {\n      \"id\": \"RISK-FUNC-83-003\",\n      \"risk\": \"Upgrade incompatible\",\n      \"mitigation\": \"upgrade check plan-only con backup previo requerido como práctica.\"\n    }\n  ],\n  \"next_sprint\": \"FUNC-SPRINT-84 — ReleaseAgent MVP dry-run y cierre Fase G\"\n}",
      "tokens": {
