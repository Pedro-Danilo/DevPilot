      "fragment": "\"src/devpilot_core/modeling/router.py\",\n    \"src/devpilot_core/store/local_store.py\"\n  ],\n  \"commands\": [\n    \"python -m devpilot_core model health --json\",\n    \"python -m devpilot_core model capabilities --json\",\n    \"python -m devpilot_core model budget status --json\",\n    \"python -m devpilot_core model generate --provider mock --prompt \\\"test\\\" --json\",\n    \"python -m devpilot_core miasi validate --json\",\n    \"python -m pytest -q\"\n  ],\n  \"tests\": [\n    \"tests/test_model_governance.py\",\n    \"tests/test_sprint_48_documentation.py\"\n  ],\n  \"pass_criteria\": [\n    \"Health/capabilities reportan mock/local/external states.\",\n    \"Budget ledger registra eventos sin costos externos por defecto.\",\n    \"Fallback a mock queda documentado y es explícito/configurado.\",\n    \"No hay llamadas externas.\",\n    \"cost_events no guarda prompts completos con secretos.\"\n  ],\n  \"block_criteria\": [\n    \"Budget permite gasto externo por defecto.\",\n    \"Provider unavailable falla con crash.\",\n    \"cost_events guardan prompts, completions o secretos crudos.\",\n    \"Fallback ocurre de forma silenciosa o no auditable.\"\n  ],\n  \"risks\": [\n    \"Costos locales no son monetarios; se separa monetary_cost de compute_estimate_units.\",\n    \"Capability matrix puede quedar obsoleta; se documenta como implemented-initial.\",\n    \"Exceso de logging; se registra metadata redacted y no payloads crudos.\"\n  ],\n  \"preliminary\": true,\n  \"next_sprint\": \"FUNC-SPRINT-49 — Prompt Registry y Prompt Packs gobernados\"\n}",
