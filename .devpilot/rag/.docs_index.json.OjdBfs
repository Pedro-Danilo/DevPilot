      "fragment": "\"docs/devpilot_backlog_fase_D_ia_local_gobernada.md\",\n    \"docs/functional_backlog_after_precode.md\",\n    \"docs/schemas/schema_catalog.json\",\n    \"src/devpilot_core/cli.py\",\n    \"src/devpilot_core/modeling/budget.py\",\n    \"src/devpilot_core/validation/gateway.py\"\n  ],\n  \"commands\": [\n    \"python -m devpilot_core prompt list --json\",\n    \"python -m devpilot_core prompt validate --json\",\n    \"python -m devpilot_core prompt show model.generate.default --json\",\n    \"python -m devpilot_core model generate --provider mock --prompt-id model.generate.default --prompt-input \\\"user_request=test\\\" --prompt-input \\\"project_context=DevPilot\\\" --json\",\n    \"python -m devpilot_core validate all --json\",\n    \"python -m devpilot_core miasi validate --json\",\n    \"python -m pytest -q\"\n  ],\n  \"tests\": [\n    \"tests/test_prompt_registry.py\",\n    \"tests/test_sprint_49_documentation.py\"\n  ],\n  \"pass_criteria\": [\n    \"Prompts tienen id/version/status y schema válido.\",\n    \"Prompt validation combina schema, placeholders y safety básica.\",\n    \"PromptSafetyChecker produce findings para secretos e injection patterns básicos.\",\n    \"prompt show no expone secretos crudos.\",\n    \"model generate --prompt-id registra prompt_id/version sin almacenar prompt crudo en cost_events.\",\n    \"No hay red ni APIs externas.\"\n  ],\n  \"block_criteria\": [\n    \"Prompt sin id/version o schema inválido.\",\n    \"Prompt show expone secretos crudos.\",\n    \"Prompt render acepta inputs no declarados.\",\n    \"Model calls gobernadas no registran prompt_id/version.\",\n    \"cost_events guardan prompts o completions crudos.\"\n  ],\n  \"risks\": [\n    \"Prompt registry demasiado rígido; se permite inputs declarados con metadata.\",\n    \"Prompt injection checks incompletos; se documentan como básicos e implemented-initial.\",\n    \"Duplicación de prompts; se bloquea por id/version duplicado.\",\n    \"No hay prompt packs avanzados ni eval matrix aún; queda para sprints posteriores.\"",
