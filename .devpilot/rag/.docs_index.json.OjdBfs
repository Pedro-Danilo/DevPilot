      "chunk_id": "ragchunk_3d5d94101b69a2cd",
      "source": {
        "path": "docs/functional_sprint_54_manifest.json",
        "line_start": 71,
        "line_end": 103,
        "title": "{"
      },
      "fragment": "\"python -m devpilot_core validate all --json\",\n    \"python -m devpilot_core miasi validate --json\",\n    \"python -m pytest -q\"\n  ],\n  \"tests\": [\n    \"tests/test_refactor_testplanner_agents.py\",\n    \"tests/test_sprint_54_documentation.py\"\n  ],\n  \"pass_criteria\": [\n    \"SafeRefactorAgent y TestPlannerAgent ejecutan en modo monoagente plan-only/dry-run.\",\n    \"SafeRefactorAgent no modifica workspace real, no invoca RefactorExecutor y no genera/aplica patches.\",\n    \"TestPlannerAgent produce plan trazable y no ejecuta tests.run ni comandos arbitrarios.\",\n    \"Los agentes están registrados en MIASI con tools y políticas declaradas.\",\n    \"Los prompts están versionados y validados por PromptRegistry.\",\n    \"EvalRunner incluye casos offline de refactor plan-only y test planning.\",\n    \"Mock provider permite pruebas herméticas sin modelos locales ni APIs externas.\"\n  ],\n  \"block_criteria\": [\n    \"safe-refactor modifica workspace real sin approval.\",\n    \"test-planner ejecuta comandos arbitrarios o tests.run sin aprobación.\",\n    \"Algún agente usa provider externo o adapter directo.\",\n    \"Se requiere modelo local real para pruebas base.\",\n    \"Se persisten prompts, completions, código fuente o secretos crudos.\",\n    \"Se habilitan handoffs o multiagente.\"\n  ],\n  \"risks\": [\n    \"Los planes de refactor son heurísticos y requieren revisión humana antes de ejecución real.\",\n    \"La planificación de pruebas depende de trazabilidad explícita y no infiere cobertura semántica profunda.\",\n    \"La explicación model-aware con mock no evalúa calidad semántica real de modelos locales.\"\n  ],\n  \"preliminary\": true,\n  \"next_sprint\": \"FUNC-SPRINT-55 — Requirements/Architecture/Security agents y cierre Fase D\"\n}",
