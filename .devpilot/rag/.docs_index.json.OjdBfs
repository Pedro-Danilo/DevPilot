      "fragment": "\"src/devpilot_core/modeling/router.py\"\n  ],\n  \"commands\": [\n    \"python -m devpilot_core model health --provider ollama --json\",\n    \"python -m devpilot_core model generate --provider ollama --prompt \\\"test\\\" --json\",\n    \"python -m devpilot_core model generate --provider mock --prompt \\\"test\\\" --json\",\n    \"python -m devpilot_core miasi validate --json\",\n    \"python -m pytest -q\"\n  ],\n  \"tests\": [\n    \"tests/test_ollama_adapter.py\",\n    \"tests/test_sprint_46_documentation.py\"\n  ],\n  \"pass_criteria\": [\n    \"Sin Ollama disponible, health devuelve unavailable controlado.\",\n    \"Con fake server, generate/classify/embed pasan.\",\n    \"No hay API externa ni API key.\",\n    \"SecretGuard bloquea prompts sensibles antes de request.\",\n    \"Provider disabled bloquea model calls sin contactar servidor.\"\n  ],\n  \"block_criteria\": [\n    \"Tests requieren Ollama real.\",\n    \"Indisponibilidad produce traceback.\",\n    \"Provider local evade CostGuard/PolicyEngine.\",\n    \"Endpoint remoto queda permitido.\",\n    \"Prompt secreto llega al provider.\"\n  ],\n  \"risks\": [\n    \"Compatibilidad de endpoints Ollama puede variar por versión.\",\n    \"No hay streaming ni retries complejos todavía.\",\n    \"Budget ledger persistente queda para FUNC-SPRINT-48.\",\n    \"AgentRuntime model-aware queda para FUNC-SPRINT-51.\"\n  ],\n  \"preliminary\": true,\n  \"next_sprint\": \"FUNC-SPRINT-47 — LMStudioAdapter local OpenAI-compatible\"\n}",
