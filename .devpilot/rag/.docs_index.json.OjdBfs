        "title": "{"
      },
      "fragment": "\"src/devpilot_core/execution/safe_subprocess.py\",\n    \"src/devpilot_core/approval/__init__.py\",\n    \"tests/test_safe_subprocess_runner.py\"\n  ],\n  \"commands\": [\n    \"python -m devpilot_core security readiness --json --write-report\",\n    \"python -m devpilot_core policy simulate --matrix standard --json --write-report\",\n    \"python -m devpilot_core approval list --json\",\n    \"python -m devpilot_core miasi validate --json\",\n    \"python -m devpilot_core tests run --profile unit --approval-id <approval_id> --json --write-report\",\n    \"python -m pytest -q\"\n  ],\n  \"tests\": [\n    \"tests/test_security_readiness.py\",\n    \"tests/test_sprint_34_documentation.py\",\n    \"safe_subprocess environment controls\"\n  ],\n  \"pass_criteria\": [\n    \"Security readiness verifies Approval Workflow.\",\n    \"Security readiness verifies PolicyEngine approval binding.\",\n    \"Security readiness verifies controlled tests.run smoke execution.\",\n    \"Policy simulation matrix covers missing, valid, wrong-scope and expired approvals.\",\n    \"SecretGuard, PromptInjectionGuard and ToolInjectionGuard are checked with synthetic payloads.\",\n    \"Fase B closure checklist and report exist.\",\n    \"pytest -q passes.\"\n  ],\n  \"block_criteria\": [\n    \"An approval-gated action passes without valid approval.\",\n    \"tests.run allows a non-allowlisted command.\",\n    \"Raw secrets appear in evidence.\",\n    \"Fase B closes without checklist or closure report.\",\n    \"Patch apply, refactor execution, Git write or deploy are enabled.\"\n  ],\n  \"risks\": [\n    \"Security readiness is not a full security certification.\",\n    \"Policy simulation uses deterministic fixtures and does not replace red teaming.\",\n    \"Fase C still requires sandbox and rollback before destructive actions.\"\n  ],\n  \"preliminary\": true,\n  \"next_sprint\": \"FUNC-SPRINT-35 — Inicio Fase C: ingeniería de repositorio y sandbox controlado\",",
