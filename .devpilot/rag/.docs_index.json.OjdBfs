      "fragment": "\"Release manifest visual MVP existe.\"\n  ],\n  \"block_criteria\": [\n    \"Desktop shell implementado sin ADR posterior.\",\n    \"UI requiere cloud o API externa.\",\n    \"UI lee filesystem local directamente.\",\n    \"No hay reporte de cierre ni release manifest.\"\n  ],\n  \"risks\": [\n    \"Confundir MVP visual local con producto web multiusuario.\",\n    \"Reabrir Desktop prematuramente.\",\n    \"Regresión CLI por integración visual.\",\n    \"Dependencias frontend inestables.\"\n  ],\n  \"next_sprint\": \"FUNC-SPRINT-74 — ADR de release, versionado y productización\",\n  \"adr_required\": false,\n  \"adr_rationale\": \"ADR-0013 y el backlog aprobado de Fase F ya establecen Web UI local first, Web UI real futura y Desktop diferido. Sprint 73 cierra y documenta la decisión, no cambia arquitectura.\",\n  \"closure_report\": \"docs/audits/phase_f_visual_product_closure_report.md\",\n  \"release_manifest\": \"docs/release/release_manifest_visual_mvp.json\"\n}",
