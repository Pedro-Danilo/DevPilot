      "fragment": "{\n  \"sprint\": \"FUNC-SPRINT-36\",\n  \"title\": \"DependencyGraph e import graph Python\",\n  \"status\": \"implemented\",\n  \"implemented_at\": \"2026-06-11\",\n  \"phase\": \"FASE-C-INGENIERIA-DE-REPOSITORIO\",\n  \"wave\": \"Ola 4 — Repo intelligence y revisión industrial\",\n  \"source_backlog\": \"docs/devpilot_backlog_fase_C_ingenieria_repositorio.md\",\n  \"architectural_decision\": {\n    \"required\": false,\n    \"adr\": null,\n    \"reason\": \"FUNC-SPRINT-36 agrega un analizador estático local basado en AST, sin dependencias externas, sin red, sin APIs, sin ejecución de código analizado, sin UI, sin sandbox real y sin acciones destructivas. Mantiene la arquitectura local-first y read-only de Fase C.\"\n  },\n  \"created_files\": [\n    \"src/devpilot_core/repo/models.py\",\n    \"src/devpilot_core/repo/dependency_graph.py\",\n    \"tests/test_dependency_graph.py\",\n    \"tests/test_sprint_36_documentation.py\",\n    \"docs/audits/func_sprint_36_dependency_graph_audit.md\",\n    \"docs/functional_sprint_36_manifest.json\"\n  ],\n  \"modified_files\": [\n    \"src/devpilot_core/repo/__init__.py\",\n    \"src/devpilot_core/cli.py\",\n    \".devpilot/miasi/tool_registry.json\",\n    \".devpilot/miasi/agent_registry.json\",\n    \"README.md\",\n    \"docs/05_operations/runbook.md\",\n    \"docs/devpilot_backlog_fase_C_ingenieria_repositorio.md\",\n    \"docs/functional_backlog_after_precode.md\",\n    \"docs/06_miasi/tool_registry.md\",\n    \"docs/06_miasi/tool_card.md\",\n    \"tests/test_sprint_32_documentation.py\",\n    \"tests/test_sprint_33_documentation.py\",\n    \"tests/test_sprint_34_documentation.py\",\n    \"tests/test_sprint_35_documentation.py\"\n  ],\n  \"commands\": [\n    \"python -m devpilot_core repo dependency-graph --target src/devpilot_core --json\",\n    \"python -m devpilot_core repo dependency-graph --target src/devpilot_core --json --write-report\",",
