      "fragment": "{\n  \"sprint\": \"FUNC-SPRINT-49\",\n  \"title\": \"Prompt Registry y contratos de prompt seguro\",\n  \"status\": \"implemented\",\n  \"implemented_at\": \"2026-06-12\",\n  \"phase\": \"FASE-D-IA-LOCAL-GOBERNADA\",\n  \"wave\": \"Ola 6 — ModelAdapter real local-first\",\n  \"source_backlog\": \"docs/devpilot_backlog_fase_D_ia_local_gobernada.md\",\n  \"architectural_decision\": {\n    \"required\": false,\n    \"adr\": \"docs/02_architecture/adrs/ADR-0011-local-model-providers.md\",\n    \"reason\": \"FUNC-SPRINT-49 ejecuta la regla central de Fase D sobre prompts versionados y trazados. No introduce un nuevo proveedor, no habilita APIs externas y no cambia el boundary de ModelAdapterRouter; agrega contratos de prompt sobre la arquitectura local-first ya aprobada.\"\n  },\n  \"created_files\": [\n    \"src/devpilot_core/prompts/__init__.py\",\n    \"src/devpilot_core/prompts/registry.py\",\n    \"src/devpilot_core/prompts/safety.py\",\n    \"docs/schemas/prompt.schema.json\",\n    \"docs/prompts/model.generate.default.v1.json\",\n    \"docs/prompts/repo.analysis.summary.v1.json\",\n    \"docs/prompts/code.review.initial.v1.json\",\n    \"tests/test_prompt_registry.py\",\n    \"tests/test_sprint_49_documentation.py\",\n    \"docs/audits/func_sprint_49_prompt_registry_audit.md\",\n    \"docs/functional_sprint_49_manifest.json\"\n  ],\n  \"modified_files\": [\n    \".devpilot/miasi/policy_matrix.json\",\n    \".devpilot/miasi/tool_registry.json\",\n    \"README.md\",\n    \"docs/04_quality/test_strategy.md\",\n    \"docs/05_operations/runbook.md\",\n    \"docs/06_miasi/policy_card.md\",\n    \"docs/06_miasi/tool_card.md\",\n    \"docs/06_miasi/tool_registry.md\",\n    \"docs/devpilot_backlog_fase_D_ia_local_gobernada.md\",\n    \"docs/functional_backlog_after_precode.md\",\n    \"docs/schemas/schema_catalog.json\",\n    \"src/devpilot_core/cli.py\",\n    \"src/devpilot_core/modeling/budget.py\",",
