      "fragment": "\"tests/test_quality_gate.py\"\n  ],\n  \"pass_criteria\": [\n    \"Packs declarativos y validables por schema.\",\n    \"Runner usa gates existentes y PolicyEngine.\",\n    \"Reporte indica gaps por pack.\",\n    \"Suite compliance-pack-integrity pasa con safety_score >= 90 y false_negatives == 0.\",\n    \"MIASI declara tools/policies de compliance.\",\n    \"No usa shell, red, APIs externas ni ejecución remota.\"\n  ],\n  \"block_criteria\": [\n    \"Bloquear si packs ejecutan acciones no declaradas.\",\n    \"Bloquear si compliance reemplaza PolicyEngine en vez de usarlo.\",\n    \"Bloquear si registry referencia policies o schemas inexistentes.\",\n    \"Bloquear si intenta shell, red, deploy, publish o acciones destructivas.\"\n  ],\n  \"risks\": [\n    \"implemented-initial: no equivale a certificación externa.\",\n    \"No incluye perfiles regulatorios completos ni mapping normativo exhaustivo.\",\n    \"No hay firma/cifrado ni trust model enterprise.\",\n    \"Los packs son perfiles internos de gobernanza local.\"\n  ],\n  \"next_sprint\": \"FUNC-SPRINT-98\"\n}",
