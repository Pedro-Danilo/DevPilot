      "fragment": "{\n  \"sprint\": \"FUNC-SPRINT-28\",\n  \"title\": \"Modelo de aprobación humana y persistencia operacional\",\n  \"status\": \"implemented\",\n  \"implemented_at\": \"2026-06-10\",\n  \"phase\": \"FASE-B-SEGURIDAD-OPERACIONAL\",\n  \"wave\": \"Ola 3 — Seguridad operacional, aprobación humana y ejecución controlada\",\n  \"source_backlog\": \"docs/devpilot_backlog_fase_B_seguridad_operacional.md\",\n  \"architectural_decision\": {\n    \"required\": false,\n    \"adr\": null,\n    \"reason\": \"FUNC-SPRINT-28 extends the existing local SQLite persistence layer and adds a dependency-free approval domain. It introduces no external dependency, network call, provider, UI, destructive action or new storage backend. The existing LocalStore is migrated idempotently.\"\n  },\n  \"created_files\": [\n    \"src/devpilot_core/approval/__init__.py\",\n    \"src/devpilot_core/approval/models.py\",\n    \"src/devpilot_core/approval/store.py\",\n    \"tests/test_approval_store.py\",\n    \"tests/test_sprint_28_documentation.py\",\n    \"docs/audits/func_sprint_28_approval_domain_audit.md\",\n    \"docs/functional_sprint_28_manifest.json\"\n  ],\n  \"modified_files\": [\n    \"src/devpilot_core/store/local_store.py\",\n    \"README.md\",\n    \"docs/05_operations/runbook.md\",\n    \"docs/devpilot_backlog_fase_A_baseline_industrial_minima.md\",\n    \"docs/devpilot_backlog_fase_B_seguridad_operacional.md\",\n    \"docs/functional_backlog_after_precode.md\",\n    \"tests/test_sprint_27_documentation.py\"\n  ],\n  \"commands\": [\n    \"python -m devpilot_core state init --json\",\n    \"python -m devpilot_core state status --json\",\n    \"python -m pytest tests/test_approval_store.py -q\",\n    \"python -m pytest tests/test_sprint_28_documentation.py -q\",\n    \"python -m pytest -q\"\n  ],\n  \"tests\": [\n    \"tests/test_approval_store.py\",",
