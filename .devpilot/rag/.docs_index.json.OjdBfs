      "fragment": "{\n  \"schema_version\": \"1.0\",\n  \"sprint_id\": \"FUNC-SPRINT-21\",\n  \"title\": \"Schema Registry y catálogo de contratos DevPilot\",\n  \"status\": \"implemented\",\n  \"phase\": \"FASE-A-BASELINE-INDUSTRIAL-MINIMA\",\n  \"implemented_at\": \"2026-06-10\",\n  \"summary\": \"Introduces a local, dependency-free Schema Registry for versioned DevPilot contracts. It lists registered schemas, detects duplicate IDs and missing files, returns CommandResult, and supports optional evidence reports. It does not validate JSON instances yet.\",\n  \"created_files\": [\n    \"src/devpilot_core/schemas/__init__.py\",\n    \"src/devpilot_core/schemas/models.py\",\n    \"src/devpilot_core/schemas/registry.py\",\n    \"docs/schemas/schema_catalog.json\",\n    \"docs/schemas/command_result.schema.json\",\n    \"docs/schemas/finding.schema.json\",\n    \"docs/schemas/evidence_report.schema.json\",\n    \"docs/schemas/application_request.schema.json\",\n    \"docs/schemas/application_response.schema.json\",\n    \"docs/schemas/service_capability.schema.json\",\n    \"docs/schemas/interface_route_contract.schema.json\",\n    \"tests/test_schema_registry.py\",\n    \"docs/audits/func_sprint_21_schema_registry_audit.md\",\n    \"docs/functional_sprint_21_manifest.json\"\n  ],\n  \"modified_files\": [\n    \"src/devpilot_core/cli.py\",\n    \"README.md\",\n    \"docs/05_operations/runbook.md\",\n    \"docs/devpilot_backlog_fase_A_baseline_industrial_minima.md\",\n    \"docs/functional_backlog_after_precode.md\"\n  ],\n  \"commands\": [\n    \"python -m devpilot_core schema list --json\",\n    \"python -m devpilot_core schema list --json --write-report\",\n    \"python -m pytest tests/test_schema_registry.py -q\",\n    \"python -m pytest -q\"\n  ],\n  \"tests\": [\n    {\n      \"id\": \"TEST-FUNC-21-001\",",
