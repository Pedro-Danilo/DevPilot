      },
      "fragment": "\"tests/test_sprint_56_documentation.py\",\n    \"tests/test_sprint_57_documentation.py\",\n    \"tests/test_sprint_58_documentation.py\"\n  ],\n  \"commands\": [\n    \"python -m devpilot_core state init --json\",\n    \"python -m devpilot_core state status --json\",\n    \"python -m devpilot_core model providers --json\",\n    \"python -m devpilot_core model generate --provider mock --prompt \\\"hello\\\" --json\",\n    \"python -m pytest tests/test_metrics_collector.py -q\",\n    \"python -m pytest tests/test_trace_store.py tests/test_event_logger.py tests/test_trace_context.py tests/test_local_store.py tests/test_metrics_collector.py tests/test_sprint_59_documentation.py -q\",\n    \"python -m devpilot_core validate-artifact docs/audits/func_sprint_59_metrics_collector_audit.md --json\",\n    \"python -m devpilot_core schema validate-manifest docs/functional_sprint_59_manifest.json --json\",\n    \"python -m devpilot_core validate all --json\",\n    \"python -m pytest -q\"\n  ],\n  \"tests\": [\n    \"tests/test_metrics_collector.py\",\n    \"tests/test_trace_store.py\",\n    \"tests/test_event_logger.py\",\n    \"tests/test_trace_context.py\",\n    \"tests/test_local_store.py\",\n    \"tests/test_sprint_59_documentation.py\",\n    \"schema validate-manifest\",\n    \"validate all\",\n    \"pytest -q\"\n  ],\n  \"pass_criteria\": [\n    \"MetricRecord serializa payload JSON redactado.\",\n    \"MetricsCollector persiste métricas sin red ni DB preinicializada.\",\n    \"LocalStore registra y resume métricas por categoría, estado y proveedor.\",\n    \"ModelAdapterRouter registra métricas del provider mock sin costo externo real.\",\n    \"La migración de metrics legacy es idempotente.\",\n    \"No se agregan dependencias externas ni exporters activos.\"\n  ],\n  \"block_criteria\": [\n    \"Se registran prompts, completions, diffs, patches, stdout/stderr o secretos crudos.\",\n    \"Se introduce dependencia externa obligatoria o telemetría remota.\",\n    \"Las métricas alteran el resultado funcional de comandos/model calls.\",\n    \"MetricsCollector falla cuando no existe DB inicializada.\",",
