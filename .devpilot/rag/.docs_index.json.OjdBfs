      "fragment": "\"wave\": \"Fase F — Producto visual\",\n  \"source_backlog\": \"docs/devpilot_backlog_fase_F_producto_visual.md\",\n  \"architectural_decision\": {\n    \"adr_required\": false,\n    \"rationale\": \"FUNC-SPRINT-72 implements Settings UI under ADR-0013 Web UI first and the existing local API/ApplicationService boundary; it does not change stack, trust boundary or execution model.\"\n  },\n  \"deleted_files\": [\n    \"package-lock.json\"\n  ],\n  \"commands\": [\n    \"python -m devpilot_core model providers --json\",\n    \"python -m pytest tests/test_api_settings.py tests/test_web_ui_settings.py tests/test_sprint_72_documentation.py -q\",\n    \"cd ui/web && npm test\",\n    \"python -m devpilot_core schema validate-manifest docs/functional_sprint_72_manifest.json --json\",\n    \"python -m devpilot_core validate-artifact docs/audits/func_sprint_72_settings_ui_audit.md --json\",\n    \"python -m devpilot_core validate all --json\",\n    \"python -m pytest -q\"\n  ],\n  \"pass_criteria\": [\n    \"Settings muestra workspace/providers/policy vía API local protegida.\",\n    \"Providers se muestran sin secretos ni valores raw de API keys.\",\n    \"Provider editor es plan-only y no escribe .devpilot/providers.yaml.\",\n    \"UI no importa devpilot_core ni lee filesystem local.\",\n    \"No se habilitan proveedores externos desde la UI.\",\n    \"Manifest, auditoría, README, runbook, backlog, OpenAPI y contrato interno están sincronizados.\"\n  ],\n  \"block_criteria\": [\n    \"UI muestra API keys o secretos en claro.\",\n    \"UI o API escriben providers/policy sin approval controlado.\",\n    \"Settings UI importa core Python o lee .devpilot directamente.\",\n    \"El plan de providers permite activar external_api por accidente.\",\n    \"validate all reporta findings bloqueantes.\"\n  ],\n  \"risks\": [\n    {\n      \"id\": \"RISK-FUNC-72-001\",\n      \"risk\": \"Secreto en UI\",\n      \"mitigation\": \"Redacción determinística y pruebas con secretos sintéticos.\"\n    },\n    {",
