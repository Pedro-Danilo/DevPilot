    {
      "chunk_id": "ragchunk_53d7e7f1f4cf1ee0",
      "source": {
        "path": "docs/functional_sprint_78_manifest.json",
        "line_start": 71,
        "line_end": 110,
        "title": "{"
      },
      "fragment": "\"pass_criteria\": [\n    \"Changelog is human-readable and Keep a Changelog-compatible.\",\n    \"Changelog is generated from local manifests and includes traceability to sprint manifests.\",\n    \"Command returns parseable CommandResult JSON.\",\n    \"Report writing is optional and restricted to outputs/reports.\",\n    \"No network, external API, publication, deployment, signing or Git tagging is performed.\",\n    \"README, runbook, Fase G backlog and functional backlog are synchronized.\"\n  ],\n  \"block_criteria\": [\n    \"Do not close if changelog invents changes not supported by manifests, commits or approved docs.\",\n    \"Do not close if CLI overwrites docs/release/CHANGELOG.md without governed confirmation.\",\n    \"Do not close if command depends on non-regenerable outputs.\",\n    \"Do not close if command calls network or external APIs.\",\n    \"Do not close if command publishes, deploys, signs or tags Git.\"\n  ],\n  \"risks\": [\n    {\n      \"id\": \"RISK-FUNC-78-001\",\n      \"risk\": \"Changelog incompleto\",\n      \"mitigation\": \"Generar desde manifests y reportar rango de sprints.\"\n    },\n    {\n      \"id\": \"RISK-FUNC-78-002\",\n      \"risk\": \"Entradas inventadas\",\n      \"mitigation\": \"Bloquear cambios sin fuente local y documentar política.\"\n    },\n    {\n      \"id\": \"RISK-FUNC-78-003\",\n      \"risk\": \"Sobrescritura accidental del changelog canónico\",\n      \"mitigation\": \"CLI report-only; archivo canónico se mantiene por docs-as-code.\"\n    },\n    {\n      \"id\": \"RISK-FUNC-78-004\",\n      \"risk\": \"Confundir changelog con release final\",\n      \"mitigation\": \"Documentar que packaging, SBOM, checksums y smoke release quedan para sprints posteriores.\"\n    }\n  ],\n  \"next_sprint\": \"FUNC-SPRINT-79 — Packaging Python y ZIP limpio reproducible\",\n  \"adr_required\": false,\n  \"adr_rationale\": \"No se requiere nueva ADR: FUNC-SPRINT-78 implementa una capacidad prevista por la ADR de release/versionado/productización y la política de release existentes; la política operacional específica queda en docs/05_operations/change_policy.md.\",",
