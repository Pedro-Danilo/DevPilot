      "fragment": "\"python -m pytest tests/test_sprint_28_documentation.py -q\",\n    \"python -m pytest -q\"\n  ],\n  \"tests\": [\n    \"tests/test_approval_store.py\",\n    \"tests/test_sprint_28_documentation.py\"\n  ],\n  \"pass_criteria\": [\n    \"ApprovalRecord has unique ID, subject, tool/action, status, actor, reason, scope, created_at and expires_at.\",\n    \"LocalStore persists approvals idempotently.\",\n    \"Allowed states are requested, approved, denied, revoked and expired.\",\n    \"Approvals without scope are rejected.\",\n    \"Existing SQLite approvals tables are migrated without dropping rows.\",\n    \"pytest -q passes.\"\n  ],\n  \"block_criteria\": [\n    \"An approval lacks expiration or scope.\",\n    \"An approval can be overwritten without a controlled transition.\",\n    \"The approvals table breaks compatibility with an existing local DB.\",\n    \"Sprint 28 connects approvals to critical execution before policy binding.\"\n  ],\n  \"risks\": [\n    \"The approval actor is local/declarative; RBAC is future work.\",\n    \"PolicyEngine binding is explicitly deferred to Sprint 30.\",\n    \"CLI approval operations are explicitly deferred to Sprint 29.\",\n    \"Event persistence is best-effort until later operational hardening.\"\n  ],\n  \"preliminary\": true,\n  \"next_sprint\": \"FUNC-SPRINT-29 — CLI de aprobación: request, list, show, approve, deny y revoke\"\n}",
