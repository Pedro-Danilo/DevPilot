      },
      "fragment": "\"python -m pytest tests/test_observability_inventory.py tests/test_post_h_010_observability_retention.py tests/test_observability_retention_schema.py tests/test_schema_registry.py tests/test_project_global_state.py -q\",\n    \"python -m devpilot_core observability inventory --json --write-report\",\n    \"python -m devpilot_core schema validate --schema-id ObservabilityInventory --instance outputs/reports/observability_inventory.json --json\",\n    \"python -m devpilot_core schema validate --schema-id PostHManifest --instance docs/post_h_010_b_manifest.json --json\",\n    \"python -m devpilot_core docs-governance validate --json\",\n    \"python -m devpilot_core test-contracts validate --json\",\n    \"python -m devpilot_core test-contracts validate-v2 --json\"\n  ],\n  \"tests\": [\n    \"tests/test_observability_inventory.py\",\n    \"tests/test_post_h_010_observability_retention.py\",\n    \"tests/test_observability_retention_schema.py\",\n    \"tests/test_schema_registry.py\",\n    \"tests/test_project_global_state.py\"\n  ],\n  \"pass_criteria\": [\n    \"Inventory reporta todos los targets definidos por retention_policy.json.\",\n    \"Inventory no modifica archivos y no lee raw payloads.\",\n    \"Reports se escriben solo con --write-report bajo outputs/reports.\",\n    \"ObservabilityInventory schema valida el reporte generado.\",\n    \"Targets runtime conservan clean_zip_excluded=true y versionable=false.\"\n  ],\n  \"block_criteria\": [\n    \"Bloquear si un target resuelve fuera del workspace.\",\n    \"Bloquear si un runtime target es source_of_truth o versionable.\",\n    \"Bloquear si raw_payload_storage_allowed=true.\",\n    \"Bloquear si se habilita red, API externa, cleanup o export en este micro-sprint.\",\n    \"Bloquear si un runtime artifact existente no está marcado clean_zip_excluded=true.\"\n  ],\n  \"risks\": [\n    \"Targets ausentes en un checkout limpio aparecen como warnings operacionales; no prueban presencia runtime real.\",\n    \"Conteos SQLite son metadata-only y no reemplazan auditoría semántica de contenido.\",\n    \"El inventario no decide acciones de limpieza; POST-H-010-C debe calcular cleanup plan dry-run.\",\n    \"El subgate observability-retention queda para POST-H-010-E.\"\n  ],\n  \"next_sprint\": \"POST-H-010\",\n  \"preliminary\": true,\n  \"security\": {\n    \"local_first\": true,\n    \"dry_run\": true,",
