    {
      "chunk_id": "ragchunk_767ebfa3c4637406",
      "source": {
        "path": "docs/functional_sprint_90_manifest.json",
        "line_start": 71,
        "line_end": 89,
        "title": "{"
      },
      "fragment": "\"Coordinator only uses implemented or implemented-initial agents.\",\n    \"Dry-run is required.\",\n    \"PolicyEngine checks every handoff.\",\n    \"No critical or destructive actions are executed.\"\n  ],\n  \"block_criteria\": [\n    \"Multiagent run without --dry-run.\",\n    \"Workflow references planned/future/disabled agents.\",\n    \"Implicit handoff without trace.\",\n    \"Workspace mutation or destructive action.\",\n    \"Shell, network, external API or remote execution.\"\n  ],\n  \"risks\": [\n    \"MVP is sequential and allowlisted; graph orchestration remains future.\",\n    \"Child agent findings are reported but do not replace a quality gate.\",\n    \"Advanced adversarial multiagent evaluation is pending.\"\n  ],\n  \"next_sprint\": \"FUNC-SPRINT-91\"\n}",
