      "fragment": "\"workspace init --execute bloquea sobrescritura si project.yaml ya existe\",\n    \"workspace status detecta workspace, docs, standards y checklist pre-code\",\n    \"salida JSON de comandos workspace es parseable\",\n    \"pytest -q pasa completo\"\n  ],\n  \"block_criteria\": [\n    \"workspace init escribe archivos en dry-run\",\n    \"workspace init sobrescribe project.yaml existente\",\n    \"workspace status no detecta artefactos mínimos\",\n    \"rutas del workspace escapan del project root\",\n    \"regresión en comandos previos\",\n    \"pytest falla\"\n  ],\n  \"tests_added\": [\n    \"test_workspace_init_dry_run_does_not_write\",\n    \"test_workspace_init_execute_writes_project_yaml\",\n    \"test_workspace_init_dry_run_reports_existing_workspace_without_overwrite\",\n    \"test_workspace_init_blocks_existing_project_yaml\",\n    \"test_workspace_status_ready_when_initialized\",\n    \"test_workspace_status_fails_when_not_initialized_but_docs_exist\",\n    \"test_workspace_discovery_from_nested_directory\",\n    \"test_workspace_cli_init_and_status_json_are_parseable\",\n    \"test_workspace_cli_dry_run_write_report\"\n  ],\n  \"expected_pytest_summary\": \"51 passed, 0 failed, 0 errors, 0 skipped\",\n  \"risks\": [\n    \"primera versión sin múltiples workspaces\",\n    \"sin migraciones de project.yaml\",\n    \"sin locking ante concurrencia\",\n    \"sin configuración cifrada\",\n    \"sin integración formal con SecretGuard todavía\",\n    \"outputs sigue siendo runtime y se regenera localmente\"\n  ],\n  \"next_sprint\": \"FUNC-SPRINT-09 — Policy Engine, PathGuard, SecretGuard y CostGuard determinísticos\"\n}",
