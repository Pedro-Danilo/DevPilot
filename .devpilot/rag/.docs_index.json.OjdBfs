      "fragment": "],\n  \"pass_criteria\": [\n    \"AgentRuntime resolves agents from executable MIASI registry.\",\n    \"Only implemented MVP document agents can run in Sprint 12.\",\n    \"Every tool-like operation is evaluated by PolicyEngine.\",\n    \"Dry-run does not write files.\",\n    \"No external APIs or API keys are required.\",\n    \"CLI output follows CommandResult and remains JSON-parseable.\"\n  ],\n  \"block_criteria\": [\n    \"Unknown agent.\",\n    \"Non-MVP agent in Sprint 12.\",\n    \"Missing or invalid MIASI executable registry.\",\n    \"PathGuard blocked subject.\",\n    \"SecretGuard detected synthetic secret.\",\n    \"Draft output already exists in execute mode.\"\n  ],\n  \"tests\": {\n    \"new_test_file\": \"tests/test_agent_runtime.py\",\n    \"expected_pytest\": \"85 passed\"\n  },\n  \"risks\": [\n    \"Rule-based agents only; no LLM yet.\",\n    \"No agentic memory.\",\n    \"No evaluation harness until FUNC-SPRINT-13.\",\n    \"No persistent human approval workflow.\",\n    \"No real tool runtime for shell, Git write, patch apply or external models.\"\n  ],\n  \"next_sprint\": \"FUNC-SPRINT-13 — Evaluation Harness para validadores y agentes\"\n}",
