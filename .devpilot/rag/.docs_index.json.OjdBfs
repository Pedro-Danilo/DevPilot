      "fragment": "{\n  \"id\": \"CORRECTIVE-PATCH-2026-06-08-PATH-NORMALIZATION\",\n  \"title\": \"Normalize frontmatter validator paths for cross-platform evidence\",\n  \"status\": \"implemented\",\n  \"date\": \"2026-06-08\",\n  \"reason\": \"Windows emitted docs\\\\\\\\valid.md in EventLog summaries while tests and evidence contract expect docs/valid.md.\",\n  \"files_modified\": [\n    \"src/devpilot_core/validators/frontmatter.py\",\n    \"tests/test_event_logger.py\"\n  ],\n  \"files_created\": [\n    \"docs/audits/corrective_patch_2026_06_08_path_normalization_audit.md\",\n    \"docs/corrective_patch_2026_06_08_path_normalization_manifest.json\"\n  ],\n  \"commands\": [\n    \"PYTHONPATH=src python -m pytest tests/test_event_logger.py::test_cli_validate_frontmatter_emits_gate_event tests/test_event_logger.py::test_frontmatter_result_path_uses_posix_separator_for_windows_style_input -q\",\n    \"PYTHONPATH=src python -m pytest -q\"\n  ],\n  \"expected_result\": \"64 passed\",\n  \"adr_required\": false,\n  \"adr_reason\": \"The change is a deterministic evidence-format hotfix; it does not change architecture, persistence, security policy, APIs, agents, providers or dependencies.\",\n  \"risks\": [\n    \"Path normalization is still duplicated in several modules.\",\n    \"A future sprint should centralize path normalization in a shared utility.\"\n  ]\n}",
