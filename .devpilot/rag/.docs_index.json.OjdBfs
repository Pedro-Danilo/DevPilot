    {
      "chunk_id": "ragchunk_584767a9c1d469e9",
      "source": {
        "path": "docs/post_h_010_e_manifest.json",
        "line_start": 36,
        "line_end": 75,
        "title": "{"
      },
      "fragment": "\"python -m pytest -p no:ddtrace tests/test_observability_hygiene_gate.py tests/test_observability_export.py tests/test_observability_cleanup_plan.py tests/test_observability_inventory.py tests/test_post_h_010_observability_retention.py tests/test_observability_retention_schema.py tests/test_schema_registry.py tests/test_project_global_state.py -q\",\n    \"python -m devpilot_core quality-gate run --profile hardening --json\",\n    \"python -m devpilot_core schema validate --schema-id ObservabilityRetentionHygiene --instance outputs/reports/observability_retention_hygiene.json --json\",\n    \"python -m devpilot_core schema validate --schema-id PostHManifest --instance docs/post_h_010_e_manifest.json --json\",\n    \"python -m devpilot_core docs-governance validate --json\",\n    \"python -m devpilot_core test-contracts validate --json\",\n    \"python -m devpilot_core test-contracts validate-v2 --json\",\n    \"python -m devpilot_core project-state validate --json\"\n  ],\n  \"tests\": [\n    \"tests/test_observability_hygiene_gate.py\",\n    \"tests/test_observability_export.py\",\n    \"tests/test_observability_cleanup_plan.py\",\n    \"tests/test_observability_inventory.py\",\n    \"tests/test_post_h_010_observability_retention.py\",\n    \"tests/test_observability_retention_schema.py\",\n    \"tests/test_schema_registry.py\",\n    \"tests/test_project_global_state.py\"\n  ],\n  \"pass_criteria\": [\n    \"quality-gate hardening incluye el subgate observability-retention.\",\n    \"El subgate valida policy, inventory metadata-only y clean ZIP hygiene sin depender de outputs efímeros.\",\n    \"test-contracts validate y validate-v2 pasan.\",\n    \"project-state validate pasa y POST-H-010 queda cerrado como implemented-initial.\",\n    \"No se versionan outputs, .devpilot/devpilot.db ni .devpilot/agent_sessions.\"\n  ],\n  \"block_criteria\": [\n    \"Bloquear si el gate requiere red, API externa o backend remoto de observabilidad.\",\n    \"Bloquear si el gate exige outputs efímeros para pasar en un ZIP limpio de fuente.\",\n    \"Bloquear si se relajan exclusiones de outputs, .devpilot/devpilot.db o .devpilot/agent_sessions.\",\n    \"Bloquear si se leen raw prompts/outputs o se ejecuta cleanup real.\",\n    \"Bloquear si runtime observability targets son source_of_truth o versionable.\"\n  ],\n  \"risks\": [\n    \"El gate es implemented-initial y no reemplaza un DLP industrial completo.\",\n    \"La firma/cifrado de audit exports queda para hardening posterior.\",\n    \"POST-H-010 queda cerrado como base local de retención/higiene, no como declaración production-ready final.\",\n    \"La ejecución real de cleanup sigue deshabilitada por diseño.\"\n  ],\n  \"next_sprint\": \"POST-H-011\",",
