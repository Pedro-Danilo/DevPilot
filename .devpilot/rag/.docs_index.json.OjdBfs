        "title": "{"
      },
      "fragment": "\"Invalid or missing sessions block safely.\"\n  ],\n  \"block_criteria\": [\n    \"Do not close if secrets are persisted without redaction.\",\n    \"Do not close if sessions can escape workspace boundaries.\",\n    \"Do not close if semantic memory or RAG is enabled.\",\n    \"Do not close if agent session inspect mutates source files.\"\n  ],\n  \"risks\": [\n    {\n      \"id\": \"RISK-FUNC-86-001\",\n      \"risk\": \"Local session state grows without pruning.\",\n      \"mitigation\": \"Retention policy is documented; pruning is future work.\"\n    },\n    {\n      \"id\": \"RISK-FUNC-86-002\",\n      \"risk\": \"Sensitive data could be summarized into sessions.\",\n      \"mitigation\": \"Only summaries are stored and payloads are redacted.\"\n    },\n    {\n      \"id\": \"RISK-FUNC-86-003\",\n      \"risk\": \"Operational memory confused with semantic memory.\",\n      \"mitigation\": \"Manifest, docs and runtime flags mark semantic memory and RAG as disabled.\"\n    }\n  ],\n  \"next_sprint\": \"FUNC-SPRINT-87 — RAG documental local MVP\"\n}",
