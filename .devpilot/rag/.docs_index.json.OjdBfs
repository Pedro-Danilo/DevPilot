      "fragment": "\"tests/test_sprint_32_documentation.py through tests/test_sprint_73_documentation.py synchronized with current milestone\"\n  ],\n  \"commands\": [\n    \"python -m devpilot_core validate-artifact docs/02_architecture/adrs/ADR-0014-release-versioning-packaging.md --json\",\n    \"python -m devpilot_core validate-artifact docs/05_operations/release_policy.md --json\",\n    \"python -m devpilot_core validate-artifact docs/05_operations/release_artifacts_matrix.md --json\",\n    \"python -m devpilot_core validate-artifact docs/audits/func_sprint_74_release_versioning_audit.md --json\",\n    \"python -m devpilot_core schema validate-manifest docs/functional_sprint_74_manifest.json --json\",\n    \"python -m pytest tests/test_sprint_74_documentation.py -q\",\n    \"python -m pytest -q\"\n  ],\n  \"tests\": [\n    \"tests/test_sprint_74_documentation.py\",\n    \"historical sprint documentation tests synchronized with README/backlog current milestone\",\n    \"full pytest regression suite\"\n  ],\n  \"pass_criteria\": [\n    \"ADR compares release interno, PyPI, ZIP limpio, wheel/sdist y desktop installer.\",\n    \"Publicación externa queda fuera de alcance del sprint.\",\n    \"Reglas de exclusión cubren outputs, caches, runtime DB, .venv, .git, node_modules y secretos.\",\n    \"Relación entre SemVer, changelog, manifest y SBOM queda definida.\",\n    \"README, runbook, backlog G y manifest quedan sincronizados.\"\n  ],\n  \"block_criteria\": [\n    \"No cerrar si permite auto-publicación externa sin aprobación.\",\n    \"No cerrar si no cubre exclusiones de outputs, caches y runtime DB.\",\n    \"No cerrar si no actualiza runbook.\",\n    \"No cerrar si confunde sprint manifest con release manifest final.\"\n  ],\n  \"risks\": [\n    {\n      \"id\": \"RISK-FUNC-74-001\",\n      \"risk\": \"Versionado inconsistente\",\n      \"mitigation\": \"ADR + release policy.\"\n    },\n    {\n      \"id\": \"RISK-FUNC-74-002\",\n      \"risk\": \"Paquetes con datos runtime\",\n      \"mitigation\": \"Matriz de exclusión y criterios BLOCK.\"\n    },",
