      "fragment": "\"tests/test_sprint_30_documentation.py\",\n    \"tests/test_sprint_31_documentation.py\",\n    \"docs/schemas/miasi_tool_registry.schema.json\",\n    \"src/devpilot_core/miasi/registry.py\"\n  ],\n  \"commands\": [\n    \"python -m pytest tests/test_tests_run_tool.py -q\",\n    \"python -m pytest tests/test_sprint_32_documentation.py -q\",\n    \"python -m devpilot_core tests profiles --json\",\n    \"python -m devpilot_core tests run --profile smoke --approval-id <approval_id> --json --write-report\",\n    \"python -m devpilot_core miasi validate --json\",\n    \"python -m devpilot_core schema validate-manifest docs/functional_sprint_32_manifest.json --json\",\n    \"python -m pytest -q\"\n  ],\n  \"tests\": [\n    \"tests/test_tests_run_tool.py\",\n    \"tests/test_sprint_32_documentation.py\"\n  ],\n  \"pass_criteria\": [\n    \"tests.run appears in MIASI as implemented-initial.\",\n    \"tests.run executes only configured pytest profiles.\",\n    \"tests.run requires scoped approval when PolicyEngine requires it.\",\n    \"TestsRunTool delegates execution to SafeSubprocessRunner.\",\n    \"No shell=True or arbitrary command execution is introduced.\",\n    \"Exit code, stdout, stderr, timeout and redactions are captured.\",\n    \"Optional JSON/Markdown reports and local events are produced.\",\n    \"pytest -q passes.\",\n    \"MIASI structural schema allows implemented-initial status for executable tool registry entries.\"\n  ],\n  \"block_criteria\": [\n    \"tests.run executes without valid approval when approval is required.\",\n    \"CLI accepts arbitrary subprocess arguments.\",\n    \"Execution bypasses SafeSubprocessRunner.\",\n    \"Pytest exit code is lost.\",\n    \"Secrets are printed raw in reports or traces.\",\n    \"The sprint claims CI/CD, sandbox, patch apply, refactor execution, Git write or deploy support.\"\n  ],\n  \"risks\": [\n    \"Pytest can execute local test code, so tests.run remains approval-gated.\",\n    \"The implementation is not a full filesystem sandbox.\",",
