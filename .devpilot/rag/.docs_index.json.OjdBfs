      "fragment": "\"API listens on 0.0.0.0 by default\",\n    \"CORS wildcard is allowed by default\",\n    \"UI can bypass ApplicationService\",\n    \"Server or frontend implementation is added before the ADR/threat model gate\"\n  ],\n  \"risks\": [\n    {\n      \"id\": \"RISK-FUNC-64-001\",\n      \"risk\": \"Localhost treated as inherently safe\",\n      \"mitigation\": \"Threat model requires token, origin/CORS constraints and policy binding in later sprints.\"\n    },\n    {\n      \"id\": \"RISK-FUNC-64-002\",\n      \"risk\": \"Frontend duplicates core logic\",\n      \"mitigation\": \"ADR and contract require UI -> API -> ApplicationService.\"\n    },\n    {\n      \"id\": \"RISK-FUNC-64-003\",\n      \"risk\": \"Desktop re-enters without evidence\",\n      \"mitigation\": \"Desktop is deferred outside Fase F and requires later ADR.\"\n    },\n    {\n      \"id\": \"RISK-FUNC-64-004\",\n      \"risk\": \"FastAPI dependency leaks into core\",\n      \"mitigation\": \"Sprint 64 does not add dependencies; Sprint 67 must use optional API extra or documented dependency boundary.\"\n    }\n  ],\n  \"next_sprint\": \"FUNC-SPRINT-65 — ApplicationService v2 por dominios\",\n  \"tests\": [\n    \"tests/test_sprint_64_documentation.py\",\n    \"tests/test_application_services.py\",\n    \"schema validate-manifest\",\n    \"validate-artifact\",\n    \"app contract\",\n    \"validate all\",\n    \"pytest -q\"\n  ]\n}",
