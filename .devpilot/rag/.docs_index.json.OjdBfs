      "fragment": "],\n  \"commands\": [\n    \"python -m devpilot_core traceability validate --json\",\n    \"python -m devpilot_core traceability coverage --json\",\n    \"python -m devpilot_core traceability report --json --write-report\",\n    \"python -m pytest tests/test_traceability_engine.py -q\",\n    \"python -m pytest -q\"\n  ],\n  \"tests\": [\n    \"tests/test_traceability_engine.py\",\n    \"tests/test_sprint_26_documentation.py\"\n  ],\n  \"pass_criteria\": [\n    \"Detects requirements without acceptance criteria.\",\n    \"Detects acceptance criteria without requirements.\",\n    \"Detects requirements without test/eval evidence when applicable.\",\n    \"Generates coverage metrics and percentages.\",\n    \"Reports gaps as actionable warning findings.\",\n    \"traceability report supports --write-report.\",\n    \"pytest -q passes.\"\n  ],\n  \"block_criteria\": [\n    \"Recommended gaps block execution in this initial version.\",\n    \"The report is not reproducible.\",\n    \"The command fails when optional documents are absent.\",\n    \"The engine mutates source documents.\",\n    \"A new dependency is added without ADR.\"\n  ],\n  \"risks\": [\n    \"Coverage is explicit and does not use semantic reasoning.\",\n    \"Warnings are not blocking quality gates yet.\",\n    \"Rule severities should become configurable in future phases.\",\n    \"Evidence extraction from prose is intentionally limited.\"\n  ],\n  \"next_sprint\": \"FUNC-SPRINT-27 — Architecture/code drift inicial y cierre de Baseline Industrial Mínima\"\n}",
