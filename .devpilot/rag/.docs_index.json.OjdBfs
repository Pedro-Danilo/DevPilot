      "fragment": "\"tests/test_sprint_32_documentation.py\",\n    \"tests/test_sprint_33_documentation.py\",\n    \"tests/test_sprint_34_documentation.py\",\n    \"tests/test_sprint_35_documentation.py\",\n    \"tests/test_sprint_36_documentation.py\",\n    \"tests/test_sprint_37_documentation.py\",\n    \"tests/test_sprint_38_documentation.py\",\n    \"tests/test_sprint_39_documentation.py\",\n    \"tests/test_sprint_40_documentation.py\",\n    \"tests/test_sprint_41_documentation.py\"\n  ],\n  \"commands\": [\n    \"python -m devpilot_core rollback plan --changeset-file outputs/reports/patch_sandbox.json --json\",\n    \"python -m devpilot_core rollback list --json\",\n    \"python -m devpilot_core rollback show <rollback_id> --json\",\n    \"python -m devpilot_core rollback execute <rollback_id> --json\",\n    \"python -m devpilot_core miasi validate --json\",\n    \"python -m pytest -q\"\n  ],\n  \"tests\": [\n    \"tests/test_rollback_manager.py\",\n    \"tests/test_sprint_42_documentation.py\"\n  ],\n  \"pass_criteria\": [\n    \"RollbackManager creates rollback plans from ChangeSet JSON files.\",\n    \"RollbackPoint metadata is persisted under .devpilot/rollback runtime paths.\",\n    \"Local backups are created only for safe workspace files.\",\n    \"rollback list/show are read-only and parseable.\",\n    \"rollback execute is approval-gated and non-mutating in Sprint 42.\",\n    \"MIASI declares rollback tools and policy rules.\"\n  ],\n  \"block_criteria\": [\n    \"Rollback execute can mutate files without approval.\",\n    \"Rollback target path escapes workspace root.\",\n    \"Backup stores secret-like content without blocking.\",\n    \"Rollback runtime points are packaged as release artifacts.\",\n    \"The sprint enables Git write, deploy or refactor execution.\"\n  ],\n  \"risks\": [\n    \"Rollback remains initial and metadata-driven, not a complete transactional restore engine.\",",
