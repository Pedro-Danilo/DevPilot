      "fragment": "\"python -m devpilot_core docs-governance validate --json\",\n    \"python -m devpilot_core docs-governance report --write-report --json\",\n    \"python -m devpilot_core schema validate --schema-id DocumentationGovernanceReport --instance outputs/reports/documentation_governance_report.json --json\",\n    \"python -m devpilot_core schema validate --schema-id PostHManifest --instance docs/post_h_009_e_manifest.json --json\",\n    \"python -m devpilot_core quality-gate run --profile hardening --json\",\n    \"python -m devpilot_core test-contracts validate --json\",\n    \"python -m devpilot_core test-contracts validate-v2 --json\"\n  ],\n  \"tests\": [\n    \"tests/test_documentation_governance_quality_gate.py\",\n    \"tests/test_quality_gate.py\",\n    \"tests/test_documentation_governance_backlogs.py\",\n    \"tests/test_documentation_governance_sync.py\",\n    \"tests/test_documentation_governance_validator.py\",\n    \"tests/test_post_h_009_documentation_governance.py\",\n    \"tests/test_project_global_state.py\"\n  ],\n  \"pass_criteria\": [\n    \"docs-governance validate retorna ok=true en baseline válido.\",\n    \"quality-gate hardening incluye subgate docs-governance y retorna ok=true.\",\n    \"test-contracts validate retorna ok=true.\",\n    \"test-contracts validate-v2 retorna ok=true.\",\n    \"README, runbook, changelog, project_state y backlog POST-H-009 quedan sincronizados con POST-H-009 cerrado y POST-H-010 como siguiente hito.\"\n  ],\n  \"block_criteria\": [\n    \"Bloquear si docs-governance detecta drift crítico Markdown/JSON, metadata canónica incompleta o backlog derivado inconsistente.\",\n    \"Bloquear si quality-gate hardening no incluye docs-governance.\",\n    \"Bloquear si se habilita red, API externa, LLM judge, remote execution, connector write o plugin execution.\",\n    \"Bloquear si se versionan outputs runtime como fuente para resolver drift.\"\n  ],\n  \"risks\": [\n    \"La validación sigue siendo determinística y contractual; no evalúa calidad editorial profunda.\",\n    \"Agregar más fuentes canónicas sin actualizar source_registry puede bloquear el quality gate.\",\n    \"El quality gate hardening aumenta levemente su costo por ejecutar docs-governance.\",\n    \"La corrección automática de drift queda fuera de alcance para evitar mutaciones no aprobadas.\"\n  ],\n  \"next_sprint\": \"POST-H-010\",\n  \"preliminary\": true,\n  \"security\": {\n    \"local_first\": true,",
