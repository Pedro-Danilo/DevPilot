      "chunk_id": "ragchunk_2130b7efdaea5481",
      "source": {
        "path": "docs/functional_sprint_32_manifest.json",
        "line_start": 1,
        "line_end": 40,
        "title": "{"
      },
      "fragment": "{\n  \"sprint\": \"FUNC-SPRINT-32\",\n  \"title\": \"tests.run como herramienta MIASI controlada\",\n  \"status\": \"implemented\",\n  \"implemented_at\": \"2026-06-11\",\n  \"phase\": \"FASE-B-SEGURIDAD-OPERACIONAL\",\n  \"wave\": \"Ola 3 — Seguridad operacional, aprobación humana y ejecución controlada\",\n  \"source_backlog\": \"docs/devpilot_backlog_fase_B_seguridad_operacional.md\",\n  \"architectural_decision\": {\n    \"required\": false,\n    \"adr\": null,\n    \"reason\": \"FUNC-SPRINT-32 compone capacidades ya aprobadas: Approval Workflow, PolicyEngine, MIASI, SafeSubprocessRunner, ReportEngine y EventLogger. No agrega dependencias externas, red, UI, backend nuevo ni ejecución arbitraria. Es una evolución interna y restringida del modelo de seguridad operacional.\"\n  },\n  \"created_files\": [\n    \"src/devpilot_core/testing/__init__.py\",\n    \"src/devpilot_core/testing/profiles.py\",\n    \"src/devpilot_core/testing/tests_run.py\",\n    \".devpilot/testing/test_profiles.json\",\n    \"tests/fixtures/smoke_pytest_project/test_smoke.py\",\n    \"tests/test_tests_run_tool.py\",\n    \"tests/test_sprint_32_documentation.py\",\n    \"docs/audits/func_sprint_32_tests_run_tool_audit.md\",\n    \"docs/functional_sprint_32_manifest.json\"\n  ],\n  \"modified_files\": [\n    \"README.md\",\n    \"docs/05_operations/runbook.md\",\n    \"docs/devpilot_backlog_fase_B_seguridad_operacional.md\",\n    \"docs/functional_backlog_after_precode.md\",\n    \"docs/06_miasi/tool_registry.md\",\n    \"docs/06_miasi/tool_card.md\",\n    \".devpilot/miasi/tool_registry.json\",\n    \"src/devpilot_core/cli.py\",\n    \"tests/test_sprint_28_documentation.py\",\n    \"tests/test_sprint_29_documentation.py\",\n    \"tests/test_sprint_30_documentation.py\",\n    \"tests/test_sprint_31_documentation.py\",\n    \"docs/schemas/miasi_tool_registry.schema.json\",\n    \"src/devpilot_core/miasi/registry.py\"\n  ],",
