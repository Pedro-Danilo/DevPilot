      "fragment": "{\n  \"sprint\": \"FUNC-SPRINT-22\",\n  \"title\": \"Schema Validator y schemas de contratos transversales\",\n  \"status\": \"implemented\",\n  \"implemented_at\": \"2026-06-10\",\n  \"phase\": \"FASE-A-BASELINE-INDUSTRIAL-MINIMA\",\n  \"wave\": \"Ola 1 — Consolidación contractual y Schema Engine\",\n  \"source_backlog\": \"docs/devpilot_backlog_fase_A_baseline_industrial_minima.md\",\n  \"architectural_decision\": {\n    \"required\": true,\n    \"adr\": \"docs/02_architecture/adrs/ADR-0010-schema-validation-dependency.md\",\n    \"reason\": \"FUNC-SPRINT-22 introduces jsonschema as a runtime dependency to validate JSON Schema Draft 2020-12 contracts.\"\n  },\n  \"created_files\": [\n    \"src/devpilot_core/schemas/validator.py\",\n    \"src/devpilot_core/schemas/errors.py\",\n    \"docs/02_architecture/adrs/ADR-0010-schema-validation-dependency.md\",\n    \"docs/audits/func_sprint_22_schema_validator_audit.md\",\n    \"docs/functional_sprint_22_manifest.json\",\n    \"tests/test_schema_validator.py\"\n  ],\n  \"modified_files\": [\n    \"pyproject.toml\",\n    \"src/devpilot_core/cli.py\",\n    \"src/devpilot_core/schemas/__init__.py\",\n    \"src/devpilot_core/schemas/models.py\",\n    \"docs/schemas/schema_catalog.json\",\n    \"docs/schemas/command_result.schema.json\",\n    \"docs/schemas/finding.schema.json\",\n    \"docs/schemas/evidence_report.schema.json\",\n    \"docs/schemas/application_request.schema.json\",\n    \"docs/schemas/application_response.schema.json\",\n    \"docs/schemas/service_capability.schema.json\",\n    \"docs/schemas/interface_route_contract.schema.json\",\n    \"README.md\",\n    \"docs/05_operations/runbook.md\",\n    \"docs/devpilot_backlog_fase_A_baseline_industrial_minima.md\",\n    \"docs/functional_backlog_after_precode.md\",\n    \"tests/test_release_manifest.py\"\n  ],",
