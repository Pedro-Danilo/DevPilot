      "fragment": "{\n  \"doc_id\": \"DEVPL-PRECODE-03-MANIFEST\",\n  \"status\": \"approved\",\n  \"version\": \"1.0.0\",\n  \"updated\": \"2026-06-04\",\n  \"approval\": \"approved_by_owner_direction\",\n  \"changes\": [\n    \"Clarified architecture baseline covers MVP, MVP+ and post-MVP.\",\n    \"Defined local-first hybrid strategy with ModelAdapter and CostGuard.\",\n    \"Expanded industrial agent runtime under MIASI.\",\n    \"Defined local persistence strategy with filesystem, SQLite and JSONL.\",\n    \"Expanded security architecture with Policy Engine, SecretGuard, approvals and observability.\",\n    \"Added ADR-0006 to ADR-0009.\",\n    \"Promoted ADR-0002 to ADR-0009 from proposed to accepted.\",\n    \"Promoted architecture baseline to approved for SPRINT-PRECODE-03.\",\n    \"Confirmed architecture is aligned with MIPSoftware and MIASI and can support SPRINT-PRECODE-04 security work.\"\n  ],\n  \"files\": [\n    \"docs/02_architecture/architecture_document.md\",\n    \"docs/02_architecture/c4_context.md\",\n    \"docs/02_architecture/c4_container.md\",\n    \"docs/02_architecture/adrs/ADR-0001-adoptar-mipsoftware-y-miasi.md\",\n    \"docs/02_architecture/adrs/ADR-0002-core-local-first-cli-ui-futura.md\",\n    \"docs/02_architecture/adrs/ADR-0003-workspaces-como-unidad-operativa.md\",\n    \"docs/02_architecture/adrs/ADR-0004-agentes-documentales-controlados-mvp.md\",\n    \"docs/02_architecture/adrs/ADR-0005-git-adapter-read-only-mvp-plus.md\",\n    \"docs/02_architecture/adrs/ADR-0006-local-first-hibrido-modeladapter-costguard.md\",\n    \"docs/02_architecture/adrs/ADR-0007-persistencia-local-filesystem-sqlite-jsonl.md\",\n    \"docs/02_architecture/adrs/ADR-0008-agent-runtime-industrial-bajo-miasi.md\",\n    \"docs/02_architecture/adrs/ADR-0009-seguridad-policy-engine-approval-observabilidad.md\",\n    \"docs/02_architecture/sprint_precode_03_architecture_baseline_review.md\",\n    \"docs/02_architecture/sprint_precode_03_architecture_audit_post_ow