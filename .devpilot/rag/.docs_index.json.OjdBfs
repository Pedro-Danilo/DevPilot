      "fragment": "\"tests/test_sprint_26_documentation.py\"\n  ],\n  \"commands\": [\n    \"python -m devpilot_core traceability architecture-drift --json\",\n    \"python -m devpilot_core traceability architecture-drift --json --write-report\",\n    \"python -m devpilot_core validate all --json\",\n    \"python -m devpilot_core traceability report --json --write-report\",\n    \"python -m devpilot_core readiness-check --strict --json\",\n    \"python -m devpilot_core miasi validate --json\",\n    \"python -m pytest -q\"\n  ],\n  \"tests\": [\n    \"tests/test_architecture_drift.py\",\n    \"tests/test_sprint_27_documentation.py\"\n  ],\n  \"pass_criteria\": [\n    \"Phase A exit checklist exists.\",\n    \"Phase A closure report exists.\",\n    \"Architecture drift detector produces non-destructive findings.\",\n    \"Critical schemas validate through existing gateways.\",\n    \"Traceability report is generated.\",\n    \"pytest -q passes.\"\n  ],\n  \"block_criteria\": [\n    \"Phase A is marked closed without operational Schema Validator.\",\n    \"Phase A is marked closed without executable Traceability Engine.\",\n    \"Closure report is missing.\",\n    \"Documentation confuses real state with target/future capabilities.\",\n    \"A new dependency is added without ADR.\"\n  ],\n  \"risks\": [\n    \"Architecture/code drift detection is heuristic and may require alias tuning.\",\n    \"It does not replace manual architecture review.\",\n    \"It must not block on minor naming differences without configuration.\",\n    \"Phase A closure is a baseline, not final product readiness.\"\n  ],\n  \"next_sprint\": \"FASE-B-PENDIENTE-DE-PLANIFICACION\"\n}",
