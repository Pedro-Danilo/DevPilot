    {
      "chunk_id": "ragchunk_de57b50a4bf98bcf",
      "source": {
        "path": "docs/functional_sprint_79_manifest.json",
        "line_start": 71,
        "line_end": 108,
        "title": "{"
      },
      "fragment": "],\n  \"pass_criteria\": [\n    \"package build returns parseable CommandResult JSON.\",\n    \"repo-zip excludes outputs, caches, venv, git, node_modules, dist and runtime DB.\",\n    \"python kind produces sdist/wheel plan and local artifacts with --execute.\",\n    \"Report contains included/excluded file lists.\",\n    \"No network, external API, publication, deployment, signing or Git tagging is performed.\",\n    \"README, runbook, Fase G backlog and functional backlog are synchronized.\"\n  ],\n  \"block_criteria\": [\n    \"Do not close if package includes secrets or .devpilot/devpilot.db.\",\n    \"Do not close if package includes outputs, caches, venv, git, node_modules or dist.\",\n    \"Do not close if command publishes externally.\",\n    \"Do not close if command depends on non-regenerable outputs.\",\n    \"Do not close if build dependencies are undocumented.\"\n  ],\n  \"risks\": [\n    {\n      \"id\": \"RISK-FUNC-79-001\",\n      \"risk\": \"Incluir runtime state o secretos en paquetes\",\n      \"mitigation\": \"Clasificación de archivos y bloqueos por ruta.\"\n    },\n    {\n      \"id\": \"RISK-FUNC-79-002\",\n      \"risk\": \"Confundir package local con release final\",\n      \"mitigation\": \"Documentar que SBOM, checksums y smoke install quedan pendientes.\"\n    },\n    {\n      \"id\": \"RISK-FUNC-79-003\",\n      \"risk\": \"Artefactos dist versionados accidentalmente\",\n      \"mitigation\": \"Tratar dist/ como output generado excluido del package y del ZIP de entrega.\"\n    }\n  ],\n  \"next_sprint\": \"FUNC-SPRINT-80 — SBOM y supply-chain baseline\",\n  \"adr_required\": false,\n  \"adr_rationale\": \"No se requiere nueva ADR: FUNC-SPRINT-79 implementa una capacidad prevista por la ADR de release/versionado/productización y por la matriz de artefactos liberables. La política operacional queda documentada en docs/05_operations/packaging.md.\",\n  \"audit_report\": \"docs/audits/func_sprint_79_packaging_audit.md\"\n}",
