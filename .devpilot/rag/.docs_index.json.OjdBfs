      },
      "fragment": "\"python -m pytest -q\"\n  ],\n  \"tests\": [\n    {\n      \"id\": \"TEST-FUNC-21-001\",\n      \"path\": \"tests/test_schema_registry.py\",\n      \"purpose\": \"Verify SchemaRegistry catalog loading, duplicate detection, missing file detection, CLI JSON output and report generation.\"\n    }\n  ],\n  \"pass_criteria\": [\n    \"schema list returns CommandResult JSON.\",\n    \"All catalog schemas exist.\",\n    \"No duplicate schema_id exists.\",\n    \"Every schema has version and description.\",\n    \"No external dependency is introduced.\",\n    \"pytest passes.\"\n  ],\n  \"block_criteria\": [\n    \"A listed schema file does not exist.\",\n    \"A duplicate schema_id is accepted without findings.\",\n    \"schema list emits invalid JSON.\",\n    \"The catalog requires network or API keys.\",\n    \"Documentation claims Sprint 21 validates JSON instances.\"\n  ],\n  \"risks\": [\n    \"Schemas are preliminary and registered only; instance validation is deferred to Sprint 22.\",\n    \"Manual schema/catalog drift remains possible until SchemaValidator is implemented.\",\n    \"Future jsonschema dependency decision may require an ADR.\"\n  ],\n  \"next_sprint\": \"FUNC-SPRINT-22 — Schema Validator y schemas de contratos transversales\"\n}",
