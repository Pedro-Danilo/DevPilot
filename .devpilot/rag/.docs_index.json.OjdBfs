    {
      "chunk_id": "ragchunk_74c0c367f8c1165b",
      "source": {
        "path": "docs/functional_sprint_60_manifest.json",
        "line_start": 106,
        "line_end": 137,
        "title": "{"
      },
      "fragment": "\"PolicyEngine produce policy.check spans/eventos/métricas.\",\n    \"ApprovalService produce approval.workflow spans/eventos/métricas.\",\n    \"ModelAdapterRouter produce model.call spans y métricas provider/model/task.\",\n    \"No se registran prompts, completions, secretos, diffs, stdout o stderr crudos.\",\n    \"La observabilidad es best-effort y no cambia comportamiento funcional.\"\n  ],\n  \"block_criteria\": [\n    \"Se registran prompts, completions, diffs, patches, stdout/stderr o secretos crudos.\",\n    \"La instrumentación altera ok/exit_code/message de CommandResult.\",\n    \"Se introduce dependencia externa obligatoria o telemetría remota.\",\n    \"Agentes no implementados generan trazas inconsistentes.\",\n    \"Se habilita multiagente, handoffs, RAG, MCP o ejecución remota fuera de alcance.\"\n  ],\n  \"risks\": [\n    {\n      \"id\": \"RISK-FUNC-60-001\",\n      \"risk\": \"Acoplar demasiado runtime y observabilidad\",\n      \"mitigation\": \"AgentOpsInstrumentor funciona como fachada best-effort y no como dependencia funcional obligatoria.\"\n    },\n    {\n      \"id\": \"RISK-FUNC-60-002\",\n      \"risk\": \"Datos sensibles en spans\",\n      \"mitigation\": \"Se reutiliza redacción de spans/métricas y se excluyen payloads crudos.\"\n    },\n    {\n      \"id\": \"RISK-FUNC-60-003\",\n      \"risk\": \"Ruido excesivo\",\n      \"mitigation\": \"La consulta y filtros operativos quedan para Sprint 61.\"\n    }\n  ],\n  \"next_sprint\": \"FUNC-SPRINT-61 — CLI de trazas y métricas: trace report, trace inspect, metrics summary\"\n}",
      "tokens": {
