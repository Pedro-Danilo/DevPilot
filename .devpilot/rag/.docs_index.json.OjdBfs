    {
      "chunk_id": "ragchunk_d42a963a643473b5",
      "source": {
        "path": "docs/functional_sprint_81_manifest.json",
        "line_start": 71,
        "line_end": 106,
        "title": "{"
      },
      "fragment": "\"release checksum returns SHA256 for a real local artifact.\",\n    \"release smoke-test validates artifact container and observes subprocess exit codes.\",\n    \"release verify consolidates checksum and smoke-test evidence.\",\n    \"Reports are written only under outputs/reports when requested.\",\n    \"No network, external API, publication, deployment, signing, Git tagging or source mutation is performed.\",\n    \"README, runbook, Fase G backlog and functional backlog are synchronized.\"\n  ],\n  \"block_criteria\": [\n    \"Do not close if no real local artifact is verified.\",\n    \"Do not close if smoke test ignores exit codes.\",\n    \"Do not close if artifacts outside the workspace are accepted.\",\n    \"Do not close if verification publishes, deploys, signs or tags Git.\",\n    \"Do not close if limitations of baseline smoke testing are not documented.\"\n  ],\n  \"risks\": [\n    {\n      \"id\": \"RISK-FUNC-81-001\",\n      \"risk\": \"Verificación de un artefacto inexistente o incorrecto\",\n      \"mitigation\": \"Exigir --artifact explícito y validar existencia dentro del workspace.\"\n    },\n    {\n      \"id\": \"RISK-FUNC-81-002\",\n      \"risk\": \"Smoke test superficial\",\n      \"mitigation\": \"Inspeccionar contenedor y ejecutar CLI mínimo observando exit code.\"\n    },\n    {\n      \"id\": \"RISK-FUNC-81-003\",\n      \"risk\": \"Confundir checksum con firma criptográfica\",\n      \"mitigation\": \"Documentar que SHA256 no sustituye firma ni provenance fuerte.\"\n    }\n  ],\n  \"next_sprint\": \"FUNC-SPRINT-82 — Estrategia de instalación e installer preliminar\",\n  \"adr_required\": false,\n  \"adr_rationale\": \"No se requiere nueva ADR: FUNC-SPRINT-81 implementa artefactos previstos por ADR-0014 y por la matriz Fase G. La política operacional queda documentada en docs/05_operations/release_verification.md.\",\n  \"audit_report\": \"docs/audits/func_sprint_81_release_verification_audit.md\"\n}",
      "tokens": {
