      "fragment": "\"tests/test_schema_registry.py\",\n    \"tests/test_release_changelog.py\",\n    \"tests/test_phase_h_backlog_approval.py\",\n    \"tests/test_advanced_evals.py\",\n    \"tests/test_quality_gate.py\"\n  ],\n  \"pass_criteria\": [\n    \"Remote runner registry validable por schema.\",\n    \"Remote runners deshabilitados por defecto.\",\n    \"RemoteRunnerStub bloquea ejecución remota.\",\n    \"Enterprise report es local/read-only y usa PolicyEngine.\",\n    \"Suite remote-enterprise pasa con safety_score >= 90 y false_negatives == 0.\",\n    \"MIASI declara tools/policies remote y enterprise.\",\n    \"No usa shell, red, APIs externas, cloud ni mutaciones de fuente.\"\n  ],\n  \"block_criteria\": [\n    \"Bloquear si cualquier runner queda enabled por defecto.\",\n    \"Bloquear si se ejecutan comandos remotos reales.\",\n    \"Bloquear si requiere cloud, red, API externa o credenciales.\",\n    \"Bloquear si enterprise report muta fuente o reemplaza PolicyEngine.\",\n    \"Bloquear si no existe ADR.\"\n  ],\n  \"risks\": [\n    \"implemented-initial: no es remote execution real.\",\n    \"No incluye transporte seguro, autenticación distribuida, firma, cifrado ni sandbox remoto.\",\n    \"Enterprise report es agregado local inicial, no reporting enterprise completo.\",\n    \"La habilitación remota futura requiere ADR nueva y safety suite ampliada.\"\n  ],\n  \"next_sprint\": \"FUNC-SPRINT-99\"\n}",
