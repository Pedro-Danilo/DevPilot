      "fragment": "],\n  \"commands\": [\n    \"python -m devpilot_core model eval run --provider mock --json\",\n    \"python -m devpilot_core model eval run --provider mock --json --write-report\",\n    \"python -m devpilot_core model eval run --provider lmstudio --json\",\n    \"python -m devpilot_core model budget status --limit 10 --json\",\n    \"python -m devpilot_core validate all --json\",\n    \"python -m devpilot_core miasi validate --json\",\n    \"python -m pytest -q\"\n  ],\n  \"tests\": [\n    \"tests/test_model_eval_runner.py\",\n    \"tests/test_sprint_50_documentation.py\"\n  ],\n  \"pass_criteria\": [\n    \"Mock eval suite pasa determinísticamente.\",\n    \"Providers unavailable se reportan/skipped y no rompen suite base.\",\n    \"Reporte incluye provider/model/prompt_id/metrics sin prompts crudos.\",\n    \"No se llaman APIs externas.\"\n  ],\n  \"block_criteria\": [\n    \"Eval requiere modelo local real.\",\n    \"Eval mide costo externo sin permiso o llama API externa.\",\n    \"Prompts/completions/secretos quedan en reportes.\"\n  ],\n  \"risks\": [\n    \"Métricas pequeñas y determinísticas; evolucionar a suites por agente/tarea.\",\n    \"Latencia local preliminar; no usar como benchmark industrial.\",\n    \"Providers locales reales pueden variar por hardware; mantener mock como baseline.\"\n  ],\n  \"preliminary\": true,\n  \"next_sprint\": \"FUNC-SPRINT-51 — AgentRuntime v2 model-aware en modo monoagente\"\n}",
