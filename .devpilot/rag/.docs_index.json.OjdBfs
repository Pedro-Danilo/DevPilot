        "title": "{"
      },
      "fragment": "\"tests/test_sprint_22_documentation.py\"\n  ],\n  \"commands\": [\n    \"python -m devpilot_core schema validate-miasi --json\",\n    \"python -m devpilot_core schema validate-workspace --json\",\n    \"python -m devpilot_core schema validate-providers --json\",\n    \"python -m devpilot_core schema validate-manifest docs/functional_sprint_23_manifest.json --json\",\n    \"python -m devpilot_core schema validate-miasi --json --write-report\",\n    \"python -m pytest tests/test_contract_schemas.py -q\",\n    \"python -m pytest -q\"\n  ],\n  \"tests\": [\n    \"tests/test_contract_schemas.py\",\n    \"tests/test_sprint_23_documentation.py\",\n    \"tests/test_schema_registry.py\",\n    \"tests/test_schema_validator.py\"\n  ],\n  \"pass_criteria\": [\n    \"MIASI registries pass structural schemas before semantic MIASI validation.\",\n    \"Workspace project metadata passes structural schema after dependency-free parse.\",\n    \"Provider example metadata passes structural schema without raw secrets.\",\n    \"Functional sprint manifests 19+ pass manifest schema.\",\n    \"New commands return CommandResult and support --json.\",\n    \"New commands support --write-report where applicable.\",\n    \"No network, API key or YAML dependency is introduced.\",\n    \"pytest -q passes.\"\n  ],\n  \"block_criteria\": [\n    \"A critical contract has no schema.\",\n    \"Providers accept raw API keys or secret fields.\",\n    \"Sprint manifests omit files, commands, tests, pass criteria, block criteria or risks.\",\n    \"Structural schema validation is presented as business validation.\",\n    \"A YAML parser dependency is added without ADR.\"\n  ],\n  \"risks\": [\n    \"The YAML parsers are narrow and not general purpose.\",\n    \"Schemas are structural and do not replace semantic validators.\",\n    \"Manifest schema remains flexible to support historical Sprint 19+ manifests.\",\n    \"Future ValidationGateway must avoid duplicating rules across schemas and Python validators.\"\n  ],",
