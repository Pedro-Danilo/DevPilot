      "fragment": "\"README.md\",\n    \"docs/05_operations/runbook.md\",\n    \"docs/devpilot_backlog_fase_G_productizacion_release.md\",\n    \"docs/functional_backlog_after_precode.md\",\n    \"tests/test_quality_gate.py\",\n    \"tests/test_sprint_32_documentation.py through tests/test_sprint_75_documentation.py synchronized with current milestone\"\n  ],\n  \"commands\": [\n    \"python -m devpilot_core quality-gate run --profile ci --pytest-timeout-seconds 600 --json\",\n    \"python -m devpilot_core schema validate-manifest docs/functional_sprint_76_manifest.json --json\",\n    \"python -m devpilot_core validate-artifact docs/05_operations/ci_cd_local.md --json\",\n    \"python -m devpilot_core validate-artifact docs/audits/func_sprint_76_ci_scaffolding_audit.md --json\",\n    \"python -m pytest tests/test_ci_workflow_scaffolding.py tests/test_sprint_76_documentation.py tests/test_quality_gate.py -q\",\n    \"python -m pytest -q\"\n  ],\n  \"tests\": [\n    \"tests/test_ci_workflow_scaffolding.py\",\n    \"tests/test_sprint_76_documentation.py\",\n    \"tests/test_quality_gate.py\",\n    \"historical sprint documentation tests synchronized with README/backlog current milestone\",\n    \"full pytest regression suite\"\n  ],\n  \"pass_criteria\": [\n    \"quality-gate run --profile ci --json returns a parseable CommandResult.\",\n    \"CI profile includes full local gates plus workflow static validation; pytest remains an explicit workflow/local step or opt-in gate subgate.\",\n    \"GitHub Actions workflow is optional, read-only and does not reference secrets.\",\n    \"Workflow does not publish packages, push tags, create releases or deploy.\",\n    \"README, runbook, backlog and functional backlog are synchronized.\"\n  ],\n  \"block_criteria\": [\n    \"No cerrar si el workflow usa secrets o credenciales externas.\",\n    \"No cerrar si el workflow publica paquetes o ejecuta entrega remota.\",\n    \"No cerrar si el perfil CI no es reproducible localmente.\",\n    \"No cerrar si no existe validación estática del workflow.\",\n    \"No cerrar si se agregan dependencias externas sin justificación.\"\n  ],\n  \"risks\": [\n    {\n      \"id\": \"RISK-FUNC-76-001\",\n      \"risk\": \"Divergencia local vs CI\",",
