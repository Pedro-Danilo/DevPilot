    {
      "chunk_id": "ragchunk_80d196cda3bae4a7",
      "source": {
        "path": "docs/functional_sprint_80_manifest.json",
        "line_start": 71,
        "line_end": 105,
        "title": "{"
      },
      "fragment": "\"SBOM declares runtime, dev and build dependencies from local manifests.\",\n    \"SBOM declares UI npm dependencies from package.json/package-lock when available.\",\n    \"SBOM includes CycloneDX-compatible baseline payload.\",\n    \"Command does not call network or external vulnerability services.\",\n    \"README, runbook, Fase G backlog and functional backlog are synchronized.\"\n  ],\n  \"block_criteria\": [\n    \"Do not close if SBOM requires network.\",\n    \"Do not close if dev dependencies are omitted.\",\n    \"Do not close if build dependencies are omitted.\",\n    \"Do not close if limitations of initial SBOM are not documented.\",\n    \"Do not close if command publishes, deploys, signs or tags Git.\"\n  ],\n  \"risks\": [\n    {\n      \"id\": \"RISK-FUNC-80-001\",\n      \"risk\": \"Falso sentido de seguridad por confundir SBOM con SCA completo\",\n      \"mitigation\": \"Documentar que no hay vulnerability scan ni license scan.\"\n    },\n    {\n      \"id\": \"RISK-FUNC-80-002\",\n      \"risk\": \"Dependencias ocultas\",\n      \"mitigation\": \"Parsear pyproject.toml, package.json y package-lock.json.\"\n    },\n    {\n      \"id\": \"RISK-FUNC-80-003\",\n      \"risk\": \"Formato SBOM insuficiente\",\n      \"mitigation\": \"Generar payload CycloneDX-compatible preliminar y plan de evolución.\"\n    }\n  ],\n  \"next_sprint\": \"FUNC-SPRINT-81 — Checksums, smoke tests y verificación de release\",\n  \"adr_required\": false,\n  \"adr_rationale\": \"No se requiere nueva ADR: FUNC-SPRINT-80 implementa un artefacto previsto por ADR-0014 y por la matriz de artefactos liberables. La política operacional queda documentada en docs/03_security/supply_chain_policy.md.\",\n  \"audit_report\": \"docs/audits/func_sprint_80_sbom_supply_chain_audit.md\"\n}",
