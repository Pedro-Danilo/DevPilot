      "fragment": "{\n  \"sprint\": \"FUNC-SPRINT-71\",\n  \"title\": \"Approval Center y acciones dry-run desde UI\",\n  \"status\": \"implemented\",\n  \"implemented_at\": \"2026-06-16\",\n  \"phase\": \"FASE-F-PRODUCTO-VISUAL\",\n  \"source_repo\": \"repo_DevPilot_Local_89.zip\",\n  \"wave\": \"Fase F — Producto visual\",\n  \"source_backlog\": \"docs/devpilot_backlog_fase_F_producto_visual.md\",\n  \"summary\": {\n    \"approval_center_implemented\": true,\n    \"approval_center_status\": \"implemented-initial\",\n    \"approval_api_routes_total\": 5,\n    \"dry_run_action_launcher_implemented\": true,\n    \"dry_run_actions_supported\": [\n      \"readiness\",\n      \"code-review\",\n      \"refactor-plan\"\n    ],\n    \"critical_actions_blocked_from_ui\": true,\n    \"blocked_critical_actions\": [\n      \"patch-apply\",\n      \"refactor-execute\",\n      \"rollback-execute\",\n      \"tests-run-execute\",\n      \"git-push\",\n      \"deploy\"\n    ],\n    \"ui_executes_destructive_actions\": false,\n    \"ui_imports_core\": false,\n    \"ui_reads_outputs_directly\": false,\n    \"ui_reads_devpilot_db_directly\": false,\n    \"api_token_required\": true,\n    \"api_policy_binding_enabled\": true,\n    \"application_service_gateway_only\": true,\n    \"routes_total\": 25,\n    \"preliminary\": true,\n    \"external_api_used\": false,\n    \"network_required\": false,\n    \"next_sprint\": \"FUNC-SPRINT-72\"",
