      "fragment": "\"python -m devpilot_core policy check external-api --external-api --provider openai --estimated-cost-usd 0.01 --json\",\n    \"python -m pytest -q\"\n  ],\n  \"pass_criteria\": [\n    \"Safe local read passes policy check.\",\n    \"Dangerous delete action blocks by default.\",\n    \"Secret-like text blocks and is redacted in reports/traces.\",\n    \"External API without budget/policy blocks by default.\",\n    \"ReportEngine and EventLogger redact through SecretGuard.\",\n    \"pytest -q passes.\"\n  ],\n  \"block_criteria\": [\n    \"Any path outside project root is allowed.\",\n    \"A .env or .git path is allowed.\",\n    \"A destructive action is allowed by default.\",\n    \"A secret-like token is persisted without redaction.\",\n    \"External API usage is allowed with no budget/policy.\"\n  ],\n  \"tests\": {\n    \"file\": \"tests/test_policy_engine.py\",\n    \"total_suite_result\": \"63 passed, 0 failed, 0 errors, 0 skipped\"\n  },\n  \"risks\": [\n    \"SecretGuard is pattern-based and not an industrial scanner.\",\n    \"CostGuard does not measure real provider usage yet.\",\n    \"PathGuard policies are static in this first version.\",\n    \"Human approval persistence is not implemented yet.\",\n    \"Policy Matrix MIASI executable remains for a later sprint.\"\n  ],\n  \"next_sprint\": \"FUNC-SPRINT-10 — Persistencia local SQLite y estado operativo\"\n}",
