      "source": {
        "path": "docs/functional_sprint_42_manifest.json",
        "line_start": 71,
        "line_end": 82,
        "title": "{"
      },
      "fragment": "\"Rollback runtime points are packaged as release artifacts.\",\n    \"The sprint enables Git write, deploy or refactor execution.\"\n  ],\n  \"risks\": [\n    \"Rollback remains initial and metadata-driven, not a complete transactional restore engine.\",\n    \"Backups can consume local disk space.\",\n    \"Secret-like files are blocked and require manual handling.\",\n    \"Future execute semantics must add tests, approval and restore validation.\"\n  ],\n  \"preliminary\": true,\n  \"next_sprint\": \"FUNC-SPRINT-43 — RefactorExecutor controlado en sandbox\"\n}",
