      "sequence": 4,
      "source_agent": "repo.analysis",
      "target_agent": "code.review",
      "reason": "CodeReviewAgent checks code-level findings using prior SDLC context through explicit handoff.",
      "policy_decision": "allow",
      "trace_id": "trace-post-h-032-h-sdlc-review-004",
      "explicit": true,
      "visible_to_operator": true,
      "supervisor_gate_required": true,
      "human_checkpoint_required": true,
