  "handoffs": [
    {
      "handoff_id": "handoff-sdlc-review-001-requirements-agent",
      "workflow_id": "sdlc-review",
      "sequence": 1,
      "source_agent": "operator",
      "target_agent": "requirements.agent",
      "reason": "RequirementsAgent starts the SDLC review by checking requirements and traceability evidence.",
      "policy_decision": "allow",
      "trace_id": "trace-post-h-032-h-sdlc-review-001",
      "explicit": true,
      "visible_to_operator": true,
      "supervisor_gate_required": true,
      "human_checkpoint_required": false,
      "observability_events": [
        "multiagent.handoff.planned",
        "policy.decision",
        "supervisor.gate.decision",
        "multiagent.handoff.traced"
      ]
    },
    {
      "handoff_id": "handoff-sdlc-review-002-architecture-agent",
      "workflow_id": "sdlc-review",
      "sequence": 2,
      "source_agent": "requirements.agent",
      "target_agent": "architecture.agent",
      "reason": "ArchitectureAgent receives requirements context and checks architecture alignment and drift risks.",
      "policy_decision": "allow",
      "trace_id": "trace-post-h-032-h-sdlc-review-002",
      "explicit": true,
      "visible_to_operator": true,
      "supervisor_gate_required": true,
      "human_checkpoint_required": false,
      "observability_events": [
        "multiagent.handoff.planned",
        "policy.decision",
