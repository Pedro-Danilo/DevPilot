      "workflow_id": "sdlc-review",
      "sequence": 3,
      "source_agent": "architecture.agent",
      "target_agent": "repo.analysis",
      "reason": "RepoAnalysisAgent inventories repository health after requirements and architecture review.",
      "policy_decision": "allow",
      "trace_id": "trace-post-h-032-h-sdlc-review-003",
      "explicit": true,
      "visible_to_operator": true,
      "supervisor_gate_required": true,
      "human_checkpoint_required": false,
      "observability_events": [
        "multiagent.handoff.planned",
        "policy.decision",
        "supervisor.gate.decision",
        "multiagent.handoff.traced"
      ]
    },
    {
      "handoff_id": "handoff-sdlc-review-004-code-review",
