  "human_checkpoints": [
    {
      "checkpoint_id": "checkpoint-code-review-risk",
      "workflow_id": "sdlc-review",
      "agent_id": "code.review",
      "action_type": "write",
      "risky": true,
      "required": true,
      "approval_binding_required": true,
      "blocks_without_approval": true,
      "reason": "Code review may propose risky changes; no write is allowed without human approval."
    },
    {
      "checkpoint_id": "checkpoint-security-risk",
      "workflow_id": "sdlc-review",
      "agent_id": "security.agent",
      "action_type": "execute",
      "risky": true,
      "required": true,
      "approval_binding_required": true,
      "blocks_without_approval": true,
      "reason": "Security actions that could execute or mutate state require explicit human approval."
    },
    {
      "checkpoint_id": "checkpoint-test-run-risk",
      "workflow_id": "sdlc-review",
      "agent_id": "testplanner.agent",
      "action_type": "execute",
      "risky": true,
      "required": true,
      "approval_binding_required": true,
      "blocks_without_approval": true,
      "reason": "Test execution is not automatic; testplanner emits plan-only recommendations unless approved."
    }
  ],
  "evals": [
    {
      "case_id": "workflow-positive-sdlc-review",
      "type": "positive",
      "reason": "All handoffs explicit, scoped and traced.",
      "should_block": false
    },
    {
      "case_id": "workflow-negative-implicit-handoff",
      "type": "negative",
      "reason": "A target agent appears without explicit source/reason.",
      "should_block": true,
      "block_reason": "implicit_handoff"
    },
    {
      "case_id": "workflow-negative-tool-inheritance",
      "type": "negative",
      "reason": "A child agent inherits coordinator-only or forbidden tools.",
      "should_block": true,
      "block_reason": "unscoped_tool_inheritance"
    },
    {
      "case_id": "workflow-negative-missing-human-checkpoint",
      "type": "negative",
      "reason": "Risky write/execute action lacks checkpoint.",
      "should_block": true,
      "block_reason": "missing_human_checkpoint"
    },
    {
      "case_id": "workflow-negative-insufficient-evidence",
      "type": "negative",
      "reason": "Supervisor evidence below threshold.",
      "should_block": true,
      "block_reason": "insufficient_evidence"
    }
  ],
  "observability_events": [
    "multiagent.handoff.planned",
    "policy.decision",
    "supervisor.gate.decision",
    "human.checkpoint.required",
    "multiagent.handoff.traced",
    "multiagent.workflow.evaluated"
  ],
  "no_go_gates": [
    "multiagent-swarm-autonomy-blocked",
    "multiagent-implicit-handoff-blocked",
    "multiagent-unscoped-tool-inheritance-blocked",
    "multiagent-missing-human-checkpoint-blocked",
    "multiagent-write-remote-plugin-without-approval-blocked"
  ],
  "notes": [
    "POST-H-032-H hardens handoff evidence and does not enable autonomous swarms.",
    "Child agents keep their own tool scopes and never inherit coordinator tools.",
    "All risky actions remain blocked until human approval in a future execution workflow."
  ],
  "limitations": [
    "Implemented-initial hardening; it validates contracts and evals, not production autonomous orchestration.",
    "No LLM, network, external API, connector write, plugin execution, remote execution or source mutation is enabled."
  ]
}
