{
  "schema_version": "1.0",
  "policy_id": "devpilot-multiagent-handoff-policy",
  "created_by": "POST-H-032-H",
  "status": "implemented-initial",
  "updated_at": "2026-07-11",
  "scope": "Deterministic hardening policy for visible, traceable and blockable multiagent handoffs without swarm autonomy.",
  "workflow_id": "sdlc-review",
  "workflow_registry_path": ".devpilot/workflows/sdlc_review.json",
  "defaults": {
    "swarm_autonomy_enabled": false,
    "autonomous_planner_enabled": false,
    "dry_run_required": true,
    "report_only": true,
    "human_checkpoint_required_for_risky_actions": true,
    "supervisor_gate_required": true,
    "connector_write_enabled": false,
    "plugin_execution_enabled": false,
    "remote_execution_enabled": false,
    "external_api_enabled": false,
    "network_enabled": false,
    "llm_enabled_by_default": false,
    "tools_executed": false,
    "source_mutations_performed": false
  },
  "supervisor_gate": {
    "gate_id": "multiagent-supervisor-deterministic-gate",
    "enabled": true,
    "deterministic": true,
    "minimum_evidence_items": 2,
    "required_fields": [
      "reason",
      "source_agent",
      "target_agent",
      "policy_decision",
      "trace_id"
    ],
    "block_on_insufficient_evidence": true,
    "block_on_unscoped_tool": true,
    "block_on_missing_human_checkpoint": true,
    "block_on_implicit_handoff": true,
    "eval_cases": [
      {
        "case_id": "positive-explicit-handoff",
        "evidence_items_total": 3,
        "policy_ok": true,
        "expected_decision": "allow"
      },
      {
        "case_id": "negative-insufficient-evidence",
        "evidence_items_total": 1,
        "policy_ok": true,
        "expected_decision": "block"
      },
      {
        "case_id": "negative-policy-block",
        "evidence_items_total": 3,
        "policy_ok": false,
        "expected_decision": "block"
      }
    ]
  },
  "agent_scopes": {
    "requirements.agent": {
      "scope_id": "scope-requirements-agent",
      "allowed_tools": [
        "agent.requirements.run",
        "artifact.read",
        "traceability.coverage",
        "report.write",
        "trace.append",
        "policy.check",
        "agent.model.generate"
      ],
      "forbidden_tools": [
        "connector.write",
        "filesystem.delete",
        "plugin.code.execute",
        "remote.runner.execute",
        "rollback.execute"
      ],
      "inherits_coordinator_tools": false,
      "external_api_allowed": false,
      "memory_shared_with_children": false,
      "rag_context_shared_only_as_citations": true,
      "source_mutation_allowed": false
    },
    "architecture.agent": {
