  "no_go_gates": [
    {
      "gate_id": "tool-not-allowlisted-blocked",
      "condition": "Agent/tool pair is not present in allowlist.",
      "severity": "critical",
      "default_state": "pass"
    },
    {
      "gate_id": "risky-tool-without-approval-blocked",
      "condition": "High/critical or approval-gated tool does not require scoped approval binding.",
      "severity": "critical",
      "default_state": "pass"
    },
    {
      "gate_id": "tool-execute-by-default-blocked",
      "condition": "Tool execution is enabled without dry-run-first planning.",
      "severity": "critical",
      "default_state": "pass"
    },
    {
      "gate_id": "connector-write-plugin-remote-blocked",
      "condition": "Connector write, plugin execution or remote execution is enabled by the contract.",
      "severity": "critical",
      "default_state": "pass"
    },
    {
      "gate_id": "tool-injection-target-change-blocked",
      "condition": "Prompt/tool injection attempts to change tool target or bypass approval/policy.",
      "severity": "critical",
      "default_state": "pass"
    }
  ],
  "notes": [
    "POST-H-032-F enables contract validation and fake/local tool planning only.",
    "No generic tool scheduler, connector write, plugin execution or remote execution is enabled.",
    "This policy is implemented-initial and must evolve with additional adversarial suites before production-grade generic execution."
  ]
