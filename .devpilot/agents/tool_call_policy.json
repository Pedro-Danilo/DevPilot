{
  "schema_version": "1.0",
  "policy_id": "devpilot-agent-tool-call-policy",
  "created_by": "POST-H-032-F",
  "status": "implemented-initial",
  "updated_at": "2026-07-11",
  "scope": "Contract-only governed agent tool calling for fake/local tools under MIASI allowlists.",
  "defaults": {
    "dry_run_first": true,
    "contract_only": true,
    "fake_local_tools_only": true,
    "execute_enabled_by_default": false,
    "connector_write_enabled": false,
    "plugin_execution_enabled": false,
    "remote_execution_enabled": false,
    "external_api_enabled": false,
    "network_enabled": false,
    "approval_binding_required_for_risky_tools": true,
    "observability_required": true,
    "tool_injection_guard_required": true,
    "report_only_under_outputs": true
  },
  "risk_policy": {
    "low": {
      "approval_required": false,
      "dry_run_first_required": true
    },
    "medium": {
      "approval_required": false,
      "dry_run_first_required": true
    },
    "medium_high": {
      "approval_required": true,
      "dry_run_first_required": true
    },
    "high": {
      "approval_required": true,
      "dry_run_first_required": true
    },
    "critical": {
      "approval_required": true,
      "dry_run_first_required": true
    }
  },
  "disallowed_capabilities": [
    "connector.write",
    "plugin.code.execute",
    "remote.runner.execute",
    "network_cost",
    "external-api",
    "shell-execution"
